---
import '../styles/global.css';
import { PESSOAS_DE_TESTE, semLogin } from '../lib/servidor/acesso';
import { ehHomologacao } from '../lib/servidor/ambiente';
import { podeEspelhar } from '../lib/servidor/espelho';
import { listarIntegrantes, listarNucleos, tamanhoDoBanco } from '../lib/servidor/repositorio';
import { emMegabytes, LIMITE_DO_PLANO, situacaoDoBanco } from '../lib/tamanho-do-banco';

interface Props {
  titulo?: string;
}

const { titulo } = Astro.props;
const { usuario } = Astro.locals;
const nucleos = (await listarNucleos()).filter((n) => usuario.nucleos.includes(n.id));
const caminho = Astro.url.pathname.replace(/\/$/, '') || '/';
const nucleoAtual = Astro.url.searchParams.get('nucleo');
const tituloPagina = titulo ? `${titulo} | Memórias Bayara e Bracarense` : 'Memórias Bayara e Bracarense';
const teste = semLogin();
const pessoasDeTeste = teste ? (await listarIntegrantes()).filter((i) => PESSOAS_DE_TESTE.includes(i.id)) : [];
const aqui = Astro.url.pathname + Astro.url.search;
// Recados deixados por formulários comuns, que voltam para a página com ?ok= ou ?erro=
const recadoOk = Astro.url.searchParams.get('ok');
const recadoErro = Astro.url.searchParams.get('erro');
// Aviso de tamanho do banco: só para os admins, junto da cópia do acervo (decisão do Gui, 16/11/2026)
const banco = usuario.admin ? situacaoDoBanco(await tamanhoDoBanco()) : undefined;
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#edf2ee" />
    <title>{tituloPagina}</title>
    <noscript>
      <!-- Sem JavaScript: some o que só funciona com ele, e aparecem os blocos que ele mostraria conforme a escolha -->
      <style>
        [data-passo], .atalhos, [data-etapa-voltar], [data-etapa-continuar], [data-adicionar-pessoa], .botao--arquivo, [data-tirar-retrato], [data-confirmar-cancelar] { display: none !important; }
        [data-para][hidden], [data-so-epoca][hidden], [data-depende][hidden] { display: block !important; }
      </style>
    </noscript>
  </head>
  <body>
    {
      teste && (
        <div class="aviso">
          <p class="miolo">
            {ehHomologacao() ? 'Homologação: a estrutura da família da produção, com nomes e memórias inventados.' : 'Versão de teste, só com memórias de exemplo.'} Ver como:
            {pessoasDeTeste.map((p) => (
              <a href={`/como/${p.id}?volta=${encodeURIComponent(aqui)}`} aria-current={p.id === usuario.pessoa ? 'true' : undefined}>
                {p.apelido ?? p.nome}
              </a>
            ))}
          </p>
        </div>
      )
    }
    <header class="miolo topo">
      <a class="topo__nome" href="/">Memórias Bayara e Bracarense</a>
      <nav class="topo__nav" aria-label="Seções">
        <a href="/" aria-current={caminho === '/' && !nucleoAtual ? 'page' : undefined}>Tudo</a>
        {
          nucleos.map((n) => (
            <a href={`/?nucleo=${n.id}`} aria-current={caminho === '/' && nucleoAtual === n.id ? 'page' : undefined}>
              {n.nome}
            </a>
          ))
        }
        <a href="/capitulos" aria-current={caminho.startsWith('/capitulos') || caminho.startsWith('/temas') ? 'page' : undefined}>Capítulos</a>
        <a href="/arvore" aria-current={caminho === '/arvore' ? 'page' : undefined}>Árvore</a>
        <a href="/pessoas" aria-current={caminho.startsWith('/pessoas') ? 'page' : undefined}>Pessoas</a>
        <a href="/rascunhos" aria-current={caminho === '/rascunhos' ? 'page' : undefined}>Rascunhos</a>
        <a class="topo__acao" href="/nova" aria-current={caminho === '/nova' ? 'page' : undefined}>Nova memória</a>
      </nav>
    </header>
    <main class="miolo">
      {recadoErro && <p class="recado recado--erro" role="alert">{recadoErro}</p>}
      {recadoOk && <p class="recado" role="status">{recadoOk}</p>}
      <slot />
    </main>
    <footer class="miolo rodape">
      Acervo privado da família. Você entrou como {usuario.nome}.
      {
        <span class="rodape__admin">
          <a href="/lixeira">Lixeira</a>
          {usuario.admin && <a href="/admin/tipos">Tipos de momento</a>}
          {usuario.admin && podeEspelhar() && <a href="/admin/espelho">Espelho da produção</a>}
          {usuario.admin && (
            <a href="/api/copia" download>
              Baixar cópia do acervo
            </a>
          )}
          {banco && !banco.passouDoAviso && <span class="rodape__banco">Banco: {banco.texto} de {emMegabytes(LIMITE_DO_PLANO)}</span>}
        </span>
        {
          banco?.passouDoAviso && (
            <p class="recado recado--erro rodape__aviso" role="status">
              O banco do acervo está com {banco.texto}, perto do limite de {emMegabytes(LIMITE_DO_PLANO)} do plano gratuito. A saída combinada é o plano Workers Paid (10 GB por banco).
              Veja "Custo" no documento de estrutura.
            </p>
          )
        }
      }
    </footer>
    <script>
      import { guardarFormularios } from '../lib/cliente/guardar-formulario';
      import { marcarEnvios } from '../lib/cliente/enviando';

      marcarEnvios();

      // Depois dos scripts da página, para os campos devolvidos acertarem o que depende deles
      if (document.readyState === 'complete') guardarFormularios();
      else addEventListener('load', guardarFormularios, { once: true });
    </script>
  </body>
</html>
