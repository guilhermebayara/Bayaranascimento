---
// O esqueleto do visual novo (docs/visual.md, "Fundações que não mudam" e "Sistema"). Na fase 3, as telas
// do site passam para ele grupo a grupo: o menu já aponta para os endereços de verdade.
// Não importa nada de src/styles/global.css: o estilo inteiro vem de src/visual/sistema.ts.
import '../visual/sistema';
import { fontesParaPedirAntes } from '../visual/fontes-da-primeira-tela';
import Assinatura from '../components/visual/Assinatura.astro';
import Monograma from '../components/visual/Monograma.astro';
import Retrato from '../components/visual/Retrato.astro';
import { PESSOAS_DE_TESTE, enderecoDeSaida, semLogin, temLogin } from '../lib/servidor/acesso';
import { ehHomologacao } from '../lib/servidor/ambiente';
import { fontesDoPedido } from '../lib/servidor/conceito';
import { enderecoDoRetrato } from '../lib/retratos';
import { numeroDoRetrato, rotuloDoRetrato, somaDoRetrato } from '../lib/avisos';
import { ENDERECO_DA_ADMINISTRACAO, contaDePendencias } from '../lib/conta';
import { contarPendenciasDaAdministracao } from '../lib/servidor/conta';
import { contarAvisosPendentes, listarIntegrantes, listarNucleos } from '../lib/servidor/repositorio';
import { FONTES_DO_SITE, assinaturaDaTela, atributosDasFontes, combinacaoDe } from '../lib/visual';

interface Props {
  titulo?: string;
  /**
   * Os núcleos do que está sendo visto: o núcleo filtrado na linha do tempo, os da memória ou do
   * capítulo, as famílias da pessoa. Decidem os sobrenomes da assinatura e a cor da tela
   * (assinaturaDaTela, em src/lib/visual.ts). Sem nenhum, vale a família completa.
   */
  nucleos?: string[];
  /** A cor da tela, quando não é a dos núcleos: 'tudo' ou a posição do núcleo ('0', '1', '2', '3') */
  familia?: string;
  /** Qual item do menu está aberto */
  secao?: 'painel' | 'explorar' | 'capitulos' | 'arvore' | 'conceito' | 'conta' | 'administracao' | 'circulo' | 'pessoas' | 'nova';
  /** A página que só a pessoa vê: tingida na cor da família dela */
  intimo?: boolean;
  /** O modo TV: a tela inteira é da memória, sem o topo, o menu e o rodapé */
  palco?: boolean;
  /**
   * A assinatura do rodapé (resposta do Gui à P7 do QA de design, 17/11/2026): inteira nas telas de
   * leitura, que é o padrão, e pela metade da largura nos formulários e nas telas utilitárias.
   * "Sua conta" já nasce com a metade.
   */
  rodape?: 'inteiro' | 'metade';
  /**
   * As telas de mapa, a árvore e o círculo (decisão do Gui, 17/11/2026): o mapa ocupa a janela
   * inteira abaixo do menu, e o rodapé não aparece. Nas outras telas, o rodapé fica.
   */
  mapa?: boolean;
}

const { titulo, nucleos = [], secao, intimo = false, palco = false, mapa = false } = Astro.props;
const rodape = Astro.props.rodape ?? (secao === 'conta' || secao === 'administracao' ? 'metade' : 'inteiro');
const { usuario } = Astro.locals;
const tituloPagina = titulo ? `${titulo} | Memórias Bayara e Bracarense` : 'Memórias Bayara e Bracarense';
// O que o esqueleto lê vai junto, sem fila (causa 1b da medição M1). As pessoas e as famílias já vêm do
// começo do pedido, guardadas (aquecerOPedido); os avisos e as pendências, numa ida só.
const [todosOsNucleos, integrantes, avisosPendentes, pendenciasDaAdministracao] = await Promise.all([
  listarNucleos(),
  listarIntegrantes(),
  palco ? 0 : contarAvisosPendentes(usuario),
  palco ? 0 : contarPendenciasDaAdministracao(usuario),
]);
const assinatura = assinaturaDaTela(nucleos, todosOsNucleos);
const familia = Astro.props.familia ?? assinatura.familia;
// As fontes do site (FONTES_DO_SITE). Nas prévias, uma combinação guardada de antes ainda vale, e a faixa de teste leva de volta à do site.
const fontes = fontesDoPedido(Astro.request);
const combinacaoEmUso = combinacaoDe(fontes);
const combinacaoDoSite = combinacaoDe(FONTES_DO_SITE);
const fontesDiferentes = Boolean(combinacaoDoSite) && combinacaoEmUso !== combinacaoDoSite;
const icones = `/icones/${fontes.serifa}`;
const teste = semLogin();
// Na homologação a família é a de verdade: a faixa fica bem marcada, como símbolo do ambiente, para
// ninguém confundir com o site de verdade (decisão do Gui, 18/11/2026)
const homologa = ehHomologacao();
// "Sair" só aparece onde há o login do Cloudflare Access (P4 do QA de design, 17/11/2026)
const saida = temLogin() ? enderecoDeSaida() : undefined;
const pessoasDeTeste = teste ? integrantes.filter((i) => PESSOAS_DE_TESTE.includes(i.id)) : [];
// "Sua conta" (docs/decisoes.md): abre pelo retrato ou nome de quem está logado, no topo.
const meuRetrato = integrantes.find((i) => i.id === usuario.pessoa)?.retrato;
// O número discreto de avisos no retrato, em qualquer tela (docs/decisoes.md, "Avisos")
// Para quem administra, somam as pendências da administração (a marca delas fica em "Sua conta")
const numeroDeAvisos = numeroDoRetrato(somaDoRetrato(avisosPendentes, pendenciasDaAdministracao));
// "Sua página" e "Seu círculo" só para quem tem página de pessoa no acervo
const temPagina = integrantes.some((i) => i.id === usuario.pessoa);
const aqui = Astro.url.pathname + Astro.url.search;
const volta = encodeURIComponent(aqui);
const caminho = Astro.url.pathname.replace(/\/$/, '');

// "Memórias", no alto, leva ao início, mas o menu também diz "Início": quem tem menos familiaridade
// com sites não precisa adivinhar (pedido do Gui, 16/11/2026)
const menu = [
  { href: '/', texto: 'Início', atual: secao === 'painel' },
  { href: '/explorar', texto: 'Explorar', atual: secao === 'explorar' },
  { href: '/capitulos', texto: 'Capítulos', atual: secao === 'capitulos' },
  { href: '/arvore', texto: 'Árvore', atual: secao === 'arvore' },
  { href: '/pessoas', texto: 'Pessoas', atual: secao === 'pessoas' },
];
const telas = [
  { href: '/', texto: 'Painel', atual: caminho === '' },
  { href: '/carta', texto: 'Carta', atual: caminho === '/carta' },
  { href: '/explorar', texto: 'Explorar', atual: caminho === '/explorar' },
  { href: '/memorias/2025-natal', texto: 'Memória', atual: caminho.startsWith('/memorias') },
  { href: '/pessoas/vo-bela', texto: 'Pessoa', atual: caminho.startsWith('/pessoas/') },
  { href: '/conta', texto: 'Conta', atual: caminho === '/conta' },
  { href: '/conceito/sobre', texto: 'Fontes', atual: caminho === '/conceito/sobre' },
  { href: '/sistema', texto: 'Sistema', atual: caminho === '/sistema' },
];
---

<!doctype html>
<html lang="pt-BR" id="alto" {...atributosDasFontes(fontes)} data-familia={familia} data-intimo={intimo ? '' : undefined} data-tela-de-mapa={mapa ? '' : undefined} data-ver-como={teste ? usuario.pessoa : undefined}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#faf2e6" />
    {/* O ícone do site é o monograma, na serifa em uso (scripts/monograma.mjs) */}
    <link rel="icon" href={`${icones}/favicon.svg`} type="image/svg+xml" />
    <link rel="icon" href={`${icones}/favicon-48.png`} type="image/png" sizes="48x48" />
    <link rel="apple-touch-icon" href={`${icones}/apple-touch-icon.png`} />
    {/* A serifa da assinatura e a grotesca do texto chegam antes, sem esperar o CSS (causa 7 da medição M1) */}
    {fontesParaPedirAntes(fontes).map((arquivo) => <link rel="preload" href={arquivo} as="font" type="font/woff2" crossorigin />)}
    <title>{tituloPagina}</title>
    <script is:inline>
      // Aparelho de toque. No iPhone com iOS 26, o Safari desenha uma banda sólida atrás das suas
      // barras quando existe um elemento preso (sticky ou fixed) encostado na borda da tela: com a
      // faixa de décadas presa no alto, a banda aparecia atrás do relógio. A saída é a do site da
      // @bsurda: no toque, o que fica parado no alto anda por uma animação ligada à rolagem
      // ("pino-novo"), sem sticky. Navegador de toque sem essa animação continua com o sticky.
      (function () {
        var raiz = document.documentElement;
        if (window.matchMedia('(hover: none) and (pointer: coarse)').matches && window.CSS && CSS.supports('animation-timeline: view()')) raiz.classList.add('pino-novo');
      })();
    </script>
  </head>
  <body>
    <a class="pular" href="#conteudo">Pular para o conteúdo</a>
    {
      teste && !palco && (
        <details class:list={['teste', { 'teste--homologa': homologa }]}>
          <summary>
            {homologa ? (
              <span class="teste__ambiente">
                <strong>Homologação</strong> A família de verdade, com memórias de exemplo. O que você faz aqui não vai para o site.
              </span>
            ) : (
              <span>Visual novo, com o acervo de exemplo.</span>
            )}
            <span>
              Vendo como {usuario.nome}. <u>Trocar</u>
            </span>
          </summary>
          <div class="teste__corpo">
            <p>
              <span>Telas:</span>
              {telas.map((t) => (
                <a href={t.href} aria-current={t.atual ? 'page' : undefined}>
                  {t.texto}
                </a>
              ))}
            </p>
            {/* A linha das fontes saiu (decisão do Gui, 23/11/2026): a fonte do site está escolhida, e a
                comparação das combinações fica na página do sistema. Quem ainda tem outra combinação guardada
                de antes vê o recado e volta para a do site. */}
            {fontesDiferentes && (
              <p>
                <span>Esta aba está com outras fontes ({combinacaoEmUso?.toUpperCase() ?? 'misturadas'}).</span>
                <a href={`/conceito/fontes/${combinacaoDoSite}?volta=${volta}`}>Voltar às fontes do site</a>
              </p>
            )}
            <p>
              <span>Ver como:</span>
              {pessoasDeTeste.map((p) => (
                <a href={`/como/${p.id}?volta=${volta}`} aria-current={p.id === usuario.pessoa ? 'true' : undefined}>
                  {p.apelido ?? p.nome}
                </a>
              ))}
            </p>
            <p>
              <a href="/">Início do site</a>
            </p>
          </div>
        </details>
      )
    }
    {
      !palco && (
    <header class="topo">
      <a class="topo__marca" href="/" aria-label="Memórias Bayara e Bracarense, página inicial">
        <span class="topo__monograma" aria-hidden="true">
          <Monograma />
        </span>
        <span class="topo__nome" aria-hidden="true">Memórias</span>
      </a>
      <nav class="topo__nav" aria-label="Seções">
        {
          menu.map((item) => (
            <a href={item.href} aria-current={item.atual ? 'page' : undefined}>
              {item.texto}
            </a>
          ))
        }
        <a class="topo__acao" href="/nova" aria-current={secao === 'nova' ? 'page' : undefined}>
          Nova memória
        </a>
      </nav>
      {/* No celular, "Nova memória" fica à vista na barra, entre a marca e o retrato, e não no fim do menu (P2 do QA de design, 17/11/2026) */}
      <a class="topo__nova" href="/nova" aria-current={secao === 'nova' ? 'page' : undefined}>
        Nova memória
      </a>
      {/* O menu da conta (decisão do Gui, 17/11/2026, "Revisão de estrutura das telas"): o retrato e o
          nome abrem Sua página, Seu círculo, Sua conta, Administração (só admins) e Sair. O número de
          avisos fica no retrato. Sem script, abre e fecha pelo próprio retrato. Seu círculo mora aqui
          desde que saiu de Pessoas (decisão do Gui, 17/11/2026). */}
      <div class="topo__conta" data-atual={secao === 'conta' || secao === 'circulo' ? '' : undefined}>
        <details class="conta-menu">
          <summary aria-label={rotuloDoRetrato(usuario.nome, avisosPendentes, pendenciasDaAdministracao)} data-regiao="retrato">
            <span class="topo__retrato">
              <Retrato nome={usuario.nome} foto={meuRetrato ? enderecoDoRetrato(meuRetrato) : null} redondo cedo />
              {numeroDeAvisos && (
                <span class="topo__avisos" aria-hidden="true">
                  {numeroDeAvisos}
                </span>
              )}
            </span>
            <span class="topo__conta-nome" aria-hidden="true">{usuario.nome}</span>
          </summary>
          <nav class="conta-menu__lista" aria-label="Sua conta">
            {temPagina && <a href={`/pessoas/${usuario.pessoa}`}>Sua página</a>}
            {temPagina && <a href="/circulo" aria-current={secao === 'circulo' ? 'page' : undefined}>Seu círculo</a>}
            <a href="/conta" aria-current={secao === 'conta' ? 'page' : undefined}>
              Sua conta
              {avisosPendentes > 0 && <span class="conta-menu__avisos">{avisosPendentes === 1 ? '1 aviso' : `${avisosPendentes} avisos`}</span>}
            </a>
            {/* A Administração tem página própria (decisão do Gui, 18/11/2026), com as pendências dela ao lado, como os avisos */}
            {usuario.admin && (
              <a href={ENDERECO_DA_ADMINISTRACAO} aria-current={secao === 'administracao' ? 'page' : undefined}>
                Administração
                {pendenciasDaAdministracao > 0 && <span class="conta-menu__avisos">{contaDePendencias(pendenciasDaAdministracao)}</span>}
              </a>
            )}
            {saida && <a href={saida}>Sair</a>}
          </nav>
        </details>
      </div>
      <details class="menu">
        <summary><span>Menu</span></summary>
        <nav class="menu__lista" aria-label="Seções">
          {
            menu.map((item) => (
              <a href={item.href} aria-current={item.atual ? 'page' : undefined}>
                {item.texto}
              </a>
            ))
          }
          <a href="/conta" aria-current={secao === 'conta' ? 'page' : undefined}>Sua conta</a>
        </nav>
      </details>
    </header>
      )
    }
    <main id="conteudo">
      <slot />
    </main>
    {
      !palco && !mapa && (
    <footer class="rodape" data-assinatura={rodape === 'metade' ? 'metade' : undefined}>
      {/* O topo não acompanha a rolagem: no fim da página, o menu de novo e a volta ao alto (P3 do QA de design, 17/11/2026) */}
      <nav class="rodape__links" aria-label="Seções, no fim da página">
        {
          menu.map((item) => (
            <a class="acao acao--quieta" href={item.href} aria-current={item.atual ? 'page' : undefined}>
              {item.texto}
            </a>
          ))
        }
      </nav>
      <div class="rodape__linha">
        <p>
          {/* "Sair" mora só no menu da conta, no retrato (resposta do Gui aos PRs #56 a #60, 17/11/2026) */}
          <span>Acervo privado da família. Você entrou como {usuario.nome}.</span>
        </p>
        <a class="rodape__alto acao acao--quieta" href="#alto">
          Voltar ao alto
        </a>
      </div>
      <Assinatura sobrenomes={assinatura.sobrenomes} />
    </footer>
      )
    }
    {
      !palco && (
        <script>
          import { ligarNoLugar } from '../lib/cliente/no-lugar';
          // Os formulários do dia a dia que mudam a tela no lugar, sem recarregar (data-no-lugar)
          ligarNoLugar();
          // O menu do celular fecha com Esc e com o toque fora dele (P9 do QA de design, 17/11/2026).
          // Sem script, continua fechando só pelo "Menu".
          // O menu da conta, no retrato, segue o mesmo jeito; abrir um fecha o outro.
          const menus = [...document.querySelectorAll<HTMLDetailsElement>('details.menu, details.conta-menu')];
          for (const menu of menus) {
            addEventListener('keydown', (evento) => {
              if (evento.key !== 'Escape' || !menu.open) return;
              const focoDentro = menu.contains(document.activeElement);
              menu.open = false;
              if (focoDentro) menu.querySelector('summary')?.focus();
            });
            addEventListener('click', (evento) => {
              if (menu.open && evento.target instanceof Node && !menu.contains(evento.target)) menu.open = false;
            });
            menu.addEventListener('toggle', () => {
              if (menu.open) for (const outro of menus) if (outro !== menu) outro.open = false;
            });
          }
        </script>
      )
    }
  </body>
</html>
