---
import Cartao from './Cartao.astro';
import { agruparPorAno, maisRecentesPrimeiro } from '../lib/datas';
import type { Integrante, Memoria, Nucleo } from '../lib/servidor/repositorio';

interface Props {
  memorias: Memoria[];
  integrantes: Integrante[];
  nucleos: Nucleo[];
  vazio?: string;
}

const { memorias, integrantes, nucleos, vazio = 'Ainda não há memórias aqui.' } = Astro.props;
// Mais recentes primeiro: rolar a página leva ao passado
const anos = agruparPorAno(maisRecentesPrimeiro(memorias));
// Salto por década (decisão do Gui, 16/11/2026): com a linha do tempo começando pelo mais recente,
// uma barra fixa no alto leva direto às décadas mais antigas. Só aparece com mais de uma década.
const decadaDe = (ano: number) => Math.floor(ano / 10) * 10;
const decadas = [...new Set(anos.map((a) => decadaDe(a.ano)))];
const primeiroDaDecada = new Set(decadas.map((d) => anos.find((a) => decadaDe(a.ano) === d)!.ano));
const tiposPresentes = Astro.locals.tipos.filter((t) => memorias.some((m) => m.tipo === t.id));
---

{
  memorias.length === 0 ? (
    <p class="vazio">{vazio}</p>
  ) : (
    <div data-linha-do-tempo>
      {tiposPresentes.length > 1 && (
        <ul class="filtros" aria-label="Filtrar por tipo de marco">
          <li>
            <button type="button" data-filtro="" aria-pressed="true">
              Tudo
            </button>
          </li>
          {tiposPresentes.map((t) => (
            <li>
              <button type="button" data-filtro={t.id} data-cor style={`--cor-tipo: ${t.cor}`} aria-pressed="false">
                {t.rotulo}
              </button>
            </li>
          ))}
        </ul>
      )}

      {decadas.length > 1 && (
        <nav class="decadas" aria-label="Ir para a década">
          <ul>
            {decadas.map((d) => (
              <li data-decada={d}>
                <a href={`#decada-${d}`}>{d}</a>
              </li>
            ))}
          </ul>
        </nav>
      )}

      {anos.map(({ ano, itens }) => (
        <>
        {primeiroDaDecada.has(ano) && <div class="decada__ancora" id={`decada-${decadaDe(ano)}`}></div>}
        <section class="ano" aria-labelledby={`ano-${ano}`} data-decada={decadaDe(ano)}>
          <h2 class="ano__numero" id={`ano-${ano}`}>
            <span>{ano}</span>
          </h2>
          <div class="ano__itens">
            {itens.map((m) => (
              <Cartao memoria={m} integrantes={integrantes} nucleos={nucleos} />
            ))}
          </div>
        </section>
        </>
      ))}
    </div>
  )
}

<script>
  const raiz = document.querySelector<HTMLElement>('[data-linha-do-tempo]');
  if (raiz) {
    const botoes = [...raiz.querySelectorAll<HTMLButtonElement>('[data-filtro]')];
    const validos = new Set(botoes.map((b) => b.dataset.filtro));

    const aplicar = (tipo: string) => {
      for (const b of botoes) b.setAttribute('aria-pressed', String(b.dataset.filtro === tipo));
      for (const secao of raiz.querySelectorAll<HTMLElement>('.ano')) {
        let visiveis = 0;
        for (const cartao of secao.querySelectorAll<HTMLElement>('.cartao')) {
          const mostra = !tipo || cartao.dataset.tipo === tipo;
          cartao.hidden = !mostra;
          if (mostra) visiveis++;
        }
        secao.hidden = visiveis === 0;
      }
      // Década sem nenhuma memória do tipo escolhido sai da barra de salto
      for (const item of raiz.querySelectorAll<HTMLElement>('.decadas [data-decada]')) {
        item.hidden = !raiz.querySelector(`.ano[data-decada="${item.dataset.decada}"]:not([hidden])`);
      }
    };

    for (const b of botoes) {
      b.addEventListener('click', () => {
        const tipo = b.dataset.filtro ?? '';
        aplicar(tipo);
        const url = new URL(location.href);
        if (tipo) url.searchParams.set('tipo', tipo);
        else url.searchParams.delete('tipo');
        history.replaceState(null, '', url);
      });
    }

    const inicial = new URLSearchParams(location.search).get('tipo') ?? '';
    if (inicial && validos.has(inicial)) aplicar(inicial);
  }
</script>
