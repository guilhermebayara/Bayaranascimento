---
// A carta de Natal (docs/decisoes.md, "Painel pessoal como página inicial"): a saudação grande com o
// nome de quem lê, o texto escrito pelos administradores no site e os nomes de quem assina, cada um
// à mão. Aparece no alto do painel na primeira visita e, depois, em /carta.
import '../visual/telas/painel.css';
import Carimbo from './visual/Carimbo.astro';
import Polaroid from './visual/Polaroid.astro';
import Rabisco from './visual/Rabisco.astro';
import { saudacao } from '../lib/painel';
import { legendaLugarAno } from '../lib/visual';

interface Props {
  /** o nome ou o apelido de quem lê */
  para: string;
  carta: { texto: string; assinatura: string; escritaEm: string };
  /** as fotos que vêm com a carta: as memórias mais recentes em que a pessoa aparece */
  fotos?: { id: string; fotos: { chave: string; legenda: string | null }[]; lugar: string | null; ano: number }[];
  /** a ação do fim da carta */
  acao: { href: string; texto: string };
}

const { para, carta, fotos = [], acao } = Astro.props;
const paragrafos = carta.texto.split(/\n\s*\n/).map((p) => p.trim()).filter(Boolean);
const [abertura, ...resto] = paragrafos;
// "Gui, Giovanna e Magno" vira três nomes, cada um com a sua mão
const assinam = carta.assinatura.split(/\s*,\s*|\s+e\s+|\s*&\s*/).map((n) => n.trim()).filter(Boolean);
// PROVISÓRIO (pergunta 1 do PR do grupo "pessoal"): o carimbo diz só "Natal de <ano>", do ano em que a carta foi escrita
const ano = carta.escritaEm.slice(0, 4);
---

<section class="carta bloco" data-familia="tudo" aria-labelledby="saudacao">
  <div class="miolo grade">
    <header class="carta__frente">
      <p>
        <Carimbo itens={[`Natal de ${ano}`]} />
      </p>
      <h1 class="carta__saudacao" id="saudacao">
        {saudacao(para)}
      </h1>
    </header>
    <div class="carta__verso">
      {abertura && <p class="serifa t-abertura">{abertura}</p>}
      {
        resto.length > 0 && (
          <div class="carta__texto">
            {resto.map((p) => (
              <p>{p}</p>
            ))}
          </div>
        )
      }
      <p class="carta__assina">
        {assinam.map((n) => (
          <span class="mao">{n}</span>
        ))}
        <Rabisco desenho="coracao" />
      </p>
      <p class="carta__acao">
        <a class="botao" href={acao.href}>
          {acao.texto}
        </a>
      </p>
      <slot />
    </div>
    {
      fotos.length > 0 && (
        <div class="carta__fotos" aria-hidden="true">
          {fotos.slice(0, 3).map((m) => (
            <div class="carta__foto">
              <Polaroid id={m.id} fotos={m.fotos} legenda={legendaLugarAno(m.lugar, m.ano)} alt="" monte={false} cedo />
            </div>
          ))}
        </div>
      )
    }
  </div>
</section>
