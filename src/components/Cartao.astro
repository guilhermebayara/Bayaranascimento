---
import Foto from './Foto.astro';
import { TIPOS } from '../data/tipos';
import { fotoChave, formatarDiaMes, nomeCurto, type Memoria, type Pessoa } from '../lib/memorias';

interface Props {
  memoria: Memoria;
  pessoas: Pessoa[];
}

const { memoria, pessoas } = Astro.props;
const { data } = memoria;
const foto = fotoChave(memoria);
const tipo = TIPOS[data.tipo];
const diaMes = formatarDiaMes(memoria);
const nomes = data.pessoas
  .map((ref) => pessoas.find((p) => p.id === ref.id))
  .filter((p): p is Pessoa => Boolean(p))
  .map(nomeCurto);
const nucleo = pessoas.filter((p) => p.data.nucleo);
const ids = new Set(data.pessoas.map((ref) => ref.id));
// "Todo mundo" só quando a lista é exatamente o núcleo da família
const todos = nucleo.length > 1 && ids.size === nucleo.length && nucleo.every((p) => ids.has(p.id));
---

<article class:list={['cartao', foto && 'cartao--com-foto']} data-tipo={data.tipo}>
  {foto && <Foto foto={foto} tipo={data.tipo} mostrarLegenda={false} />}
  <div>
    {diaMes && <p class="cartao__data">{diaMes}</p>}
    <h3><a href={`/memorias/${memoria.id}`}>{data.titulo}</a></h3>
    <ul class="cartao__detalhes">
      <li class="tipo" style={`--cor-tipo: ${tipo.cor}`}>{tipo.rotulo}</li>
      {nomes.length > 0 && <li>{todos ? 'Todo mundo' : nomes.join(', ')}</li>}
      {data.lugar && <li>{data.lugar}</li>}
      {data.exemplo && <li><span class="exemplo">exemplo</span></li>}
    </ul>
  </div>
</article>
