---
import Foto from './Foto.astro';
import { tipoDaMemoria } from '../lib/tipos';
import { formatarDiaMes } from '../lib/datas';
import type { Integrante, Memoria, Nucleo } from '../lib/servidor/repositorio';

interface Props {
  memoria: Memoria;
  integrantes: Integrante[];
  nucleos: Nucleo[];
}

const { memoria, integrantes, nucleos } = Astro.props;
const foto = memoria.fotos[0];
const tipo = tipoDaMemoria(Astro.locals.tipos, memoria);
const diaMes = formatarDiaMes(memoria);
const nomes = memoria.integrantes
  .map((id) => integrantes.find((i) => i.id === id))
  .filter((i): i is Integrante => Boolean(i))
  .map((i) => i.apelido ?? i.nome);
const restritaA = memoria.visibilidade === 'nucleos' ? memoria.nucleos.map((id) => nucleos.find((n) => n.id === id)?.nome).filter(Boolean) : [];
const destino = memoria.situacao === 'rascunho' ? `/nova?id=${memoria.id}` : `/memorias/${memoria.id}`;
---

<article class:list={['cartao', foto && 'cartao--com-foto']} data-tipo={memoria.tipo}>
  {foto && <Foto foto={foto} cor={tipo.cor} mostrarLegenda={false} />}
  <div>
    {diaMes && <p class="cartao__data">{diaMes}</p>}
    <h3><a href={destino}>{memoria.titulo}</a></h3>
    <ul class="cartao__detalhes">
      <li class="tipo" style={`--cor-tipo: ${tipo.cor}`}>{tipo.rotulo}</li>
      {nomes.length > 0 && <li>{nomes.join(', ')}</li>}
      {memoria.lugar && <li>{memoria.lugar}</li>}
      {memoria.relatos > 1 && <li>{memoria.relatos} relatos</li>}
      {restritaA.length > 0 && <li><span class="selo">Só {restritaA.join(' e ')}</span></li>}
      {memoria.situacao === 'rascunho' && <li><span class="selo">Rascunho</span></li>}
      {memoria.exemplo && <li><span class="exemplo">exemplo</span></li>}
    </ul>
  </div>
</article>
