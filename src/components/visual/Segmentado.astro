---
// O seletor segmentado (decisão do Gui, 17/11/2026, "Componentes do sistema"): uma escolha só entre
// poucas, no estilo do controle segmentado do iOS. O Gui liberou o uso (18/11/2026) onde a escolha é de
// uma entre poucas e troca o que aparece embaixo: "Quem pode ver?" da nova memória, "Quem reconhece este
// laço?" e "Como estão hoje?" do casal.
//
// Cada opção é um rádio de formulário: a escolha vai junto com o envio, funciona sem script, e as
// setas do teclado passam de uma opção à outra, como em todo grupo de rádios.
interface Props {
  /** o que está sendo escolhido, para o leitor de tela: "Quem pode ver" */
  rotulo: string;
  /** id de um rótulo visível que nomeia o grupo; quando há, vale ele, e não `rotulo` */
  rotuloId?: string;
  /** o nome do campo do formulário */
  nome: string;
  /** trava a escolha: quem não pode mudar vê o valor de agora */
  travado?: boolean;
  /** id do texto que explica a escolha, lido junto do grupo */
  explicacao?: string;
  opcoes: { valor: string; texto: string; atual?: boolean }[];
}

const { rotulo, rotuloId, nome, travado = false, explicacao, opcoes } = Astro.props;
---

<div class="segmentado" role="radiogroup" aria-label={rotuloId ? undefined : rotulo} aria-labelledby={rotuloId} aria-describedby={explicacao}>
  {
    opcoes.map((o) => (
      <label>
        <input type="radio" name={nome} value={o.valor} checked={o.atual} disabled={travado} />
        <span>{o.texto}</span>
      </label>
    ))
  }
</div>
