---
// A assinatura do nome (docs/visual.md): "MEMÓRIAS" fixo e grande, na largura inteira, e abaixo
// os sobrenomes das famílias do que está sendo visto. O texto por extenso vai para quem não vê.
interface Props {
  sobrenomes?: string;
  /** Quando a assinatura é o título da página */
  titulo?: boolean;
}

const { sobrenomes = 'Bayara & Bracarense', titulo = false } = Astro.props;
const Marca = titulo ? 'h1' : 'p';
const porExtenso = `Memórias ${sobrenomes.replace(/ & /g, ' e ')}`;
---

<Marca class="assinatura" aria-label={porExtenso}>
  <span class="assinatura__memorias" aria-hidden="true">MEMÓRIAS</span>
  <span class="assinatura__sobrenomes" aria-hidden="true">{sobrenomes}</span>
</Marca>
