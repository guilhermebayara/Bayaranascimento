---
// Rabiscos de caneta: os enfeites que alguém faria à mão numa foto ou num bilhete.
// São poucos e pequenos. Todos são enfeite e ficam fora da leitura de tela.
interface Props {
  desenho: 'sublinha' | 'seta' | 'brilhos' | 'coracao' | 'envelope';
}

const { desenho } = Astro.props;
---

{
  desenho === 'sublinha' && (
    <svg class="rabisco rabisco--sublinha" viewBox="0 0 200 12" preserveAspectRatio="none" fill="none" aria-hidden="true">
      <path d="M2 8c18-6 30 4 48 0s30-6 50-1 32 3 50-1 30-3 48 1" stroke="currentColor" stroke-width="3" stroke-linecap="round" vector-effect="non-scaling-stroke" />
    </svg>
  )
}
{
  desenho === 'seta' && (
    <svg class="rabisco rabisco--seta" viewBox="0 0 64 40" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M4 30c14 6 34 2 50-16" />
      <path d="M43 12l11 1-3 11" />
    </svg>
  )
}
{
  desenho === 'brilhos' && (
    <svg class="rabisco rabisco--brilhos" viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M20 6c.8 7.5 4 11.400 13 14-9 2.600-12.200 6.500-13 14-.8-7.500-4-11.400-13-14 9-2.600 12.200-6.500 13-14z" />
      <path d="M38 28c.4 3.400 1.800 5.200 6 6.400-4.200 1.200-5.600 3-6 6.400-.4-3.400-1.800-5.200-6-6.400 4.200-1.200 5.600-3 6-6.400z" />
      <path d="M39 9h.01" stroke-width="3.4" />
    </svg>
  )
}
{
  desenho === 'coracao' && (
    <svg class="rabisco rabisco--coracao" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M12 20c-4.600-3.300-8-6.300-8-10.200C4 7.200 5.900 5.300 8.200 5.300c1.600 0 3 .9 3.800 2.300.8-1.400 2.200-2.300 3.800-2.300 2.300 0 4.200 1.900 4.200 4.500 0 3.900-3.400 6.900-8 10.200z" />
    </svg>
  )
}
{
  // O envelope do laboratório, com as fotos novas saindo dele. As cores vêm da família.
  desenho === 'envelope' && (
    <svg class="rabisco rabisco--envelope" viewBox="0 0 200 176" fill="none" stroke="var(--tinta)" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <g transform="rotate(-11 78 66)">
        <rect x="48" y="14" width="60" height="92" rx="6" fill="var(--branco)" />
        <rect x="55" y="22" width="46" height="58" rx="2" fill="var(--meio)" stroke-width="1.6" />
      </g>
      <g transform="rotate(9 124 62)">
        <rect x="96" y="8" width="60" height="92" rx="6" fill="var(--branco)" />
        <rect x="103" y="16" width="46" height="58" rx="2" fill="var(--pastel)" stroke-width="1.6" />
        <path d="M116 58c4-8 8-8 11 0 3-5 6-5 9 0" stroke-width="1.6" />
        <circle cx="137" cy="30" r="4" stroke-width="1.6" />
      </g>
      <path d="M22 84h156v78c0 4.400-3.600 8-8 8H30c-4.400 0-8-3.600-8-8z" fill="var(--branco)" />
      <path d="M22 86l78 50 78-50" />
      <path d="M24 166l56-44M176 166l-56-44" stroke-width="1.6" />
      <path d="M170 22c.5 4.600 2.400 7 8 8.500-5.600 1.500-7.500 3.900-8 8.500-.5-4.600-2.400-7-8-8.500 5.600-1.500 7.500-3.900 8-8.500z" fill="var(--vivo)" stroke-width="1.8" />
      <path d="M30 40h.01M40 26h.01" stroke-width="4" stroke="var(--vivo)" />
    </svg>
  )
}
