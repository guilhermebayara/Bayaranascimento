---
// A foto-chave como foto revelada (docs/visual.md): moldura branca no formato da Instax mini,
// margem de baixo mais larga com a legenda "lugar (ano)" em mono, e uma inclinação escolhida
// pelo id, sempre a mesma. Com mais de uma foto, as outras aparecem atrás: o monte já diz que
// há mais. A forma de cor atrás leva a cor do tipo de momento (--tipo-cor, posta por quem usa).
// Memória sem foto ganha o mesmo cartão, com a cor e o ícone do tipo no lugar da imagem.
import IconeDoTipo from './IconeDoTipo.astro';
import { formaDoId, giroDoId } from '../../lib/visual';

interface Props {
  /** id da memória: decide a inclinação */
  id: string;
  fotos: { chave: string; legenda: string | null }[];
  legenda: string;
  /** o título da memória, numa linha acima de lugar e ano (as fotos da carta, crítica C2) */
  titulo?: string;
  /** texto alternativo da foto principal */
  alt?: string;
  /** o monte só aparece onde há espaço para ele */
  monte?: boolean;
  /** carrega logo, para a foto do alto da página */
  cedo?: boolean;
  /** sem inclinação */
  reta?: boolean;
  /** a forma de cor atrás da foto */
  forma?: boolean;
  /** o tipo de momento: memória sem foto ganha um cartão do mesmo formato, com o ícone do tipo */
  tipo?: string;
  /** um rabisco pelo nome, no lugar do rabisco do tipo (a prévia de /admin/tipos) */
  rabisco?: string;
  /** na página da memória: cada foto do monte é um link que abre a galeria naquela foto */
  galeria?: boolean;
  /**
   * Uma media query: a foto só é baixada onde ela vale. Para a foto que só existe com mouse (a lista
   * do Explorar): no celular, o navegador fica com uma imagem vazia e não busca o arquivo.
   */
  soOnde?: string;
}

const { id, fotos, legenda, titulo, alt, monte = true, cedo = false, reta = false, forma = false, tipo = 'outro', galeria = false, soOnde, rabisco } = Astro.props;
// Um ponto transparente: o que o navegador mostra onde a foto não é para ser baixada
const VAZIA = 'data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw==';
const [principal, ...outras] = fotos;
const atras = monte ? outras.slice(0, 2) : [];
const giro = reta ? 0 : giroDoId(id);
---

{
  // Memória sem foto: o mesmo cartão, com a cor e o ícone do tipo de momento no lugar da imagem.
  // Assim nenhuma memória fica com um buraco onde as outras têm foto.
  !principal && (
    <div class="monte">
      {forma && <span class="monte__forma" data-forma={formaDoId(id)} aria-hidden="true" />}
      <figure class="polaroid polaroid--sem-foto" style={`--giro: ${giro}deg`}>
        <span class="polaroid__foto" aria-hidden="true">
          <IconeDoTipo tipo={tipo} rabisco={rabisco} />
        </span>
        <figcaption class:list={['polaroid__legenda', { 'polaroid__legenda--com-titulo': titulo }]}>
          {titulo && <span class="polaroid__titulo">{titulo}</span>}
          {legenda}
        </figcaption>
      </figure>
    </div>
  )
}
{
  principal && (
    <div class="monte">
      {forma && <span class="monte__forma" data-forma={formaDoId(id)} aria-hidden="true" />}
      {atras.map((foto, n) =>
        galeria ? (
          // Pelo teclado, a galeria abre na foto principal e segue dali: estas ficam fora da ordem do Tab
          <a class="monte__atras" data-atras={n + 1} href={`/fotos/${foto.chave}`} data-galeria={n + 1} tabindex="-1" aria-hidden="true">
            <span>
              <img src={`/fotos/${foto.chave}`} alt="" loading="lazy" decoding="async" />
            </span>
          </a>
        ) : (
          <div class="monte__atras" data-atras={n + 1} aria-hidden="true">
            <span>
              <img src={`/fotos/${foto.chave}`} alt="" loading="lazy" decoding="async" />
            </span>
          </div>
        ),
      )}
      <figure class="polaroid" style={`--giro: ${giro}deg`}>
        {galeria ? (
          <a class="polaroid__foto" href={`/fotos/${principal.chave}`} data-galeria="0" aria-label={fotos.length > 1 ? `Ver as ${fotos.length} fotos` : 'Ver a foto inteira'}>
            <img src={`/fotos/${principal.chave}`} alt={alt ?? principal.legenda ?? ''} loading={cedo ? 'eager' : 'lazy'} decoding="async" />
          </a>
        ) : (
          <span class="polaroid__foto">
            {soOnde ? (
              <picture>
                <source media={soOnde} srcset={`/fotos/${principal.chave}`} />
                <img src={VAZIA} alt={alt ?? principal.legenda ?? ''} loading="lazy" decoding="async" />
              </picture>
            ) : (
              <img src={`/fotos/${principal.chave}`} alt={alt ?? principal.legenda ?? ''} loading={cedo ? 'eager' : 'lazy'} decoding="async" />
            )}
          </span>
        )}
        <figcaption class:list={['polaroid__legenda', { 'polaroid__legenda--com-titulo': titulo }]}>
          {titulo && <span class="polaroid__titulo">{titulo}</span>}
          {legenda}
        </figcaption>
      </figure>
    </div>
  )
}
