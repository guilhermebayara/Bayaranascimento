---
// Os ícones dos tipos de momento: rabiscos de traço redondo, como desenhados a caneta no verso
// da foto (src/visual/rabiscos.ts). O tipo mostra o rabisco que os administradores escolheram em
// /admin/tipos ou, sem escolha, o de sempre; tipo sem nenhum ganha o brilho.
// O ícone é enfeite: o nome do tipo está sempre escrito ao lado.
import { iconeDoTipo } from '../../lib/visual';
import { rabisco } from '../../visual/rabiscos';

interface Props {
  /** o id do tipo de momento: mostra o rabisco dele */
  tipo?: string;
  /** ou um rabisco pelo nome, sem passar pelo tipo (a grade de escolha, a página do sistema) */
  rabisco?: string;
}

const { tipo = '' } = Astro.props;
const { desenho } = rabisco(Astro.props.rabisco ?? iconeDoTipo(tipo));
---

<svg class="icone" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={desenho} />
