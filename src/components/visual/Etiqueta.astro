---
// A etiqueta-balão: o tipo de momento, com o ícone e a cor dele (docs/visual.md).
import IconeDoTipo from './IconeDoTipo.astro';
import { estiloDaCor, estiloDoTipo } from '../../lib/visual';

interface Props {
  /** o id do tipo de momento: decide o ícone e a cor */
  tipo: string;
  /** o nome do tipo, como a pessoa lê */
  rotulo: string;
  /** uma cor da paleta e um rabisco pelo nome, no lugar dos do tipo (a prévia de /admin/tipos) */
  cor?: string;
  rabisco?: string;
}

const { tipo, rotulo, cor, rabisco } = Astro.props;
---

<span class="etiqueta" style={cor ? estiloDaCor(cor) : estiloDoTipo(tipo)}>
  <IconeDoTipo tipo={tipo} rabisco={rabisco} />
  <span data-etiqueta-rotulo>{rotulo}</span>
</span>
