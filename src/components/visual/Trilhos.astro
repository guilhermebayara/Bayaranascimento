---
// Os trilhos dos capítulos na altura de uma linha da linha do tempo (src/lib/linha-capitulos.ts).
// Cada trilho é uma linha vertical: contínua onde a memória é do capítulo, com uma parada nela,
// e tracejada onde a memória é de fora. Cada trilho leva a cor do capítulo dele. São enfeite: o
// capítulo está escrito na marca do alto do trilho e no sinal de cada memória.
interface Props {
  estados: (string | null)[];
  /** o capítulo que passa por cada trilho aqui, na mesma ordem: a cor dele e o id, para o destaque */
  capitulos?: ({ id: string; estilo: string } | null)[];
}

const { estados, capitulos = [] } = Astro.props;
---

<span class="trilhos" aria-hidden="true">
  {
    estados.map(
      (estado, n) =>
        estado &&
        estado !== 'ponta' && <i class="trilho" data-n={n} data-estado={estado} data-capitulo={capitulos[n]?.id} style={`--n: ${n}; ${capitulos[n]?.estilo ?? ''}`} />,
    )
  }
</span>
