---
// O retrato de foto de álbum (docs/visual.md): um retângulo reto com cantoneiras nos quatro cantos.
// Quem não tem foto aparece com as iniciais sobre a cor da família. É enfeite: o nome da pessoa está sempre escrito ao lado.
import { iniciais } from '../../lib/retratos';

interface Props {
  nome: string;
  /** o endereço da foto de retrato, se a pessoa tem uma */
  foto?: string | null;
  /** a cor da família da pessoa: 'tudo', '0', '1', '2' ou '3'. Sem ela, vale a cor da tela */
  familia?: string;
  /** em círculo, só para o retrato de quem está usando o site: o topo, o Início e o centro do círculo */
  redondo?: boolean;
  /** carrega logo, para o que está no alto da página */
  cedo?: boolean;
  /**
   * Quem já faleceu (decisões do Gui, 18/11/2026): a foto em tom mais suave, que acende com o mouse em
   * cima e com o foco do teclado. Quem usa o retrato escreve "em memória" perto do nome.
   */
  falecido?: boolean;
}

const { nome, foto, familia, redondo = false, cedo = false, falecido = false } = Astro.props;
---

<span class:list={['retrato', { 'retrato--redondo': redondo, 'retrato--falecido': falecido }]} data-familia={familia}>
  {foto ? <img src={foto} alt="" loading={cedo ? undefined : 'lazy'} decoding={cedo ? undefined : 'async'} /> : <span aria-hidden="true">{iniciais(nome)}</span>}
</span>
