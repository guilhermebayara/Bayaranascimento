---
// O retrato de foto de álbum (docs/visual.md): um retângulo reto com cantoneiras nos quatro cantos.
// Quem não tem foto aparece com as iniciais sobre a cor da família. É enfeite: o nome da pessoa está sempre escrito ao lado.
import { fontesDoRetrato, iniciais } from '../../lib/retratos';

interface Props {
  nome: string;
  /** o endereço da foto de retrato, se a pessoa tem uma */
  foto?: string | null;
  /** a cor da família da pessoa: 'tudo', '0', '1', '2' ou '3'. Sem ela, vale a cor da tela */
  familia?: string;
  /** em círculo: o retrato de quem está usando o site (o topo e o Início) e as pessoas do círculo */
  redondo?: boolean;
  /** carrega logo, para o que está no alto da página */
  cedo?: boolean;
  /**
   * Quem já faleceu (decisões do Gui, 18/11/2026): a foto em tom mais suave, que acende com o mouse em
   * cima e com o foco do teclado. Quem usa o retrato escreve "em memória" perto do nome.
   */
  falecido?: boolean;
  /**
   * O retrato grande, de até 300 px de altura (a página da pessoa, a do laço e "Sua conta"): o navegador
   * escolhe entre a cópia pequena e a original (fontesDoRetrato). Os outros usam só a cópia.
   */
  grande?: boolean;
}

const { nome, foto, familia, redondo = false, cedo = false, falecido = false, grande = false } = Astro.props;
const fontes = foto ? fontesDoRetrato(foto, grande) : null;
---

<span class:list={['retrato', { 'retrato--redondo': redondo, 'retrato--falecido': falecido }]} data-familia={familia}>
  {fontes ? <img src={fontes.src} srcset={fontes.srcset} sizes={fontes.sizes} alt="" loading={cedo ? undefined : 'lazy'} decoding={cedo ? undefined : 'async'} /> : <span aria-hidden="true">{iniciais(nome)}</span>}
</span>
