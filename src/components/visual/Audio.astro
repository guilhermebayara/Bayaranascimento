---
// O bloco de áudio de um relato (docs/visual.md): o rótulo com a duração, o tocador do próprio
// aparelho e a transcrição, que abre empurrando o conteúdo.
interface Props {
  /** "Áudio · 2 min 14 s" */
  rotulo: string;
  src?: string;
  transcricao?: string | null;
}

const { rotulo, src, transcricao } = Astro.props;
---

<div class="audio">
  <p class="rotulo">{rotulo}</p>
  <audio controls preload="none" src={src}></audio>
  {
    transcricao && (
      <details>
        <summary>Ler a transcrição</summary>
        {transcricao.split(/\n{2,}/).map((p) => (
          <p>{p}</p>
        ))}
      </details>
    )
  }
</div>
