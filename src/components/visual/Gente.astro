---
// Uma pessoa numa linha de lista: o retrato pequeno, o nome e, embaixo, o que ela é ("sua avó",
// "amigo-irmão") e um detalhe em mono ("adoção em maio de 2001", "só você vê"). A linha inteira é
// o link para a página da pessoa. Serve às listas de laços, na página da pessoa e na conta.
// Peça aprovada pelo Gui em 17/11/2026 (pergunta 9 do PR do grupo "pessoal").
import Retrato from './Retrato.astro';

interface Props {
  href: string;
  nome: string;
  /** o apelido que quem olha vê, ao lado do nome: "Alexsander (Lugh)". Só na lista de Pessoas */
  apelido?: string | null;
  /** o endereço do retrato, se a pessoa tem um e quem olha pode ver */
  foto?: string | null;
  /** a cor da família da pessoa */
  familia?: string;
  /** o parentesco ou o nome do laço */
  laco?: string | null;
  /** um detalhe, em mono */
  detalhe?: string | null;
  /** quem já faleceu: o retrato fica em tom suave, e "em memória" vem escrito embaixo */
  falecido?: boolean;
}

const { href, nome, apelido, foto, familia, laco, detalhe, falecido = false } = Astro.props;
---

<a class="gente" href={href}>
  <Retrato nome={nome} foto={foto} familia={familia} falecido={falecido} />
  <span class="gente__quem">
    <strong>{nome}{apelido && <span class="gente__apelido"> ({apelido})</span>}</strong>
    {laco && <span class="gente__laco suave">{laco}</span>}
    {detalhe && <span class="ficha suave">{detalhe}</span>}
    {falecido && <span class="em-memoria">em memória</span>}
  </span>
</a>
