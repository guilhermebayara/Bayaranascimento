---
// A linha do tempo do Explorar. A ideia da tela: o ano como divisória de fichário e as fotos-chave
// como fotos reveladas; a ficha de cada memória fica numa linha mono. Os capítulos aparecem como
// trilhos à esquerda das memórias (src/lib/linha-capitulos.ts), e as épocas de todos, como o chão.
//
// As memórias chegam já filtradas e na ordem pedida (src/lib/explorar.ts). Os trilhos, as épocas e
// a faixa de décadas só aparecem quando a ordem é a do tempo e nenhum filtro quebra a continuidade
// (`trilhos`): nos outros casos, o capítulo vem escrito em cada memória. Fora da ordem do tempo
// ("Entraram por último", "Mais contadas"), a lista é corrida, sem a divisória dos anos.
import IconeDoTipo from '../visual/IconeDoTipo.astro';
import SinalDoCapitulo from '../visual/SinalDoCapitulo.astro';
import Polaroid from '../visual/Polaroid.astro';
import Trilhos from '../visual/Trilhos.astro';
import Vazio from '../visual/Vazio.astro';
import { agruparPorAno } from '../../lib/datas';
import { capitulosNosTrilhos, chaoDaEpoca, montarTrilhos, trilhosNaEpoca, trilhosNaMarca } from '../../lib/linha-capitulos';
import { ehEpoca, type Capitulo } from '../../lib/capitulos';
import { ancoraDaMemoria, type Ordem } from '../../lib/explorar';
import { tipoDaMemoria } from '../../lib/tipos';
import type { Integrante, Memoria, Nucleo } from '../../lib/servidor/repositorio';
import { carimboDaData, diaMesCurto, estiloDoCapitulo, estiloDoTipo, legendaLugarAno, listaCurta } from '../../lib/visual';

interface Props {
  /** as memórias que a pessoa vê, já filtradas e na ordem pedida */
  memorias: Memoria[];
  /** os capítulos que a pessoa pode ver */
  capitulos: Capitulo[];
  integrantes: Integrante[];
  nucleos: Nucleo[];
  ordem: Ordem;
  /** os trilhos, as épocas e a faixa de décadas aparecem (mostraTrilhos, em src/lib/explorar.ts) */
  trilhos: boolean;
  /** para limpar os filtros, quando nada passa neles */
  limpar?: string;
  /**
   * O fecho, depois da última memória (resposta do Gui à P41 do QA de design de 17/11/2026). A frase
   * "Aqui começa o acervo." só aparece quando é verdade (terminaNoComecoDoAcervo, em src/lib/explorar.ts).
   */
  fecho?: { comecoDoAcervo: boolean };
}

const { memorias, integrantes, nucleos, ordem, trilhos, limpar } = Astro.props;
const { tipos } = Astro.locals;
const { fecho } = Astro.props;
const nomeDe = (id: string) => integrantes.find((i) => i.id === id)?.apelido ?? integrantes.find((i) => i.id === id)?.nome;

// Na ordem do tempo, o ano é a divisória. Rolar a página leva ao passado ou, em "Mais antigas
// primeiro", ao presente. Fora dela, a lista é uma só.
const peloTempo = ordem === 'recentes' || ordem === 'antigas';
const paraOPresente = ordem === 'antigas';
const naOrdemDaTela = memorias;
const anos = peloTempo ? agruparPorAno(naOrdemDaTela) : naOrdemDaTela.length ? [{ ano: 0, itens: naOrdemDaTela }] : [];
// Os capítulos como trilhos: só os que a pessoa pode ver, contando só as memórias que ela vê aqui
//
// Época e capítulo (decisão do Gui, 16/11/2026; ver src/lib/linha-capitulos.ts). O capítulo por
// período diz de quem é (migração 019): as memórias do período em que a pessoa não está ficam de
// fora, com o trilho tracejado. Os capítulos por período sem ninguém são épocas de todos e viram o
// chão, sem trilho.
const capitulos = Astro.props.capitulos.map((c) => (ehEpoca(c) ? { ...c, deTodos: true } : c));
// Sem os trilhos, as épocas também saem: o chão só faz sentido com a linha do tempo inteira
const montagem = montarTrilhos(
  naOrdemDaTela,
  capitulos.filter((c) => trilhos || !('deTodos' in c)),
);
const posicaoDe = new Map(naOrdemDaTela.map((m, i) => [m.id, i]));
const capituloDe = (id: string) => montagem.capitulos.find((c) => c.id === id)!;
const epocaDe = (id: string) => montagem.epocas.find((e) => e.id === id)!;
// A época de todos é o chão da linha do tempo: as memórias de dentro dela ficam sobre um papel de
// outro tom. Onde duas épocas valem ao mesmo tempo, o chão fica um tom mais fundo (até três).
const chao = (epocas: number) => (epocas > 0 ? String(Math.min(epocas, 3)) : undefined);
const chaoEm = (posicao: number) => chao(montagem.linhas[posicao]!.epocas);
// Entre um ano e outro, o chão é o das épocas que vêm da memória de cima e continuam na de baixo
const chaoDeCima = (posicao: number) => chao(montagem.linhas[posicao]!.epocasDeCima);
// O capítulo de cada trilho na altura de uma memória: a cor dele e o id, para o destaque
const noTrilho = (posicao: number) =>
  capitulosNosTrilhos(montagem, Math.min(posicao, naOrdemDaTela.length - 1)).map((c) => (c ? { id: c.id, estilo: estiloDoCapitulo(c.cor) } : null));
// No computador, o ano diz também as épocas que passam por ele: no meio de uma época longa, a aba
// com o nome dela já ficou para trás
const epocasDoAno = (itens: { id: string }[]) => {
  const posicoes = itens.map((m) => posicaoDe.get(m.id)!);
  return montagem.epocas.filter((e) => posicoes.some((p) => e.primeira <= p && p <= e.ultima));
};
const decadaDe = (ano: number) => Math.floor(ano / 10) * 10;
const decadas = [...new Set(anos.map((a) => decadaDe(a.ano)))];
const primeiroDaDecada = new Set(decadas.map((d) => anos.find((a) => decadaDe(a.ano) === d)!.ano));
// Onde o trilho acaba, embaixo: na ordem de sempre, é o começo do capítulo; em "Mais antigas primeiro", o fim
const pontaDeBaixo = paraOPresente ? 'Fim' : 'Começo';
const primeiraMemoria = anos[0]?.itens[0]?.id;
---

<div class="linha" data-linha-do-tempo data-filtrando={trilhos ? undefined : ''} style={`--trilhos: ${trilhos ? montagem.quantos : 0}`}>
    <slot name="capa" />

    {/* A década é uma faixa na cor da família, parada no alto, com o nome do que ela faz.
        O bloco em volta (data-trilho) marca até onde a faixa acompanha a rolagem no toque. */}
    <div class="linha__trilho" data-trilho data-resultado data-sem-memorias={anos.length === 0 ? '' : undefined}>
    {/* O que fica parado no alto é uma peça só: a faixa de décadas e, no toque, o ano em que se está */}
    <div class="parada" data-barra data-preso>
      {
        trilhos && decadas.length > 1 && (
          <nav class="decadas" aria-label="Ir para a década">
            <div class="decadas__dentro miolo">
              <p class="decadas__nome rotulo" aria-hidden="true">
                Ir para a década
              </p>
              <ul>
                {decadas.map((d, i) => (
                  <li data-decada={d} data-aqui={i === 0 ? '' : undefined}>
                    <a href={`#decada-${d}`}>{d}</a>
                  </li>
                ))}
              </ul>
            </div>
          </nav>
        )
      }
      {/* No toque, o ano parado é esta gaveta, presa à faixa: o script copia para ela o cabeçalho do
          ano em que se está. Com mouse ela não aparece: o próprio cabeçalho fica parado. */}
      <div class="parada__ano" data-ano-parado data-vazia aria-hidden="true" />
    </div>

    {/* O nome do capítulo, ao passar o mouse pelo trilho dele (só no computador) */}
    <p class="trilho-nome ficha" data-trilho-nome hidden aria-hidden="true" />
    <script type="application/json" data-capitulos-da-linha set:html={JSON.stringify(Object.fromEntries(montagem.capitulos.map((c) => [c.id, { titulo: c.titulo, periodo: c.periodo, estilo: estiloDoCapitulo(c.cor) }])))} />

    {
      memorias.length === 0 && (
        <div class="miolo">
          <Vazio frase={limpar ? 'Nenhuma memória passa nesses filtros.' : 'Ainda não há memórias aqui.'}>
            {limpar ? (
              <a class="acao" href={limpar}>
                Limpar filtros
              </a>
            ) : (
              <a class="acao" href="/nova">
                Nova memória
              </a>
            )}
          </Vazio>
        </div>
      )
    }

    {
      anos.map(({ ano, itens }) => (
        <>
          {peloTempo && primeiroDaDecada.has(ano) && <div class="decada__ancora" id={`decada-${decadaDe(ano)}`} />}
          <section class:list={['ano miolo grade', !peloTempo && 'ano--corrida']} aria-labelledby={peloTempo ? `ano-${ano}` : undefined} aria-label={peloTempo ? undefined : 'Memórias'} data-decada={peloTempo ? decadaDe(ano) : undefined}>
            {/* Entre um ano e outro, o fio do tempo e os trilhos que vêm de cima continuam */}
            {posicaoDe.get(itens[0]!.id)! > 0 && (
              <div class="ano__passa" data-na-epoca={chaoDeCima(posicaoDe.get(itens[0]!.id)!)}>
                <Trilhos estados={montagem.linhas[posicaoDe.get(itens[0]!.id)!]!.chega} capitulos={noTrilho(posicaoDe.get(itens[0]!.id)!)} />
              </div>
            )}
            {peloTempo && (
            <header class="ano__cabeca" data-chave={`a:${ano}`} data-ano={ano} data-na-epoca={chaoDeCima(posicaoDe.get(itens[0]!.id)!)}>
              <h2 class="ano__numero" id={`ano-${ano}`}>
                {ano}
              </h2>
              <p class="rotulo suave" data-contagem>
                {itens.length} {itens.length === 1 ? 'memória' : 'memórias'}
              </p>
              {epocasDoAno(itens).length > 0 && (
                <p class="ano__epocas ficha suave">
                  <span class="so-leitor">Épocas: </span>
                  {epocasDoAno(itens).map((e) => (
                    <span>{e.titulo}</span>
                  ))}
                </p>
              )}
            </header>
            )}
            <div class="ano__itens">
              {itens.map((m) => {
                const tipo = tipoDaMemoria(tipos, m);
                const nomes = m.integrantes.map(nomeDe).filter((n): n is string => Boolean(n));
                const restritaA = m.visibilidade === 'nucleos' ? m.nucleos.map((id) => nucleos.find((n) => n.id === id)?.nome).filter(Boolean) : [];
                const destino = m.situacao === 'rascunho' ? `/nova?id=${m.id}` : `/memorias/${m.id}`;
                // Na lista corrida não há o ano por cima: a data vem inteira
                const quando = peloTempo ? diaMesCurto(m) : carimboDaData(m);
                const posicao = posicaoDe.get(m.id)!;
                const linha = montagem.linhas[posicao]!;
                return (
                  <>
                  {/* A época de todos é o chão: o papel muda de tom do alto dela (o fim, que vem primeiro na tela) até o
                      começo. O nome fica numa aba que sai do próprio chão, como a de uma divisória de fichário. */}
                  {linha.epocaAbre.map(epocaDe).map((e) => {
                    const lados = chaoDaEpoca(montagem, posicao, e.id, 'abre');
                    return (
                      <div class="epoca epoca--abre" data-na-epoca={chao(lados.fora)} data-chao={chao(lados.dentro)}>
                        <Trilhos estados={trilhosNaEpoca(montagem, posicao, 'abre')} capitulos={noTrilho(posicao)} />
                        <p class="epoca__aba">
                          <span class="rotulo suave">Época</span>
                          <a class="epoca__titulo serifa" href={`/capitulos/${e.id}`}>
                            {e.titulo}
                          </a>
                          <span class="ficha suave">{e.periodo}</span>
                        </p>
                        <span class="epoca__chao" />
                      </div>
                    );
                  })}
                  {linha.abre.map(capituloDe).map((c) => (
                    <div class="marca marca--abre" data-n={c.trilho} data-capitulo={c.id} data-na-epoca={chaoEm(posicao)} style={`--n: ${c.trilho}; ${estiloDoCapitulo(c.cor)}`}>
                      <Trilhos estados={trilhosNaMarca(montagem, posicao, c.id, 'abre')} capitulos={noTrilho(posicao)} />
                      <p class="marca__texto">
                        <span class="rotulo suave">Capítulo</span>
                        <a class="marca__titulo serifa" href={`/capitulos/${c.id}`}>
                          {c.titulo}
                        </a>
                        <span class="ficha suave">{c.periodo}</span>
                      </p>
                    </div>
                  ))}
                  <article
                    class="entrada entrada--com-foto"
                    id={ancoraDaMemoria(m.id)}
                    data-chave={`m:${m.id}`}
                    data-ano={m.ano}
                    data-tipo={m.tipo}
                    data-na-epoca={chaoEm(posicao)}
                    data-em-leitura={m.id === primeiraMemoria ? '' : undefined}
                    style={estiloDoTipo(m.tipo)}
                  >
                    <Trilhos estados={linha.trilhos} capitulos={noTrilho(posicao)} />
                    <span class="entrada__ponto" aria-hidden="true" />
                    <p class="entrada__quando rotulo">
                      <IconeDoTipo tipo={m.tipo} />
                      {quando && <span>{quando}</span>}
                      <span>{tipo.rotulo}</span>
                      {m.aproximada && peloTempo && <span>data aproximada</span>}
                    </p>
                    {/* Toda memória tem o seu cartão: sem foto, ele leva a cor e o ícone do tipo de momento */}
                    <div class="entrada__foto">
                      <Polaroid id={m.id} fotos={m.fotos} legenda={legendaLugarAno(m.lugar, m.ano)} alt="" cedo={m.id === primeiraMemoria} forma tipo={m.tipo} largura="(min-width: 1600px) 330px, (min-width: 1000px) 215px, 160px" />
                    </div>
                    <div class="entrada__texto">
                      <h3 class="entrada__titulo">
                        <a href={destino}>{m.titulo}</a>
                      </h3>
                      <p class="entrada__ficha ficha suave">
                        {nomes.length > 0 && <span>{listaCurta(nomes)}</span>}
                        {m.relatos > 0 && (
                          <span>
                            {m.relatos} {m.relatos === 1 ? 'relato' : 'relatos'}
                          </span>
                        )}
                        {m.fotos.length > 1 && <span>{m.fotos.length} fotos</span>}
                        {restritaA.length > 0 && <span>só {restritaA.join(' e ')}</span>}
                        {m.situacao === 'rascunho' && <span>rascunho</span>}
                        {m.exemplo && <span>exemplo</span>}
                      </p>
                      {/* O sinal de cada capítulo da memória: a mesma parada do trilho, na cor dele, com o nome */}
                      {linha.capitulos.length > 0 && (
                        <p class="entrada__capitulos ficha">
                          <span class="so-leitor">Capítulos: </span>
                          {linha.capitulos.map(capituloDe).map((c) => (
                            <SinalDoCapitulo id={c.id} titulo={c.titulo} cor={c.cor} />
                          ))}
                        </p>
                      )}
                    </div>
                  </article>
                  {linha.fecha.map(capituloDe).map((c) => (
                    <div class="marca marca--fecha" data-n={c.trilho} data-capitulo={c.id} data-na-epoca={chaoEm(posicao)} style={`--n: ${c.trilho}; ${estiloDoCapitulo(c.cor)}`}>
                      <Trilhos estados={trilhosNaMarca(montagem, posicao, c.id, 'fecha')} capitulos={noTrilho(posicao)} />
                      <p class="marca__texto ficha suave">{pontaDeBaixo} do capítulo “{c.titulo}”</p>
                    </div>
                  ))}
                  {linha.epocaFecha.map(epocaDe).map((e) => {
                    const lados = chaoDaEpoca(montagem, posicao, e.id, 'fecha');
                    return (
                      <div class="epoca epoca--fecha" data-na-epoca={chao(lados.fora)} data-chao={chao(lados.dentro)}>
                        <Trilhos estados={trilhosNaEpoca(montagem, posicao, 'fecha')} capitulos={noTrilho(posicao + 1)} />
                        <p class="epoca__aba ficha suave">{pontaDeBaixo} da época “{e.titulo}”</p>
                      </div>
                    );
                  })}
                  </>
                );
              })}
            </div>
          </section>
        </>
      ))
    }
    </div>
    {/* O fecho: depois da última memória, a página diz que acabou e oferece o que fazer */}
    {
      fecho && (
        <footer class="linha__fecho miolo">
          <div class="linha__fecho-dentro">
            {fecho.comecoDoAcervo && <p class="linha__fecho-frase serifa">Aqui começa o acervo.</p>}
            <p class="linha__fecho-acoes">
              <a class="acao" href="/nova">
                Nova memória
              </a>
              <a class="acao acao--quieta" href="#conteudo">
                Voltar ao começo
              </a>
            </p>
          </div>
        </footer>
      )
    }
  </div>


<script>
  // A década da barra, o ano parado no alto e o destaque do capítulo. O ponto do trilho acompanha
  // a memória em leitura. Sem script, a lista inteira aparece e nada disso faz falta.
  //
  // O Explorar troca o conteúdo sem recarregar a página (ver o script de src/pages/explorar.astro):
  // a cada troca, o que escutava a janela e observava a linha anterior é desligado, e tudo começa
  // de novo na linha que chegou.
  let desligar = new AbortController();
  const iniciar = () => {
    desligar.abort();
    desligar = new AbortController();
    const { signal } = desligar;
    const raiz = document.querySelector<HTMLElement>('[data-linha-do-tempo]');
    if (!raiz) return;
    {
    // No computador, passar o mouse por um trilho acende o capítulo inteiro e diz o nome dele ao
    // lado do cursor (pedido do Gui, 16/11/2026: capítulo longo fica fácil de identificar). O foco
    // no título do capítulo faz o mesmo. No celular, o sinal em cada memória já diz o capítulo.
    const nome = raiz.querySelector<HTMLElement>('[data-trilho-nome]');
    const dados = JSON.parse(raiz.querySelector('[data-capitulos-da-linha]')?.textContent || '{}') as Record<string, { titulo: string; periodo: string; estilo: string }>;
    if (nome && matchMedia('(hover: hover) and (pointer: fine)').matches) {
      let aceso = '';
      const acender = (id: string) => {
        if (id === aceso) return;
        for (const e of raiz.querySelectorAll('[data-vivo]')) e.removeAttribute('data-vivo');
        aceso = id;
        raiz.toggleAttribute('data-com-capitulo-vivo', Boolean(id));
        if (id) for (const e of raiz.querySelectorAll(`[data-capitulo="${CSS.escape(id)}"]`)) e.setAttribute('data-vivo', '');
      };
      const apagar = () => {
        acender('');
        nome.hidden = true;
      };
      const doTrilho = (alvo: EventTarget | null) => (alvo instanceof Element ? alvo.closest<HTMLElement>('.trilho[data-capitulo]') : null);
      raiz.addEventListener('pointermove', (evento) => {
        const trilho = doTrilho(evento.target);
        const capitulo = trilho && dados[trilho.dataset.capitulo!];
        if (!trilho || !capitulo) {
          // Sobre o título do capítulo, o capítulo acende sem o nome ao lado: ele já está escrito ali
          const marca = evento.target instanceof Element ? evento.target.closest<HTMLElement>('.marca__texto')?.closest<HTMLElement>('.marca[data-capitulo]') : null;
          if (marca) acender(marca.dataset.capitulo!);
          else if (aceso && !raiz.querySelector('.marca__titulo:focus-visible')) acender('');
          nome.hidden = true;
          return;
        }
        acender(trilho.dataset.capitulo!);
        nome.textContent = capitulo.periodo ? `${capitulo.titulo} · ${capitulo.periodo}` : capitulo.titulo;
        nome.setAttribute('style', capitulo.estilo);
        const caixa = raiz.getBoundingClientRect();
        nome.style.left = `${evento.clientX - caixa.left + 14}px`;
        nome.style.top = `${evento.clientY - caixa.top}px`;
        nome.hidden = false;
      });
      raiz.addEventListener('pointerleave', apagar);
      raiz.addEventListener('focusin', (evento) => {
        const marca = evento.target instanceof Element && evento.target.matches('.marca__titulo:focus-visible') ? evento.target.closest<HTMLElement>('.marca[data-capitulo]') : null;
        if (marca) acender(marca.dataset.capitulo!);
      });
      raiz.addEventListener('focusout', (evento) => {
        if (evento.target instanceof Element && evento.target.matches('.marca__titulo')) acender('');
      });
    }

    // O ano parado no alto leva o tom do chão que está logo embaixo dele: assim não vira uma faixa
    // de outro tom quando uma época começa ou acaba no meio do ano.
    const cabecas = [...raiz.querySelectorAll<HTMLElement>('.ano > .ano__cabeca')];
    const tom = (peca: HTMLElement, valor: string) => {
      if (valor === (peca.dataset.naEpoca ?? '')) return;
      if (valor) peca.dataset.naEpoca = valor;
      else delete peca.dataset.naEpoca;
    };
    // O tom do chão numa linha da tela, dentro de um ano: o do bloco que está ali
    const tomNaLinha = (secao: HTMLElement, linha: number): string | undefined => {
      for (const bloco of secao.querySelectorAll<HTMLElement>(':scope > .ano__itens > *')) {
        if (!bloco.getClientRects().length) continue;
        const caixa = bloco.getBoundingClientRect();
        if (caixa.top > linha || caixa.bottom <= linha) continue;
        // Na aba do alto de uma época, o chão dela começa onde a aba acaba
        const chao = bloco.querySelector<HTMLElement>('.epoca__chao');
        return (chao && chao.getBoundingClientRect().top <= linha ? bloco.dataset.chao : bloco.dataset.naEpoca) ?? '';
      }
      return undefined;
    };
    let acertarOsAnos = () => {};
    let marcado = false;
    const pedirOsAnos = () => {
      if (marcado) return;
      marcado = true;
      requestAnimationFrame(() => {
        marcado = false;
        acertarOsAnos();
      });
    };

    if (!document.documentElement.classList.contains('pino-novo')) {
      // Com sticky (mouse, e toque sem a animação ligada à rolagem): no celular o cabeçalho tem
      // fundo; enquanto está parado, acompanha o chão. Fora dali, vale o tom que veio do servidor.
      const estreita = matchMedia('(max-width: 61.99rem)');
      for (const c of cabecas) c.dataset.chaoDeCima = c.dataset.naEpoca ?? '';
      acertarOsAnos = () => {
        for (const c of cabecas) {
          const caixa = c.getBoundingClientRect();
          const secao = c.parentElement!.getBoundingClientRect();
          // Parado: o alto da seção já passou por ele, e a seção ainda não acabou
          const parado = estreita.matches && !raiz.hasAttribute('data-filtrando') && secao.top < caixa.top - 1 && secao.bottom > caixa.bottom;
          const embaixo = parado ? tomNaLinha(c.parentElement!, caixa.bottom + 1) : c.dataset.chaoDeCima!;
          if (embaixo !== undefined) tom(c, embaixo);
        }
      };
    } else if ('ResizeObserver' in window) {
      // No toque não há sticky (ver "pino-novo" em Visual.astro e em linha.css). A faixa de décadas
      // fica parada por uma animação ligada à rolagem, que precisa da altura do trecho e da faixa.
      // O ano parado é a gaveta presa à faixa: uma cópia do cabeçalho do ano em que se está, posta
      // no lugar exato dele quando ele chega ao alto. Assim só uma peça anda com a rolagem, e nada
      // liga nem desliga animação no meio do caminho (era o que fazia a faixa e o ano darem um
      // pulinho na troca de ano, no iPhone).
      const trilho = raiz.querySelector<HTMLElement>('[data-trilho]');
      const barra = trilho?.querySelector<HTMLElement>(':scope > [data-barra]');
      const gaveta = raiz.querySelector<HTMLElement>('[data-ano-parado]');
      // Onde começa o cabeçalho de cada ano, na página
      let altos: number[] = [];
      let mostrado: HTMLElement | null = null;
      const medir = () => {
        if (!trilho || !barra) return;
        trilho.style.setProperty('--alt', `${trilho.offsetHeight}px`);
        trilho.style.setProperty('--barra-alt', `${barra.offsetHeight}px`);
        altos = cabecas.map((c) => (c.getClientRects().length ? c.getBoundingClientRect().top + scrollY : Infinity));
        // A contagem do ano pode ter mudado com o filtro: a gaveta é copiada de novo
        mostrado = null;
        pedirOsAnos();
      };
      acertarOsAnos = () => {
        if (!gaveta) return;
        const caixa = gaveta.getBoundingClientRect();
        const linha = caixa.top + scrollY + 0.5;
        // O ano em que se está: o último cabeçalho que já chegou à linha em que o ano para
        let atual: HTMLElement | null = null;
        for (let n = 0; n < altos.length; n++) if (altos[n]! <= linha) atual = cabecas[n]!;
        if (atual !== mostrado) {
          mostrado = atual;
          if (atual) {
            const copia = atual.cloneNode(true) as HTMLElement;
            for (const e of copia.querySelectorAll('[id]')) e.removeAttribute('id');
            gaveta.replaceChildren(...copia.childNodes);
          }
          gaveta.toggleAttribute('data-vazia', !atual);
        }
        if (!atual) return;
        const embaixo = tomNaLinha(atual.parentElement!, caixa.bottom + 1);
        if (embaixo !== undefined) tom(gaveta, embaixo);
      };
      const olho = new ResizeObserver(medir);
      signal.addEventListener('abort', () => olho.disconnect());
      if (trilho) olho.observe(trilho);
      medir();
    }
    addEventListener('scroll', pedirOsAnos, { passive: true, signal });
    addEventListener('resize', pedirOsAnos, { passive: true, signal });

    // A memória em leitura e a década dela: a que cruza o meio da tela
    if ('IntersectionObserver' in window) {
      const entradas = [...raiz.querySelectorAll<HTMLElement>('.entrada')];
      const itensDaBarra = [...raiz.querySelectorAll<HTMLElement>('.decadas [data-decada]')];
      // Só mexe no que muda: a memória que deixou de ser a em leitura, a que passou a ser e a década
      let emLeitura = raiz.querySelector<HTMLElement>('.entrada[data-em-leitura]');
      let decadaAqui = raiz.querySelector<HTMLElement>('.decadas [data-aqui]')?.dataset.decada;
      const marcar = (atual: HTMLElement) => {
        if (atual !== emLeitura) {
          emLeitura?.removeAttribute('data-em-leitura');
          atual.setAttribute('data-em-leitura', '');
          emLeitura = atual;
        }
        const decada = atual.closest<HTMLElement>('.ano')?.dataset.decada;
        if (decada === decadaAqui) return;
        decadaAqui = decada;
        for (const item of itensDaBarra) item.toggleAttribute('data-aqui', item.dataset.decada === decada);
      };
      signal.addEventListener('abort', () => observador.disconnect());
      const observador = new IntersectionObserver(
        (vistas) => {
          const noMeio = vistas.filter((v) => v.isIntersecting).at(-1);
          if (noMeio) marcar(noMeio.target as HTMLElement);
        },
        { rootMargin: '-45% 0px -45% 0px' },
      );
      for (const e of entradas) observador.observe(e);
      // De volta ao alto da página, a memória em leitura é a primeira
      addEventListener(
        'scroll',
        () => {
          if (scrollY < innerHeight / 2 && entradas[0] && !entradas[0].hasAttribute('data-em-leitura')) marcar(entradas[0]);
        },
        { passive: true, signal },
      );
    }
    }
  };
  iniciar();
  document.addEventListener('explorar:trocou', iniciar);
</script>
