---
// O palco: uma memória por vez, grande, para ver junto (docs/decisoes.md, "Explorar"). Serve ao
// modo TV, que passa pelas memórias na ordem dos filtros, e ao "Me mostre uma memória", que sorteia.
// Cada memória é uma página: "Anterior" e "Próxima" são links, então funciona sem script, pelo
// teclado e pelo controle da TV. Com script, o modo TV passa sem recarregar.
//
// A TV é superfície grande (decisões do Gui, 17/11/2026): a foto é uma foto revelada, como no resto
// do site, e a memória com várias fotos espalha as outras em volta da principal.
//
// A partir de 62rem, o modo TV é a barra (proposta A da sessão X, escolhida pelo Gui em 22/11/2026):
// a tela não rola, tudo é proporcional à janela e os controles moram num cartão branco que flutua no
// pé da tela, com os símbolos de TV e o nome de cada um no foco. O estilo está em telas/tv.css.
// Abaixo de 62rem, o modo TV é o de antes: os mesmos controles, com o nome escrito no lugar do
// símbolo (telas/explorar.css).
import BotaoDeSimbolo from '../visual/BotaoDeSimbolo.astro';
import Carimbo from '../visual/Carimbo.astro';
import Polaroid from '../visual/Polaroid.astro';
import Vazio from '../visual/Vazio.astro';
import { carimboDaData, estiloDoTipo, legendaLugarAno, listaCurta } from '../../lib/visual';
import { degrauDoTitulo, degrauDoTrecho } from '../../lib/explorar';
import { tempoDaVoz } from '../../lib/sala';

interface Props {
  modo: 'tv' | 'acaso';
  memoria?: { id: string; titulo: string; tipo: string; lugar: string | null; ano: number; mes: number | null; dia: number | null; aproximada: boolean; fotos: { chave: string; legenda: string | null }[] };
  /** o trecho de um relato e quem contou */
  trecho?: { texto: string; por: string };
  /** os nomes de quem estava */
  nomes?: string[];
  /** "3 de 41", no modo TV */
  posicao?: string;
  /** endereços: a de antes, a de depois (ou outra sorteada) e a volta ao Explorar */
  antes?: string;
  depois?: string;
  sair: string;
  /**
   * "Passar sozinho": o tempo em uso (null, desligado), a pausa, o endereço que liga cada tempo e o
   * que desliga
   */
  passar?: { tempo: number | null; pausado: boolean; tempos: { segundos: number; href: string }[]; parar: string };
  /** para limpar os filtros, quando nada passa neles */
  limpar: string;
  /** a animação do modo TV em uso (src/lib/explorar.ts, MOVIMENTOS) */
  movimento?: string;
  /** as animações, para quem está vendo escolher */
  movimentos?: { id: string; nome: string; href: string }[];
  /**
   * A voz de quem contou o trecho, no modo TV (aplicação da E1): toca na vez da memória, com o botão de som
   * na barra. Sem áudios, o botão continua lá, para a barra não mudar de uma memória para a outra.
   */
  voz?: { por: string; audios: { src: string; duracao: number | null }[] };
  /** a linha do alto, depois de "Modo TV": "3 de 48", "3 de 48 · só o que é aberto a toda a família" */
  linha?: string;
  /** o tempo mínimo desta tela no "Passar sozinho", em segundos (o parágrafo da carta, segundosDoParagrafo) */
  tempoMinimo?: number;
  /** o título da página, para a troca sem recarregar */
  tituloDaPagina?: string;
  /** a tela traz uma cena pronta no slot "cena" (a carta na sala), no lugar da memória */
  comCena?: boolean;
  /** o passo da ordem do modo TV (o id da memória ou "carta-2"), para o palco escrever o endereço e o "3 de 48" */
  passo?: string;
  /** na sala (o marcador no endereço): o palco escreve a linha do alto com o que entra */
  sala?: boolean;
  /** na sala, "Ler tudo" no lugar de "Abrir esta memória": o endereço da primeira parte */
  ler?: string;
  /** "Ler tudo" aberto (a cena é a leitura): "Passar sozinho" espera, e o Esc volta à memória */
  lendo?: boolean;
}

/** Quantas fotos da memória, além da principal, cabem em volta dela */
const EM_VOLTA = 4;

const { modo, memoria, trecho, nomes = [], posicao, antes, depois, sair, passar, limpar, movimento, movimentos, voz, linha, tempoMinimo, tituloDaPagina, comCena = false, passo, sala = false, ler, lendo = false } = Astro.props;
// A tela que não é uma memória (a carta na sala) vem pronta, no lugar das fotos e do texto
const cena = comCena && Astro.slots.has('cena');
const tv = modo === 'tv';
const comVoz = Boolean(voz && voz.audios.length > 0);
const duracaoDaVoz = voz?.audios.reduce((soma, a) => soma + (a.duracao ?? 0), 0) ?? 0;
const [principal, ...outras] = memoria?.fotos ?? [];
const emVolta = outras.slice(0, EM_VOLTA);
const abrir = memoria ? `/memorias/${memoria.id}` : '';
// "Passar sozinho", num toque só, liga no tempo padrão; os outros tempos estão em "Ajustes"
const ligar = passar?.tempos.find((t) => t.segundos === 10) ?? passar?.tempos[0];
---

{
  !memoria && !cena && (
    <div class="miolo">
      <Vazio frase="Nenhuma memória passa nesses filtros.">
        <a class="acao" href={limpar}>
          Limpar filtros
        </a>
        <a class="acao acao--quieta" href={sair}>
          {tv ? 'Sair do modo TV' : 'Voltar ao Explorar'}
        </a>
      </Vazio>
    </div>
  )
}
{
  (memoria || cena) && (
    <article
      class:list={['palco', `palco--${modo}`, { 'palco--cena': cena }]}
      style={memoria ? estiloDoTipo(memoria.tipo) : undefined}
      data-familia={cena ? 'tudo' : undefined}
      data-palco
      data-movimento={modo === 'tv' ? movimento : undefined}
      data-passar={passar?.tempo ?? undefined}
      data-pausado={passar?.pausado ? '' : undefined}
      data-voz={comVoz ? JSON.stringify(voz!.audios) : undefined}
      data-tempo={tempoMinimo}
      data-titulo={tituloDaPagina}
      data-passo={passo}
      data-sala={sala ? '' : undefined}
      data-lendo={lendo ? '' : undefined}
    >
      {/* Com script, a animação só começa com as fotos prontas: até lá, elas esperam fora da tela.
          Fica antes de tudo, para valer já no primeiro desenho. Se algo falhar, a espera acaba sozinha. */}
      <script is:inline>
        (function () {
          var palco = document.currentScript.parentElement;
          palco.setAttribute('data-espera', '');
          setTimeout(function () {
            palco.removeAttribute('data-espera');
          }, 4000);
        })();
      </script>
      <header class="palco__topo miolo">
        <p class="rotulo">
          {tv ? 'Modo TV' : 'Uma memória ao acaso'}
          {/* No modo TV, depois de uma passagem, o palco escreve aqui o "3 de 48" da ordem que a página mandou */}
          {tv ? <span data-palco-linha>{(linha ?? posicao) && ` · ${linha ?? posicao}`}</span> : (linha ?? posicao) && <span> · {linha ?? posicao}</span>}
        </p>
        <a class="acao acao--quieta" href={sair} data-palco-sair>
          {tv ? 'Sair do modo TV' : 'Voltar ao Explorar'}
        </a>
        {/* Sem rede, a memória da tela fica e o aviso aparece aqui (o script escreve o texto) */}
        {tv && <p class="palco__aviso ficha" role="status" data-palco-aviso />}
      </header>
      <div class:list={['palco__cena miolo', { 'palco__cena--especial': cena }]}>
        {cena && <slot name="cena" />}
        {memoria && (
          <>
            <div class:list={['palco__fotos', `palco__fotos--${emVolta.length}`]}>
              {/* As outras fotos da memória, espalhadas em volta da principal */}
              {emVolta.map((foto, n) => (
                <div class="palco__extra" data-n={n + 1} aria-hidden="true">
                  <Polaroid id={`${memoria.id}-${n + 1}`} fotos={[foto]} legenda={foto.legenda ?? ''} alt="" monte={false} cedo largura="(min-width: 1600px) 320px, 160px" />
                </div>
              ))}
              {/* No modo TV, tocar na foto passa para a próxima; no "ao acaso", abre a memória. Na sala, sem a
                  próxima, a foto não leva a lugar nenhum: um toque sem querer não tira ninguém da sala. */}
              {sala && !depois ? (
                <div class="palco__principal">
                  <Polaroid id={memoria.id} fotos={principal ? [principal] : []} legenda={legendaLugarAno(memoria.lugar, memoria.ano)} tipo={memoria.tipo} monte={false} cedo principal />
                </div>
              ) : (
                <a class="palco__principal" href={tv && depois ? depois : abrir} data-palco-leva={tv && depois ? '' : undefined} aria-label={tv && depois ? 'Próxima memória' : `Abrir a memória ${memoria.titulo}`} tabindex="-1">
                  <Polaroid id={memoria.id} fotos={principal ? [principal] : []} legenda={legendaLugarAno(memoria.lugar, memoria.ano)} tipo={memoria.tipo} monte={false} cedo principal />
                </a>
              )}
            </div>
            <div class="palco__texto">
              <p>
                <Carimbo itens={[carimboDaData(memoria), memoria.lugar]} />
              </p>
              {/* No modo TV, a memória longa desce na escala: o título em três degraus e o trecho em dois
                  (src/lib/explorar.ts). O limite de linhas é só a rede de proteção. */}
              <h1 class="palco__titulo" data-degrau={tv ? degrauDoTitulo(memoria.titulo) : undefined}>
                {memoria.titulo}
              </h1>
              {trecho && (
                <blockquote class="palco__trecho" data-degrau={tv ? degrauDoTrecho(trecho.texto) : undefined}>
                  <p class="serifa t-abertura">“{trecho.texto}”</p>
                  <footer>
                    <span class="mao">{trecho.por}</span>
                  </footer>
                </blockquote>
              )}
              {/* A voz de quem contou, que toca na vez da memória, com o fio que anda enquanto a pessoa fala */}
              {comVoz && (
                <p class="palco__voz" data-palco-voz>
                  <span class="palco__voz-nome">A voz de {voz!.por}</span>
                  <span class="palco__voz-tempo">{tempoDaVoz(duracaoDaVoz)}</span>
                  <span class="palco__voz-fio" aria-hidden="true">
                    <span data-palco-ouvido />
                  </span>
                </p>
              )}
              {nomes.length > 0 && <p class="ficha suave">Com {listaCurta(nomes, 5)}</p>}
              {/* Na sala, ninguém sai para a página da memória, que mostra o que o login vê: "Ler tudo" mostra o
                  texto inteiro aqui, só com o que entra na sala (decisão do Gui, 25/11/2026) */}
              {sala ? (
                ler && (
                  <p>
                    <a class="acao" href={ler} data-palco-ler data-palco-leva>
                      Ler tudo
                    </a>
                  </p>
                )
              ) : (
                <p>
                  <a class="acao" href={abrir}>
                    Abrir esta memória
                  </a>
                </p>
              )}
            </div>
          </>
        )}
        {/* Os controles ficam num grupo só: a barra do pé da tela, a partir de 62rem. Em "Só as fotos"
            eles somem juntos e voltam juntos; "Ocultar os controles" os tira da tela até a pessoa pedir. */}
        <div class="palco__controles" data-palco-controles>
          <nav class="palco__passos" aria-label={tv ? 'Passar as memórias' : 'Outra memória'}>
            {tv && (
              <>
                {/* O caminho de volta de "Só as fotos", em destaque. Só aparece nesse modo, com script. */}
                <button type="button" class="botao palco__volta" data-palco-mostrar-texto hidden>
                  Mostrar o texto
                </button>
                {/* Os três do tocador, na ordem de todo controle: anterior, tocar ou pausar, próxima.
                    "Próxima" é a ação cheia, e o foco começa nela. */}
                <BotaoDeSimbolo elemento="a" simbolo="anterior" nome="Anterior" class="acao palco__anterior" href={antes} aria-disabled={antes ? undefined : 'true'} rel="prev" data-palco-antes data-palco-leva />
                {/* "Passar sozinho" só existe com script: sem ele, nem aparece. Desligado, um toque liga;
                    ligado, o mesmo lugar pausa e retoma, e o símbolo e o nome trocam juntos. O tempo e a
                    animação ficam em "Ajustes". */}
                {passar && ligar && (
                  <span class="palco__sozinho" data-palco-passar hidden>
                    {passar.tempo === null ? (
                      <BotaoDeSimbolo elemento="a" simbolo="tocar" nome="Passar sozinho" class="acao acao--quieta" href={ligar.href} data-palco-tocar />
                    ) : (
                      <BotaoDeSimbolo simbolo={passar.pausado ? 'tocar' : 'pausar'} nome={passar.pausado ? 'Retomar' : 'Pausar'} class="acao" data-palco-pausa />
                    )}
                  </span>
                )}
                <BotaoDeSimbolo elemento="a" simbolo="proxima" nome="Próxima" cheio class="botao palco__proxima" href={depois} aria-disabled={depois ? undefined : 'true'} rel="next" data-palco-depois data-palco-leva />
                {/* O som da voz de quem contou, depois de "Próxima". Começa desligado, e ligar é o gesto que o
                    navegador pede para tocar som; o símbolo e o nome trocam juntos. Com voz na memória e o
                    som desligado, o símbolo ganha um ponto na cor viva. Só com script. */}
                <BotaoDeSimbolo simbolo="sem-som" nome="Ligar o som" class="acao acao--quieta palco__som" data-palco-som data-tem-voz={comVoz ? '' : undefined} hidden />
              </>
            )}
            {modo === 'acaso' && depois && (
              <a class="botao" href={depois} data-palco-depois>
                Me mostre outra
              </a>
            )}
          </nav>
          {/* A tela cheia mora na barra, a partir de 62rem; abaixo disso, em "Ajustes". Só com script. */}
          {tv && <BotaoDeSimbolo simbolo="tela-cheia" nome="Tela cheia" class="palco__na-barra" data-palco-cheia hidden />}
          {tv && (passar || (movimentos && movimentos.length > 0)) && (
            <details class="palco__ajustes" data-palco-ajustes>
              <BotaoDeSimbolo elemento="summary" simbolo="ajustes" nome="Ajustes" />
              {/* As partes ficam lado a lado quando há largura (resposta do Gui à P50, 17/11/2026) */}
              <div class="palco__partes">
                {passar && (
                  <div class="palco__ajuste" role="group" aria-labelledby="ajuste-tempo" data-palco-passar hidden>
                    <p class="rotulo suave" id="ajuste-tempo">
                      Passar sozinho a cada
                    </p>
                    <p class="palco__opcoes">
                      {passar.tempos.map((t) => (
                        <a href={t.href} aria-current={t.segundos === passar.tempo ? 'true' : undefined} data-palco-leva>
                          {t.segundos} segundos
                        </a>
                      ))}
                      {passar.tempo !== null && <a href={passar.parar}>Parar de passar sozinho</a>}
                    </p>
                  </div>
                )}
                {/* Só as fotos, sem os textos, e a tela cheia: para deixar passando na sala. Só com script. */}
                <div class="palco__ajuste" role="group" aria-labelledby="ajuste-tela" data-palco-tela hidden>
                  <p class="rotulo suave" id="ajuste-tela">
                    Tela
                  </p>
                  <p class="palco__opcoes">
                    <button type="button" data-palco-so-fotos aria-pressed="false">
                      Só as fotos
                    </button>
                    <button type="button" class="palco__fora-da-barra" data-palco-cheia aria-pressed="false" hidden>
                      Tela cheia
                    </button>
                  </p>
                </div>
                {movimentos && (
                  <div class="palco__ajuste" role="group" aria-labelledby="ajuste-animacao">
                    <p class="rotulo suave" id="ajuste-animacao">
                      Animação
                    </p>
                    <p class="palco__opcoes">
                      {movimentos.map((m) => (
                        <a href={m.href} aria-current={m.id === movimento ? 'true' : undefined} data-palco-movimento>
                          {m.nome}
                        </a>
                      ))}
                    </p>
                  </div>
                )}
              </div>
            </details>
          )}
          {/* Ocultar os controles: a barra sai da tela e deixa a memória sozinha, até a pessoa pedir de
              volta (qualquer tecla, o ponteiro ou um toque). Só com script, a partir de 62rem. */}
          {tv && <BotaoDeSimbolo simbolo="ocultar" nome="Ocultar os controles" class="palco__na-barra" data-palco-ocultar hidden />}
        </div>
      </div>
      {/* Com os controles ocultos, o caminho de volta é um botão pequeno no canto, que fica com o
          foco (pedido do Gui, 22/11/2026: tocar em qualquer lugar ou apertar qualquer tecla não pode
          ser o comando de voltar, porque as setas continuam passando as memórias). Só a partir de 62rem. */}
      {tv && <BotaoDeSimbolo simbolo="mostrar" nome="Mostrar os controles" nomeAcima class="palco__na-barra palco__reexibir" data-palco-reexibir hidden />}
    </article>
  )
}

<script>
  // O modo TV passa de uma memória para a outra sem recarregar a página (correção pedida pelo Gui,
  // 17/11/2026: com a página recarregando, a animação acabava antes de a foto chegar). A página da
  // memória seguinte é buscada de antemão, com as fotos; ao passar, o palco é trocado com todas
  // prontas, e é aí que a animação começa. As teclas seguem a lógica de interface de TV (teclaNaTv,
  // em src/lib/explorar.ts). Nada espera uma animação acabar: passar no meio de uma chegada troca na hora.
  // Sem script, "Anterior" e "Próxima" continuam sendo links, e "Passar sozinho", a tela cheia e
  // "Ocultar os controles" nem aparecem.
  import { AVISO_SEM_REDE, SEGUNDOS_ATE_TENTAR_DE_NOVO, SEGUNDOS_DOS_CONTROLES, falhaDeRede, reacaoEmSoFotos, teclaNaTv } from '../../lib/explorar';
  import { simbolo, type IdDoSimbolo } from '../../visual/simbolos';
  import { ANTECEDENCIA_DO_PEDACO, RESPIRO_DEPOIS_DA_VOZ, VALIDADE_DO_PEDACO, linhaDoAlto, pedacoVencido, posicaoNaOrdem, vizinhasNaOrdem } from '../../lib/sala';

  const calmo = matchMedia('(prefers-reduced-motion: reduce)');
  // A barra do pé da tela, com os símbolos, o ocultar e as setas que andam por ela, vale a partir de 62rem
  // e em toda janela deitada (o celular espelhado na TV ou virado para mostrar), como telas/tv.css
  const naBarra = matchMedia('(min-width: 62rem), (orientation: landscape)');
  const palco = () => document.querySelector<HTMLElement>('[data-palco]');
  const link = (nome: string) => palco()?.querySelector<HTMLAnchorElement>(`[data-palco-${nome}]`) ?? null;
  const serve = (a: HTMLAnchorElement | null): a is HTMLAnchorElement => Boolean(a && a.getAttribute('href') && a.getAttribute('aria-disabled') !== 'true');

  // A ordem do modo TV (causa 6 da medição M1): os ids das memórias que entram, na ordem, já com os filtros,
  // quem vê o quê e a regra da sala aplicados pelo servidor, que a manda uma vez, junto com a primeira
  // memória. O navegador só anda por ela: cada passagem pede o pedaço do palco de uma memória à rota que lê
  // uma memória só e confere tudo de novo (src/pages/explorar/palco.astro). Sem a ordem, ou para um endereço
  // que não está nela, a página inteira, como antes.
  const ordem: string[] = (() => {
    try {
      const lida = JSON.parse(document.querySelector('[data-ordem-da-tv]')?.textContent ?? '[]');
      return Array.isArray(lida) ? lida.filter((id): id is string => typeof id === 'string') : [];
    } catch {
      return [];
    }
  })();
  function enderecoDoPedaco(href: string): string | null {
    const url = new URL(href, location.href);
    const m = url.searchParams.get('m');
    if (ordem.length === 0 || !m || url.pathname !== '/explorar' || url.searchParams.get('ver') !== 'tv') return null;
    const vizinhas = vizinhasNaOrdem(ordem, m, url.searchParams.has('passar'));
    if (vizinhas.indice < 0) return null;
    url.pathname = '/explorar/palco';
    if (vizinhas.antes) url.searchParams.set('antes', vizinhas.antes);
    if (vizinhas.depois) url.searchParams.set('depois', vizinhas.depois);
    // A posição ("3 de 48") não vai: a rota não a recebe do navegador (correção 5 da revisão R-AB), e o palco a
    // escreve ao chegar, da ordem que o servidor mandou (escreverLinha)
    return url.href;
  }

  // As memórias já buscadas: a de antes e a de depois ficam prontas enquanto a memória está na tela. Cada
  // pedaço vale por pouco tempo (VALIDADE_DO_PEDACO, em src/lib/sala.ts; correção 1 da revisão R-AB): vencido,
  // ele não vai à tela nem toca a voz dele, e é pedido de novo à rota de uma memória, que confere tudo de novo.
  // A idade conta do pedido, e não da resposta: o que a rota decidiu vale do momento em que foi pedido.
  interface Pedaco {
    pagina: Promise<Document>;
    em: number;
  }
  const paginas = new Map<string, Pedaco>();
  /** Quando foi pedido o pedaço de cada palco que está ou esteve na tela; o da primeira página, no começo */
  const buscadoEm = new WeakMap<HTMLElement, number>();
  const buscar = (href: string, validade = VALIDADE_DO_PEDACO): Pedaco => {
    const alvo = enderecoDoPedaco(href) ?? href;
    const guardado = paginas.get(alvo);
    if (guardado && !pedacoVencido(guardado.em, performance.now(), validade)) return guardado;
    if (paginas.size > 24) paginas.clear();
    const em = performance.now();
    const pagina = fetch(alvo, { headers: { Accept: 'text/html' }, cache: 'no-store' })
      .then((resposta) => (resposta.ok ? resposta.text() : Promise.reject(new Error(String(resposta.status)))))
      .then((texto) => new DOMParser().parseFromString(texto, 'text/html'));
    const pedaco = { pagina, em };
    pagina.catch(() => {
      if (paginas.get(alvo) === pedaco) paginas.delete(alvo);
    });
    paginas.set(alvo, pedaco);
    return pedaco;
  };
  /** O endereço da memória da tela, com o "m" do passo (a primeira página pode ter chegado sem ele) */
  const enderecoDaVez = (p: HTMLElement) => {
    const url = new URL(location.href);
    if (p.dataset.passo) url.searchParams.set('m', p.dataset.passo);
    return url.href;
  };
  /** O "3 de 48" do alto, da ordem que o servidor mandou; a rota de uma memória não o escreve */
  function escreverLinha(p: HTMLElement) {
    const linha = p.querySelector<HTMLElement>('[data-palco-linha]');
    const posicao = p.dataset.passo ? posicaoNaOrdem(ordem, p.dataset.passo) : undefined;
    if (!linha || !posicao) return;
    const texto = linhaDoAlto({ sala: p.hasAttribute('data-sala'), posicao: posicao.posicao, de: posicao.de });
    linha.textContent = texto ? ` · ${texto}` : '';
  }
  // Uma foto pronta: já baixada e aberta, do tamanho certo desde o primeiro desenho. Sem rede, a
  // foto que não chegou segura a passagem: a memória seguinte não entra pela metade.
  // As fontes vêm da foto da página (src, e srcset e sizes das cópias menores, src/lib/copias-das-fotos.ts)
  const fotoPronta = async (img: HTMLImageElement) => {
    const foto = new Image();
    foto.decoding = 'sync';
    const endereco = img.getAttribute('src') ?? '';
    for (const nome of ['sizes', 'srcset', 'fetchpriority']) {
      const valor = img.getAttribute(nome);
      if (valor) foto.setAttribute(nome, valor);
    }
    foto.src = endereco;
    await foto.decode().catch(() => {
      if (endereco && !navigator.onLine) throw new TypeError('sem rede');
    });
    return foto;
  };
  const fotosDe = (raiz: ParentNode) => [...raiz.querySelectorAll<HTMLImageElement>('.palco__fotos img')];
  /** Troca cada foto do palco que vai chegar pela foto já pronta: nada aparece pela metade. */
  const aprontar = (raiz: ParentNode) =>
    Promise.all(
      fotosDe(raiz).map(async (img) => {
        const pronta = await fotoPronta(img);
        pronta.alt = img.alt;
        img.replaceWith(pronta);
      }),
    );
  const memoriaDe = (href: string) => new URL(href, location.href).searchParams.get('m');
  /** O link continua no palco: todo link do modo TV que segue no modo TV troca no lugar */
  const ficaNoPalco = (href: string) => new URL(href, location.href).searchParams.get('ver') === 'tv';
  const animacaoDe = (href: string) => new URL(href, location.href).searchParams.get('mov') ?? 'a';

  // No endereço fica só o que traz a pessoa de volta ao mesmo lugar: a memória da vez e os filtros
  // (decisão do Gui, 17/11/2026). A animação e o tempo do "Passar sozinho" são preferências,
  // guardadas no aparelho; se está passando sozinho e a pausa valem enquanto o modo TV está aberto.
  const semPreferencias = (href: string) => {
    const url = new URL(href, location.href);
    for (const nome of ['passar', 'pausa', 'mov']) url.searchParams.delete(nome);
    return url.pathname + url.search;
  };
  const guardar = (nome: string, valor: string) => {
    try {
      localStorage.setItem(nome, valor);
    } catch {
      // sem armazenamento, a preferência vale só até sair do modo TV
    }
  };
  const guardado = (nome: string) => {
    try {
      return localStorage.getItem(nome);
    } catch {
      return null;
    }
  };

  let pedido = 0;
  let relogio = 0;
  /** A passagem que acabou de sair de "Ler tudo" para a mesma memória (prepararSom retoma a voz) */
  let voltouDaLeitura = false;
  let pausado = false;
  // Sem rede (C3 do QA de código de 17/11/2026): a passagem que não saiu espera aqui. A memória da
  // tela fica, o aviso aparece, e a mesma passagem é tentada de novo de tempos em tempos e assim
  // que o navegador avisa que a rede voltou.
  let aEspera: { a: HTMLAnchorElement; deTras: boolean } | null = null;
  let relogioDaRede = 0;
  function esperarARede(a: HTMLAnchorElement, deTras: boolean) {
    const atual = palco();
    if (!atual) return;
    aEspera = { a, deTras };
    atual.setAttribute('data-sem-rede', '');
    const aviso = atual.querySelector<HTMLElement>('[data-palco-aviso]');
    if (aviso && aviso.textContent !== AVISO_SEM_REDE) aviso.textContent = AVISO_SEM_REDE;
    clearTimeout(relogio);
    clearTimeout(relogioDaRede);
    relogioDaRede = window.setTimeout(tentarDeNovo, SEGUNDOS_ATE_TENTAR_DE_NOVO * 1000);
  }
  function tentarDeNovo() {
    clearTimeout(relogioDaRede);
    if (!aEspera) return;
    // O link de quem espera é o do palco que ficou na tela
    if (!aEspera.a.isConnected) return desistirDeEsperar();
    passar(aEspera.a, aEspera.deTras);
  }
  function desistirDeEsperar() {
    clearTimeout(relogioDaRede);
    aEspera = null;
    const atual = palco();
    atual?.removeAttribute('data-sem-rede');
    const aviso = atual?.querySelector<HTMLElement>('[data-palco-aviso]');
    if (aviso) aviso.textContent = '';
  }
  // "Só as fotos": os controles à vista e o relógio que os esconde de novo
  let controles = false;
  let relogioDosControles = 0;

  async function passar(a: HTMLAnchorElement | null, deTras = false) {
    const atual = palco();
    if (!serve(a) || !atual) return;
    // Só o modo TV troca no lugar: o "ao acaso" sorteia no servidor, e sair é sair
    if (!atual.classList.contains('palco--tv') || !ficaNoPalco(a.href)) return location.assign(a.href);
    const href = a.href;
    const meu = ++pedido;
    clearTimeout(relogio);
    clearTimeout(relogioDaRede);
    try {
      // O pedaço que demorou a ficar pronto (as fotos sem rede) e venceu no caminho é pedido de novo
      let novo: HTMLElement | undefined;
      let pedaco: Pedaco | undefined;
      let pagina: Document | undefined;
      for (let vez = 0; vez < 3 && (!pedaco || pedacoVencido(pedaco.em, performance.now())); vez++) {
        pedaco = buscar(href);
        pagina = await pedaco.pagina;
        const chegou = pagina.querySelector<HTMLElement>('[data-palco]');
        if (!chegou) throw new Error('sem o palco');
        novo = document.importNode(chegou, true);
        novo.querySelector('script')?.remove();
        await aprontar(novo);
        if (meu !== pedido) return;
      }
      if (!novo || !pedaco || !pagina || pedacoVencido(pedaco.em, performance.now())) throw new Error('o pedaço venceu');
      buscadoEm.set(novo, pedaco.em);
      escreverLinha(novo);
      // Uma passagem mais nova já saiu: esta chegou atrasada
      if (meu !== pedido) return;
      novo.toggleAttribute('data-de-tras', deTras);
      // A mesma memória (trocar o tempo, parar de passar sozinho): nada chega de novo. Trocar a
      // animação é a exceção: ela chega de novo, para a pessoa ver o que escolheu.
      const mesma = memoriaDe(href) === memoriaDe(location.href) && animacaoDe(href) === (atual.dataset.movimento ?? 'a');
      if (!mesma) novo.setAttribute('data-pronta', '');
      // "Ajustes" continua como estava, aberto ou fechado
      const ajustes = novo.querySelector<HTMLDetailsElement>('[data-palco-ajustes]');
      if (ajustes) ajustes.open = atual.querySelector<HTMLDetailsElement>('[data-palco-ajustes]')?.open ?? false;
      const ativo = document.activeElement instanceof HTMLElement ? document.activeElement : null;
      // O foco fica no mesmo controle: quem estava em "Passar sozinho" segue em "Pausar", e o contrário
      const focado = ['antes', 'depois', 'tocar', 'pausa', 'mostrar-texto', 'ocultar', 'som', 'vozes'].find((nome) => ativo?.hasAttribute(`data-palco-${nome}`));
      const noAjuste = ativo?.closest('[data-palco-ajustes]') ? nomeDe(ativo) : undefined;
      const naCheia = ativo?.matches('.palco__na-barra[data-palco-cheia]');
      const cor = getComputedStyle(atual).backgroundColor;
      // No Álbum, as fotos que estavam na tela saem pela lateral, empurradas pelas que chegam
      const saem = !mesma && !calmo.matches && novo.dataset.movimento === 'a' ? atual.querySelector<HTMLElement>('.palco__fotos') : null;
      const saemDe = saem?.getBoundingClientRect();
      // A passagem saiu: quem esperava a rede não espera mais (o palco novo chega sem o aviso)
      aEspera = null;
      // A voz da memória que sai para junto com ela. "Ler tudo" da mesma memória vale como a pausa: a voz
      // pausa ao abrir e retoma ao voltar (decisão do Gui, 25/11/2026)
      const mesmoPasso = Boolean(novo.dataset.passo) && novo.dataset.passo === atual.dataset.passo;
      const indoLer = mesmoPasso && novo.hasAttribute('data-lendo');
      voltouDaLeitura = mesmoPasso && atual.hasAttribute('data-lendo') && !novo.hasAttribute('data-lendo');
      if (indoLer) {
        if (!atual.hasAttribute('data-lendo')) suspenderVoz();
      } else if (!voltouDaLeitura) {
        vozSuspensa = false;
        pararVoz();
      }
      atual.replaceWith(novo);
      // A lista de vozes do pedaço que chegou vale para o portão (a mesma memória ou a seguinte)
      confirmar(novo, pedaco.em);
      const cena = novo.querySelector<HTMLElement>('.palco__cena');
      if (saem && saemDe && cena) {
        const base = cena.getBoundingClientRect();
        saem.setAttribute('aria-hidden', 'true');
        saem.inert = true;
        saem.classList.add('palco__fotos--saindo');
        Object.assign(saem.style, { left: `${saemDe.left - base.left}px`, top: `${saemDe.top - base.top}px`, width: `${saemDe.width}px`, height: `${saemDe.height}px` });
        cena.append(saem);
        // Quem passou para a frente empurra para a esquerda; quem voltou, para a direita
        const lado = deTras ? 1 : -1;
        const fim = () => saem.remove();
        saem.animate([{ translate: '0 0', rotate: '0deg' }, { translate: `${lado * 110}vw 0`, rotate: `${lado * 8}deg` }], { duration: 800, easing: 'cubic-bezier(0.5, 0, 0.8, 0.4)', fill: 'forwards' }).finished.then(fim, fim);
      }
      // O fundo passa de uma cor à outra, em vez de trocar de uma vez
      if (!calmo.matches) novo.animate([{ backgroundColor: cor }, {}], { duration: 900, easing: 'ease-out' });
      // Passar de memória não enche o histórico: o voltar do aparelho sai do modo TV de uma vez
      history.replaceState(history.state, '', semPreferencias(href));
      document.title = novo.dataset.titulo ?? pagina.title;
      const deVoltaDaLeitura = voltouDaLeitura;
      preparar();
      const noMesmoAjuste = noAjuste ? [...novo.querySelectorAll<HTMLElement>('[data-palco-ajustes] :is(a, button, summary)')].find((e) => nomeDe(e) === noAjuste) : undefined;
      const tocarOuPausar = focado === 'tocar' || focado === 'pausa' ? novo.querySelector<HTMLElement>('[data-palco-pausa], [data-palco-tocar]') : null;
      const mesmo = naCheia ? novo.querySelector<HTMLElement>('.palco__na-barra[data-palco-cheia]') : focado ? novo.querySelector<HTMLElement>(`[data-palco-${focado}]`) : null;
      // Em "Só as fotos", com os controles escondidos, o foco não vai para nenhum deles; com eles
      // ocultos pelo botão, fica no botão do canto que os traz de volta
      if (ocultos) novo.querySelector<HTMLElement>('[data-palco-reexibir]')?.focus({ preventScroll: true });
      // Em "Ler tudo", o foco começa na próxima parte (ou em "Voltar à memória", na última); de volta, em "Ler tudo"
      const daLeitura = deVoltaDaLeitura
        ? novo.querySelector<HTMLElement>('[data-palco-ler]')
        : novo.hasAttribute('data-lendo') && !serve(novo.querySelector<HTMLAnchorElement>('[data-palco-depois]'))
          ? novo.querySelector<HTMLElement>('[data-palco-voltar-da-leitura]')
          : null;
      if (!escondidos()) (noMesmoAjuste ?? daLeitura ?? tocarOuPausar ?? mesmo ?? link('depois'))?.focus({ preventScroll: true });
    } catch (erro) {
      // Uma passagem mais nova já saiu: o erro desta não leva de volta à memória antiga
      // (achado do QA de código de 17/11/2026, como na troca do Explorar)
      if (meu !== pedido) return;
      // Sem rede, ir para o endereço trocaria a memória pela página de erro do navegador
      if (falhaDeRede(erro, navigator.onLine)) return esperarARede(a, deTras);
      location.assign(href);
    }
  }

  // O que cada memória precisa ao chegar: "Passar sozinho" à vista, as vizinhas buscadas e o relógio
  function preparar() {
    const atual = palco();
    if (!atual) return;
    if (atual.classList.contains('palco--tv')) {
      // A busca de antemão: a seguinte e a anterior, com as fotos. Com a ordem na mão, também a memória
      // depois da seguinte, só o pedaço do palco e, quando a seguinte já chegou, as fotos dela: quem passa
      // duas vezes seguidas não espera a rede na segunda, e as fotos dela têm duas passagens para chegar no 4G
      // lento. Se o pedaço dela vencer antes de entrar, "Passar sozinho" o pede de novo um pouco antes (armar), e
      // as fotos já estão no aparelho. A anterior é buscada só se ainda não foi: vencida, ela é pedida de novo
      // se a pessoa voltar.
      const comFotos = (pagina: Promise<Document>) => pagina.then((doc) => Promise.all(fotosDe(doc).map((img) => fotoPronta(img))).then(() => doc));
      for (const nome of ['depois', 'antes']) {
        const vizinha = link(nome);
        if (!serve(vizinha)) continue;
        const pronta = comFotos(buscar(vizinha.href, nome === 'antes' ? Infinity : VALIDADE_DO_PEDACO).pagina);
        if (nome === 'depois' && ordem.length > 0)
          pronta
            .then((doc) => {
              const adiante = doc.querySelector<HTMLAnchorElement>('[data-palco] [data-palco-depois]');
              if (serve(adiante) && memoriaDe(adiante.href) !== memoriaDe(location.href)) return comFotos(buscar(adiante.href).pagina);
            })
            .catch(() => undefined);
        else pronta.catch(() => undefined);
      }
    }
    for (const parte of atual.querySelectorAll<HTMLElement>('[data-palco-passar], [data-palco-tela], [data-palco-ocultar], [data-palco-reexibir]')) parte.hidden = false;
    // Os controles ocultos pelo botão continuam ocultos de uma memória para a outra
    atual.toggleAttribute('data-oculto', ocultos);
    // "Só as fotos" é preferência guardada no aparelho; a tela cheia vale enquanto durar
    // Com "Ler tudo" aberto, "Só as fotos" não vale: o texto é o que se lê ali (correção 2 da revisão R-AB3)
    marcarTela(!atual.hasAttribute('data-lendo') && guardado('tv-so-fotos') === '1');
    // "Passar sozinho", num toque, liga no tempo que a pessoa escolheu da última vez
    const tempo = guardado('tv-tempo');
    const noTempo = [...atual.querySelectorAll<HTMLAnchorElement>('.palco__ajuste[data-palco-passar] a[data-palco-leva]')].find((a) => new URL(a.href).searchParams.get('passar') === tempo);
    const ligar = atual.querySelector<HTMLAnchorElement>('.palco__sozinho a');
    if (noTempo && ligar) ligar.setAttribute('href', noTempo.getAttribute('href')!);
    pausado = atual.hasAttribute('data-pausado');
    chegouEm = performance.now();
    prepararSom(atual);
    armar();
  }

  // "Só as fotos" esconde o título, o trecho e os dados; a tela cheia é a do navegador, onde existe
  // (no iPhone não existe: ali o botão nem aparece)
  function marcarTela(soFotos: boolean) {
    const atual = palco();
    if (!atual) return;
    atual.toggleAttribute('data-so-fotos', soFotos);
    // Os controles à vista seguem de uma memória para a outra; fora de "Só as fotos", a marca sai
    atual.toggleAttribute('data-controles', soFotos && controles);
    const botao = atual.querySelector<HTMLButtonElement>('[data-palco-so-fotos]');
    if (botao) {
      botao.setAttribute('aria-pressed', String(soFotos));
      botao.textContent = soFotos ? 'Mostrar o texto' : 'Só as fotos';
    }
    // O caminho de volta em destaque, na linha de "Anterior" e "Próxima"
    const volta = atual.querySelector<HTMLButtonElement>('[data-palco-mostrar-texto]');
    if (volta) volta.hidden = !soFotos;
    // A tela cheia: o símbolo na barra (a partir de 62rem) e o nome escrito em "Ajustes" (abaixo disso)
    for (const cheia of atual.querySelectorAll<HTMLButtonElement>('[data-palco-cheia]')) {
      cheia.hidden = !document.fullscreenEnabled;
      const nome = document.fullscreenElement ? 'Sair da tela cheia' : 'Tela cheia';
      if (cheia.classList.contains('botao-simbolo')) trocarSimbolo(cheia, document.fullscreenElement ? 'sair-da-tela-cheia' : 'tela-cheia', nome);
      else {
        cheia.setAttribute('aria-pressed', String(Boolean(document.fullscreenElement)));
        cheia.textContent = nome;
      }
    }
  }

  /** O nome de um controle: o aria-label do botão de símbolo ou o texto */
  const nomeDe = (e: Element) => e.getAttribute('aria-label') ?? e.textContent?.trim() ?? '';
  /** Troca o símbolo, o nome escrito e o nome acessível de um botão de símbolo, juntos */
  function trocarSimbolo(botao: HTMLElement, id: IdDoSimbolo, nome: string) {
    const desenho = botao.querySelector('svg');
    if (desenho && desenho.dataset.simbolo !== id) {
      desenho.innerHTML = simbolo(id).desenho;
      desenho.dataset.simbolo = id;
    }
    botao.setAttribute('aria-label', nome);
    const escrito = botao.querySelector('.botao-simbolo__nome');
    if (escrito) escrito.textContent = nome;
  }

  const soFotos = () => Boolean(palco()?.hasAttribute('data-so-fotos'));
  const escondidos = () => ocultos || (soFotos() && !controles);

  // "Ocultar os controles" (pedidos do Gui, 22/11/2026): a barra e o alto saem da tela, e a memória
  // fica sozinha, com um botão pequeno no canto que os traz de volta. Esse botão fica com o foco: o
  // Enter (o OK do controle) e o Esc trazem a barra; as setas continuam passando as memórias, e o
  // toque e o clique fazem o que sempre fizeram. Diferente de "Só as fotos", em que eles somem
  // sozinhos e voltam a cada gesto, aqui ficam ocultos até a pessoa pedir. "Passar sozinho" continua
  // passando. Não fica guardado: cada entrada começa com a barra.
  let ocultos = false;
  function ocultar() {
    const atual = palco();
    if (!atual) return;
    ocultos = true;
    atual.setAttribute('data-oculto', '');
    // O foco do teclado nunca fica num controle escondido: vai para o botão do canto
    atual.querySelector<HTMLElement>('[data-palco-reexibir]')?.focus({ preventScroll: true });
  }
  /** A barra volta, e o foco volta para o botão de ocultar, de onde a pessoa saiu */
  function reexibir() {
    const atual = palco();
    if (!atual || !ocultos) return;
    ocultos = false;
    atual.removeAttribute('data-oculto');
    if (soFotos()) mostrarControles();
    atual.querySelector<HTMLElement>('[data-palco-ocultar]')?.focus({ preventScroll: true });
  }

  // Em "Só as fotos", os controles voltam por alguns segundos a cada gesto e somem de novo sozinhos.
  // O relógio recomeça a cada gesto, então eles não somem enquanto a pessoa está mexendo.
  function mostrarControles(focar = false) {
    const atual = palco();
    // Com os controles ocultos pelo botão, só o botão do canto os traz de volta
    if (!atual || !soFotos() || ocultos) return;
    controles = true;
    atual.setAttribute('data-controles', '');
    if (focar) atual.querySelector<HTMLElement>('[data-palco-mostrar-texto]')?.focus({ preventScroll: true });
    clearTimeout(relogioDosControles);
    relogioDosControles = window.setTimeout(esconderControles, SEGUNDOS_DOS_CONTROLES * 1000);
  }
  function esconderControles() {
    clearTimeout(relogioDosControles);
    controles = false;
    const atual = palco();
    if (!atual) return;
    atual.removeAttribute('data-controles');
    // O foco do teclado nunca fica num controle escondido
    const ativo = document.activeElement;
    if (soFotos() && ativo instanceof HTMLElement && atual.contains(ativo)) ativo.blur();
  }
  // Entrar e sair de "Só as fotos". Ao entrar, os controles ficam na tela por alguns segundos, para
  // a pessoa ver onde está o caminho de volta; ao sair, o foco vai para "Próxima", como na chegada.
  function trocarSoFotos(ligar: boolean) {
    guardar('tv-so-fotos', ligar ? '1' : '0');
    if (!ligar) {
      clearTimeout(relogioDosControles);
      controles = false;
    }
    marcarTela(ligar);
    if (ligar) mostrarControles(true);
    else link('depois')?.focus({ preventScroll: true });
  }

  // Ligado: a próxima entra sozinha depois do tempo escolhido. Com a aba escondida, espera. Enquanto alguém
  // fala, a memória espera a voz acabar e mais três segundos (esperaDaMemoria, em src/lib/sala.ts); o
  // parágrafo da carta fica pelo menos o tempo de ler (segundosDoParagrafo, no data-tempo do palco).
  function armar() {
    clearTimeout(relogio);
    const atual = palco();
    const segundos = Number(atual?.dataset.passar);
    if (!(segundos > 0) || pausado || document.hidden) return;
    // A voz vai tocar ou está tocando, ou a rota confirma a voz de um pedaço vencido: quem arma de novo é o fim dela
    if (falando || relogioDaVoz || renovando) return;
    const base = Math.max(segundos, Number(atual?.dataset.tempo) || 0) * 1000;
    const passou = performance.now() - chegouEm;
    const espera = falou ? Math.max(base - passou, RESPIRO_DEPOIS_DA_VOZ * 1000) : base;
    relogio = window.setTimeout(() => passar(link('depois')), espera);
    // A seguinte, buscada de novo um pouco antes de entrar se até lá tiver vencido: a passagem continua sem
    // esperar a rede, e nada mais velho que a janela vai à tela (correção 1 da revisão R-AB)
    clearTimeout(relogioDoPedaco);
    const depois = link('depois');
    if (serve(depois))
      relogioDoPedaco = window.setTimeout(
        () => void buscar(depois.href, VALIDADE_DO_PEDACO - ANTECEDENCIA_DO_PEDACO).pagina.then((doc) => Promise.all(fotosDe(doc).map((img) => fotoPronta(img)))).catch(() => undefined),
        Math.max(0, espera - ANTECEDENCIA_DO_PEDACO),
      );
  }
  let relogioDoPedaco = 0;

  // --- A voz de quem contou ----------------------------------------------------------------------
  // Um tocador só, fora do palco, que fica de uma memória para a outra: depois que a pessoa liga o som, o
  // navegador deixa ele tocar as vozes seguintes sem outro gesto. O som começa desligado e liga no próprio
  // toque no símbolo; a escolha fica guardada no aparelho. As vozes vêm do palco que o servidor mandou
  // (data-voz): só de relato publicado que não espera ninguém, de memória que a pessoa vê e, na sala, de
  // memória aberta a todos.
  const voz = new Audio();
  voz.preload = 'auto';
  // Um instante de silêncio, para destravar o som no primeiro gesto (o Safari do iPhone pede)
  const SILENCIO = 'data:audio/wav;base64,UklGRiQAAABXQVZFZm10IBAAAAABAAEAQB8AAIA+AAACABAAZGF0YQAAAAA=';
  let somLigado = false;
  let destravado = false;
  let falando = false;
  let falou = false;
  let relogioDaVoz = 0;
  let renovando = false;
  let vozSuspensa = false;
  let chegouEm = 0;
  let fila: { src: string; duracao: number | null }[] = [];
  const vozesDe = (p: HTMLElement | null): { src: string; duracao: number | null }[] => {
    try {
      return JSON.parse(p?.dataset.voz ?? '[]');
    } catch {
      return [];
    }
  };
  const absoluto = (src: string) => new URL(src, location.href).href;
  function marcarOuvindo(sim: boolean) {
    palco()?.toggleAttribute('data-ouvindo', sim);
  }

  // --- O portão da voz (correção 1 da revisão R-AB3) ---------------------------------------------------
  // Nas rodadas da revisão, cada caminho que tocava a voz conferia por conta própria, e a cada rodada um deles
  // esquecia. Agora todo começo e toda retomada de áudio passam por portaoDaVoz, o único lugar que chama
  // `voz.play()` (a guarda do teste confere: testes/sala.test.ts). Ele toca uma fonte só se ela está na lista
  // de vozes do pedaço confirmado mais recente da memória que está na tela (`confirmado`), dentro da validade.
  // Vencido, ele pede o pedaço de novo à rota de uma memória antes; fora da lista, nada toca e a linha "A voz
  // de …" sai. Quem chama: a primeira voz (tocarVozDaVez), a próxima da fila (proximaDaFila), ligar o som pelo
  // símbolo ou pela ação escrita da carta (alternarSom), retomar depois da pausa (alternarPausa), voltar de "Ler tudo"
  // (prepararSom) e o instante de silêncio do primeiro gesto (destravar).
  // Toda chegada de um pedaço da memória da tela (a passagem, "Ler tudo", a renovação) passa por confirmar, que
  // guarda a lista mais nova e para o que está tocando ou pausado e saiu dela.
  let confirmado: { passo: string; vozes: Set<string>; em: number } | null = null;
  /** Muda a cada pedido de voz, a cada pausa e a cada passagem: a resposta que chega depois não toca mais nada */
  let vez = 0;

  /** Um pedaço da memória da tela chegou: a lista dele vale, se for o mais novo dessa memória */
  function confirmar(p: HTMLElement, em: number) {
    const passo = p.dataset.passo ?? '';
    if (confirmado && confirmado.passo === passo && confirmado.em > em) return;
    confirmado = { passo, vozes: new Set(vozesDe(p).map((v) => absoluto(v.src))), em };
    const lista = confirmado.vozes;
    // O que está tocando ou pausado e saiu da lista para, e a fila fica só com o que continua nela
    if (falando && !lista.has(voz.src)) {
      voz.pause();
      falando = false;
      marcarOuvindo(false);
    }
    fila = fila.filter((v) => lista.has(absoluto(v.src)));
    const naTela = palco();
    if (naTela?.dataset.passo === passo && lista.size === 0) {
      delete naTela.dataset.voz;
      naTela.querySelector('[data-palco-voz]')?.remove();
    }
  }
  /** O pedaço da memória da tela, de novo, à rota de uma memória: o que ela mandar vale; sem resposta, nenhuma voz */
  async function renovarPedaco(atual: HTMLElement) {
    const pedaco = buscar(enderecoDaVez(atual));
    let lista: string | undefined;
    try {
      const chegou = (await pedaco.pagina).querySelector<HTMLElement>('[data-palco]');
      if (chegou?.dataset.passo === atual.dataset.passo) lista = chegou.dataset.voz;
    } catch {
      // A memória não entra mais, ou a rede caiu: nada toca
    }
    if (lista) atual.dataset.voz = lista;
    else delete atual.dataset.voz;
    buscadoEm.set(atual, pedaco.em);
    // Só se pede de novo um pedaço vencido, e o guardado só volta dentro da validade: o que chega é sempre o mais novo
    confirmar(atual, pedaco.em);
  }
  /** A voz para e sai: nada toca, e a linha "A voz de …" deixa a tela */
  function calarVoz() {
    pararVoz();
    vozSuspensa = false;
    const naTela = palco();
    if (naTela) {
      delete naTela.dataset.voz;
      naTela.querySelector('[data-palco-voz]')?.remove();
    }
  }
  /**
   * O portão: o único lugar que toca. `fonte` nula só destrava o som com o instante de silêncio (o gesto que o
   * Safari do iPhone pede). `retomar`: continua de onde o áudio parou, se ele ainda vale. `gesto`: a chamada veio
   * de um toque ou tecla, e o silêncio destrava o som antes de qualquer espera.
   */
  async function portaoDaVoz(fonte: string | null, { retomar = false, gesto = false } = {}) {
    const minha = ++vez;
    const atual = palco();
    if (!atual) return;
    if (gesto && !falando) {
      destravado = true;
      voz.src = SILENCIO;
      voz.play().catch(() => undefined);
    }
    if (fonte === null) return;
    const alvo = absoluto(fonte);
    const vale = () => Boolean(confirmado && confirmado.passo === atual.dataset.passo && !pedacoVencido(confirmado.em, performance.now()));
    if (!vale()) {
      // Vencido: a rota confirma de novo antes. Até lá, "Passar sozinho" espera
      clearTimeout(relogio);
      renovando = true;
      await renovarPedaco(atual);
      renovando = false;
      if (minha !== vez || palco() !== atual) return void armar();
    }
    if (!somLigado || pausado || atual.hasAttribute('data-lendo')) return void armar();
    if (!vale() || !confirmado!.vozes.has(alvo)) {
      calarVoz();
      return void armar();
    }
    // A fonte sai da fila quando começa
    const n = fila.findIndex((v) => absoluto(v.src) === alvo);
    if (n >= 0) fila.splice(n, 1);
    if (!(retomar && voz.src === alvo)) voz.src = alvo;
    // Enquanto a voz toca, "Passar sozinho" espera: quem arma de novo é o fim dela (ligar o som com o relógio já
    // armado deixava a memória passar no meio da voz)
    clearTimeout(relogio);
    falando = true;
    falou = true;
    marcarOuvindo(true);
    voz.play().catch(() => {
      // O navegador não deixou tocar (sem gesto ainda): a memória segue sem a voz
      falando = false;
      marcarOuvindo(false);
      armar();
    });
  }

  function destravar() {
    if (destravado) return;
    destravado = true;
    if (falando) return;
    void portaoDaVoz(null, { gesto: true });
  }
  function pararVoz() {
    vez++;
    clearTimeout(relogioDaVoz);
    relogioDaVoz = 0;
    fila = [];
    falando = false;
    voz.pause();
    marcarOuvindo(false);
  }
  /** A próxima da fila, pelo portão; sem nenhuma, a memória pode passar */
  function proximaDaFila(gesto = false) {
    relogioDaVoz = 0;
    const proxima = fila[0];
    if (!proxima) {
      falando = false;
      marcarOuvindo(false);
      armar();
      return;
    }
    void portaoDaVoz(proxima.src, { gesto });
  }
  /** A voz da memória da tela, do começo. `logo`: no gesto de ligar o som, sem esperar. */
  function tocarVozDaVez(logo = false) {
    pararVoz();
    fila = vozesDe(palco());
    if (!somLigado || fila.length === 0 || pausado) return void (fila = []);
    if (logo) return proximaDaFila(true);
    // A voz entra depois de a memória chegar; com movimento reduzido, quase na hora
    relogioDaVoz = window.setTimeout(proximaDaFila, calmo.matches ? 300 : 1400);
  }
  voz.addEventListener('ended', () => {
    if (voz.src !== SILENCIO && falando) proximaDaFila();
  });
  voz.addEventListener('timeupdate', () => {
    const ouvido = palco()?.querySelector<HTMLElement>('[data-palco-ouvido]');
    if (ouvido && falando && voz.duration) ouvido.style.width = `${Math.min(100, (voz.currentTime / voz.duration) * 100)}%`;
  });
  function prepararSom(atual: HTMLElement) {
    const botao = atual.querySelector<HTMLButtonElement>('[data-palco-som]');
    if (!botao) return pararVoz();
    botao.hidden = false;
    marcarSom(botao);
    // Com "Ler tudo" aberto, a voz fica pausada
    if (atual.hasAttribute('data-lendo')) return;
    const voltou = voltouDaLeitura;
    voltouDaLeitura = false;
    if (voltou) {
      // A voz que "Ler tudo" pausou retoma de onde estava, pelo portão: só se ela continua na lista mais nova da
      // memória, dentro da validade. A que já tinha acabado não toca de novo.
      const suspensa = vozSuspensa;
      vozSuspensa = false;
      if (suspensa && falando && !pausado) return void portaoDaVoz(voz.src, { retomar: true });
      if (suspensa && fila.length > 0 && !pausado) return proximaDaFila();
      if (falou || suspensa) return;
    }
    falou = false;
    tocarVozDaVez();
  }
  /** "Ler tudo" abriu: a voz pausa como na pausa, e a fila fica para quando a pessoa voltar */
  function suspenderVoz() {
    vez++;
    vozSuspensa = falando || Boolean(relogioDaVoz) || fila.length > 0;
    clearTimeout(relogioDaVoz);
    relogioDaVoz = 0;
    if (falando) voz.pause();
  }
  /** O símbolo, o nome e a marca do som ligado, juntos (o ponto na cor viva sai com o som ligado, telas/tv.css).
      Na carta da sala, a ação escrita ao lado dos pontos acompanha a mesma escolha (CartaNaTv.astro). */
  function marcarSom(botao: HTMLElement) {
    trocarSimbolo(botao, somLigado ? 'som' : 'sem-som', somLigado ? 'Desligar o som' : 'Ligar o som');
    botao.toggleAttribute('data-ligado', somLigado);
    const vozes = botao.closest('[data-palco]')?.querySelector<HTMLButtonElement>('[data-palco-vozes]');
    if (!vozes) return;
    vozes.hidden = false;
    vozes.textContent = (somLigado ? vozes.dataset.desligar : vozes.dataset.ligar) ?? '';
    vozes.toggleAttribute('data-ligado', somLigado);
  }
  function alternarSom(botao: HTMLElement) {
    somLigado = !somLigado;
    guardar('tv-som', somLigado ? '1' : '0');
    marcarSom(botao);
    if (somLigado) {
      // Este toque é o gesto: a voz da memória da tela começa já, pelo portão, ou o som fica destravado
      if (vozesDe(palco()).length > 0) tocarVozDaVez(true);
      else destravar();
    } else {
      pararVoz();
      armar();
    }
  }

  // A pausa fica no endereço e segue para a memória seguinte: quem pausou e passa à mão continua pausado
  function alternarPausa(botao: HTMLButtonElement) {
    const atual = palco();
    if (!atual) return;
    pausado = !pausado;
    // A voz pausa e retoma junto
    if (pausado) {
      vez++;
      clearTimeout(relogioDaVoz);
      relogioDaVoz = 0;
      voz.pause();
    }
    // Retomar passa pelo portão: o áudio pausado continua só se ainda está na lista confirmada, dentro da
    // validade (vencido, a rota confirma antes); a fila segue com o que ficou nela
    else if (falando) void portaoDaVoz(voz.src, { retomar: true });
    else if (fila.length > 0) proximaDaFila();
    else if (!falou) tocarVozDaVez();
    // O símbolo e o nome trocam juntos, no mesmo botão: pausado, ele diz "Retomar", com o de tocar
    trocarSimbolo(botao, pausado ? 'tocar' : 'pausar', pausado ? 'Retomar' : 'Pausar');
    atual.toggleAttribute('data-pausado', pausado);
    // Pausar enquanto se espera a rede desiste da passagem; retomar arma o relógio de novo
    if (pausado && aEspera) desistirDeEsperar();
    const levar = (endereco: string) => {
      const url = new URL(endereco, location.href);
      if (pausado) url.searchParams.set('pausa', '1');
      else url.searchParams.delete('pausa');
      return url.pathname + url.search;
    };
    // Escolher um tempo retoma: esses links não levam a pausa
    for (const a of atual.querySelectorAll<HTMLAnchorElement>('a[data-palco-leva][href], a[data-palco-movimento][href]')) if (!a.closest('[data-palco-passar]')) a.setAttribute('href', levar(a.href));
    armar();
  }

  // "Ajustes" aberto: o Esc e, na barra, o toque fora fecham a folha antes de qualquer outra coisa,
  // e o foco volta para o botão que a abriu
  const abertos = () => [...(palco()?.querySelectorAll<HTMLDetailsElement>('[data-palco-ajustes][open]') ?? [])];
  function fecharAbertos(fora?: Element | null) {
    const lista = abertos().filter((aberto) => !fora || !aberto.contains(fora));
    for (const aberto of lista) {
      const tinhaFoco = aberto.contains(document.activeElement);
      aberto.open = false;
      if (!fora || tinhaFoco) aberto.querySelector<HTMLElement>('summary')?.focus({ preventScroll: true });
    }
    return lista.length > 0;
  }

  // A barra, pelas setas: os botões à vista, na ordem da tela. Com "Ajustes" aberto, a folha é uma
  // fila à parte, em cima: as setas para cima e para baixo entram nela e voltam ao botão de "Ajustes".
  const aVista = (e: HTMLElement) => !e.closest('[hidden]') && e.getClientRects().length > 0 && getComputedStyle(e).visibility !== 'hidden';
  const naFolha = (e: Element | null) => Boolean(e?.closest('.palco__partes'));
  function botoesDaBarra(daFolha: boolean) {
    const atual = palco();
    if (!atual) return [];
    return [...atual.querySelectorAll<HTMLElement>('.palco__controles :is(a[href], button, summary)')].filter((e) => aVista(e) && naFolha(e) === daFolha);
  }
  function andar(tecla: string) {
    const ativo = document.activeElement instanceof HTMLElement ? document.activeElement : null;
    if (!ativo) return;
    const resumo = palco()?.querySelector<HTMLElement>('[data-palco-ajustes] > summary');
    if (tecla === 'ArrowUp' || tecla === 'ArrowDown') {
      if (tecla === 'ArrowUp' && !naFolha(ativo)) {
        const folha = botoesDaBarra(true);
        return (folha.find((e) => e.getAttribute('aria-current') === 'true') ?? folha[0])?.focus({ preventScroll: true });
      }
      if (tecla === 'ArrowDown' && naFolha(ativo)) resumo?.focus({ preventScroll: true });
      return;
    }
    const fila = botoesDaBarra(naFolha(ativo));
    const aqui = fila.indexOf(ativo);
    // Nas pontas, o foco para: nada dá a volta, como no controle da TV
    fila[aqui + (tecla === 'ArrowLeft' ? -1 : 1)]?.focus({ preventScroll: true });
  }

  /** O botão de tocar e pausar, pela tecla de mídia: liga o "Passar sozinho", pausa ou retoma */
  function tocarOuPausar() {
    const pausa = palco()?.querySelector<HTMLButtonElement>('[data-palco-pausa]');
    if (pausa) return alternarPausa(pausa);
    const tocar = palco()?.querySelector<HTMLAnchorElement>('[data-palco-tocar]');
    if (tocar && !tocar.closest('[hidden]')) passar(tocar);
  }

  const primeiro = palco();
  if (primeiro) {
    // Sem "m" no endereço (a porta da sala), a página abriu no passo que o servidor escolheu: ele vai para o
    // endereço, para o voltar e a busca de antemão saberem onde estão (correção 4 da revisão R-AB)
    if (primeiro.dataset.passo && !new URL(location.href).searchParams.has('m')) history.replaceState(history.state, '', semPreferencias(enderecoDaVez(primeiro)));
    // O som começa como a pessoa deixou da última vez neste aparelho; sem escolha, desligado. Ligado de
    // antes, o navegador ainda pede um gesto depois de abrir a página: a primeira tecla ou o primeiro toque
    // destrava a voz, e até lá a memória passa sem ela
    somLigado = guardado('tv-som') === '1';
    // O pedaço da primeira página, pedido com ela
    confirmar(primeiro, 0);
    // Qualquer tecla também é gesto: com o som ligado, ela destrava a voz
    document.addEventListener('keydown', () => void (somLigado && destravar()), { capture: true });
    // Na chegada pela página, a animação espera as fotos: sem isso ela acabava antes de elas aparecerem
    Promise.all(fotosDe(primeiro).map((img) => (img.complete ? img.decode().catch(() => undefined) : new Promise((ok) => img.addEventListener('load', ok, { once: true }))))).then(() => {
      primeiro.setAttribute('data-pronta', '');
      primeiro.removeAttribute('data-espera');
    });
    document.addEventListener('keydown', (evento) => {
      if (evento.metaKey || evento.ctrlKey || evento.altKey || !palco()) return;
      // Com "Ler tudo" aberto, o Esc volta à memória antes de qualquer outra coisa, com "Só as fotos" guardado ou
      // não (correção 2 da revisão R-AB3)
      const daLeitura = evento.key === 'Escape' && palco()!.hasAttribute('data-lendo') ? palco()!.querySelector<HTMLAnchorElement>('[data-palco-voltar-da-leitura]') : null;
      if (serve(daLeitura)) {
        evento.preventDefault();
        if (ocultos) reexibir();
        return void passar(daLeitura, true);
      }
      const ativo = document.activeElement;
      const reacao = teclaNaTv(evento.key, {
        barra: naBarra.matches,
        ajustesAbertos: abertos().length > 0,
        ocultos,
        soFotos: soFotos(),
        controlesAVista: controles,
        focoNaBarra: Boolean(ativo?.closest('[data-palco] .palco__controles')),
      });
      // Em "Só as fotos", toda tecla mantém os controles à vista por mais alguns segundos
      if (soFotos() && controles) mostrarControles();
      switch (reacao) {
        case 'reexibir':
          evento.preventDefault();
          return reexibir();
        case 'fechar-ajustes':
          evento.preventDefault();
          return void fecharAbertos();
        case 'mostrar-controles':
          // O Tab segue o caminho dele, já com os controles à vista; as outras teclas só mostram
          if (evento.key !== 'Tab') evento.preventDefault();
          return mostrarControles(evento.key !== 'Tab');
        case 'voltar-ao-texto':
          evento.preventDefault();
          return trocarSoFotos(false);
        case 'sair':
          if (serve(link('sair'))) location.assign(link('sair')!.href);
          return;
        case 'andar':
        case 'subir':
        case 'descer':
          evento.preventDefault();
          return andar(evento.key);
        case 'anterior':
          evento.preventDefault();
          return void passar(link('antes'), true);
        case 'proxima':
          evento.preventDefault();
          return void passar(link('depois'));
        case 'tocar-ou-pausar':
          evento.preventDefault();
          return tocarOuPausar();
        case 'acionar':
          // O espaço aciona o link com o foco, como o Enter; nos botões, o navegador já faz isso
          if (ativo instanceof HTMLAnchorElement && ativo.closest('[data-palco]')) {
            evento.preventDefault();
            ativo.click();
          }
          return;
      }
    });
    // O toque e o clique, em "Só as fotos" com os controles escondidos, só trazem os controles: a
    // foto não passa de memória nesse primeiro toque. Na captura, antes de qualquer outro tratamento.
    document.addEventListener(
      'click',
      (evento) => {
        // Com os controles ocultos pelo botão, o toque e o clique fazem o que sempre fizeram
        if (!soFotos() || ocultos) return;
        if (reacaoEmSoFotos({ tipo: 'toque' }, controles) === 'mostrar-controles') {
          evento.preventDefault();
          evento.stopPropagation();
        }
        mostrarControles();
      },
      true,
    );
    // O mouse que se mexe de verdade: a troca de memória embaixo de um cursor parado não conta
    let cursor = '';
    document.addEventListener('mousemove', (evento) => {
      const onde = `${evento.screenX},${evento.screenY}`;
      if (onde === cursor) return;
      const primeiroSinal = cursor === '';
      cursor = onde;
      if (!primeiroSinal && soFotos()) mostrarControles();
    });
    document.addEventListener('click', (evento) => {
      const alvo = evento.target instanceof Element ? evento.target : null;
      const pausa = alvo?.closest<HTMLButtonElement>('[data-palco] [data-palco-pausa]');
      if (pausa) return alternarPausa(pausa);
      if (alvo?.closest('[data-palco] :is([data-palco-so-fotos], [data-palco-mostrar-texto])')) return trocarSoFotos(!soFotos());
      if (alvo?.closest('[data-palco] [data-palco-ocultar]')) return ocultar();
      const som = alvo?.closest<HTMLElement>('[data-palco] [data-palco-som]');
      if (som) return alternarSom(som);
      // A ação escrita da carta da sala (data-palco-vozes) é o mesmo gesto do símbolo da barra
      const barra = alvo?.closest('[data-palco] [data-palco-vozes]') ? palco()?.querySelector<HTMLElement>('[data-palco-som]') : null;
      if (barra) return alternarSom(barra);
      if (alvo?.closest('[data-palco] [data-palco-reexibir]')) return reexibir();
      if (alvo?.closest('[data-palco] [data-palco-cheia]')) {
        const pedido = document.fullscreenElement ? document.exitFullscreen() : document.documentElement.requestFullscreen();
        return void pedido.catch(() => undefined);
      }
      // Dentro do modo TV, todo link que continua nele troca no lugar: passar, o tempo, a animação
      const a = alvo?.closest<HTMLAnchorElement>('[data-palco].palco--tv a[href]');
      if (!a || evento.defaultPrevented || evento.button !== 0 || evento.metaKey || evento.ctrlKey || evento.shiftKey || evento.altKey) return;
      if (!ficaNoPalco(a.href)) return;
      evento.preventDefault();
      // O primeiro toque com o som ligado destrava a voz das memórias seguintes
      if (somLigado) destravar();
      // A animação e o tempo escolhidos em "Ajustes" ficam guardados no aparelho
      if (a.hasAttribute('data-palco-movimento')) guardar('tv-animacao', animacaoDe(a.href));
      const tempo = a.closest('.palco__ajuste[data-palco-passar]') ? new URL(a.href).searchParams.get('passar') : null;
      if (tempo) guardar('tv-tempo', tempo);
      passar(a, a.hasAttribute('data-palco-antes'));
    });
    // Na barra, o toque fora de "Ajustes" fecha a folha (abaixo de 62rem, ela abre no lugar e fica)
    document.addEventListener('pointerdown', (evento) => void (naBarra.matches && fecharAbertos(evento.target instanceof Element ? evento.target : null)));
    document.addEventListener('visibilitychange', () => {
      if (!aEspera) armar();
    });
    // A rede voltou: a passagem que esperava sai na hora
    addEventListener('online', tentarDeNovo);
    // Sair da tela cheia pelo Esc do navegador não chega à página como tecla: os controles voltam aqui
    document.addEventListener('fullscreenchange', () => {
      marcarTela(soFotos());
      if (ocultos) reexibir();
      else mostrarControles();
    });
    preparar();
    // Quem entra com "Só as fotos" guardado vê os controles por alguns segundos, com o caminho de volta
    mostrarControles();
    history.replaceState(history.state, '', semPreferencias(location.href));
    // A animação guardada no aparelho vale ao entrar no modo TV
    const animacao = guardado('tv-animacao');
    const daAnimacao = animacao && animacao !== (primeiro.dataset.movimento ?? 'a') ? [...primeiro.querySelectorAll<HTMLAnchorElement>('a[data-palco-movimento]')].find((a) => animacaoDe(a.href) === animacao) : undefined;
    if (daAnimacao) passar(daAnimacao);
    // O foco começa em "Próxima": no controle da TV, o botão do meio já passa. Em "Só as fotos", em
    // "Mostrar o texto".
    (soFotos() ? palco()?.querySelector<HTMLElement>('[data-palco-mostrar-texto]') : link('depois'))?.focus({ preventScroll: true });
  }
</script>
