---
// O palco: uma memória por vez, grande, para ver junto (docs/decisoes.md, "Explorar"). Serve ao
// modo TV, que passa pelas memórias na ordem dos filtros, e ao "Me mostre uma memória", que sorteia.
// Cada memória é uma página: "Anterior" e "Próxima" são links, então funciona sem script, pelo
// teclado e pelo controle da TV. O script só acrescenta as setas e o "Passar sozinho".
import Carimbo from '../visual/Carimbo.astro';
import Polaroid from '../visual/Polaroid.astro';
import Vazio from '../visual/Vazio.astro';
import { carimboDaData, estiloDoTipo, legendaLugarAno, listaCurta } from '../../lib/visual';

interface Props {
  modo: 'tv' | 'acaso';
  memoria?: { id: string; titulo: string; tipo: string; lugar: string | null; ano: number; mes: number | null; dia: number | null; aproximada: boolean; fotos: { chave: string; legenda: string | null }[] };
  /** o trecho de um relato e quem contou */
  trecho?: { texto: string; por: string };
  /** os nomes de quem estava */
  nomes?: string[];
  /** "3 de 41", no modo TV */
  posicao?: string;
  /** endereços: a de antes, a de depois (ou outra sorteada) e a volta ao Explorar */
  antes?: string;
  depois?: string;
  sair: string;
  /**
   * "Passar sozinho": o tempo em uso (null, desligado), a pausa, o endereço que liga cada tempo e o
   * que desliga
   */
  passar?: { tempo: number | null; pausado: boolean; tempos: { segundos: number; href: string }[]; parar: string };
  /** a foto da memória seguinte, para já estar carregada quando ela entrar */
  fotoSeguinte?: string;
  /** para limpar os filtros, quando nada passa neles */
  limpar: string;
  /** a versão do movimento do modo TV em uso (src/lib/explorar.ts, MOVIMENTOS) */
  movimento?: string;
  /** só nas prévias: as versões, para trocar pela faixa do alto */
  movimentos?: { id: string; nome: string; href: string }[];
}

const { modo, memoria, trecho, nomes = [], posicao, antes, depois, sair, passar, fotoSeguinte, limpar, movimento, movimentos } = Astro.props;
const foto = memoria?.fotos[0];
const abrir = memoria ? `/memorias/${memoria.id}` : '';
---

{
  !memoria && (
    <div class="miolo">
      <Vazio frase="Nenhuma memória passa nesses filtros.">
        <a class="acao" href={limpar}>
          Limpar filtros
        </a>
        <a class="acao acao--quieta" href={sair}>
          Voltar ao Explorar
        </a>
      </Vazio>
    </div>
  )
}
{
  memoria && (
    <article class:list={['palco', `palco--${modo}`]} style={estiloDoTipo(memoria.tipo)} data-palco data-movimento={modo === 'tv' ? movimento : undefined} data-passar={passar?.tempo ?? undefined} data-pausado={passar?.pausado ? '' : undefined}>
      {/* De que lado a memória chega: quem passou para trás vê a foto entrar pelo outro lado. Fica
          antes de tudo, para valer já no primeiro desenho da página. */}
      <script is:inline>
        (function () {
          try {
            if (sessionStorage.getItem('palco-direcao') === 'antes') document.currentScript.parentElement.setAttribute('data-de-tras', '');
            sessionStorage.removeItem('palco-direcao');
          } catch (e) {}
        })();
      </script>
      {movimentos && (
        <p class="teste palco__faixa">
          <span>Movimento do modo TV, para escolher:</span>
          {movimentos.map((m) => (
            <a href={m.href} aria-current={m.id === movimento ? 'true' : undefined}>
              {m.id.toUpperCase()} {m.nome}
            </a>
          ))}
        </p>
      )}
      <header class="palco__topo miolo">
        <p class="rotulo">
          {modo === 'tv' ? 'Modo TV' : 'Uma memória ao acaso'}
          {posicao && <span> · {posicao}</span>}
        </p>
        <a class="acao acao--quieta" href={sair} data-palco-sair>
          {modo === 'tv' ? 'Sair do modo TV' : 'Voltar ao Explorar'}
        </a>
      </header>
      <div class="palco__cena miolo">
        {/* No modo TV, tocar na foto passa para a próxima; no "ao acaso", abre a memória */}
        <a class="palco__foto" href={modo === 'tv' && depois ? depois : abrir} data-palco-leva={modo === 'tv' && depois ? '' : undefined} aria-label={modo === 'tv' && depois ? 'Próxima memória' : `Abrir a memória ${memoria.titulo}`} tabindex="-1">
          {foto ? (
            <img src={`/fotos/${foto.chave}`} alt={foto.legenda ?? ''} decoding="async" />
          ) : (
            <span class="palco__cartao">
              <Polaroid id={memoria.id} fotos={[]} legenda={legendaLugarAno(memoria.lugar, memoria.ano)} tipo={memoria.tipo} reta />
            </span>
          )}
        </a>
        <div class="palco__texto">
          <p>
            <Carimbo itens={[carimboDaData(memoria), memoria.lugar]} />
          </p>
          <h1 class="palco__titulo">{memoria.titulo}</h1>
          {trecho && (
            <blockquote class="palco__trecho">
              <p class="serifa t-abertura">“{trecho.texto}”</p>
              <footer>
                <span class="mao">{trecho.por}</span>
              </footer>
            </blockquote>
          )}
          {nomes.length > 0 && <p class="ficha suave">Com {listaCurta(nomes, 5)}</p>}
          <p>
            <a class="acao" href={abrir}>
              Abrir esta memória
            </a>
          </p>
        </div>
        <nav class="palco__passos" aria-label={modo === 'tv' ? 'Passar as memórias' : 'Outra memória'}>
          {modo === 'tv' && (
            <>
              <a class="acao" href={antes} aria-disabled={antes ? undefined : 'true'} rel="prev" data-palco-antes data-palco-leva>
                Anterior
              </a>
              <a class="botao" href={depois} aria-disabled={depois ? undefined : 'true'} rel="next" data-palco-depois data-palco-leva>
                Próxima
              </a>
            </>
          )}
          {modo === 'acaso' && depois && (
            <a class="botao" href={depois} data-palco-depois>
              Me mostre outra
            </a>
          )}
        </nav>
        {/* "Passar sozinho": quem está vendo escolhe o tempo de cada memória e pode pausar e retomar.
            Só existe com script: sem ele, o grupo nem aparece. */}
        {passar && (
          <div class="palco__passar" role="group" aria-labelledby="passar-sozinho" data-palco-passar hidden>
            <p class="rotulo suave" id="passar-sozinho">
              Passar sozinho
            </p>
            <p class="palco__tempos">
              {passar.tempos.map((t) => (
                <a href={t.href} aria-current={t.segundos === passar.tempo ? 'true' : undefined} data-palco-leva>
                  {t.segundos} segundos
                </a>
              ))}
            </p>
            {passar.tempo !== null && (
              <p class="palco__tempos">
                <button type="button" class="acao" data-palco-pausa aria-pressed={passar.pausado ? 'true' : 'false'}>
                  {passar.pausado ? 'Retomar' : 'Pausar'}
                </button>
                <a class="acao acao--quieta" href={passar.parar}>
                  Parar de passar sozinho
                </a>
              </p>
            )}
          </div>
        )}
      </div>
      {fotoSeguinte && <link rel="preload" as="image" href={fotoSeguinte} />}
    </article>
  )
}

<script>
  // O modo TV passa de uma memória para a outra sem recarregar a página (correção pedida pelo Gui,
  // 17/11/2026: com a página recarregando, as animações acabavam antes de a foto chegar). A página
  // da memória seguinte é buscada de antemão; ao passar, o palco é trocado com a foto já pronta, e
  // é aí que o movimento começa. As setas do teclado e do controle da TV passam, e o Esc sai.
  // Nada espera uma animação acabar: passar no meio de uma chegada troca na hora.
  // Sem script, "Anterior" e "Próxima" continuam sendo links, e "Passar sozinho" nem aparece.
  const calmo = matchMedia('(prefers-reduced-motion: reduce)');
  const palco = () => document.querySelector<HTMLElement>('[data-palco]');
  const link = (nome: string) => palco()?.querySelector<HTMLAnchorElement>(`[data-palco-${nome}]`) ?? null;
  const serve = (a: HTMLAnchorElement | null): a is HTMLAnchorElement => Boolean(a && a.getAttribute('href') && a.getAttribute('aria-disabled') !== 'true');

  // As páginas já buscadas: a de antes e a de depois ficam prontas enquanto a memória está na tela
  const paginas = new Map<string, Promise<Document>>();
  const buscar = (href: string) => {
    if (!paginas.has(href)) {
      if (paginas.size > 24) paginas.clear();
      const pagina = fetch(href, { headers: { Accept: 'text/html' } })
        .then((resposta) => (resposta.ok ? resposta.text() : Promise.reject(new Error(String(resposta.status)))))
        .then((texto) => new DOMParser().parseFromString(texto, 'text/html'));
      pagina.catch(() => paginas.delete(href));
      paginas.set(href, pagina);
    }
    return paginas.get(href)!;
  };
  const fotoPronta = (endereco: string | null | undefined) => {
    if (!endereco) return Promise.resolve();
    const foto = new Image();
    foto.src = endereco;
    return foto.decode().catch(() => undefined);
  };
  const memoriaDe = (href: string) => new URL(href, location.href).searchParams.get('m');

  let pedido = 0;
  let relogio = 0;
  let pausado = false;

  async function passar(a: HTMLAnchorElement | null, deTras = false) {
    const atual = palco();
    if (!serve(a) || !atual) return;
    // Só o modo TV troca no lugar: o "ao acaso" sorteia no servidor, e sair é sair
    if (!atual.classList.contains('palco--tv') || new URL(a.href).searchParams.get('ver') !== 'tv') return location.assign(a.href);
    const href = a.href;
    const meu = ++pedido;
    clearTimeout(relogio);
    try {
      const pagina = await buscar(href);
      const chegou = pagina.querySelector<HTMLElement>('[data-palco]');
      if (!chegou) throw new Error('sem o palco');
      await fotoPronta(chegou.querySelector<HTMLImageElement>('.palco__foto img')?.getAttribute('src'));
      // Uma passagem mais nova já saiu: esta chegou atrasada
      if (meu !== pedido) return;
      const novo = document.importNode(chegou, true);
      novo.querySelector('script')?.remove();
      novo.toggleAttribute('data-de-tras', deTras);
      // A mesma memória (trocar o tempo, parar de passar sozinho): nada chega de novo
      if (memoriaDe(href) === memoriaDe(location.href)) novo.removeAttribute('data-movimento');
      const focado = ['antes', 'depois', 'pausa'].find((nome) => document.activeElement?.hasAttribute(`data-palco-${nome}`)) ?? 'depois';
      const cor = getComputedStyle(atual).backgroundColor;
      atual.replaceWith(novo);
      // O fundo passa de uma cor à outra, em vez de trocar de uma vez
      if (!calmo.matches) novo.animate([{ backgroundColor: cor }, {}], { duration: 700, easing: 'ease-out' });
      // Passar de memória não enche o histórico: o voltar do aparelho sai do modo TV de uma vez
      history.replaceState(history.state, '', href);
      document.title = pagina.title;
      preparar();
      (palco()?.querySelector<HTMLElement>(`[data-palco-${focado}]`) ?? link('depois'))?.focus({ preventScroll: true });
    } catch {
      location.assign(href);
    }
  }

  // O que cada memória precisa ao chegar: "Passar sozinho" à vista, as vizinhas buscadas e o relógio
  function preparar() {
    const atual = palco();
    if (!atual) return;
    for (const nome of ['depois', 'antes']) {
      const vizinha = link(nome);
      if (serve(vizinha) && atual.classList.contains('palco--tv')) {
        buscar(vizinha.href)
          .then((pagina) => fotoPronta(pagina.querySelector<HTMLImageElement>('.palco__foto img')?.getAttribute('src')))
          .catch(() => undefined);
      }
    }
    const grupo = atual.querySelector<HTMLElement>('[data-palco-passar]');
    if (grupo) grupo.hidden = false;
    pausado = atual.hasAttribute('data-pausado');
    armar();
  }

  // Ligado: a próxima entra sozinha depois do tempo escolhido. Com a aba escondida, espera.
  function armar() {
    clearTimeout(relogio);
    const segundos = Number(palco()?.dataset.passar);
    if (segundos > 0 && !pausado && !document.hidden) relogio = window.setTimeout(() => passar(link('depois')), segundos * 1000);
  }

  // A pausa fica no endereço e segue para a memória seguinte: quem pausou e passa à mão continua pausado
  function alternarPausa(botao: HTMLButtonElement) {
    const atual = palco();
    if (!atual) return;
    pausado = !pausado;
    botao.textContent = pausado ? 'Retomar' : 'Pausar';
    botao.setAttribute('aria-pressed', String(pausado));
    atual.toggleAttribute('data-pausado', pausado);
    const levar = (endereco: string) => {
      const url = new URL(endereco, location.href);
      if (pausado) url.searchParams.set('pausa', '1');
      else url.searchParams.delete('pausa');
      return url.pathname + url.search;
    };
    history.replaceState(history.state, '', levar(location.href));
    for (const a of atual.querySelectorAll<HTMLAnchorElement>('a[data-palco-leva][href]')) {
      // Escolher um tempo retoma: esses links não levam a pausa
      if (!a.closest('.palco__tempos')) a.setAttribute('href', levar(a.href));
    }
    armar();
  }

  if (palco()) {
    document.addEventListener('keydown', (evento) => {
      if (evento.metaKey || evento.ctrlKey || evento.altKey || !palco()) return;
      if (evento.key === 'ArrowRight') passar(link('depois'));
      else if (evento.key === 'ArrowLeft') passar(link('antes'), true);
      else if (evento.key === 'Escape' && serve(link('sair'))) location.assign(link('sair')!.href);
    });
    document.addEventListener('click', (evento) => {
      const alvo = evento.target instanceof Element ? evento.target : null;
      const pausa = alvo?.closest<HTMLButtonElement>('[data-palco] [data-palco-pausa]');
      if (pausa) return alternarPausa(pausa);
      // Dentro do modo TV, todo link que continua nele troca no lugar: passar, escolher o tempo, parar
      const a = alvo?.closest<HTMLAnchorElement>('[data-palco].palco--tv a[href]');
      if (!a || evento.defaultPrevented || evento.button !== 0 || evento.metaKey || evento.ctrlKey || evento.shiftKey || evento.altKey) return;
      if (new URL(a.href).searchParams.get('ver') !== 'tv' || a.closest('.palco__faixa')) return;
      evento.preventDefault();
      passar(a, a.hasAttribute('data-palco-antes'));
    });
    document.addEventListener('visibilitychange', armar);
    preparar();
    // O foco começa em "Próxima": no controle da TV, o botão do meio já passa
    link('depois')?.focus({ preventScroll: true });
  }
</script>
