---
// O mural de fotos (docs/decisoes.md, "Explorar"): a caixa de fotografias aberta na mesa. Uma
// superfície só de fotos reveladas, de ponta a ponta; um toque abre a memória. Memória sem foto
// entra como cartão, na cor do tipo de momento.
//
// Decisões do Gui (17/11/2026, segunda rodada: com o ano como cabeçalho, o mural tinha virado uma
// segunda linha do tempo). A orientação mora em objetos que ficam entre as fotos, sem cabeçalho:
// - a década é um cartão no meio das fotos, no lugar de uma delas, na cor da família;
// - o ano é uma aba na primeira foto de cada ano, como a de um fichário;
// - na margem de cada foto vai só o título da memória, pequeno, na letra manuscrita;
// - no computador, ao passar o mouse, o verso da foto aparece ao lado, saindo de trás dela, como
//   uma dupla: um cartão do mesmo tamanho, com a data, o lugar, quem estava e quantos relatos. A
//   foto continua à vista, e o clique abre a memória (terceira rodada: a ficha pequena não funcionou);
// - quem está vendo escolhe o tamanho das fotos: pequenas, médias ou grandes.
// Nas ordens que não seguem a data ("Entraram por último" e "Mais contadas"), saem os cartões e as
// abas, e a ficha do verso passa a ser o lugar da data.
import Carimbo from '../visual/Carimbo.astro';
import Polaroid from '../visual/Polaroid.astro';
import type { Ordem, Tamanho } from '../../lib/explorar';
import { carimboDaData, estiloDoTipo, listaCurta, nomeDaDecada } from '../../lib/visual';

interface MemoriaDoMural {
  id: string;
  titulo: string;
  ano: number;
  mes: number | null;
  dia: number | null;
  aproximada: boolean;
  lugar: string | null;
  tipo: string;
  integrantes: string[];
  relatos: number;
  fotos: { chave: string; legenda: string | null }[];
}

interface Props {
  /** as memórias, já filtradas e na ordem pedida */
  memorias: MemoriaDoMural[];
  ordem: Ordem;
  tamanho: Tamanho;
  /** o nome de cada pessoa, como aparece na tela */
  nomeDe: (id: string) => string | undefined;
}

const { memorias, ordem, tamanho, nomeDe } = Astro.props;
const peloTempo = ordem === 'recentes' || ordem === 'antigas';
const decadaDe = (ano: number) => Math.floor(ano / 10) * 10;
const naDecada = (decada: number) => memorias.filter((m) => decadaDe(m.ano) === decada).length;
const cedo = new Set(memorias.slice(0, 8).map((m) => m.id));
// A primeira foto de cada ano leva a aba; a primeira de cada década vem depois do cartão dela
const itens = memorias.map((m, n) => {
  const anterior = memorias[n - 1];
  return {
    m,
    abreAno: peloTempo && anterior?.ano !== m.ano,
    abreDecada: peloTempo && (!anterior || decadaDe(anterior.ano) !== decadaDe(m.ano)) ? decadaDe(m.ano) : null,
    nomes: m.integrantes.map(nomeDe).filter((nome): nome is string => Boolean(nome)),
  };
});
---

<ul class="mural miolo" aria-label="Fotos das memórias" data-mural data-tamanho={tamanho}>
  {
    itens.map(({ m, abreAno, abreDecada, nomes }) => (
      <>
        {abreDecada !== null && (
          <li class="mural__decada" id={`decada-${abreDecada}`}>
            <p>
              <span class="rotulo">{nomeDaDecada(abreDecada).rotulo}</span>
              <strong data-letras={nomeDaDecada(abreDecada).numero.length}>{nomeDaDecada(abreDecada).numero}</strong>
              <span class="ficha">
                {naDecada(abreDecada)} {naDecada(abreDecada) === 1 ? 'memória' : 'memórias'}
              </span>
            </p>
          </li>
        )}
        <li class="mural__foto" style={estiloDoTipo(m.tipo)}>
          {abreAno && (
            <span class="mural__aba" aria-hidden="true">
              {m.ano}
            </span>
          )}
          <a href={`/memorias/${m.id}`}>
            <Polaroid id={m.id} fotos={m.fotos} legenda={m.titulo} alt="" monte={false} cedo={cedo.has(m.id)} tipo={m.tipo} />
            <span class="mural__verso">
              <Carimbo itens={[carimboDaData(m), m.lugar]} />
              {nomes.length > 0 && <span class="ficha">Com {listaCurta(nomes)}</span>}
              {m.relatos > 0 && (
                <span class="ficha suave">
                  {m.relatos} {m.relatos === 1 ? 'relato' : 'relatos'}
                </span>
              )}
            </span>
          </a>
        </li>
      </>
    ))
  }
</ul>

<script>
  // O verso sai para a direita da foto; perto da borda direita da tela, sai para a esquerda
  const mural = document.querySelector<HTMLElement>('[data-mural]');
  if (mural && matchMedia('(hover: hover) and (pointer: fine)').matches) {
    const acertar = (alvo: EventTarget | null) => {
      const item = alvo instanceof Element ? alvo.closest<HTMLElement>('.mural__foto') : null;
      const verso = item?.querySelector<HTMLElement>('.mural__verso');
      if (!item || !verso) return;
      const sobra = innerWidth - item.getBoundingClientRect().right;
      item.toggleAttribute('data-para-a-esquerda', sobra < verso.offsetWidth * 0.95);
    };
    mural.addEventListener('pointerover', (evento) => acertar(evento.target));
    mural.addEventListener('focusin', (evento) => acertar(evento.target));
  }
</script>
