---
// Os controles do Explorar (docs/decisoes.md, "Explorar"): a forma de ver, a família e, num lugar
// só, os filtros e a ordem. Cada controle tem nome e lugar fixo, um embaixo do outro, e não sai do
// lugar ao abrir (pedido do Gui, 16/11/2026). Tudo é link ou formulário comum: funciona sem script,
// e o que foi escolhido fica no endereço, para guardar ou mandar.
//
// Respostas do Gui ao QA de design de 17/11/2026: "Forma de ver" tem só as três formas que trocam no
// lugar, e "Modo TV" e "Me mostre uma memória" são saídas, ao lado, com seta (P34). No celular, as
// opções de cada controle ficam numa linha só, que rola para o lado (P32). Toda opção reserva a
// largura do negrito, para nenhuma mudar de lugar ao ser marcada (P37). O período é só "Do ano" e
// "Até o ano" (P35), e o fim do formulário leva ao resultado (P33).
import IconeDoTipo from '../visual/IconeDoTipo.astro';
import {
  FORMAS_NO_LUGAR,
  FORMAS_QUE_SAEM,
  NOMES_DAS_FORMAS,
  NOMES_DAS_ORDENS,
  NOMES_DOS_TAMANHOS,
  ORDENS,
  ORDEM_PADRAO,
  SEM_FILTRO,
  TAMANHOS,
  TAMANHO_PADRAO,
  acaoDeVerOResultado,
  alternarFamilia,
  enderecoDoExplorar,
  tamanhoNoEndereco,
  temFiltro,
  type Filtros,
  type Forma,
  type Tamanho,
} from '../../lib/explorar';
import { corDoNucleo, estiloDoTipo } from '../../lib/visual';

interface Opcao {
  id: string;
  nome: string;
}

interface Props {
  filtros: Filtros;
  forma: Forma;
  nucleos: Opcao[];
  tipos: Opcao[];
  pessoas: Opcao[];
  capitulos: Opcao[];
  temas: Opcao[];
  /** quantas memórias passam nos filtros, na forma de ver em uso */
  quantas: number;
  /** os filtros ligados, já escritos (resumoDosFiltros) */
  resumo: string[];
  /** a faixa de décadas vem logo abaixo: o nome dela, no celular, fica aqui */
  comDecadas?: boolean;
  /** no mural: o tamanho das fotos em uso */
  tamanho?: Tamanho;
}

const { filtros, forma, nucleos, tipos, pessoas, capitulos, temas, quantas, resumo, comDecadas = false, tamanho = TAMANHO_PADRAO } = Astro.props;
const verOResultado = acaoDeVerOResultado(quantas);
// O período tem um jeito só de ser dito: de um ano a outro. O endereço que chega com uma década
// (um link antigo) aparece nos dois campos, e a escolha seguinte já sai como intervalo.
const doAno = filtros.de ?? filtros.decada;
const ateOAno = filtros.ate ?? (filtros.decada === null ? null : filtros.decada + 9);
// O tamanho das fotos é do mural: acompanha os links e o formulário enquanto se está nele
const doMural = forma === 'mural' ? tamanhoNoEndereco(tamanho) : {};
// A família aceita mais de uma escolha: cada toque liga ou desliga só aquela
const ordemDasFamilias = nucleos.map((n) => n.id);
const filtrando = temFiltro({ ...filtros, familias: [] });
const semFiltros: Filtros = { ...SEM_FILTRO, familias: filtros.familias };
// Os grupos longos ficam recolhidos, e abrem sozinhos quando têm algo marcado
const grupos = [
  { nome: 'Quem estava junto', campo: 'pessoa', opcoes: pessoas, marcados: filtros.pessoas, dica: 'A memória precisa ter todas as pessoas marcadas.' },
  { nome: 'Capítulo', campo: 'capitulo', opcoes: capitulos, marcados: filtros.capitulos, dica: null },
  { nome: 'Tema', campo: 'tema', opcoes: temas, marcados: filtros.temas, dica: null },
].filter((g) => g.opcoes.length > 0);
---

<div class="controles">
  <div class="controle">
    <p class="controle__nome rotulo suave" id="controle-forma">Forma de ver</p>
    <div class="controle__linha">
      <nav class="linha__opcoes" aria-labelledby="controle-forma">
        {
          FORMAS_NO_LUGAR.map((f) => (
            <a href={enderecoDoExplorar(filtros, f, f === 'mural' ? tamanhoNoEndereco(tamanho) : {})} data-opcao={f} aria-current={f === forma ? 'page' : undefined}>
              <span class="opcao__texto" data-texto={NOMES_DAS_FORMAS[f]}>{NOMES_DAS_FORMAS[f]}</span>
            </a>
          ))
        }
      </nav>
      {/* As duas saídas: levam a outra tela, e por isso nunca ficam marcadas como a forma em uso */}
      <p class="controle__saidas">
        {
          FORMAS_QUE_SAEM.map((f) => (
            <a class="acao acao--quieta saida" href={enderecoDoExplorar(filtros, f)}>
              {NOMES_DAS_FORMAS[f]}
            </a>
          ))
        }
      </p>
    </div>
  </div>
  {
    nucleos.length > 0 && (
      <div class="controle">
        <p class="controle__nome rotulo suave" id="controle-familia">
          Família
        </p>
        {/* A família aceita mais de uma: cada opção é uma etiqueta, que acende na cor da família quando
            está marcada (decisão do Gui, 17/11/2026). "Família completa" é todas, e marcar as três
            volta sozinho a ela. */}
        <div class="controle__linha">
        <nav class="linha__opcoes linha__opcoes--etiquetas" aria-labelledby="controle-familia">
          <a href={enderecoDoExplorar({ ...filtros, familias: [] }, forma, doMural)} data-opcao="" data-familia="tudo" aria-current={filtros.familias.length === 0 ? 'page' : undefined}>
            <span class="opcao__texto" data-texto="Família completa">Família completa</span>
          </a>
          {nucleos.map((n) => (
            <a
              href={enderecoDoExplorar({ ...filtros, familias: alternarFamilia(filtros.familias, n.id, ordemDasFamilias) }, forma, doMural)}
              data-opcao={n.id}
              data-familia={corDoNucleo(n.id, ordemDasFamilias)}
              aria-current={filtros.familias.includes(n.id) ? 'true' : undefined}
            >
              <span class="opcao__texto" data-texto={n.nome}>{n.nome}</span>
            </a>
          ))}
        </nav>
        </div>
      </div>
    )
  }
  <div class="controle">
    <p class="controle__nome rotulo suave" id="controle-filtros">Filtros</p>
    {/* Fechado, o controle diz o que está ligado e a ordem; aberto, o formulário aparece logo abaixo dele */}
    <details class="filtros">
      <summary aria-labelledby="controle-filtros filtro-atual">
        <span id="filtro-atual" data-filtro-atual>
          {resumo.length > 0 ? resumo.join(' · ') : 'Nenhum filtro'} · {NOMES_DAS_ORDENS[filtros.ordem]}
        </span>
      </summary>
      <form class="filtros__form" method="get" action="/explorar" data-filtros>
        {forma !== 'linha' && <input type="hidden" name="ver" value={forma} />}
        {doMural.tamanho && <input type="hidden" name="tamanho" value={doMural.tamanho} />}
        {filtros.familias.map((id) => <input type="hidden" name="nucleo" value={id} />)}
        <fieldset class="filtros__grupo">
          <legend class="rotulo suave">Ordem</legend>
          <ul>
            {ORDENS.map((o) => (
              <li>
                <label class="escolha">
                  <input type="radio" name="ordem" value={o === ORDEM_PADRAO ? '' : o} checked={filtros.ordem === o} />
                  <span>{NOMES_DAS_ORDENS[o]}</span>
                </label>
              </li>
            ))}
          </ul>
        </fieldset>
        {
          tipos.length > 1 && (
            <fieldset class="filtros__grupo">
              <legend class="rotulo suave">Tipo de momento</legend>
              <ul>
                {tipos.map((t) => (
                  <li style={estiloDoTipo(t.id)}>
                    <label class="escolha">
                      <input type="checkbox" name="tipo" value={t.id} checked={filtros.tipos.includes(t.id)} />
                      <IconeDoTipo tipo={t.id} />
                      <span>{t.nome}</span>
                    </label>
                  </li>
                ))}
              </ul>
            </fieldset>
          )
        }
        <fieldset class="filtros__grupo">
          <legend class="rotulo suave">O que a memória tem</legend>
          <ul>
            <li>
              <label class="escolha">
                <input type="checkbox" name="foto" value="1" checked={filtros.comFoto} />
                <span>Foto</span>
              </label>
            </li>
            <li>
              <label class="escolha">
                <input type="checkbox" name="audio" value="1" checked={filtros.comAudio} />
                <span>Áudio</span>
              </label>
            </li>
          </ul>
        </fieldset>
        <fieldset class="filtros__grupo">
          <legend class="rotulo suave">Seus relatos</legend>
          <ul>
            <li>
              <label class="escolha">
                <input type="checkbox" name="contou" value="1" checked={filtros.contou} />
                <span>Você já contou</span>
              </label>
            </li>
            <li>
              <label class="escolha">
                <input type="checkbox" name="falta" value="1" checked={filtros.falta} />
                <span>Você estava e ainda não contou</span>
              </label>
            </li>
          </ul>
        </fieldset>
        <fieldset class="filtros__grupo filtros__grupo--periodo">
          <legend class="rotulo suave">Período</legend>
          <label class="campo">
            <span class="campo__rotulo">Do ano</span>
            <input class="campo__entrada" type="text" inputmode="numeric" pattern="[0-9]{4}" maxlength="4" name="de" value={doAno ?? ''} />
          </label>
          <label class="campo">
            <span class="campo__rotulo">Até o ano</span>
            <input class="campo__entrada" type="text" inputmode="numeric" pattern="[0-9]{4}" maxlength="4" name="ate" value={ateOAno ?? ''} />
          </label>
        </fieldset>
        {
          grupos.map((g) => (
            <details class="filtros__grupo filtros__grupo--longo" open={g.marcados.length > 0}>
              <summary>
                <span>
                  {g.nome}
                  {g.marcados.length > 0 && ` (${g.marcados.length})`}
                </span>
              </summary>
              {g.dica && <p class="ficha suave">{g.dica}</p>}
              <ul>
                {g.opcoes.map((o) => (
                  <li>
                    <label class="escolha">
                      <input type="checkbox" name={g.campo} value={o.id} checked={g.marcados.includes(o.id)} />
                      <span>{o.nome}</span>
                    </label>
                  </li>
                ))}
              </ul>
            </details>
          ))
        }
        <p class="filtros__acoes">
          <button class="botao sem-troca" type="submit">Mostrar memórias</button>
          {/* Com script cada escolha já valeu: o fim do formulário diz quantas memórias passam e leva
              a elas, fechando o painel. O texto muda a cada escolha, com a região. */}
          {verOResultado ? (
            <button class="botao so-com-troca" type="button" data-ver-resultado>
              {verOResultado}
            </button>
          ) : (
            <span class="so-com-troca">Nenhuma memória passa nesses filtros.</span>
          )}
          {
            filtrando && (
              <a class="acao acao--quieta" href={enderecoDoExplorar(semFiltros, forma, doMural)}>
                Limpar filtros
              </a>
            )
          }
        </p>
      </form>
    </details>
  </div>
  {
    forma === 'mural' && (
      <div class="controle">
        <p class="controle__nome rotulo suave" id="controle-tamanho">
          Fotos
        </p>
        <nav class="linha__opcoes linha__opcoes--curtas" aria-labelledby="controle-tamanho">
          {TAMANHOS.map((t) => (
            <a href={enderecoDoExplorar(filtros, forma, tamanhoNoEndereco(t))} data-opcao={t} data-tamanho-das-fotos={t} aria-current={t === tamanho ? 'page' : undefined}>
              <span class="opcao__texto" data-texto={NOMES_DOS_TAMANHOS[t]}>{NOMES_DOS_TAMANHOS[t]}</span>
            </a>
          ))}
        </nav>
      </div>
    )
  }
  {/* No celular o nome de cada controle fica em cima dele: o da faixa de décadas também */}
  {
    comDecadas && (
      <p class="controle__nome controle__nome--decadas rotulo suave" aria-hidden="true">
        Ir para a década
      </p>
    )
  }
</div>
