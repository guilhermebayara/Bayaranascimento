---
// Formulário de capítulo, em etapas. Serve para criar e para editar.
import CampoAno from './CampoAno.astro';
import QuemEstava from './QuemEstava.astro';
import { Familia } from '../lib/parentesco';
import { comArtigo } from '../lib/servidor/conteudo';
import { MESES } from '../lib/datas';
import { modoNoFormulario, type Capitulo } from '../lib/capitulos';
import { familiasDe, listarCapitulos, listarCasais, listarFiliacoes, listarIntegrantes, listarNucleos, listarTemasVisiveis } from '../lib/servidor/repositorio';

interface Props {
  capitulo?: Capitulo;
}

const { capitulo: c } = Astro.props;
const { usuario } = Astro.locals;
const todos = await listarCapitulos(usuario);
const temFilhos = Boolean(c) && todos.some((x) => x.dentroDe === c!.id);
// Só entra em outro quem não tem capítulos dentro, e só em capítulos que não estão dentro de ninguém
const maiores = temFilhos ? [] : todos.filter((x) => x.id !== c?.id && !x.dentroDe);
const todosOsNucleos = await listarNucleos();
const nucleos = todosOsNucleos.filter((n) => usuario.nucleos.includes(n.id) || c?.nucleos.includes(n.id));
// Só quem criou muda quem pode ver. Para os outros, as opções ficam travadas com o valor atual.
const travaQuemVe = Boolean(c) && c!.criadoPor !== usuario.pessoa;
const integrantes = await listarIntegrantes();
const quemCriou = travaQuemVe ? integrantes.find((i) => i.id === c!.criadoPor) : undefined;
// De quem é o capítulo por período: a mesma escolha de "Quem estava?" na memória, agrupada por família
const arvore = new Familia(await listarFiliacoes(), await listarCasais(usuario));
const porNome = [...integrantes].sort((a, b) => (a.apelido ?? a.nome).localeCompare(b.apelido ?? b.nome, 'pt-BR'));
const gruposDePessoas = [
  ...todosOsNucleos.map((n) => ({ nome: n.nome, ids: porNome.filter((i) => familiasDe(i)[0] === n.id).map((i) => i.id) })),
  { nome: 'De fora das famílias', ids: porNome.filter((i) => !familiasDe(i).some((f) => todosOsNucleos.some((n) => n.id === f))).map((i) => i.id) },
];
const proximos = Object.fromEntries(
  integrantes.map((i) => [
    i.id,
    [...new Set([...arvore.casais(i.id).map((x) => x.outro), ...arvore.pais(i.id).map((p) => p.responsavel), ...arvore.filhos(i.id).map((f) => f.filho), ...arvore.irmaos(i.id).map((x) => x.id)])],
  ]),
);
const temas = await listarTemasVisiveis(usuario);
const temasDoCapitulo = (c?.temas ?? []).map((id) => temas.find((t) => t.id === id)?.nome).filter(Boolean).join(', ');
const modo = modoNoFormulario(c);
const datas = [
  { prefixo: 'inicio', rotulo: 'Começou em', mes: 'Mês em que começou', data: c?.inicio, obrigatorio: true },
  { prefixo: 'fim', rotulo: 'Terminou em', mes: 'Mês em que terminou', data: c?.fim, obrigatorio: false },
];
---

<form class="formulario" method="post" action="/api/capitulos" data-ficha-capitulo>
  <input type="hidden" name="acao" value="salvar" />
  {c && <input type="hidden" name="id" value={c.id} />}

  <section data-etapa="O capítulo">
    <fieldset>
      <legend>O capítulo</legend>
      <label class="campo">
        <span>Título</span>
        <input type="text" name="titulo" required maxlength="120" autocomplete="off" value={c?.titulo ?? ''} placeholder="Ex.: Casamento da Giovanna e do Lucas Magno" />
      </label>
      <div class="campo">
        <span id="rotulo-modo">Como as memórias entram?</span>
        <div class="abas" role="radiogroup" aria-labelledby="rotulo-modo" data-modo>
          <label class="aba">
            <input type="radio" name="modo" value="reunido" checked={modo === 'reunido'} />
            <span>
              <strong>Reunido</strong>
              <small>Você escolhe as memórias. O período é calculado por elas. Ex.: um casamento, uma viagem.</small>
            </span>
          </label>
          <label class="aba">
            <input type="radio" name="modo" value="periodo" checked={modo === 'periodo'} />
            <span>
              <strong>Por período</strong>
              <small>A história de alguém, com começo e fim. Entram sozinhas as memórias do período com essas pessoas ou famílias. Ex.: a gravidez da Giovanna.</small>
            </span>
          </label>
          {/* Criar e editar uma época é só dos administradores (decisão do Gui, 16/11/2026) */}
          {usuario.admin && (
            <label class="aba">
              <input type="radio" name="modo" value="epoca" checked={modo === 'epoca'} />
              <span>
                <strong>Época</strong>
                <small>Um tempo da família inteira, com começo e fim. Tudo o que aconteceu no período entra sozinho. Ex.: a pandemia, os anos 90.</small>
              </span>
            </label>
          )}
        </div>
      </div>
      <div data-so-epoca hidden={modo === 'reunido'}>
        {
          datas.map((d) => (
            <div class="campo">
              <label for={`campo-${d.prefixo}`}>
                {d.rotulo} {!d.obrigatorio && <small>(deixe vazio se ainda não acabou)</small>}
              </label>
              <CampoAno id={`campo-${d.prefixo}`} nome={`${d.prefixo}Ano`} valor={d.data?.ano} obrigatorioNaEpoca={d.obrigatorio}>
                <select name={`${d.prefixo}Mes`} aria-label={d.mes}>
                  <option value="">Mês, se souber</option>
                  {MESES.map((m, n) => <option value={n + 1} selected={d.data?.mes === n + 1}>{m}</option>)}
                </select>
              </CampoAno>
            </div>
          ))
        }
        <div data-so-periodo hidden={modo !== 'periodo'}>
        <fieldset class="campo">
          <legend>De quem é este período?</legend>
          <p class="dica">Marque as famílias ou as pessoas. Entram só as memórias do período com elas.</p>
          <div class="opcoes" role="group" aria-label="Famílias">
            {todosOsNucleos.map((n) => (
              <label class="opcao">
                <input type="checkbox" name="familias" value={n.id} checked={c?.familias.includes(n.id)} />
                <span>Família {n.nome}</span>
              </label>
            ))}
          </div>
        </fieldset>
        <QuemEstava
          integrantes={integrantes}
          marcados={c?.pessoas ?? []}
          grupos={gruposDePessoas}
          proximos={proximos}
          eu={usuario.pessoa}
          legenda="Quais pessoas?"
          dica="Ao marcar alguém, a família dessa pessoa aparece como sugestão."
          cadastrar={false}
        />
        </div>
      </div>
      <label class="campo">
        <span>Texto de abertura <small>(opcional)</small></span>
        <textarea name="abertura" rows="5" maxlength="5000" placeholder="Algumas linhas que apresentam esse momento para quem chegar.">{c?.abertura ?? ''}</textarea>
      </label>
    </fieldset>
  </section>

  <section data-etapa="Onde se encaixa">
    <fieldset>
      <legend>Onde se encaixa</legend>
      <p class="dica">Tudo aqui é opcional.</p>
      {
        maiores.length > 0 && (
          <label class="campo">
            <span>Fica dentro de um capítulo maior?</span>
            <select name="dentroDe">
              <option value="">Não, é um capítulo solto</option>
              {maiores.map((m) => <option value={m.id} selected={c?.dentroDe === m.id}>{m.titulo}</option>)}
            </select>
            <span class="dica">Ex.: o chá de panela dentro do casamento. São no máximo dois níveis.</span>
          </label>
        )
      }
      {temFilhos && <p class="dica">Este capítulo tem outros dentro dele, então não pode entrar em um maior.</p>}
      <label class="campo">
        <span>Temas</span>
        <input type="text" name="temas" maxlength="500" autocomplete="off" list="temas-do-capitulo" value={temasDoCapitulo} placeholder="Ex.: relacionamentos, viagens" />
        <span class="dica">Etiquetas livres, separadas por vírgula, para ligar capítulos e memórias que têm a ver.</span>
      </label>
      <datalist id="temas-do-capitulo">
        {temas.map((t) => <option value={t.nome} />)}
      </datalist>
    </fieldset>
  </section>

  <section data-etapa="Quem vê">
    <fieldset>
      <legend>Quem pode ver?</legend>
      <p class="dica">Vale para o título e o texto de abertura. Cada memória dentro do capítulo continua com a visibilidade dela.</p>
      {travaQuemVe && <p class="dica">Só {quemCriou ? comArtigo(quemCriou) : 'quem criou'}, que criou o capítulo, muda quem pode ver.</p>}
      {travaQuemVe && <input type="hidden" name="visibilidade" value={c!.visibilidade} />}
      {travaQuemVe && c!.nucleos.map((n) => <input type="hidden" name="nucleos" value={n} />)}
      <label class="marcar">
        <input type="radio" name="visibilidade" value="todos" checked={(c?.visibilidade ?? 'todos') === 'todos'} disabled={travaQuemVe} />
        <span>Toda a família vê</span>
      </label>
      <label class="marcar">
        <input type="radio" name="visibilidade" value="nucleos" checked={c?.visibilidade === 'nucleos'} disabled={travaQuemVe} />
        <span>Só quem é das famílias marcadas abaixo</span>
      </label>
      {
        nucleos.length > 0 && (
          <div class="opcoes" role="group" aria-label="Famílias">
            {nucleos.map((n) => (
              <label class="opcao">
                <input type="checkbox" name="nucleos" value={n.id} checked={c?.nucleos.includes(n.id)} disabled={travaQuemVe} />
                <span>{n.nome}</span>
              </label>
            ))}
          </div>
        )
      }
    </fieldset>
  </section>

  <div class="acoes acoes--etapas">
    <button type="button" class="botao botao--leve" data-etapa-voltar>Voltar</button>
    <button type="button" class="botao" data-etapa-continuar>Continuar</button>
    <button type="submit" class="botao" data-so-no-fim={c ? undefined : ''}>{c ? 'Salvar capítulo' : 'Criar capítulo'}</button>
  </div>
</form>

<script>
  import { ligarCamposDeAno, montarEtapas } from '../lib/cliente/etapas';
  import { ligarQuemEstava } from '../lib/cliente/quem-estava';

  const form = document.querySelector<HTMLFormElement>('[data-ficha-capitulo]');
  if (form) {
    // As datas existem para a época e para o capítulo por período; "De quem é", só para o por período
    const epoca = form.querySelector<HTMLElement>('[data-so-epoca]')!;
    const periodo = form.querySelector<HTMLElement>('[data-so-periodo]')!;
    const aplicar = () => {
      const escolha = form.querySelector<HTMLInputElement>('input[name="modo"]:checked')?.value;
      const comDatas = escolha === 'epoca' || escolha === 'periodo';
      epoca.hidden = !comDatas;
      periodo.hidden = escolha !== 'periodo';
      for (const el of epoca.querySelectorAll<HTMLInputElement | HTMLSelectElement>('input, select')) {
        el.disabled = !comDatas || (escolha !== 'periodo' && periodo.contains(el));
        if ('obrigatorioNaEpoca' in el.dataset) (el as HTMLInputElement).required = comDatas;
      }
    };
    form.querySelector('[data-modo]')!.addEventListener('change', aplicar);
    aplicar();
    const quemE = form.querySelector<HTMLElement>('[data-quem-estava]');
    if (quemE) ligarQuemEstava(quemE);
    ligarCamposDeAno(form);
    montarEtapas(form);
  }
</script>
