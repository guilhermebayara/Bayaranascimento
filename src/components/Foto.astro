---
import { TIPOS, type TipoId } from '../data/tipos';

interface Props {
  foto: { chave: string; legenda: string | null };
  tipo: string;
  mostrarLegenda?: boolean;
}

const { foto, tipo, mostrarLegenda = true } = Astro.props;
const cor = TIPOS[tipo as TipoId]?.cor ?? 'var(--tinta)';
---

<figure class="foto" style={`--cor-tipo: ${cor}`}>
  <div class="foto__papel">
    {
      foto.chave ? (
        <img src={`/fotos/${foto.chave}`} alt={foto.legenda ?? ''} loading="lazy" decoding="async" />
      ) : (
        <div class="foto__reserva">Foto de exemplo</div>
      )
    }
  </div>
  {mostrarLegenda && foto.legenda && <figcaption>{foto.legenda}</figcaption>}
</figure>
