---
// A página de um formulário no visual novo (docs/visual.md, "Grupo 4: formularios"): o esqueleto,
// a abertura quieta (o rótulo, o título e uma frase), os recados que voltam do servidor e o que todo
// formulário precisa para funcionar: sem JavaScript, somem os botões que dependem dele e aparecem os
// blocos que ele mostraria; o que foi digitado volta quando o servidor recusa; e o botão do envio
// diz o que está acontecendo ("Salvando…"). Antes, isso morava no esqueleto antigo (Base.astro).
//
// O estilo é um só para todas as telas de formulário: src/visual/telas/formulario.css.
import '../../visual/telas/formulario.css';
import Visual from '../../layouts/Visual.astro';
import Recado from '../visual/Recado.astro';

interface Props {
  /** O título da página, grande, em serifa */
  titulo: string;
  /** O título da aba do navegador, quando é mais longo que o da página */
  aba?: string;
  /** A linha pequena acima do título: o que esta tela é ("Nova memória", "Capítulo") */
  rotulo?: string;
  /** Os núcleos do que está sendo editado: dão a cor da tela e a assinatura */
  nucleos?: string[];
  secao?: 'painel' | 'explorar' | 'capitulos' | 'arvore' | 'pessoas' | 'conta';
  /** Página de trabalho estreita (o padrão) ou larga, para listas e tabelas */
  larga?: boolean;
}

const { titulo, aba, rotulo, nucleos, secao, larga = false } = Astro.props;
// Recados deixados por formulários comuns, que voltam para a página com ?ok= ou ?erro=
const recadoOk = Astro.url.searchParams.get('ok');
const recadoErro = Astro.url.searchParams.get('erro');
---

<Visual titulo={aba ?? titulo} nucleos={nucleos} secao={secao}>
  <noscript>
    {/* Sem JavaScript: some o que só funciona com ele, e aparecem os blocos que ele mostraria conforme a escolha */}
    <style is:inline>
      [data-passo], .atalhos, [data-etapa-voltar], [data-etapa-continuar], [data-adicionar-pessoa], .botao--arquivo, [data-tirar-retrato], [data-confirmar-cancelar], [data-frase-data], [data-frase-abertura], [data-ao-lado] { display: none !important; }
      [data-para][hidden], [data-so-epoca][hidden], [data-so-periodo][hidden], [data-depende][hidden] { display: block !important; }
    </style>
  </noscript>
  <div class:list={['pagina-de-formulario', 'miolo', { 'pagina-de-formulario--larga': larga }]}>
    <header class="pagina-de-formulario__abre">
      {rotulo && <p class="rotulo suave">{rotulo}</p>}
      <h1 class="t-2">{titulo}</h1>
      <div class="pagina-de-formulario__frase suave">
        <slot name="abertura" />
      </div>
      {/* A frase com lacunas da abertura (Nova memória): quem usa decide se ela existe */}
      <slot name="frase" />
    </header>
    {recadoErro && <Recado erro>{recadoErro}</Recado>}
    {recadoOk && <Recado>{recadoOk}</Recado>}
    <slot />
  </div>
</Visual>

<script>
  import { guardarFormularios } from '../../lib/cliente/guardar-formulario';
  import { marcarEnvios } from '../../lib/cliente/enviando';

  marcarEnvios();

  // Depois dos scripts da página, para os campos devolvidos acertarem o que depende deles
  if (document.readyState === 'complete') guardarFormularios();
  else addEventListener('load', guardarFormularios, { once: true });
</script>
