---
// O slider de proximidade nos formulários (decisão do Gui, 18/11/2026; docs/decisoes.md, "Círculo"): o
// mesmo valor do círculo, com o desenho da peça Proximidade. O valor guardado continua o de sempre
// (src/lib/circulo.ts): o campo manda o lugar do slider, e o de quando a página abriu, para o servidor
// saber se a pessoa mexeu (o slider sempre tem um valor, e não mexer é não dizer).
import Proximidade from '../visual/Proximidade.astro';
import { lugarNoSlider } from '../../lib/circulo';

interface Props {
  /** o id do slider, único na página */
  id: string;
  /** o valor guardado (0 colado no centro, 100 fora do círculo) */
  valor: number;
  /** se "Fora do círculo" é opção; sem ela, o slider começa em Conhecido */
  comFora?: boolean;
  rotulo?: string;
  dica?: string;
}

const { id, valor, comFora = true, rotulo = 'Proximidade', dica } = Astro.props;
---

<div class="campo campo-proximidade">
  <Proximidade id={id} valor={valor} comFora={comFora} rotulo={rotulo} nome="posicao" descricao={dica ? `${id}-dica` : undefined} />
  <input type="hidden" name="posicaoAntes" value={lugarNoSlider(valor, comFora)} />
  {dica && <p class="dica" id={`${id}-dica`}>{dica}</p>}
</div>
