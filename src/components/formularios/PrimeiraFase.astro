---
// A primeira fase no cadastro do casal (guiado e "Adicionar casal"): "Como estão hoje?", só com o que é
// estar junto, no seletor segmentado (decisão do Gui, 18/11/2026: a escolha troca o que aparece embaixo,
// porque o namoro pergunta "Já é da família"), e quando começou, com mês e dia opcionais. O fim e o resto
// da história vêm depois, em "Adicionar o que aconteceu depois" (FasesDepois.astro), que troca a pergunta
// por "Como estavam?". Os campos são as linhas paralelas do cadastro (faseTipo, faseInicioAno...).
import CampoData from '../CampoData.astro';
import Segmentado from '../visual/Segmentado.astro';
import JaDaFamilia from './JaDaFamilia.astro';

interface Props {
  /** "guia" ou "novo": os ids da página */
  id: string;
}
const { id } = Astro.props;
const DE_HOJE = [
  { valor: 'namoro', texto: 'Namoro' },
  { valor: 'noivado', texto: 'Noivado' },
  { valor: 'casamento', texto: 'Casamento', atual: true },
  { valor: 'uniao', texto: 'União' },
];
---

<div class="campo primeira-fase" data-primeira-fase>
  <span id={`rotulo-fase-${id}`}>Como estão hoje?</span>
  <Segmentado rotulo="Como estão hoje" rotuloId={`rotulo-fase-${id}`} nome="faseTipo" opcoes={DE_HOJE} />
</div>
<CampoData prefixo="faseInicio" id={`${id}-fase-inicio`} rotuloAno="Começou em" />
<JaDaFamilia id={`ja-da-familia-${id}`} />

<script>
  // "Já é da família" só vale para o namoro de hoje: some, desmarcado, com outra escolha ou com uma fase depois
  for (const bloco of document.querySelectorAll<HTMLElement>('[data-primeira-fase]')) {
    const formulario = bloco.closest('form');
    const marca = formulario?.querySelector<HTMLElement>('[data-ja-da-familia]');
    if (!formulario || !marca) continue;
    const caixa = marca.querySelector<HTMLInputElement>('input[type="checkbox"]')!;
    const aplicar = () => {
      const tipo = bloco.querySelector<HTMLInputElement>('input:checked')?.value;
      const depois = [...formulario.querySelectorAll<HTMLSelectElement>('[data-fase-depois] select')].some((s) => s.value);
      marca.hidden = tipo !== 'namoro' || depois;
      if (marca.hidden) caixa.checked = false;
    };
    formulario.addEventListener('change', aplicar);
    formulario.addEventListener('fases-depois', aplicar);
    aplicar();
  }
</script>
