---
// O relato num campo só (observação do Gui depois da sessão H, 18/11/2026; conceito da sessão I, proposta A,
// "mensagem", escolhida pelo Gui): escrever e falar com o mesmo peso, na caixa de escrever de um aplicativo
// de conversa. Os áudios e as fotos entram como balões no alto da caixa, o texto cresce embaixo e, no pé,
// o "+" à esquerda abre o menu com o que se anexa (fotos desse dia, áudio do celular) e o microfone fica à
// direita, como no WhatsApp.
// O script dos áudios é o de sempre (src/lib/cliente/audios.ts), e o das fotos também
// (src/lib/cliente/fotos.ts): a marcação guarda os mesmos data-*. Sem script, fica só a caixa de texto:
// gravar e anexar dependem dele.
interface Props {
  transcricaoAutomatica: string;
  /** o nome do campo de texto no formulário */
  nome: string;
  texto: string;
  desabilitado?: boolean;
  /** o "+" oferece fotos desse dia (no relato de uma memória que já existe; na nova memória, as fotos têm etapa própria) */
  comFotos?: boolean;
}
const { transcricaoAutomatica, nome, texto, desabilitado = false, comFotos = false } = Astro.props;
---

<div class="relato-caixa" data-audios data-caixa-relato data-transcricao-automatica={transcricaoAutomatica}>
  <ol class="audios__lista relato-caixa__audios" data-lista-audios aria-label="Áudios do relato"></ol>
  <slot name="dentro" />
  <label class="so-leitor" for="relato-texto">O relato escrito</label>
  <textarea id="relato-texto" class="relato-caixa__texto" name={nome} rows="6" maxlength="20000" placeholder="Escreva como foi, ou toque no microfone e conte falando." disabled={desabilitado}>{texto}</textarea>
  <div class="relato-caixa__pe" data-pe-da-caixa hidden>
    <details class="menu-acoes relato-caixa__mais" data-menu-acoes>
      <summary class="menu-acoes__botao relato-caixa__mais-botao" aria-label="Anexar ao relato" title="Anexar">
        <svg class="icone" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14M5 12h14"></path></svg>
      </summary>
      <div class="menu-acoes__lista relato-caixa__mais-lista">
        {comFotos && (
          <button type="button" class="menu-acoes__item" data-anexar="fotos">
            Fotos desse dia
          </button>
        )}
        <button type="button" class="menu-acoes__item" data-anexar="audio">
          Áudio do celular
        </button>
      </div>
    </details>
    <input type="file" accept="audio/*,.opus,.ogg,.m4a,.mp3,.wav,.webm" multiple data-enviar-audio class="oculto-visualmente" tabindex="-1" aria-hidden="true" />
    <div class="gravador relato-caixa__gravador" data-gravador>
      <span class="gravador__texto" data-gravador-texto>Toque no microfone para gravar</span>
      <button type="button" class="gravador__cancelar" data-cancelar-gravacao hidden>Cancelar</button>
      <button type="button" class="gravador__botao" data-gravar aria-label="Gravar áudio">
        <svg class="gravador__mic" viewBox="0 0 24 24" aria-hidden="true">
          <rect x="9" y="3" width="6" height="11" rx="3"></rect>
          <path d="M5.5 11a6.5 6.5 0 0 0 13 0M12 17.5V21"></path>
        </svg>
        <svg class="gravador__parar" viewBox="0 0 24 24" aria-hidden="true">
          <rect x="7" y="7" width="10" height="10" rx="1.5"></rect>
        </svg>
      </button>
    </div>
  </div>
  <p class="gravador__dica dica relato-caixa__dica" data-gravador-dica hidden></p>
  <p class="situacao relato-caixa__situacao" data-situacao-audio role="status" aria-live="polite"></p>
</div>

<script>
  import { ligarMenus } from '../../lib/cliente/menus';

  for (const raiz of document.querySelectorAll<HTMLElement>('[data-caixa-relato]')) {
    // A caixa cresce com o texto. Onde o navegador já faz isso sozinho (field-sizing), o CSS cuida.
    const caixa = raiz.querySelector<HTMLTextAreaElement>('textarea')!;
    if (!CSS.supports('field-sizing', 'content')) {
      const crescer = () => {
        caixa.style.height = 'auto';
        caixa.style.height = `${caixa.scrollHeight}px`;
      };
      caixa.addEventListener('input', crescer);
      crescer();
    }
    // O "+": cada opção abre a escolha de arquivo do aparelho e fecha o menu
    const mais = raiz.querySelector<HTMLDetailsElement>('.relato-caixa__mais');
    ligarMenus(raiz);
    for (const opcao of raiz.querySelectorAll<HTMLButtonElement>('[data-anexar]')) {
      opcao.addEventListener('click', () => {
        const qual = opcao.dataset.anexar === 'fotos' ? '[data-escolher-fotos]' : '[data-enviar-audio]';
        raiz.querySelector<HTMLInputElement>(qual)?.click();
        if (mais) mais.open = false;
      });
    }
  }
</script>
