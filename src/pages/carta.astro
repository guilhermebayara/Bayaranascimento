---
// A carta de Natal, depois da primeira visita: o link discreto do painel leva até aqui.
import '../visual/telas/painel.css';
import Visual from '../layouts/Visual.astro';
import Carta from '../components/Carta.astro';
import Vazio from '../components/visual/Vazio.astro';
import { listarIntegrantes, listarMemorias, obterCarta } from '../lib/servidor/repositorio';

const { usuario } = Astro.locals;
const carta = await obterCarta();
const eu = (await listarIntegrantes()).find((i) => i.id === usuario.pessoa);
// As fotos que acompanham a carta: as mais recentes em que a pessoa aparece, entre as que ela vê
const fotos = carta
  ? (await listarMemorias(usuario)).filter((m) => m.situacao === 'publicada' && m.integrantes.includes(usuario.pessoa) && m.fotos.length > 0).reverse().slice(0, 3)
  : [];
---

<Visual titulo="Carta de Natal" secao="painel" familia="tudo">
  {
    carta && eu ? (
      <Carta para={usuario.nome} carta={carta} fotos={fotos} acao={{ href: '/', texto: 'Voltar ao início', quieta: true }}>
        {usuario.admin && (
          <a class="acao acao--quieta" href="/admin/carta">
            Editar a carta
          </a>
        )}
      </Carta>
    ) : (
      <div class="miolo carta__vazia">
        <Vazio frase="A carta ainda não foi escrita.">
          <p>
            <a class="acao" href="/">
              Voltar ao início
            </a>
            {usuario.admin && (
              <a class="acao" href="/admin/carta">
                Escrever a carta
              </a>
            )}
          </p>
        </Vazio>
      </div>
    )
  }
</Visual>
