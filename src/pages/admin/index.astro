---
// A Administração em página própria (decisão do Gui, 18/11/2026: ela saiu de "Sua conta", que fica igual
// para todos). Só os administradores chegam aqui; para os outros, a página não existe. O cartão é o da
// proposta A do conceito da sessão H (escolha do Gui, 18/11/2026; registro em docs/visual/conceito-h/):
// os atalhos em grupos por tema, cada grupo uma linha que abre e fecha, uma por vez, e no alto "Tudo em
// dia" ou o sinal das pendências, que abre a lista delas por cima. Os endereços antigos da seção (as
// âncoras de "Sua conta") chegam aqui pelo script de /conta. As regras estão em src/lib/conta.ts; os
// dados, em montarAdministracao (src/lib/servidor/conta.ts).
import '../../visual/telas/painel.css';
import '../../visual/telas/conta.css';
import Visual from '../../layouts/Visual.astro';
import { FRASE_DA_COPIA_DO_ACERVO, GRUPO_DO_ESPACO, contaDePendencias, grupoDaPendencia, gruposDaAdministracao, fraseDaCopiaMensal, idDoGrupo, porcentoDoBanco, resumoDoGrupo } from '../../lib/conta';
import { LIMITE_DO_PLANO } from '../../lib/tamanho-do-banco';
import { comArtigo, juntarNomes } from '../../lib/servidor/conteudo';
import { montarAdministracao } from '../../lib/servidor/conta';
import { listarIntegrantes } from '../../lib/servidor/repositorio';

const { usuario } = Astro.locals;
const adm = await montarAdministracao(usuario);
if (!adm) return new Response('Página não encontrada', { status: 404 });

// "Só você, a Giovanna e o Lucas Magno veem esta página": os administradores, com quem olha primeiro
const quemVe = juntarNomes(['você', ...(await listarIntegrantes()).filter((i) => i.admin && i.id !== usuario.pessoa).map(comArtigo)]);
// "Baixar cópia do acervo" baixa um arquivo: fica à parte dos links que abrem página, junto do tamanho do banco (P153)
const paginasDaAdministracao = adm.administracao.filter((item) => !item.baixar);
const copias = adm.administracao.filter((item) => item.baixar);
const { pendencias, situacao } = adm;
const pendenciaDo = (tipo: string) => pendencias.find((p) => p.tipo === tipo);
// Os atalhos em grupos por tema, cada um numa lista de linhas (observação do Gui, 18/11/2026)
const grupos = gruposDaAdministracao(paginasDaAdministracao);
const bancoPorcento = situacao.banco ? porcentoDoBanco(situacao.banco.bytes, LIMITE_DO_PLANO) : 0;
const copiaMensal = fraseDaCopiaMensal(situacao.copiaMensal, adm.hoje);
---

<Visual titulo="Administração" secao="administracao">
  <div class="admin miolo">
    <header class="admin__abre">
      <p class="rotulo suave">{quemVe === 'você' ? 'Só você vê esta página' : `Só ${quemVe} veem esta página`}</p>
      <h1 class="t-1">Administração</h1>
    </header>

    <section class="cartao conta__admin admin__cartao" aria-label="Atalhos e situação do acervo">
      {/* Proposta A do conceito da sessão H (escolha do Gui, 18/11/2026): cada grupo é uma linha que abre e
          fecha, uma por vez, como no painel da árvore; o sinal do alto abre, por cima, a lista das pendências */}
      <div class="conta__admin-alto">
        {pendencias.length > 0 ? (
          <details class="conta__sinal" data-menu-acoes>
            <summary class="conta__pendencias ficha">{contaDePendencias(pendencias.length)}</summary>
            <div class="conta__balao">
              <p class="rotulo suave">O que pede você</p>
              <ul>
                {pendencias.map((p) => (
                  <li>
                    <a class="menu-acoes__item" href={p.href ?? `#${idDoGrupo(grupoDaPendencia(p))}`} data-abre-grupo={p.href ? undefined : idDoGrupo(grupoDaPendencia(p))}>
                      <strong>{p.texto}</strong>
                      <span class="ficha suave">em {grupoDaPendencia(p)}</span>
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          </details>
        ) : (
          <span class="ficha suave">Tudo em dia</span>
        )}
      </div>
      {grupos.map((grupo) => {
        const marcadas = pendencias.filter((p) => grupoDaPendencia(p) === grupo.titulo).length;
        return (
          <details class="conta__grupo" name="administracao" id={idDoGrupo(grupo.titulo)}>
            <summary>
              <span class="conta__grupo-nome">{grupo.titulo}</span>
              <span class:list={['ficha', marcadas ? 'conta__pendente' : 'suave']}>{resumoDoGrupo(grupo.itens.length, marcadas)}</span>
            </summary>
            <ul>
              {grupo.itens.map((item) => (
                <li>
                  <a class:list={['conta__atalho', { 'conta__atalho--pendente': item.pendencia }]} href={item.href}>
                    <strong>{item.rotulo}</strong>
                    {item.situacao && <span class="ficha">{item.situacao}</span>}
                  </a>
                </li>
              ))}
            </ul>
          </details>
        );
      })}
      {(() => {
        const marcadas = pendencias.filter((p) => grupoDaPendencia(p) === GRUPO_DO_ESPACO).length;
        return (
          <details class="conta__grupo" name="administracao" id={idDoGrupo(GRUPO_DO_ESPACO)}>
            <summary>
              <span class="conta__grupo-nome">{GRUPO_DO_ESPACO}</span>
              <span class:list={['ficha', marcadas ? 'conta__pendente' : 'suave']}>{marcadas ? contaDePendencias(marcadas) : adm.banco ? `banco em ${bancoPorcento}%` : 'tudo certo'}</span>
            </summary>
            <div class="conta__banco">
              <div class="conta__medidores">
                {adm.banco && (
                  <div class:list={['conta__medidor', { 'conta__medidor--aviso': adm.bancoEmAviso }]}>
                    <p class="conta__banco-linha">
                      <strong>Banco do acervo</strong>
                      <span class="ficha">{adm.banco}</span>
                    </p>
                    <div class="conta__medida" role="img" aria-label={`Banco: ${adm.banco}`}>
                      <span style={`width: ${bancoPorcento}%`} />
                    </div>
                    {adm.bancoEmAviso && <p class="conta__nota">Perto do limite do plano gratuito. A saída combinada é o plano Workers Paid.</p>}
                  </div>
                )}
                {adm.espaco && (
                  <div class:list={['conta__medidor', { 'conta__medidor--aviso': adm.espaco.emAviso }]}>
                    <p class="conta__banco-linha">
                      <strong>Fotos e áudios</strong>
                      <span class="ficha">{adm.espaco.frase}</span>
                    </p>
                    <div class="conta__medida" role="img" aria-label={`Fotos e áudios: ${adm.espaco.frase}`}>
                      <span style={`width: ${adm.espaco.porcento}%`} />
                    </div>
                    {adm.espaco.emAviso && <p class="conta__nota">Perto do limite do plano gratuito, que soma a produção, a homologação e as prévias.</p>}
                    {adm.espaco.nota && <p class="conta__nota ficha">{adm.espaco.nota}</p>}
                  </div>
                )}
              </div>
              <div class="conta__copias">
                {copiaMensal && <p class:list={['conta__nota', 'ficha', { conta__pendente: Boolean(pendenciaDo('copia')) }]}>{copiaMensal}</p>}
                {copias.map((copia) => (
                  <a class="acao" href={copia.href} download>
                    {copia.rotulo}
                  </a>
                ))}
                {copias.length > 0 && <p class="conta__nota">{FRASE_DA_COPIA_DO_ACERVO}</p>}
              </div>
            </div>
          </details>
        );
      })()}
    </section>
  </div>
</Visual>

<script>
  // O balão das pendências (Esc, toque fora) e a pendência sem página própria, que abre o grupo dela
  import { ligarMenus } from '../../lib/cliente/menus';
  ligarMenus();
  // Quem chega pelo endereço de um grupo (/admin#espaco-e-copias, ou uma âncora antiga de "Sua conta") o encontra aberto
  const doEndereco = location.hash && document.getElementById(decodeURIComponent(location.hash.slice(1)));
  if (doEndereco instanceof HTMLDetailsElement) doEndereco.open = true;
  document.addEventListener('click', (e) => {
    const link = (e.target as HTMLElement).closest<HTMLAnchorElement>('[data-abre-grupo]');
    const grupo = link && (document.getElementById(link.dataset.abreGrupo!) as HTMLDetailsElement | null);
    if (!link || !grupo) return;
    e.preventDefault();
    link.closest<HTMLDetailsElement>('details[data-menu-acoes]')!.open = false;
    grupo.open = true;
    grupo.querySelector('summary')?.focus();
  });
</script>
