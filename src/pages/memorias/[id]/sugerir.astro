---
// Sugerir uma correção (onda 2, decisão do Gui de 17/11/2026): dos dados da memória, para quem a criou, ou
// um recado a quem registrou um relato. Ninguém muda a memória ou o relato de outra pessoa: quem recebe
// decide. Regras em src/lib/sugestoes.ts e permissoes.ts; a rota é /api/sugestoes.
import Pagina from '../../../components/formularios/Pagina.astro';
import CampoAno from '../../../components/CampoAno.astro';
import { formatarData } from '../../../lib/datas';
import { destinatarios } from '../../../lib/sugestoes';
import { podeSugerirDados, veORelato } from '../../../lib/servidor/permissoes';
import { listarIntegrantesQueVe, listarRelatos, obterMemoria, pessoasQueONaoVe, pessoasQueSoVoceVe } from '../../../lib/servidor/repositorio';

const { usuario } = Astro.locals;
const memoria = await obterMemoria(usuario, Astro.params.id ?? '');
if (!memoria || memoria.situacao !== 'publicada') return new Response('Memória não encontrada', { status: 404 });
const [visiveis, soDela, naoVe] = await Promise.all([listarIntegrantesQueVe(usuario), pessoasQueSoVoceVe(usuario), pessoasQueONaoVe(usuario)]);
const nome = (id: string) => visiveis.find((i) => i.id === id)?.apelido ?? visiveis.find((i) => i.id === id)?.nome ?? id;
const dados = podeSugerirDados(usuario, memoria).ok;
// Os relatos de outras pessoas, para o recado: só os que quem olha vê
const relatos = (await listarRelatos(usuario, memoria.id)).filter((r) => r.situacao === 'publicada' && r.registradoPor !== usuario.pessoa && veORelato(r, usuario, naoVe));
const quemEstava = memoria.integrantes.filter((id) => !naoVe.has(id));
// Quem chega pelo menu de um relato ("Deixar um recado para Fulano") encontra esse relato já escolhido
const relatoPedido = relatos.find((r) => r.id === Number(Astro.url.searchParams.get('relato')))?.id;
// A sugestão de dados vai para quem criou e para quem está na memória (resposta do Gui à sessão F)
const recebem = destinatarios({ tipo: 'dados', para: memoria.criadaPor, de: usuario.pessoa }, memoria).filter((id) => !naoVe.has(id)).map(nome);
const paraQuem = recebem.length > 1 ? `${recebem.slice(0, -1).join(', ')} e ${recebem[recebem.length - 1]}` : (recebem[0] ?? nome(memoria.criadaPor));
// Quem pode entrar: quem quem sugere vê, que ainda não está, e que não existe só para ela
const podemEntrar = visiveis.filter((i) => !memoria.integrantes.includes(i.id) && !soDela.has(i.id)).sort((a, b) => a.nome.localeCompare(b.nome, 'pt-BR'));
const MESES = ['janeiro', 'fevereiro', 'março', 'abril', 'maio', 'junho', 'julho', 'agosto', 'setembro', 'outubro', 'novembro', 'dezembro'];
const deQuem = (r: (typeof relatos)[number]) => (r.por === r.registradoPor ? nome(r.por) : `${nome(r.por)}, registrado por ${nome(r.registradoPor)}`);
---

<Pagina titulo="Sugerir uma correção" aba={`Sugerir uma correção em ${memoria.titulo}`} rotulo="Memória" nucleos={memoria.nucleos} secao="explorar">
  <Fragment slot="abertura">
    <p>
      <a href={`/memorias/${memoria.id}`}>{memoria.titulo}</a>, {formatarData(memoria)}{memoria.lugar && `, em ${memoria.lugar}`}.
    </p>
    <p>Ninguém muda o que outra pessoa registrou: quem recebe a sugestão decide se aceita, recusa ou responde.</p>
  </Fragment>

  {
    dados && (
      <section class="painel">
        <h2>Os dados da memória</h2>
        <p class="dica">Preencha só o que mudaria. Vai para {paraQuem}, que podem corrigir a memória; o primeiro que responder decide.</p>
        <form class="formulario" method="post" action="/api/sugestoes">
          <input type="hidden" name="acao" value="sugerir-dados" />
          <input type="hidden" name="memoria" value={memoria.id} />
          <div class="em-linha" role="group" aria-label="Quando foi">
              <div class="em-linha__campo">
                <label for="sugestao-ano">Em que ano foi</label>
                <CampoAno id="sugestao-ano" nome="ano" />
              </div>
              <label class="campo em-linha__campo">
                <span>Mês <small>(se souber)</small></span>
                <select name="mes">
                  <option value="">Não sei</option>
                  {MESES.map((m, n) => <option value={n + 1}>{m}</option>)}
                </select>
              </label>
          </div>
          <label class="campo">
            <span>Onde foi</span>
            <input type="text" name="lugar" maxlength="120" placeholder={memoria.lugar ?? 'Ex.: Belo Horizonte'} />
          </label>
          <div class="sugerir__quem" role="group" aria-label="Quem estava">
            <label class="campo">
              <span>Faltou alguém?</span>
              <select name="entram" data-busca-sugestao>
                <option value="">Escreva o nome</option>
                {podemEntrar.map((i) => <option value={i.id}>{i.nome}</option>)}
              </select>
            </label>
            {quemEstava.length > 0 && (
              <div class="campo">
                <span>Alguém não estava?</span>
                <div class="opcoes">
                  {quemEstava.map((id) => (
                    <label class="opcao">
                      <input type="checkbox" name="saem" value={id} />
                      <span>{nome(id)}</span>
                    </label>
                  ))}
                </div>
              </div>
            )}
          </div>
          <label class="campo">
            <span>Por quê? <small>(opcional)</small></span>
            <textarea name="texto" rows="3" maxlength="2000" placeholder="Ex.: acho que foi em 1998, no ano em que a Vó mudou"></textarea>
          </label>
          <div class="acoes">
            <button class="botao" type="submit">Enviar a sugestão</button>
          </div>
        </form>
      </section>
    )
  }

  {
    relatos.length > 0 && (
      <section class="painel" id="recado">
        <h2>Um recado sobre um relato</h2>
        <p class="dica">Vai só para quem escreveu ou registrou o relato. O relato continua como está.</p>
        <form class="formulario" method="post" action="/api/sugestoes">
          <input type="hidden" name="acao" value="recado" />
          <input type="hidden" name="memoria" value={memoria.id} />
          {relatos.length === 1 ? (
            <input type="hidden" name="relato" value={relatos[0]!.id} />
          ) : (
            <div class="campo">
              <span id="rotulo-recado-relato">Sobre o relato de</span>
              <div class="opcoes" role="radiogroup" aria-labelledby="rotulo-recado-relato">
                {relatos.map((r, n) => (
                  <label class="opcao">
                    <input type="radio" name="relato" value={r.id} checked={relatoPedido ? r.id === relatoPedido : n === 0} />
                    <span>{deQuem(r)}</span>
                  </label>
                ))}
              </div>
            </div>
          )}
          <label class="campo">
            <span>{relatos.length === 1 ? `Recado sobre o relato de ${deQuem(relatos[0]!)}` : 'Recado'}</span>
            <textarea name="texto" rows="4" maxlength="2000" required placeholder="Ex.: acho que foi em 1998"></textarea>
          </label>
          <div class="acoes">
            <button class="botao" type="submit">Enviar o recado</button>
          </div>
        </form>
      </section>
    )
  }
  {!dados && relatos.length === 0 && <p class="dica">Esta memória é sua e não tem relato de outra pessoa: corrija direto em <a href={`/nova?id=${memoria.id}`}>Corrigir esta memória</a>.</p>}
</Pagina>

<script>
  import { buscaDePessoa } from '../../../lib/cliente/busca-pessoa';
  const lista = document.querySelector<HTMLSelectElement>('[data-busca-sugestao]');
  if (lista) buscaDePessoa(lista);
</script>
