---
// Escrever meu relato, como conversa (escolha do Gui depois da sessão I, 18/11/2026; regras em
// src/lib/conversa.ts). À esquerda, a janela de escrever: cada envio vira uma mensagem, gravada na hora.
// O relato nasce rascunho e entra na memória com "Publicar relato"; depois, cada mensagem nova entra na
// hora. Ao lado, no computador (embaixo, no celular), os relatos dos outros, como estão na memória, com
// "Citar" em cada mensagem: a citação vai no relato de quem cita.
import Pagina from '../../../components/formularios/Pagina.astro';
import Janela from '../../../components/conversa/Janela.astro';
import Voz from '../../../components/conversa/Voz.astro';
import { formatarData, jaFaleceu } from '../../../lib/datas';
import { resumoDaMensagem } from '../../../lib/conversa';
import { enderecoDoRetrato } from '../../../lib/retratos';
import { coresDasPessoas } from '../../../lib/familias';
import { pessoasComAcesso } from '../../../lib/servidor/acesso';
import { conversaDosRelatos } from '../../../lib/servidor/conversa';
import { donoDoRelato, veORelato } from '../../../lib/servidor/permissoes';
import { situacaoDaTranscricaoAgora } from '../../../lib/servidor/transcricao';
import {
  familiasDe,
  listarCasais,
  listarFotosDoRelato,
  listarIntegrantes,
  listarIntegrantesQueVe,
  listarNucleos,
  listarRelatos,
  nomesDasPessoasExcluidas,
  obterMemoria,
  obterMensagem,
  obterRelato,
  pessoasQueONaoVe,
} from '../../../lib/servidor/repositorio';

const { usuario } = Astro.locals;
const memoria = await obterMemoria(usuario, Astro.params.id ?? '');
if (!memoria) return new Response('Memória não encontrada', { status: 404 });
if (memoria.situacao === 'rascunho') return Astro.redirect(`/nova?id=${memoria.id}`);

const integrantes = await listarIntegrantes();
const nomesNaLixeira = await nomesDasPessoasExcluidas();
const achar = (id: string) => integrantes.find((i) => i.id === id);
const nome = (id: string) => achar(id)?.apelido ?? achar(id)?.nome ?? nomesNaLixeira.get(id) ?? 'Alguém';
const ordemDosNucleos = (await listarNucleos()).map((n) => n.id);
const retratoDe = (id: string) => (achar(id)?.retrato ? enderecoDoRetrato(achar(id)!.retrato!) : null);
const corDe = coresDasPessoas(integrantes, await listarCasais(usuario), ordemDosNucleos);
const familiaDe = (id: string) => (achar(id) ? corDe(id) : undefined);

// Em nome de quem dá para escrever: a própria pessoa e quem não acessa o site, entre quem ela vê (C1)
const visiveis = await listarIntegrantesQueVe(usuario);
const comAcesso = await pessoasComAcesso();
const semAcesso = visiveis.filter((i) => i.tipo === 'pessoa' && !comAcesso.has(i.id) && i.id !== usuario.pessoa);
const pedido = Astro.url.searchParams.get('por');
const por = pedido && semAcesso.some((p) => p.id === pedido) ? pedido : usuario.pessoa;
const opcoes = [{ id: usuario.pessoa, rotulo: `Eu, ${usuario.nome}` }, ...semAcesso.map((p) => ({ id: p.id, rotulo: `${p.nome}, e eu estou escrevendo` }))];

const existente = await obterRelato(memoria.id, por, usuario);
const bloqueado = Boolean(existente) && donoDoRelato(existente!) !== usuario.pessoa;
const relatos = await listarRelatos(usuario, memoria.id);
const quemRegistrou = bloqueado && relatos.some((r) => r.id === existente!.id) ? nome(donoDoRelato(existente!)) : undefined;
const publicado = existente?.situacao === 'publicada' && !bloqueado;

// Os relatos dos outros, publicados, como na memória (quem contou primeiro antes)
const dosOutros = relatos.filter((r) => r.situacao === 'publicada' && r.id !== existente?.id);
const fotosDoMeu = existente && !bloqueado ? await listarFotosDoRelato(existente.id) : [];
const fotos = [...memoria.fotos, ...fotosDoMeu.filter((f) => !memoria.fotos.some((m) => m.id === f.id))];
const conversa = await conversaDosRelatos([...(existente && !bloqueado ? [existente] : []), ...dosOutros], fotos, nome, undefined, relatos);
const minhas = existente && !bloqueado ? (conversa.get(existente.id) ?? []) : [];

// "Citar", vindo da memória: só uma mensagem publicada de outra pessoa, nesta memória, que quem escreve vê
const pedidoDeCitacao = Number(Astro.url.searchParams.get('cita')) || 0;
let citando: { id: number; quem: string; resumo: string } | null = null;
if (pedidoDeCitacao && !bloqueado) {
  const citada = await obterMensagem(pedidoDeCitacao);
  if (citada && citada.memoriaId === memoria.id && citada.situacao === 'publicada' && citada.relatoId !== existente?.id && veORelato(citada, usuario, await pessoasQueONaoVe(usuario))) {
    citando = { id: citada.id!, quem: nome(citada.por), resumo: resumoDaMensagem(citada) };
  }
}
const transcricaoAutomatica = await situacaoDaTranscricaoAgora();
---

<Pagina titulo="Meu relato" aba={`Relato: ${memoria.titulo}`} rotulo="Relato" nucleos={memoria.nucleos} secao="explorar" larga>
  <p slot="abertura">
    <a href={`/memorias/${memoria.id}`}>{memoria.titulo}</a>, {formatarData(memoria)}. Conte como você lembra desse momento: um texto, um áudio ou uma foto por vez, na ordem que vierem.
  </p>

  <div class="relato-conversa">
    <section class="janela-do-relato" aria-labelledby="titulo-seu-relato">
      <h2 class="rotulo suave" id="titulo-seu-relato">{por === usuario.pessoa ? 'Seu relato' : `O relato de ${nome(por)}`}</h2>

      {
        bloqueado ? (
          <p class="recado">Esse relato já foi registrado por {quemRegistrou ?? 'outra pessoa'}, e só quem registrou pode alterar.</p>
        ) : (
          <Janela modo="ao-vivo" memoria={memoria.id} por={por} mensagens={minhas} publicado={publicado} transcricaoAutomatica={transcricaoAutomatica} comFotos citando={citando}>
            <p class="relato-conversa__acoes">
              {!publicado && (
                <button type="submit" class="botao" name="situacao" value="publicada" data-publicar>
                  Publicar relato
                </button>
              )}
              <a class={publicado ? 'botao' : 'acao'} href={`/memorias/${memoria.id}${existente ? `#relato-${existente.id}` : ''}`}>
                Voltar para a memória
              </a>
            </p>
          </Janela>
        )
      }

      {/* Quem está contando: quase sempre quem escreve. A linha recolhida fica depois da janela e abre a
          escolha; trocar abre o relato daquela pessoa (resposta do Gui à P137 do QA de design, 17/11/2026) */}
      {
        semAcesso.length > 0 && (
          <details class="mais-opcoes" data-outra-pessoa open={por !== usuario.pessoa}>
            <summary>Estou escrevendo por outra pessoa</summary>
            <form method="get" class="em-linha" data-quem-conta>
              <label class="campo">
                <span>Quem está contando</span>
                <select name="por">
                  {opcoes.map((o) => (
                    <option value={o.id} selected={o.id === por}>
                      {o.rotulo}
                    </option>
                  ))}
                </select>
              </label>
              <button class="acao" type="submit" data-trocar-sem-script>
                Abrir o relato
              </button>
            </form>
          </details>
        )
      }

    </section>

    {
      dosOutros.length > 0 && (
        <section class="relato-conversa__memoria" aria-labelledby="titulo-na-memoria">
          <h2 class="rotulo suave" id="titulo-na-memoria">
            Na memória
          </h2>
          <p class="dica">Toque em "Citar" para responder a uma mensagem no seu relato. A citação fica no seu relato.</p>
          <div class="voz-fio">
            {dosOutros.map((r) => (
              <Voz nome={nome(r.por)} retrato={retratoDe(r.por)} familia={familiaDe(r.por)} falecido={Boolean(achar(r.por) && jaFaleceu(achar(r.por)!))} registradoPor={r.registradoPor !== r.por ? nome(r.registradoPor) : null} mensagens={conversa.get(r.id) ?? []} minha={r.por === usuario.pessoa} citarEm={bloqueado ? undefined : `/memorias/${memoria.id}/relato?${por !== usuario.pessoa ? `por=${por}&` : ''}cita=`} />
            ))}
          </div>
        </section>
      )
    }
  </div>

  <div class="confirmacao" data-confirmacao hidden>
    <h2>Relato publicado</h2>
    <p>Ele já aparece na página da memória. Se lembrar de mais alguma coisa, é só voltar e mandar.</p>
    <p>
      <a class="botao" href={`/memorias/${memoria.id}`} data-ir-para-memoria>Voltar para a memória</a>
    </p>
  </div>
</Pagina>

<script>
  import { buscaDePessoa } from '../../../lib/cliente/busca-pessoa';
  import { ligarConversa } from '../../../lib/cliente/conversa';

  // Quem está contando: escolher abre o relato daquela pessoa
  const quemConta = document.querySelector<HTMLFormElement>('[data-quem-conta]');
  if (quemConta) {
    const select = quemConta.querySelector<HTMLSelectElement>('select[name="por"]')!;
    buscaDePessoa(select);
    quemConta.querySelector<HTMLElement>('[data-trocar-sem-script]')!.hidden = true;
    select.addEventListener('change', () => quemConta.requestSubmit());
    const linha = document.querySelector<HTMLDetailsElement>('[data-outra-pessoa]')!;
    // Fechar a linha volta para "Eu"
    linha.addEventListener('toggle', () => {
      if (!linha.open && select.selectedIndex !== 0) {
        select.selectedIndex = 0;
        quemConta.requestSubmit();
      }
    });
  }

  const janela = document.querySelector<HTMLElement>('[data-conversa]');
  if (janela) {
    // "Citar" ao lado: na janela, o botão cita sem sair da página
    for (const citar of document.querySelectorAll<HTMLAnchorElement>('.relato-conversa__memoria a.msg__citar')) {
      const id = new URL(citar.href).searchParams.get('cita') ?? '';
      const botao = Object.assign(document.createElement('button'), { type: 'button', className: citar.className, textContent: 'Citar' });
      botao.dataset.citar = id;
      botao.dataset.quem = citar.closest('.voz')?.querySelector('.voz__quem .mao')?.textContent ?? '';
      citar.replaceWith(botao);
    }
    const conversa = ligarConversa(janela);
    janela.addEventListener('submit', (e) => e.preventDefault());
    const publicar = janela.querySelector<HTMLButtonElement>('[data-publicar]');
    publicar?.addEventListener('click', async (e) => {
      e.preventDefault();
      if (conversa.ocupado()) {
        // Espera o envio que está a caminho
        await new Promise((r) => setTimeout(r, 400));
      }
      publicar.disabled = true;
      const destino = await conversa.publicar();
      publicar.disabled = false;
      if (!destino) return;
      publicar.remove();
      const confirmacao = document.querySelector<HTMLElement>('[data-confirmacao]')!;
      confirmacao.hidden = false;
      const titulo = confirmacao.querySelector<HTMLElement>('h2')!;
      titulo.setAttribute('tabindex', '-1');
      titulo.focus();
    });
  }
</script>
