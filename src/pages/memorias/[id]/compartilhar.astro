---
// Compartilhar uma memória como imagem (onda 2, decisão do Gui de 17/11/2026; src/lib/compartilhar.ts).
// Só gera quem vê a memória publicada. Se ela é só de algumas famílias, o aviso vem antes, e a imagem só
// aparece depois de a pessoa confirmar (?confirmado=1, que funciona sem script). A imagem é desenhada no
// navegador, sem passar pelo servidor.
import Pagina from '../../../components/formularios/Pagina.astro';
import Segmentado from '../../../components/visual/Segmentado.astro';
import { avisoAntesDeCompartilhar, escolhaDoNomeAparece, nomeNaImagem, trechoDoRelato, type NomesDeQuemAparece } from '../../../lib/compartilhar';
import type { DadosDaImagem } from '../../../lib/cliente/compartilhar';
import { formatarData } from '../../../lib/datas';
import { FONTES_DO_SITE } from '../../../lib/visual';
import { MONOGRAMAS } from '../../../visual/monograma';
import { listarIntegrantes, listarMeusApelidos, listarNucleos, listarRelatos, obterMemoria, nomesDasPessoasExcluidas } from '../../../lib/servidor/repositorio';

const { usuario } = Astro.locals;
const memoria = await obterMemoria(usuario, Astro.params.id ?? '');
if (!memoria || memoria.situacao !== 'publicada') return new Response('Memória não encontrada', { status: 404 });
const nucleos = await listarNucleos();
const aviso = avisoAntesDeCompartilhar(
  memoria.visibilidade,
  memoria.nucleos.map((id) => nucleos.find((n) => n.id === id)?.nome).filter((n): n is string => Boolean(n)),
);
const confirmado = !aviso || Astro.url.searchParams.get('confirmado') === '1';
// O trecho: o relato de quem compartilha, se houver; senão, o primeiro relato publicado que ela vê
const relatos = (await listarRelatos(usuario, memoria.id)).filter((r) => r.situacao === 'publicada' && r.texto.trim());
const relato = relatos.find((r) => r.por === usuario.pessoa) ?? relatos[0];
// Qual nome vai na imagem (decisão do Gui, 18/11/2026, depois da sessão H): o da família é o padrão,
// porque o apelido próprio é privado e a imagem sai do acervo. `apelido` já viria trocado pelo de quem
// olha (listarIntegrantes, nas páginas), então os dois nomes são lidos à parte, cada um da sua fonte.
const integrantes = await listarIntegrantes();
const meusApelidos = await listarMeusApelidos(usuario.pessoa);
// Quem está na lixeira (excluir pessoa): o relato que contou continua com o nome
const nomesNaLixeira = await nomesDasPessoasExcluidas();
const nomesDe = (id: string): NomesDeQuemAparece => {
  const i = integrantes.find((x) => x.id === id);
  return { nome: i?.nome ?? nomesNaLixeira.get(id) ?? '', apelidoDaFamilia: i?.apelidoDaFamilia ?? null, meuApelido: meusApelidos.get(id) ?? null };
};
// Quem aparece na imagem: hoje, só quem contou o trecho
const quemAparece = relato ? [nomesDe(relato.por)] : [];
const escolheONome = escolhaDoNomeAparece(quemAparece);
const principal = memoria.fotos.find((f) => f.principal) ?? memoria.fotos[0];
const dados: DadosDaImagem | null = confirmado
  ? {
      titulo: memoria.titulo,
      data: formatarData(memoria),
      lugar: memoria.lugar,
      foto: principal ? `/fotos/${principal.chave}` : null,
      trecho: relato ? trechoDoRelato(relato.texto) : null,
      autorDoTrecho: relato ? nomeNaImagem(nomesDe(relato.por), 'familia') : null,
      // Com o seu apelido, só quando a escolha muda algo; até a pessoa escolher, nada dele vai para a imagem
      comOSeuApelido: escolheONome && relato ? { autorDoTrecho: nomeNaImagem(nomesDe(relato.por), 'meu') } : null,
      // O M da serifa em uso, como marca d'água leve (a assinatura com o nome do site saiu, 18/11/2026)
      monograma: MONOGRAMAS[FONTES_DO_SITE.serifa].normal,
    }
  : null;
---

<Pagina titulo="Compartilhar como imagem" aba={`Compartilhar ${memoria.titulo}`} rotulo="Memória" nucleos={memoria.nucleos} secao="explorar">
  <Fragment slot="abertura">
    <p>
      <a href={`/memorias/${memoria.id}`}>{memoria.titulo}</a>
    </p>
    <p>Uma imagem vertical, para stories e WhatsApp: a foto, o título, a data e um trecho do relato.</p>
  </Fragment>

  {
    !confirmado ? (
      <section class="compartilhar__aviso">
        <p class="recado recado--erro">{aviso}</p>
        <p class="acoes">
          <a class="botao" href={`/memorias/${memoria.id}/compartilhar?confirmado=1`}>
            Entendi, montar a imagem
          </a>
          <a class="acao" href={`/memorias/${memoria.id}`}>
            Voltar para a memória
          </a>
        </p>
      </section>
    ) : (
      <section class="compartilhar" data-compartilhar-raiz>
        <p class="dica" data-estado>
          Montando a imagem…
        </p>
        <noscript>
          <p class="dica">Para montar a imagem, o navegador precisa estar com o JavaScript ligado.</p>
        </noscript>
        {/* Qual nome usar: só aparece quando muda algo. O seletor troca a imagem no lugar */}
        {escolheONome && (
          <div class="campo nome-na-imagem" data-nome-na-imagem>
            <span id="rotulo-nome-na-imagem">Qual nome usar?</span>
            <Segmentado
              rotulo="Qual nome usar na imagem"
              nome="nomeNaImagem"
              explicacao="frase-nome-na-imagem"
              opcoes={[
                { valor: 'familia', texto: 'O da família', atual: true },
                { valor: 'meu', texto: 'O seu apelido' },
              ]}
            />
            <p class="nome-na-imagem__frase" id="frase-nome-na-imagem" aria-live="polite">
              <span data-frase-do-nome="familia">Como a família toda conhece: {dados?.autorDoTrecho}.</span>
              <span data-frase-do-nome="meu" hidden>
                Como você chama: {dados?.comOSeuApelido?.autorDoTrecho}. Quem receber a imagem vai ver o seu apelido.
              </span>
            </p>
          </div>
        )}
        <canvas hidden />
        <img class="compartilhar__previa" data-previa alt={`A imagem de “${memoria.titulo}” para compartilhar`} hidden />
        <p class="acoes">
          <button class="botao" type="button" data-compartilhar hidden>
            Compartilhar
          </button>
          <a class="acao" data-baixar hidden>
            Baixar a imagem
          </a>
        </p>
        <script type="application/json" id="dados-da-imagem" set:html={JSON.stringify(dados).replace(/</g, '\\u003c')} />
      </section>
    )
  }
</Pagina>

<script>
  import { ligarCompartilhar, type DadosDaImagem } from '../../../lib/cliente/compartilhar';
  const raiz = document.querySelector<HTMLElement>('[data-compartilhar-raiz]');
  const bruto = document.getElementById('dados-da-imagem')?.textContent;
  if (raiz && bruto) void ligarCompartilhar(raiz, JSON.parse(bruto) as DadosDaImagem);
</script>
