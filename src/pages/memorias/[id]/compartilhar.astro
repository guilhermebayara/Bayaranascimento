---
// Compartilhar uma memória como imagem (onda 2, decisão do Gui de 17/11/2026; src/lib/compartilhar.ts).
// Só gera quem vê a memória publicada. Se ela é só de algumas famílias, o aviso vem antes, e a imagem só
// aparece depois de a pessoa confirmar (?confirmado=1, que funciona sem script). A imagem é desenhada no
// navegador, sem passar pelo servidor.
//
// O espaço de personalizar (proposta A do conceito da sessão J, escolha do Gui de 18/11/2026): a imagem
// num palco de tamanho fixo e uma bandeja com abas, um assunto por vez, num painel de altura fixa.
import Pagina from '../../../components/formularios/Pagina.astro';
import Segmentado from '../../../components/visual/Segmentado.astro';
import { CORES_DA_IMAGEM, abasDoEstudio, avisoAntesDeCompartilhar, nomeNaImagem, trechoDoRelato, type AbaDoEstudio, type NomesDeQuemAparece, type RelatoDaImagem } from '../../../lib/compartilhar';
import type { DadosDaImagem } from '../../../lib/cliente/compartilhar';
import { formatarData, jaFaleceu } from '../../../lib/datas';
import { enderecoDoRetrato } from '../../../lib/retratos';
import { FONTES_DO_SITE, estiloDoTipo } from '../../../lib/visual';
import { MONOGRAMAS } from '../../../visual/monograma';
import { listarIntegrantes, listarMeusApelidos, listarNucleos, listarRelatos, nomesDasPessoasExcluidas, obterMemoria, pessoasQueONaoVe } from '../../../lib/servidor/repositorio';

const { usuario } = Astro.locals;
const memoria = await obterMemoria(usuario, Astro.params.id ?? '');
if (!memoria || memoria.situacao !== 'publicada') return new Response('Memória não encontrada', { status: 404 });
const nucleos = await listarNucleos();
const aviso = avisoAntesDeCompartilhar(
  memoria.visibilidade,
  memoria.nucleos.map((id) => nucleos.find((n) => n.id === id)?.nome).filter((n): n is string => Boolean(n)),
);
const confirmado = !aviso || Astro.url.searchParams.get('confirmado') === '1';
// Os trechos: só de relato publicado que a pessoa vê. O dela vem primeiro, e é o padrão
const publicados = (await listarRelatos(usuario, memoria.id)).filter((r) => r.situacao === 'publicada' && r.texto.trim());
const naOrdem = [...publicados.filter((r) => r.por === usuario.pessoa), ...publicados.filter((r) => r.por !== usuario.pessoa)];
// Qual nome vai na imagem (decisão do Gui, 18/11/2026, depois da sessão H): o da família é o padrão,
// porque o apelido próprio é privado e a imagem sai do acervo. `apelido` já viria trocado pelo de quem
// olha (listarIntegrantes, nas páginas), então os dois nomes são lidos à parte, cada um da sua fonte.
const integrantes = await listarIntegrantes();
const meusApelidos = await listarMeusApelidos(usuario.pessoa);
const naoVe = await pessoasQueONaoVe(usuario);
// Quem está na lixeira (excluir pessoa): o relato que contou continua com o nome
const nomesNaLixeira = await nomesDasPessoasExcluidas();
const nomesDe = (id: string): NomesDeQuemAparece => {
  const i = integrantes.find((x) => x.id === id);
  return { nome: i?.nome ?? nomesNaLixeira.get(id) ?? '', apelidoDaFamilia: i?.apelidoDaFamilia ?? null, meuApelido: meusApelidos.get(id) ?? null };
};
const relatos: RelatoDaImagem[] = naOrdem.map((r) => {
  const quem = integrantes.find((i) => i.id === r.por);
  const daFamilia = nomeNaImagem(nomesDe(r.por), 'familia');
  const meu = nomeNaImagem(nomesDe(r.por), 'meu');
  return {
    autor: daFamilia,
    // O seu apelido só vai para a página quando muda algo
    comOSeuApelido: meu !== daFamilia ? meu : null,
    trecho: trechoDoRelato(r.texto),
    // O retrato de quem contou, só de quem a pessoa vê
    retrato: quem?.retrato && !naoVe.has(r.por) ? enderecoDoRetrato(quem.retrato) : null,
    faleceu: Boolean(quem && jaFaleceu(quem)),
  };
});
// A foto principal primeiro: é o padrão
const fotos = [...memoria.fotos.filter((f) => f.principal), ...memoria.fotos.filter((f) => !f.principal)].map((f) => `/fotos/${f.chave}`);
const dados: DadosDaImagem | null = confirmado
  ? {
      titulo: memoria.titulo,
      data: formatarData(memoria),
      lugar: memoria.lugar,
      fotos,
      relatos,
      // O M da serifa em uso, como marca d'água leve (a assinatura com o nome do site saiu, 18/11/2026)
      monograma: MONOGRAMAS[FONTES_DO_SITE.serifa].normal,
    }
  : null;
const abas = abasDoEstudio(relatos, fotos.length);
const NOMES_DAS_ABAS: Record<AbaDoEstudio, string> = { nome: 'Nome', cores: 'Cores', foto: 'Foto', relato: 'Relato' };
// As amostras de cor carregam os tokens de cada esquema: o script lê delas as cores da imagem
const esquemas = CORES_DA_IMAGEM.filter((c) => c.id !== 'momento' || memoria.tipo).map((c) => ({
  ...c,
  estilo:
    c.id === 'papel'
      ? '--amostra-papel: var(--papel); --amostra-vivo: var(--vivo)'
      : c.id === 'familia'
        ? '--amostra-papel: var(--pastel); --amostra-vivo: var(--vivo)'
        : `${estiloDoTipo(memoria.tipo)}; --amostra-papel: var(--tipo-pastel); --amostra-vivo: var(--tipo-cor)`,
}));
const primeiro = relatos[0];
---

<Pagina titulo="Compartilhar como imagem" aba={`Compartilhar ${memoria.titulo}`} rotulo="Memória" nucleos={memoria.nucleos} secao="explorar">
  <Fragment slot="abertura">
    <p>
      <a href={`/memorias/${memoria.id}`}>{memoria.titulo}</a>
    </p>
    <p>Uma imagem vertical, para stories e WhatsApp: a foto, o título, a data e um trecho do relato.</p>
  </Fragment>

  {
    !confirmado ? (
      <section class="compartilhar__aviso">
        <p class="recado recado--erro">{aviso}</p>
        <p class="acoes">
          <a class="botao" href={`/memorias/${memoria.id}/compartilhar?confirmado=1`}>
            Entendi, montar a imagem
          </a>
          <a class="acao" href={`/memorias/${memoria.id}`}>
            Voltar para a memória
          </a>
        </p>
      </section>
    ) : (
      <section class="compartilhar estudio" data-compartilhar-raiz>
        <div class="estudio__palco">
          <p class="dica" data-estado>
            Montando a imagem…
          </p>
          <noscript>
            <p class="dica">Para montar a imagem, o navegador precisa estar com o JavaScript ligado.</p>
          </noscript>
          <canvas hidden />
          <img class="compartilhar__previa" data-previa alt={`A imagem de “${memoria.titulo}” para compartilhar`} hidden />
        </div>
        <div class="estudio__lado">
          <div class="bandeja" data-bandeja>
            <h2 class="bandeja__titulo">Personalizar</h2>
            {abas.length > 1 && <Segmentado rotulo="O que personalizar" nome="abaDaImagem" opcoes={abas.map((a, i) => ({ valor: a, texto: NOMES_DAS_ABAS[a], atual: i === 0 }))} />}
            {abas.includes('nome') && (
              <fieldset class="opcoes-da-imagem bandeja__painel" data-painel="nome" hidden={abas[0] !== 'nome'}>
                <legend class="so-leitor">Qual nome usar na imagem</legend>
                <label class="opcao-da-imagem">
                  <input type="radio" name="nomeNaImagem" value="familia" checked />
                  <span>
                    <strong>O da família</strong>
                    <span class="mao" data-nome-da-familia>
                      {primeiro?.autor}
                    </span>
                    <small>Como a família toda conhece.</small>
                  </span>
                </label>
                <label class="opcao-da-imagem">
                  <input type="radio" name="nomeNaImagem" value="meu" disabled={!primeiro?.comOSeuApelido} />
                  <span>
                    <strong>O seu apelido</strong>
                    <span class="mao" data-nome-meu>
                      {primeiro?.comOSeuApelido ?? primeiro?.autor}
                    </span>
                    <small>Quem receber a imagem vai ver.</small>
                  </span>
                </label>
                <label class="marcar-na-imagem" data-em-memoria hidden={!(primeiro?.faleceu && primeiro.retrato)}>
                  <input type="checkbox" name="emMemoria" />
                  <span>Mostrar “em memória”, com a foto em tom suave</span>
                </label>
              </fieldset>
            )}
            <fieldset class="opcoes-da-imagem opcoes-da-imagem--lado bandeja__painel" data-painel="cores" hidden={abas[0] !== 'cores'}>
              <legend class="so-leitor">As cores da imagem</legend>
              {esquemas.map((e, i) => (
                <label class="opcao-da-imagem">
                  <input type="radio" name="coresDaImagem" value={e.id} checked={i === 0} />
                  <span data-esquema={e.id} style={e.estilo}>
                    <span class="opcao-da-imagem__cor" />
                    <strong>{e.nome}</strong>
                  </span>
                </label>
              ))}
            </fieldset>
            {abas.includes('foto') && (
              <fieldset class="opcoes-da-imagem opcoes-da-imagem--lado bandeja__painel" data-painel="foto" hidden>
                <legend class="so-leitor">Qual foto vai na imagem</legend>
                {fotos.map((f, i) => (
                  <label class="opcao-da-imagem opcao-da-imagem--foto">
                    <input type="radio" name="fotoDaImagem" value={i} checked={i === 0} aria-label={`Foto ${i + 1} de ${fotos.length}`} />
                    <span>
                      <img class="opcao-da-imagem__foto" src={f} alt="" loading="lazy" />
                    </span>
                  </label>
                ))}
              </fieldset>
            )}
            {abas.includes('relato') && (
              <fieldset class="opcoes-da-imagem bandeja__painel" data-painel="relato" hidden>
                <legend class="so-leitor">Qual relato vai na imagem</legend>
                {relatos.map((r, i) => (
                  <label class="opcao-da-imagem">
                    <input type="radio" name="relatoDaImagem" value={i} checked={i === 0} />
                    <span>
                      <strong>{r.autor}</strong>
                      <small>{r.trecho}</small>
                    </span>
                  </label>
                ))}
              </fieldset>
            )}
          </div>
          <p class="acoes">
            <button class="botao" type="button" data-compartilhar hidden>
              Compartilhar
            </button>
            <a class="acao" data-baixar hidden>
              Baixar a imagem
            </a>
          </p>
        </div>
        <script type="application/json" id="dados-da-imagem" set:html={JSON.stringify(dados).replace(/</g, '\\u003c')} />
      </section>
    )
  }
</Pagina>

<script>
  import { ligarCompartilhar, type DadosDaImagem } from '../../../lib/cliente/compartilhar';
  const raiz = document.querySelector<HTMLElement>('[data-compartilhar-raiz]');
  const bruto = document.getElementById('dados-da-imagem')?.textContent;
  if (raiz && bruto) void ligarCompartilhar(raiz, JSON.parse(bruto) as DadosDaImagem);
</script>
