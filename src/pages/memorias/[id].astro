---
// A página da memória (docs/visual.md, "Página da memória").
// A ideia da tela: a foto e o verso. A frente é a imagem grande; o verso é a ficha em mono, como
// o carimbo do laboratório, e os relatos como bilhetes assinados à mão. A ordem é a de docs/visual.md.
import { naListaDeQuemOlha } from '../../lib/ex-casal';
import '../../visual/telas/memoria.css';
import Visual from '../../layouts/Visual.astro';
import Voz from '../../components/conversa/Voz.astro';
import Reacoes from '../../components/visual/Reacoes.astro';
import MenuDeAcoes from '../../components/visual/MenuDeAcoes.astro';
import { ofereceEntrar } from '../../lib/reacoes';
import Carimbo from '../../components/visual/Carimbo.astro';
import Dado from '../../components/visual/Dado.astro';
import Etiqueta from '../../components/visual/Etiqueta.astro';
import Ficha from '../../components/visual/Ficha.astro';
import Retrato from '../../components/visual/Retrato.astro';
import TarjaDoDiscreto from '../../components/visual/TarjaDoDiscreto.astro';
import Recado from '../../components/visual/Recado.astro';
import { fraseDosRelatosQueEsperam } from '../../lib/avisos';
import Polaroid from '../../components/visual/Polaroid.astro';
import { fontesDaFoto } from '../../lib/copias-das-fotos';
import Rabisco from '../../components/visual/Rabisco.astro';
import { memoriaDoCapitulo } from '../../lib/capitulos';
import { recolheQuemEstava, relatoJaEstaNaAbertura } from '../../lib/memoria';
import { pedidosDosRelatos } from '../../lib/servidor/pedido-do-relato';
import { tipoDaMemoria } from '../../lib/tipos';
import { formatarData, jaFaleceu } from '../../lib/datas';
import { Familia, possessivo, type Tratamento } from '../../lib/parentesco';
import { enderecoDoRetrato } from '../../lib/retratos';
import { chaveDoPublico, podeEditarMemoria, podeExcluirMemoria } from '../../lib/servidor/permissoes';
import { comoPublicoAntigo, paraQuemPassouAVer } from '../../lib/servidor/avisos';
import {
  familiasDe,
  listarAudiosDosRelatos,
  listarFotosDoRelato,
  listarMensagensDosRelatos,
  listarCapitulos,
  comoOsExesAparecem,
  contarSugestoesAbertas,
  disseQueEstava,
  listarReacoes,
  listarCasais,
  listarFiliacoes,
  listarIntegrantes,
  listarNucleos,
  listarRelatos,
  listarTemas,
  obterMemoria,
  pessoasQueONaoVe,
  abrirAvisosDaMemoria, nomesDasPessoasExcluidas, vizinhasDaMemoria } from '../../lib/servidor/repositorio';
import { conversaDosRelatos } from '../../lib/servidor/conversa';
import { carimboDaData, estiloDoTipo, giroDoId, legendaLugarAno, trechoDoRelato } from '../../lib/visual';
import { coresDasPessoas } from '../../lib/familias';

const { usuario, tipos } = Astro.locals;
const memoria = await obterMemoria(usuario, Astro.params.id ?? '');
// Rascunho se edita no formulário. Memória que a pessoa não vê é como se não existisse.
if (!memoria) return new Response('Memória não encontrada', { status: 404 });
if (memoria.situacao === 'rascunho') return Astro.redirect(`/nova?id=${memoria.id}`);
// O que a página lê vai junto, numa ida só (causa 1b da medição M1, docs/desempenho/): as pessoas, as
// famílias e os laços já vêm guardados do começo do pedido; o resto é desta memória.
const publicada = memoria.situacao === 'publicada';
const temQuemEstava = memoria.integrantes.length > 0;
const [, integrantes, nucleos, relatos, nomesNaLixeira, naoVe, casais, modosDosExes, filiacoes, todosOsCapitulos, todosOsTemas, vizinhas, eleDisseQueEstava, sugestoesAbertas] = await Promise.all([
  // Abrir a memória tira da lista os avisos que apontam para ela (menos o pedido para liberar um relato)
  abrirAvisosDaMemoria(usuario, memoria.id),
  listarIntegrantes(),
  listarNucleos(),
  listarRelatos(usuario, memoria.id),
  // Quem está na lixeira (excluir pessoa) some do site, mas o relato que contou continua com o nome
  nomesDasPessoasExcluidas(),
  temQuemEstava ? pessoasQueONaoVe(usuario) : new Set<string>(),
  listarCasais(usuario),
  temQuemEstava ? comoOsExesAparecem(usuario) : new Map<string, 'discreto' | 'fora'>(),
  listarFiliacoes(),
  listarCapitulos(usuario),
  listarTemas(),
  // Vizinhas na linha do tempo, entre as que a pessoa vê: por uma consulta própria, sem ler o acervo inteiro
  vizinhasDaMemoria(usuario, memoria),
  publicada && !memoria.integrantes.includes(usuario.pessoa) ? disseQueEstava(memoria.id, usuario) : false,
  publicada ? contarSugestoesAbertas(memoria, usuario) : 0,
]);
const ordemDosNucleos = nucleos.map((n) => n.id);
// Reações (onda 2): só nos relatos publicados e nas fotos que a pessoa vê, e só com quem ela vê
const alvosDasReacoes = new Set(['memoria:0', ...relatos.filter((r) => r.situacao === 'publicada').map((r) => `relato:${r.id}`), ...memoria.fotos.map((f) => `foto:${f.id}`)]);
// As fotos do meu relato em rascunho ainda não são da memória: entram à parte na conversa, sem galeria
const meuEmRascunho = relatos.find((r) => r.situacao === 'rascunho' && r.registradoPor === usuario.pessoa);
// O que depende dos relatos, numa segunda ida. As mensagens ficam guardadas para a conversa, mais abaixo.
const [audiosDosRelatos, , reacoes, fotosDoRascunho] = await Promise.all([
  listarAudiosDosRelatos(relatos.map((r) => r.id)),
  listarMensagensDosRelatos(relatos).then(() => undefined),
  publicada ? listarReacoes(memoria.id, usuario, alvosDasReacoes) : new Map(),
  meuEmRascunho ? listarFotosDoRelato(meuEmRascunho.id) : [],
]);
const achar = (id: string) => integrantes.find((i) => i.id === id);
const nome = (id: string) => achar(id)?.apelido ?? achar(id)?.nome ?? nomesNaLixeira.get(id) ?? id;
const faleceu = (id: string) => Boolean(achar(id) && jaFaleceu(achar(id)!));

// Retratos em "Quem estava": só de quem a pessoa vê. Sem retrato, as iniciais sobre a cor da família.
const retratoDe = (id: string) => {
  const pessoa = achar(id);
  return pessoa?.retrato && !naoVe.has(id) ? enderecoDoRetrato(pessoa.retrato) : null;
};
const corDe = coresDasPessoas(integrantes, casais, ordemDosNucleos);
const familiaDe = (id: string) => corDe(id);
// Como os exes aparecem para quem olha (src/lib/ex-casal.ts): modosDosExes
// Quem só existe num laço privado de outra pessoa não aparece em "Quem estava" (C1, 17/11/2026)
// O ex que quem olha deixou fora sai de "Quem estava"; o discreto fica, com a tarja (naListaDeQuemOlha)
const quemEstava = memoria.integrantes.filter((id) => !naoVe.has(id) && naListaDeQuemOlha(modosDosExes.get(id)) !== 'fora');
// O parentesco do ponto de vista de quem olha: "sua avó"
const tratamentos = new Map<string, Tratamento>(integrantes.map((i) => [i.id, i.tratamento]));
const familia = new Familia(filiacoes, casais, tratamentos);
const paraVoce = (id: string) => {
  if (id === usuario.pessoa) return 'você';
  const relacao = familia.relacao(usuario.pessoa, id);
  return relacao ? possessivo(relacao, achar(id)?.tratamento ?? null) : undefined;
};

const tipo = tipoDaMemoria(tipos, memoria);
const dosNucleos = memoria.nucleos.map((id) => nucleos.find((n) => n.id === id)?.nome).filter((n): n is string => Boolean(n));
const podeEditar = podeEditarMemoria(usuario, memoria).ok;
const podeExcluir = podeExcluirMemoria(usuario, memoria).ok;
const temPaginaNoAcervo = integrantes.some((i) => i.id === usuario.pessoa);
// A oferta fica na página, escondida, para aparecer no lugar logo depois do "eu estava lá" (sem recarregar)
const podeEntrarEmQuemEstava = publicada && temPaginaNoAcervo && !memoria.integrantes.includes(usuario.pessoa);
const ofereceQuemEstava = podeEntrarEmQuemEstava && ofereceEntrar(eleDisseQueEstava, false);
// Capítulos: os reunidos em que foi colocada e os por período em que a data cai, se forem de quem está nela
const capitulos = todosOsCapitulos.filter((c) => memoriaDoCapitulo(memoria, c));
const temas = todosOsTemas.filter((t) => memoria.temas.includes(t.id));
const meuRelato = relatos.find((r) => r.por === usuario.pessoa);
const temMeuRelato = Boolean(meuRelato);
// Com o relato ainda em rascunho, a linha e a ação dizem isso (resposta do Gui à 45-N8, 17/11/2026,
// confirmada depois do PR #48: o botão do alto continua "Continuar meu relato")
const meuRelatoEmRascunho = meuRelato?.situacao === 'rascunho';
const textoDaAcao = meuRelatoEmRascunho ? 'Continuar meu relato' : temMeuRelato ? 'Editar meu relato' : 'Contar como foi';

// O trecho da abertura vem do primeiro relato publicado que tem texto
const relatoDaAbertura = relatos.find((r) => r.situacao === 'publicada' && r.texto.trim());
const trecho = relatoDaAbertura ? trechoDoRelato(relatoDaAbertura.texto) : undefined;
// Um só relato, que coube inteiro na abertura: a seção "Relato" não repete o bilhete (P52 do QA de design de 17/11/2026)
// O relato que trouxe fotos fica com o bilhete, para as fotos aparecerem pequenas nele ("Fotos pelo relato")
// A linha para liberar fica no bilhete: o relato que espera não se esconde na abertura
const relatoSoNaAbertura = !relatos.some((r) => r.soParaNucleos && r.registradoPor === usuario.pessoa) && relatoJaEstaNaAbertura(relatos, trecho, (id) => (audiosDosRelatos.get(id)?.length ?? 0) + memoria.fotos.filter((f) => String(f.relatoId) === String(id)).length);
// No celular, até seis retratos em "Quem estava"; o resto abre no lugar (P51)
const recolheQuem = recolheQuemEstava(quemEstava.length);

const { antes, depois } = vizinhas;

// A cor e a assinatura acompanham os núcleos da memória; aberta a todos, as famílias juntas
const corDaTela = memoria.visibilidade === 'nucleos' ? undefined : 'tudo';
const outrasFotos = memoria.fotos.length > 1;

// A foto que veio com um relato ("Fotos pelo relato", em docs/decisoes.md) é da memória: aparece na
// parede e na galeria com as outras e, pequena, no bilhete do relato que a trouxe (.bilhete__fotos,
// em src/visual/telas/memoria.css). Tocar nela abre a galeria nela.
// Ampliar quem vê com relatos (docs/decisoes.md): quem criou a memória vê de quem são os relatos que
// esperam o sim do autor; quem registrou um relato que espera vê a linha discreta para liberar
const esperam = memoria.criadaPor === usuario.pessoa ? relatos.filter((r) => r.situacao === 'publicada' && r.soParaNucleos && r.registradoPor !== usuario.pessoa) : [];
const fraseDaEspera = fraseDosRelatosQueEsperam(esperam.map((r) => ({ nome: nome(r.por), tratamento: achar(r.por)?.tratamento ?? null })));
const ok = Astro.url.searchParams.get('ok');
const erro = Astro.url.searchParams.get('erro');
// Os relatos de quem olha que esperam o sim dele: a ação com o mesmo nome do aviso (crítica C2)
const pedidosDaPagina = await pedidosDosRelatos(
  usuario,
  relatos.filter((r) => r.soParaNucleos && r.registradoPor === usuario.pessoa).map((r) => ({ relatoId: r.id, publico: memoria })),
);

// O relato como conversa: as mensagens de cada relato, com os áudios, as fotos (que abrem a galeria da
// memória) e as citações resolvidas para quem olha. As fotos do meu relato em rascunho ainda não são da
// memória: entram à parte, sem galeria (meuEmRascunho e fotosDoRascunho, no alto).
const conversa = await conversaDosRelatos(relatos, [...memoria.fotos, ...fotosDoRascunho.filter((f) => !memoria.fotos.some((m) => m.id === f.id))], nome, (fotoId) => {
  const n = memoria.fotos.findIndex((f) => f.id === fotoId);
  return n >= 0 ? n : undefined;
});
// "Citar": quem tem página no acervo cita uma mensagem dos outros no próprio relato
const podeCitar = publicada && temPaginaNoAcervo;
---

<Visual titulo={memoria.titulo} secao="explorar" nucleos={memoria.nucleos} familia={corDaTela}>
  {/* A faixa de recados (data-recados): vazia e escondida sem recado, para o formulário no lugar achá-la */}
  {
    ok || erro || fraseDaEspera ? (
      <div class="miolo memoria__recados" data-recados>
        {(ok || erro) && <Recado erro={Boolean(erro)}>{erro ?? ok}</Recado>}
        {fraseDaEspera && <p class="memoria__espera suave">{fraseDaEspera}</p>}
      </div>
    ) : (
      <p data-recados hidden />
    )
  }
  <article class="memoria">
    <div class="abre__fundo" style={estiloDoTipo(memoria.tipo)}>
    <header class="abre miolo grade">
      <div class="abre__texto">
        <p class="abre__sobre">
          <Carimbo itens={[carimboDaData(memoria), memoria.lugar]} />
          {memoria.visibilidade === 'nucleos' && <span class="selo">Só {dosNucleos.join(' e ')}</span>}
          {memoria.exemplo && <span class="selo">exemplo</span>}
        </p>
        <h1 class="t-1">{memoria.titulo}</h1>
        {
          trecho && relatoDaAbertura && (
            <blockquote class="abre__trecho">
              <p class="serifa t-abertura">“{trecho}”</p>
              <footer>
                <span class="mao">{nome(relatoDaAbertura.por)}</span>
              </footer>
            </blockquote>
          )
        }
        {/* As ações do alto. No celular, os dois atalhos e, embaixo, reagir e o menu; no computador, tudo
            numa linha: reagir, os dois atalhos e o menu (sugestão do Gui, 18/11/2026: o menu ficava
            escondido na ponta da coluna, encostado nas fotos) */}
        <div class="abre__acoes">
        {/* Atalho pequeno no alto para quem chega querendo contar; o convite grande fica no fim */}
        <p class="abre__atalho">
          <a class="acao" href={`/memorias/${memoria.id}/relato`}>
            {textoDaAcao}
          </a>
          {/* Mandar fotos sem escrever relato (resposta do Gui ao PR #51, 17/11/2026) */}
          <a class="acao acao--quieta" href={`/memorias/${memoria.id}/fotos`}>
            Acrescentar fotos
          </a>
        </p>
        {/* Reagir à memória inteira fica à vista, como nas redes (observação do Gui, 18/11/2026) */}
        {
          publicada && (
            <div class="abre__reagir acoes-do-item">
              <Reacoes memoria={memoria.id} alvo="memoria" marcas={reacoes.get('memoria:0')} eu={usuario.pessoa} nome={nome} volta={`/memorias/${memoria.id}`} sobre="a memória" />
              {/* O resto mora no menu, como nas plataformas que a família usa (observação do Gui, 18/11/2026) */}
              <MenuDeAcoes rotulo="Mais ações da memória">
                <a class="menu-acoes__item" href={`/memorias/${memoria.id}/compartilhar`}>
                  Compartilhar como imagem
                </a>
                {memoria.criadaPor === usuario.pessoa ? (
                  <a class="menu-acoes__item" href={`/nova?id=${memoria.id}`}>
                    Corrigir esta memória
                  </a>
                ) : (
                  <a class="menu-acoes__item" href={`/memorias/${memoria.id}/sugerir`}>
                    Sugerir uma correção
                  </a>
                )}
                <a class="menu-acoes__item" href={`/memorias/${memoria.id}/historico`}>
                  Histórico de alterações
                </a>
              </MenuDeAcoes>
            </div>
          )
        }
        </div>
      </div>
      {
        memoria.fotos.length > 0 && (
          // Com mais de uma foto e espaço, as de trás se abrem em leque. Cada foto abre a galeria nela.
          <div class:list={['abre__foto', outrasFotos && `abre__foto--leque abre__foto--${Math.min(memoria.fotos.length, 3)}`]}>
            <Polaroid id={memoria.id} fotos={memoria.fotos} legenda={legendaLugarAno(memoria.lugar, memoria.ano)} cedo galeria principal largura="(min-width: 1600px) 470px, (min-width: 1000px) 310px, 160px" />
          </div>
        )
      }
      {
        // Sem foto, o lado direito leva o cartão do tipo de momento, o mesmo da linha do tempo (P53).
        // Só onde a abertura tem dois lados: no celular ela é só tipo.
        memoria.fotos.length === 0 && (
          <div class="abre__foto abre__foto--tipo">
            <Polaroid id={memoria.id} fotos={[]} legenda={legendaLugarAno(memoria.lugar, memoria.ano)} tipo={memoria.tipo} />
          </div>
        )
      }
    </header>
    </div>

    <div class="corpo grade">
      <aside class="dados" aria-label="Ficha da memória">
        <Ficha>
          <Dado rotulo="Quando">{formatarData(memoria)}</Dado>
          {
            memoria.lugar && (
              <Dado rotulo="Onde">{memoria.lugar}</Dado>
            )
          }
          <Dado rotulo="Tipo">
              <Etiqueta tipo={memoria.tipo} rotulo={tipo.rotulo} />
            </Dado>
          {
            capitulos.length > 0 && (
              <Dado rotulo={capitulos.length === 1 ? 'Capítulo' : 'Capítulos'}>
                  {capitulos.map((c) => (
                    <a href={`/capitulos/${c.id}`}>{c.titulo}</a>
                  ))}
                </Dado>
            )
          }
          {
            temas.length > 0 && (
              <Dado rotulo="Temas">
                  {temas.map((t) => (
                    <a href={`/temas/${t.id}`}>{t.nome}</a>
                  ))}
                </Dado>
            )
          }
          {
            dosNucleos.length > 0 && (
              <Dado rotulo="Famílias">{dosNucleos.join(', ')}</Dado>
            )
          }
        </Ficha>
      </aside>

      <div class="corpo__conteudo">
        {/* "Quem estava" e a oferta de entrar nele: uma região, para entrar acontecer no lugar */}
        <div class="regiao" data-regiao="quem-estava">
        {
          // Depois de "eu estava lá" numa memória em que não está: um toque para entrar em Quem estava
          podeEntrarEmQuemEstava && (
            <form class="entrar-em-quem-estava" method="post" action="/api/reacoes" data-entrar-em-quem-estava hidden={!ofereceQuemEstava} data-no-lugar="quem-estava" data-chave="quem-estava">
              <input type="hidden" name="acao" value="entrar" />
              <input type="hidden" name="memoria" value={memoria.id} />
              <span>Você disse que estava lá. Quer entrar em Quem estava?</span>
              <button class="acao" type="submit">
                Entrar em Quem estava
              </button>
            </form>
          )
        }
        {
          quemEstava.length > 0 && (
            <section class="parte" aria-labelledby="quem-estava">
              <h2 class="parte__titulo" id="quem-estava">
                Quem estava
              </h2>
              <ul class:list={['quem', recolheQuem && 'quem--recolhe']} data-quem>
                {quemEstava.map((id) => (
                  <li>
                    {naListaDeQuemOlha(modosDosExes.get(id)) === 'tarja' ? (
                      // Um ex que quem olha deixou discreto: a foto borrada com a tarja por cima e o nome borrado, sem link
                      <span class="pessoa pessoa--discreto">
                        <TarjaDoDiscreto nome={nome(id)} foto={retratoDe(id)} familia={familiaDe(id)} />
                      </span>
                    ) : (
                      <a class="pessoa" href={`/pessoas/${id}`}>
                        <Retrato nome={nome(id)} foto={retratoDe(id)} familia={familiaDe(id)} falecido={faleceu(id)} />
                        <span class="pessoa__nome">{nome(id)}</span>
                        {paraVoce(id) && <span class="pessoa__laco ficha suave">{paraVoce(id)}</span>}
                        {faleceu(id) && <span class="em-memoria">em memória</span>}
                      </a>
                    )}
                  </li>
                ))}
              </ul>
              {
                // "Ver todos" só existe no celular e com script: sem script, a lista vem inteira
                recolheQuem && (
                  <p class="quem__todos">
                    <button type="button" class="acao" data-quem-todos hidden>
                      Ver todos os {quemEstava.length}
                    </button>
                  </p>
                )
              }
            </section>
          )
        }
        </div>

        {
          relatos.length > 0 && !relatoSoNaAbertura && (
            <section class="parte parte--conversa" aria-labelledby="relatos">
              <h2 class="parte__titulo" id="relatos">
                {relatos.length === 1 ? 'Relato' : 'Relatos'}
              </h2>
              {/* O relato como conversa (escolha do Gui depois da sessão I, 18/11/2026; src/lib/conversa.ts): cada
                  pessoa é uma voz, com o retrato e o nome à mão no começo e as mensagens na ordem em que mandou,
                  quem contou primeiro antes. As de quem olha à direita, no pastel da família. As reações são do
                  relato inteiro, no fim da voz. "Citar" leva ao relato de quem olha, com a mensagem citada. */}
              <div class="voz-fio">
                {relatos.map((relato) => (
                  <Voz
                    id={`relato-${relato.id}`}
                    nome={nome(relato.por)}
                    retrato={retratoDe(relato.por)}
                    familia={familiaDe(relato.por)}
                    falecido={faleceu(relato.por)}
                    registradoPor={relato.registradoPor !== relato.por ? nome(relato.registradoPor) : null}
                    mensagens={conversa.get(relato.id) ?? []}
                    minha={relato.por === usuario.pessoa}
                    citarEm={podeCitar && relato.situacao === 'publicada' && relato.registradoPor !== usuario.pessoa ? `/memorias/${memoria.id}/relato?cita=` : undefined}
                  >
                    <Fragment slot="antes">
                      {relato.situacao === 'rascunho' && <p class="selo bilhete__selo">Rascunho, só você vê</p>}
                      {relato.soParaNucleos && relato.registradoPor === usuario.pessoa && (
                        <form class="bilhete__espera" method="post" action="/api/avisos" data-regiao={`liberar-${relato.id}`} data-no-lugar={`liberar-${relato.id} retrato`} data-chave={`liberar-${relato.id}`}>
                          <input type="hidden" name="relato" value={relato.id} />
                          <input type="hidden" name="resposta" value="liberar" />
                          {/* Liberar diz para quem libera, e a rota confere que é esse o público de agora (revisão Y2 do PR #160) */}
                          <input type="hidden" name="publico" value={chaveDoPublico(memoria)} />
                          <input type="hidden" name="volta" value={`/memorias/${memoria.id}#relato-${relato.id}`} />
                          <span class="suave">Visível só para quem via antes.</span>
                          {/* A ação tem o mesmo nome no aviso e aqui (pedidosDosRelatos, crítica C2) */}
                          <button type="submit" class="acao acao--quieta">
                            {pedidosDaPagina.get(relato.id)?.acao ?? `Liberar para ${paraQuemPassouAVer(comoPublicoAntigo(relato.publicoConhecido ?? relato.soParaNucleos), memoria, nucleos)}`}
                          </button>
                          <span class="bilhete__sem-volta ficha suave">Liberar não tem volta.</span>
                        </form>
                      )}
                    </Fragment>
                    {publicada && relato.situacao === 'publicada' && (
                      <div slot="pe" class="acoes-do-item">
                        <Reacoes memoria={memoria.id} alvo="relato" alvoId={relato.id} marcas={reacoes.get(`relato:${relato.id}`)} eu={usuario.pessoa} nome={nome} volta={`/memorias/${memoria.id}#relato-${relato.id}`} sobre={`o relato de ${nome(relato.por)}`} />
                        <MenuDeAcoes rotulo={`Mais ações do relato de ${nome(relato.por)}`}>
                          {/* O recado ao autor do relato, numa página própria, à parte da sugestão de dados da
                              memória (observação do Gui, 18/11/2026). No próprio relato, contar mais fica no
                              atalho do alto e na linha do fim */}
                          {relato.registradoPor !== usuario.pessoa && (
                            <a class="menu-acoes__item" href={`/memorias/${memoria.id}/recado?relato=${relato.id}`}>
                              Deixar um recado para {nome(relato.registradoPor)}
                            </a>
                          )}
                          <a class="menu-acoes__item" href={`/memorias/${memoria.id}/compartilhar`}>
                            Compartilhar como imagem
                          </a>
                        </MenuDeAcoes>
                      </div>
                    )}
                  </Voz>
                ))}
              </div>
            </section>
          )
        }

        {
          // A parede de fotos: todas as fotos da memória como fotos reveladas, com a legenda de cada uma.
          // Tocar numa abre a galeria, com a foto inteira.
          outrasFotos && (
            <section class="parte" aria-labelledby="fotos">
              <h2 class="parte__titulo" id="fotos">
                Fotos
              </h2>
              <ul class="parede">
                {memoria.fotos.map((foto, n) => (
                  <li id={`foto-${foto.id}`}>
                    <a class="monte" href={`/fotos/${foto.chave}`} data-galeria={n} aria-label={`Ver a foto inteira${foto.legenda ? `: ${foto.legenda}` : ''}`}>
                      <figure class="polaroid" style={`--giro: ${giroDoId(`${memoria.id}-${n}`)}deg`}>
                        <span class="polaroid__foto">
                          <img {...fontesDaFoto(foto, 'pequena', '(min-width: 1600px) 250px, (min-width: 1000px) 220px, 150px')} alt={foto.legenda ?? ''} loading="lazy" decoding="async" />
                        </span>
                        <figcaption class="polaroid__legenda">{foto.legenda ?? ''}</figcaption>
                      </figure>
                    </a>
                    {publicada && (
                      <div class="acoes-do-item">
                        <Reacoes memoria={memoria.id} alvo="foto" alvoId={foto.id} marcas={reacoes.get(`foto:${foto.id}`)} eu={usuario.pessoa} nome={nome} volta={`/memorias/${memoria.id}#foto-${foto.id}`} sobre={`a foto ${n + 1}`} />
                        <MenuDeAcoes rotulo={`Mais ações da foto ${n + 1}`}>
                          <a class="menu-acoes__item" href={`/fotos/${foto.chave}`} target="_blank" rel="noopener">
                            Ver a foto inteira
                          </a>
                          <a class="menu-acoes__item" href={`/fotos/${foto.chave}`} download>
                            Baixar a foto
                          </a>
                        </MenuDeAcoes>
                      </div>
                    )}
                  </li>
                ))}
              </ul>
            </section>
          )
        }
      </div>
    </div>

    {/* Quem já contou não precisa do convite: uma linha quieta, e a página termina em "Antes" e "Depois" (P54) */}
    {
      temMeuRelato && (
        <p class="contou miolo">
          <span class="contou__frase">{meuRelatoEmRascunho ? 'Seu relato está em rascunho.' : 'Você já contou esse dia.'}</span>
          <a class="acao" href={`/memorias/${memoria.id}/relato`}>
            {textoDaAcao}
          </a>
        </p>
      )
    }
    {/* O convite para contar: um bilhete em branco com o nome de quem está vendo, à espera do relato dela */}
    {
      !temMeuRelato && (
        <section class="convite miolo" aria-labelledby="convite" style={estiloDoTipo(memoria.tipo)}>
          <div class="convite__mesa">
            <span class="convite__forma" aria-hidden="true" />
            <div class="convite__bilhete bilhete">
              <p class="convite__para rotulo suave">
                <Retrato nome={usuario.nome} foto={retratoDe(usuario.pessoa)} familia={familiaDe(usuario.pessoa)} />
                Para {usuario.nome}
              </p>
              <h2 class="convite__titulo serifa" id="convite">
                Cada pessoa conta o dia do jeito que lembra.
              </h2>
              <div class="convite__linhas" aria-hidden="true">
                <span />
                <span />
                <span />
              </div>
              <p class="convite__pe">
                <span class="convite__assina">
                  <span class="mao">{usuario.nome}</span>
                  <Rabisco desenho="sublinha" />
                </span>
                <a class="botao" href={`/memorias/${memoria.id}/relato`}>
                  Contar como foi
                </a>
              </p>
            </div>
          </div>
        </section>
      )
    }
  </article>

  {/* A galeria: a foto inteira, uma de cada vez, sem sair da página. As fotos ficam numa fila que
      rola para o lado com a rolagem do próprio aparelho: a foto acompanha o dedo e a seguinte entra,
      como no álbum de fotos do celular. Sem script, cada foto continua sendo um link para a imagem. */}
  {
    memoria.fotos.length > 0 && (
      <dialog class="galeria" data-galeria-caixa aria-label="Fotos desta memória">
        <div class="galeria__topo">
          <p class="rotulo" data-galeria-conta aria-live="polite" />
          <button type="button" class="galeria__fechar" data-galeria-fechar>
            Fechar
          </button>
        </div>
        <ul class="galeria__fila" data-galeria-fila>
          {memoria.fotos.map((foto, n) => (
            <li class="galeria__quadro">
              <figure>
                <img {...fontesDaFoto(foto, 'inteira')} alt={foto.legenda ?? ''} loading="lazy" decoding="async" />
                <figcaption>
                  <span class="galeria__legenda">{foto.legenda ?? ''}</span>
                </figcaption>
              </figure>
            </li>
          ))}
        </ul>
        <div class="galeria__passos">
          <button type="button" class="galeria__passo galeria__passo--antes" data-galeria-passo="-1">
            Anterior
          </button>
          <button type="button" class="galeria__passo galeria__passo--depois" data-galeria-passo="1">
            Próxima
          </button>
        </div>
      </dialog>
    )
  }

  <nav class="vizinhas miolo" aria-label="Outras memórias">
    {
      [
        { rotulo: 'Antes', m: antes },
        { rotulo: 'Depois', m: depois },
      ].map(({ rotulo, m }) => (
        <div class:list={['vizinha', rotulo === 'Depois' && 'vizinha--depois']}>
          {m && (
            <a href={`/memorias/${m.id}`}>
              <span class="rotulo suave">
                {rotulo} · {carimboDaData(m)}
              </span>
              <strong class="serifa t-3">{m.titulo}</strong>
            </a>
          )}
        </div>
      ))
    }
  </nav>

  <p class="servico miolo">
    {
      podeEditar && (
        <a class="acao acao--quieta" href={`/nova?id=${memoria.id}`}>
          Corrigir esta memória
        </a>
      )
    }
    {/* Compartilhar e sugerir uma correção moram no menu da memória, no alto (observação do Gui, 18/11/2026) */}
    {
      sugestoesAbertas > 0 && (
        <a class="acao acao--quieta" href={`/memorias/${memoria.id}/sugestoes`}>
          {sugestoesAbertas === 1 ? '1 sugestão de correção' : `${sugestoesAbertas} sugestões de correção`}
        </a>
      )
    }
    <a class="acao acao--quieta" href={`/memorias/${memoria.id}/historico`}>
      Histórico de alterações
    </a>
    {
      podeExcluir && (
        <a class="acao acao--quieta" href={`/memorias/${memoria.id}/excluir`}>
          Excluir memória
        </a>
      )
    }
  </p>
</Visual>

<script>
  import { ligarMenus } from '../../lib/cliente/menus';
  import { ligarReacoes } from '../../lib/cliente/reacoes';
  import { ligarAudioDaMensagem } from '../../lib/cliente/conversa';
  // As reações no lugar, sem recarregar, e os menus dos três pontos
  ligarReacoes();
  ligarMenus();
  // Os áudios das vozes: o botão de tocar e a onda; sem script, o tocador do aparelho
  for (const audio of document.querySelectorAll<HTMLElement>('.voz [data-audio]')) ligarAudioDaMensagem(audio);

  // "Quem estava" no celular: até seis retratos, e "Ver todos os N" abre o resto no lugar. A lista só
  // é recolhida aqui, pelo script: sem ele, ela vem inteira. O CSS só esconde abaixo de 40rem.
  const quem = document.querySelector<HTMLElement>('[data-quem].quem--recolhe');
  const verTodos = document.querySelector<HTMLButtonElement>('[data-quem-todos]');
  if (quem && verTodos) {
    const aVista = quem.querySelectorAll('li').length - quem.querySelectorAll('li:nth-child(n + 7)').length;
    quem.classList.add('quem--recolhida');
    verTodos.hidden = false;
    verTodos.addEventListener('click', () => {
      quem.classList.remove('quem--recolhida');
      verTodos.parentElement?.remove();
      // O foco segue para a primeira pessoa que acabou de aparecer
      quem.children[aVista]?.querySelector('a')?.focus();
    });
  }

  // A galeria de fotos da memória. Abre na foto tocada e mostra a imagem inteira. As fotos ficam
  // numa fila que rola para o lado: no toque, a foto acompanha o dedo e para na seguinte (é a
  // rolagem do próprio aparelho, com encaixe); os botões e as setas do teclado fazem a mesma
  // passagem, deslizando. O botão de voltar do aparelho fecha a galeria em vez de sair da página.
  const caixa = document.querySelector<HTMLDialogElement>('[data-galeria-caixa]');
  const fila = caixa?.querySelector<HTMLElement>('[data-galeria-fila]');
  if (caixa && fila && typeof caixa.showModal === 'function') {
    const total = fila.children.length;
    const conta = caixa.querySelector<HTMLElement>('[data-galeria-conta]')!;
    const passos = [...caixa.querySelectorAll<HTMLButtonElement>('[data-galeria-passo]')];
    const calmo = matchMedia('(prefers-reduced-motion: reduce)');
    let atual = 0;
    // Para onde a fila está indo, enquanto desliza por um botão ou pelo teclado
    let destino = 0;
    let deslizando = 0;
    let noHistorico = false;

    const anotar = () => {
      conta.textContent = total > 1 ? `Foto ${atual + 1} de ${total}` : 'Foto';
      for (const b of passos) {
        b.hidden = total < 2;
        // Na ponta, o botão só fica apagado (aria-disabled): desligado de verdade, ele engoliria as
        // setas do teclado de quem está com o foco nele
        b.setAttribute('aria-disabled', String(Number(b.dataset.galeriaPasso) < 0 ? destino === 0 : destino === total - 1));
      }
    };
    const ir = (n: number, deslizar = true) => {
      destino = Math.max(0, Math.min(total - 1, n));
      const suave = deslizar && !calmo.matches;
      clearTimeout(deslizando);
      if (suave) deslizando = window.setTimeout(() => (deslizando = 0), 700);
      else {
        deslizando = 0;
        atual = destino;
      }
      fila.scrollTo({ left: destino * fila.clientWidth, behavior: suave ? 'smooth' : 'instant' });
      anotar();
    };
    // A foto da vez é a que está no meio da fila: vale para o dedo, para o botão e para o teclado
    fila.addEventListener(
      'scroll',
      () => {
        const n = Math.round(fila.scrollLeft / Math.max(1, fila.clientWidth));
        if (n === atual) return;
        atual = n;
        if (!deslizando) destino = n;
        anotar();
      },
      { passive: true },
    );
    const abrir = (n: number) => {
      if (!caixa.open) {
        caixa.showModal();
        history.pushState({ galeria: true }, '');
        noHistorico = true;
      }
      ir(n, false);
    };

    document.addEventListener('click', (evento) => {
      const link = evento.target instanceof Element ? evento.target.closest<HTMLAnchorElement>('a[data-galeria]') : null;
      // Abrir em outra aba continua funcionando: o link leva à imagem
      if (!link || evento.button !== 0 || evento.metaKey || evento.ctrlKey || evento.shiftKey || evento.altKey) return;
      evento.preventDefault();
      abrir(Number(link.dataset.galeria));
    });
    caixa.querySelector('[data-galeria-fechar]')?.addEventListener('click', () => caixa.close());
    // Tocar ou clicar no fundo, fora da foto, da legenda e dos controles, fecha a galeria (P55 do
    // QA de design de 17/11/2026). Arrastar para passar de foto não é clique, e não fecha.
    caixa.addEventListener('click', (evento) => {
      if (evento.target instanceof Element && !evento.target.closest('img, figcaption, button, [data-galeria-conta]')) caixa.close();
    });
    for (const b of passos) b.addEventListener('click', () => ir(destino + Number(b.dataset.galeriaPasso)));
    caixa.addEventListener('keydown', (evento) => {
      if (evento.key !== 'ArrowRight' && evento.key !== 'ArrowLeft') return;
      evento.preventDefault();
      ir(destino + (evento.key === 'ArrowRight' ? 1 : -1));
    });
    // Se a tela muda de tamanho ou vira, a foto da vez continua no lugar
    addEventListener('resize', () => caixa.open && ir(atual, false));
    // Fechada pelo botão ou pelo Esc: desfaz a entrada que a galeria pôs no histórico
    caixa.addEventListener('close', () => {
      if (!noHistorico) return;
      noHistorico = false;
      history.back();
    });
    // O voltar do aparelho, com a galeria aberta, fecha a galeria
    addEventListener('popstate', () => {
      if (!caixa.open) return;
      noHistorico = false;
      caixa.close();
    });
  }
</script>
