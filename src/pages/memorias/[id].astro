---
import Base from '../../layouts/Base.astro';
import Foto from '../../components/Foto.astro';
import { dentroDoPeriodo } from '../../lib/capitulos';
import { tipoDaMemoria } from '../../lib/tipos';
import { formatarData } from '../../lib/datas';
import { podeEditarMemoria, podeExcluirMemoria } from '../../lib/servidor/permissoes';
import { listarCapitulos, listarIntegrantes, listarMemorias, listarNucleos, listarRelatos, listarTemas, obterMemoria, listarAudiosDosRelatos } from '../../lib/servidor/repositorio';
import { duracaoEmTexto } from '../../lib/audios';

const { usuario } = Astro.locals;
const memoria = await obterMemoria(usuario, Astro.params.id ?? '');
// Rascunho se edita no formulário. Memória que a pessoa não vê é como se não existisse.
if (!memoria) return new Response('Memória não encontrada', { status: 404 });
if (memoria.situacao === 'rascunho') return Astro.redirect(`/nova?id=${memoria.id}`);

const integrantes = await listarIntegrantes();
const nucleos = await listarNucleos();
const relatos = await listarRelatos(usuario, memoria.id);
const audiosDosRelatos = await listarAudiosDosRelatos(relatos.map((r) => r.id));
const achar = (id: string) => integrantes.find((i) => i.id === id);
const nome = (id: string) => achar(id)?.apelido ?? achar(id)?.nome ?? id;
const tipo = tipoDaMemoria(Astro.locals.tipos, memoria);
const dosNucleos = memoria.nucleos.map((id) => nucleos.find((n) => n.id === id)?.nome).filter(Boolean);
const podeEditar = podeEditarMemoria(usuario, memoria).ok;
// Capítulos: os reunidos em que foi colocada e os de época em que a data cai
const capitulos = (await listarCapitulos(usuario)).filter((c) =>
  c.modo === 'reunido' ? memoria.capitulos.includes(c.id) : Boolean(c.inicio) && dentroDoPeriodo(memoria, c.inicio!, c.fim),
);
const temas = (await listarTemas()).filter((t) => memoria.temas.includes(t.id));
const podeExcluir = podeExcluirMemoria(usuario, memoria).ok;
const temMeuRelato = relatos.some((r) => r.por === usuario.pessoa);

// Vizinhas na linha do tempo, entre as que a pessoa vê
const todas = await listarMemorias(usuario);
const posicao = todas.findIndex((m) => m.id === memoria.id);
const antes = todas[posicao - 1];
const depois = todas[posicao + 1];
---

<Base titulo={memoria.titulo}>
  <article>
    <header class="memoria__cabeca">
      <p class="memoria__etiquetas">
        <span class="tipo" style={`--cor-tipo: ${tipo.cor}`}>{tipo.rotulo}</span>
        {memoria.visibilidade === 'nucleos' && <span class="selo">Só {dosNucleos.join(' e ')}</span>}
        {memoria.exemplo && <span class="exemplo">exemplo</span>}
      </p>
      <h1>{memoria.titulo}</h1>
      <dl class="memoria__ficha">
        <dt>Quando</dt>
        <dd>{formatarData(memoria)}</dd>
        {
          memoria.lugar && (
            <>
              <dt>Onde</dt>
              <dd>{memoria.lugar}</dd>
            </>
          )
        }
        {
          memoria.integrantes.length > 0 && (
            <>
              <dt>Quem</dt>
              <dd>
                {memoria.integrantes.map((id, i) => (
                  <>
                    {i > 0 && ', '}
                    <a href={`/pessoas/${id}`}>{nome(id)}</a>
                  </>
                ))}
              </dd>
            </>
          )
        }
        {
          capitulos.length > 0 && (
            <>
              <dt>{capitulos.length === 1 ? 'Capítulo' : 'Capítulos'}</dt>
              <dd>
                {capitulos.map((c, i) => (
                  <>
                    {i > 0 && ', '}
                    <a href={`/capitulos/${c.id}`}>{c.titulo}</a>
                  </>
                ))}
              </dd>
            </>
          )
        }
        {
          temas.length > 0 && (
            <>
              <dt>Temas</dt>
              <dd>
                {temas.map((t, i) => (
                  <>
                    {i > 0 && ', '}
                    <a href={`/temas/${t.id}`}>{t.nome}</a>
                  </>
                ))}
              </dd>
            </>
          )
        }
        {
          dosNucleos.length > 0 && (
            <>
              <dt>Núcleos</dt>
              <dd>{dosNucleos.join(', ')}</dd>
            </>
          )
        }
      </dl>
      {/* A ação principal fica no alto, junto do título (decisão do Gui, 16/11/2026); excluir, por último */}
      <p class="acoes acoes--pagina">
        <a class="botao" href={`/memorias/${memoria.id}/relato`}>{temMeuRelato ? 'Editar meu relato' : 'Escrever meu relato'}</a>
        {podeEditar && <a class="botao botao--leve" href={`/nova?id=${memoria.id}`}>Corrigir esta memória</a>}
        <a class="link-acao" href={`/memorias/${memoria.id}/historico`}>Histórico de alterações</a>
      </p>
    </header>

    {
      memoria.fotos.length > 0 && (
        <div class="galeria">
          {memoria.fotos.map((foto) => (
            <Foto foto={foto} cor={tipo.cor} />
          ))}
        </div>
      )
    }

    {
      relatos.map((relato) => (
        <section class="relato">
          <h2>
            Contado por {nome(relato.por)}
            {relato.registradoPor !== relato.por && `, registrado por ${nome(relato.registradoPor)}`}
            {relato.situacao === 'rascunho' && <span class="selo">Rascunho, só você vê</span>}
          </h2>
          {(audiosDosRelatos.get(relato.id) ?? []).length > 0 && (
            <ol class="audios__lista audios__lista--leitura">
              {(audiosDosRelatos.get(relato.id) ?? []).map((audio, n, todos) => (
                <li class="audio">
                  {todos.length > 1 && <p class="audio__titulo"><strong>Áudio {n + 1}</strong> <span>{duracaoEmTexto(audio.duracao)}</span></p>}
                  <audio controls preload="none" src={`/audios/${audio.chave}`}></audio>
                  {audio.transcricao && (
                    <details class="audio__transcricao">
                      <summary>Ler a transcrição</summary>
                      {audio.transcricao.split(/\n{2,}/).map((p) => <p>{p}</p>)}
                    </details>
                  )}
                </li>
              ))}
            </ol>
          )}
          {relato.texto.trim() && (
            <div class="relato__texto">
              {relato.texto.split(/\n{2,}/).map((paragrafo) => (
                <p>{paragrafo}</p>
              ))}
            </div>
          )}
        </section>
      ))
    }

    {podeExcluir && <p class="memoria__rodape"><a href={`/memorias/${memoria.id}/excluir`}>Excluir memória</a></p>}
  </article>

  <nav class="vizinhas" aria-label="Outras memórias">
    <div>
      {
        antes && (
          <a href={`/memorias/${antes.id}`}>
            <small>Antes, {formatarData(antes)}</small>
            <strong>{antes.titulo}</strong>
          </a>
        )
      }
    </div>
    <div class="vizinhas__depois">
      {
        depois && (
          <a href={`/memorias/${depois.id}`}>
            <small>Depois, {formatarData(depois)}</small>
            <strong>{depois.titulo}</strong>
          </a>
        )
      }
    </div>
  </nav>
</Base>
