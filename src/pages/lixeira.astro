---
import Pagina from '../components/formularios/Pagina.astro';
import Vazio from '../components/visual/Vazio.astro';
import ConfirmarRemocao from '../components/ConfirmarRemocao.astro';
import { formatarData, formatarMomento } from '../lib/datas';
import { podeExcluirMemoria } from '../lib/servidor/permissoes';
import {
  listarCapitulos,
  listarCapitulosExcluidos,
  listarExcluidas,
  listarIntegrantes,
  listarPessoasExcluidas,
  listarRascunhosDeRelatoDescartados,
  obterMemoria,
  obterRelatoRegistradoPor,
} from '../lib/servidor/repositorio';

// Cada pessoa vê na lixeira só o que poderia recuperar: admins, as memórias que
// enxergavam; os demais, os próprios rascunhos descartados.
const { usuario } = Astro.locals;
const excluidas = (await listarExcluidas(usuario)).filter((m) => podeExcluirMemoria(usuario, m).ok);
const capitulos = usuario.admin ? await listarCapitulosExcluidos(usuario) : [];
// Excluir pessoa (decisão do Gui depois da sessão I): as pessoas na lixeira, só para os administradores
const pessoas = usuario.admin ? await listarPessoasExcluidas() : [];
// O rascunho de relato que ficou para trás e foi descartado (resposta do Gui à P4 do QA de 23/11/2026): só de quem o escreveu
const relatos = await listarRascunhosDeRelatoDescartados(usuario);
const integrantes = await listarIntegrantes();
const nome = (id: string | null) => {
  const i = integrantes.find((x) => x.id === id);
  return i?.apelido ?? i?.nome ?? 'alguém';
};
// Depois de restaurar uma memória ou um capítulo, a pessoa continua na lixeira, com o caminho para o que voltou (resposta do Gui
// à P154, 17/11/2026). Só entra o que ela pode ver: a busca é a de sempre.
const restaurada = Astro.url.searchParams.get('restaurada');
const memoriaDeVolta = restaurada ? await obterMemoria(usuario, restaurada) : undefined;
const restaurado = Astro.url.searchParams.get('restaurado');
const capituloDeVolta = restaurado ? (await listarCapitulos(usuario)).find((c) => c.id === restaurado) : undefined;
const relatoRestaurado = Number(Astro.url.searchParams.get('rascunho-de-relato')) || 0;
// Já fora da lixeira: confere de novo que o rascunho é de quem olha, numa memória que ela vê
const memoriaDoRelato = Astro.url.searchParams.get('memoria') ?? '';
const porDoRelato = Astro.url.searchParams.get('por') ?? '';
const relatoDeVolta =
  relatoRestaurado && porDoRelato && (await obterMemoria(usuario, memoriaDoRelato))
    ? await obterRelatoRegistradoPor(memoriaDoRelato, porDoRelato, usuario).then((r) => (r?.id === relatoRestaurado ? r : undefined))
    : undefined;
// Aprovado pelo Gui em 17/11/2026 (pergunta 8 do PR do grupo "formularios"): a linha pequena acima do título e os textos novos da abertura
---

<Pagina titulo="Lixeira" rotulo="Sua conta" secao="conta" larga>
  <Fragment slot="abertura">
    <p>
      {usuario.admin ? 'Memórias, capítulos e pessoas excluídos e rascunhos descartados.' : 'Seus rascunhos descartados.'} Nada aqui aparece no site, e tudo pode ser restaurado como estava.
      {usuario.admin && ' Nada some sozinho: só um administrador apaga de vez, um item por vez.'}
    </p>
    <p class="acoes">
      <a class="acao" href="/conta">Voltar para a sua conta</a>
    </p>
  </Fragment>
  {
    memoriaDeVolta && (
      <p class="acoes">
        <a class="acao" href={memoriaDeVolta.situacao === 'rascunho' ? `/nova?id=${memoriaDeVolta.id}` : `/memorias/${memoriaDeVolta.id}`}>
          {memoriaDeVolta.situacao === 'rascunho' ? 'Continuar o rascunho' : 'Ver a memória'}
        </a>
      </p>
    )
  }
  {
    relatoDeVolta && (
      <p class="acoes">
        <a class="acao" href={`/memorias/${relatoDeVolta.memoriaId}/relato?por=${relatoDeVolta.por}`}>Ver o rascunho</a>
      </p>
    )
  }
  {
    capituloDeVolta && (
      <p class="acoes">
        <a class="acao" href={`/capitulos/${capituloDeVolta.id}`}>Ver o capítulo</a>
      </p>
    )
  }
  {
    excluidas.length + capitulos.length + pessoas.length + relatos.length === 0 ? (
      <Vazio frase="A lixeira está vazia." />
    ) : (
      <ul class="linhas linhas--com-acao">
        {excluidas.map((m) => (
          <li>
            <div>
              <strong>{m.titulo}</strong>
              <span>
                {formatarData(m)}
                {m.situacao === 'rascunho' && ', rascunho'}
              </span>
            </div>
            <p class="dica">
              {m.situacao === 'rascunho' ? 'Descartado' : 'Excluída'} por {nome(m.excluidaPor)} em {formatarMomento(m.excluidaEm)}.
              {m.situacao === 'publicada' && ` ${m.fotos.length} ${m.fotos.length === 1 ? 'foto' : 'fotos'}, ${m.relatos} ${m.relatos === 1 ? 'relato' : 'relatos'}.`}
            </p>
            <div class="lixeira__acoes">
              <form method="post" action="/api/lixeira" class="em-linha">
                <input type="hidden" name="acao" value="restaurar-excluida" />
                <input type="hidden" name="memoria" value={m.id} />
                <button class="botao botao--leve" type="submit">Restaurar</button>
              </form>
              {usuario.admin && (
                <form method="post" action="/api/lixeira" class="lixeira__apagar">
                  <input type="hidden" name="memoria" value={m.id} />
                  <ConfirmarRemocao
                    rotulo="Apagar de vez"
                    pergunta={`Apagar de vez “${m.titulo}”? A ficha, os relatos e o histórico somem para sempre e não dá para restaurar.`}
                    acao="apagar-de-vez"
                    confirmar="Apagar de vez"
                  />
                </form>
              )}
            </div>
          </li>
        ))}
        {relatos.map((r) => (
          <li>
            <div>
              <strong>{r.por === usuario.pessoa ? 'Seu relato' : `Relato de ${nome(r.por)}`}</strong>
              <span>em “{r.titulo}”, rascunho</span>
            </div>
            <p class="dica">Descartado por você em {formatarMomento(r.descartadoEm)}.</p>
            <div class="lixeira__acoes">
              <form method="post" action="/api/lixeira" class="em-linha">
                <input type="hidden" name="acao" value="restaurar-rascunho-de-relato" />
                <input type="hidden" name="memoria" value={r.memoriaId} />
                <input type="hidden" name="relato" value={r.id} />
                <button class="botao botao--leve" type="submit">Restaurar</button>
              </form>
            </div>
          </li>
        ))}
        {capitulos.map((c) => (
          <li>
            <div>
              <strong>{c.titulo}</strong>
              <span>capítulo</span>
            </div>
            <p class="dica">Excluído em {formatarMomento(c.excluidoEm)}. As memórias dele continuam no acervo.</p>
            <div class="lixeira__acoes">
              <form method="post" action="/api/capitulos" class="em-linha">
                <input type="hidden" name="acao" value="restaurar" />
                <input type="hidden" name="id" value={c.id} />
                <button class="botao botao--leve" type="submit">Restaurar</button>
              </form>
              <form method="post" action="/api/lixeira" class="lixeira__apagar">
                <input type="hidden" name="capitulo" value={c.id} />
                <ConfirmarRemocao
                  rotulo="Apagar de vez"
                  pergunta={`Apagar de vez o capítulo “${c.titulo}”? Ele some para sempre. As memórias dele continuam no acervo.`}
                  acao="apagar-capitulo-de-vez"
                  confirmar="Apagar de vez"
                />
              </form>
            </div>
          </li>
        ))}
        {pessoas.map((p) => (
          <li>
            <div>
              <strong>{p.nome}</strong>
              <span>{p.tipo === 'bicho' ? 'bichinho' : 'pessoa'}</span>
            </div>
            <p class="dica">Excluída por {nome(p.excluidaPor)} em {formatarMomento(p.excluidaEm)}. Restaurar devolve a página, os laços e "Quem estava".</p>
            <div class="lixeira__acoes">
              <form method="post" action="/api/pessoas-excluidas" class="em-linha">
                <input type="hidden" name="acao" value="restaurar" />
                <input type="hidden" name="pessoa" value={p.id} />
                <button class="botao botao--leve" type="submit">Restaurar</button>
              </form>
            </div>
          </li>
        ))}
      </ul>
    )
  }
</Pagina>
