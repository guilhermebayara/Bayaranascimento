---
// A árvore da família inteira, com todas as ligações. Os controles mudam o que
// está em destaque e o que aparece, na hora, sem recarregar:
// - partir de: de quem é a linha direta (por padrão, Gui, Giovanna e Magno). O resto da
//   família fica em ramos recolhidos, que abrem por cima da árvore;
// - família: destaca uma família e deixa as outras mais apagadas, ou escondidas;
// - camadas: consideração e coração, ex-casais, bichos.
import '../visual/telas/arvore.css';
import Visual from '../layouts/Visual.astro';
import Vazio from '../components/visual/Vazio.astro';
import { anosDeVida } from '../lib/datas';
import { Familia, estaoJuntos, lacoParaODono, nomeDoPapel, possessivo, type Tratamento } from '../lib/parentesco';
import type { DadosDaArvore } from '../lib/cliente/arvore';
import { comLacoDeArvore } from '../lib/arvore-montagem';
import { pessoasQueNaoVe } from '../lib/servidor/permissoes';
import { enderecoDoRetrato, iniciais } from '../lib/retratos';
import { familiasDe, listarCasais, listarFiliacoes, listarIntegrantes, listarLacosDoCoracao, listarLacosResumidos, listarNucleos, pessoasEmLacosPrivadosDeOutros } from '../lib/servidor/repositorio';

// De quem é a linha direta mostrada quando a árvore abre: os três que unem os núcleos.
// Quem quiser parte de outra pessoa pelo seletor "Partir de" ou pela ficha.
const CENTROS_PADRAO = ['gui', 'giovanna', 'lucas-magno'];

const { usuario } = Astro.locals;
const todos = await listarIntegrantes();
const achar = (id: string) => integrantes.find((i) => i.id === id);
const chamar = (id: string) => achar(id)?.apelido ?? achar(id)?.nome ?? id;
const nucleos = await listarNucleos();
const filiacoes = await listarFiliacoes();
// Só chega ao navegador o que a pessoa pode ver: casais e laços privados de outros ficam no servidor
const casais = await listarCasais(usuario);
const lacos = await listarLacosDoCoracao(usuario);
// Quem só existe num laço privado de outra pessoa não aparece: nem o laço, nem o nome
const soEmPrivados = await pessoasEmLacosPrivadosDeOutros(usuario);
const temLacoVisivel = new Set<string>([usuario.pessoa, ...filiacoes.flatMap((f) => [f.filho, f.responsavel]), ...casais.flatMap((c) => [c.a, c.b]), ...lacos.flatMap((l) => [l.dono, l.pessoa])]);
const naoVe = pessoasQueNaoVe(soEmPrivados, temLacoVisivel);
const integrantes = todos.filter((i) => !naoVe.has(i.id));
const resumidos = (await listarLacosResumidos()).filter((r) => integrantes.some((i) => i.id === r.a) && integrantes.some((i) => i.id === r.b));
const centros = CENTROS_PADRAO.filter((id) => integrantes.some((i) => i.id === id));
const tratamentos = new Map<string, Tratamento>(integrantes.map((i) => [i.id, i.tratamento]));
const familia = new Familia(filiacoes, casais, tratamentos);
const minuscula = (texto: string) => texto.charAt(0).toLowerCase() + texto.slice(1);

// O que cada pessoa é de quem está olhando: parentesco, ou o laço do coração dela
const rotulo = (id: string) => {
  if (id === usuario.pessoa) return 'você';
  const relacao = familia.relacao(usuario.pessoa, id);
  if (relacao) return possessivo(relacao, achar(id)!.tratamento);
  const meu = lacos.find((l) => l.pessoa === id && l.dono === usuario.pessoa);
  return meu ? lacoParaODono(meu.nome, achar(id)!.tratamento) : '';
};

const dados: DadosDaArvore = {
  eu: usuario.pessoa,
  centros,
  nucleos: nucleos.map((n) => ({ id: n.id, nome: n.nome })),
  // Na árvore, membro e parente de uma família aparecem iguais: a cor e o lado vêm das duas coisas
  pessoas: integrantes.map((i) => ({
    id: i.id,
    nome: i.apelido ?? i.nome,
    rotulo: rotulo(i.id),
    nucleos: familiasDe(i),
    bicho: i.tipo === 'bicho',
    especie: i.especie,
    anos: anosDeVida(i),
    // Só para a ficha que abre ao tocar: os cartões da árvore continuam sem foto
    retrato: i.retrato ? enderecoDoRetrato(i.retrato) : null,
    iniciais: iniciais(i.apelido ?? i.nome),
  })),
  filiacoes: filiacoes.map((f) => ({ filho: f.filho, responsavel: f.responsavel, consideracao: f.qualidade === 'consideracao' })),
  casais: casais.filter((c) => c.fases.length > 0).map((c) => ({ a: c.a, b: c.b, ex: !estaoJuntos(c) })),
  resumidos: resumidos.map((r) => ({ a: r.a, b: r.b, papel: r.papel, rotulo: `${nomeDoPapel(r.papel, achar(r.b)?.tratamento ?? null)} de ${chamar(r.a)}` })),
  coracao: lacos.map((l) => ({
    dono: l.dono,
    pessoa: l.pessoa,
    papel: l.papel,
    rotulo: l.dono === usuario.pessoa ? lacoParaODono(l.nome, achar(l.pessoa)?.tratamento ?? null) : `${minuscula(l.nome)} de ${chamar(l.dono)}`,
  })),
};
const nomesDosCentros = (() => {
  const n = centros.map(chamar);
  return n.length > 1 ? `${n.slice(0, -1).join(', ')} e ${n[n.length - 1]}` : (n[0] ?? 'Você');
})();
const ordenados = [...integrantes].sort((a, b) => a.nome.localeCompare(b.nome, 'pt-BR'));
// "Partir de" só oferece quem tem laço de árvore (filiação ou casal): de quem não tem, a árvore seria só a pessoa
const comLaco = comLacoDeArvore(dados);
---

<Visual titulo="Árvore" secao="arvore">
  <div class="arvore" data-arvore>
    <div class="arvore__topo miolo">
      <h1 class="serifa t-2">Árvore</h1>
      <p>Arraste para andar pela família. Toque em alguém para ver quem é, e de novo para abrir a página. Os botões + abrem os outros ramos da família.</p>
    </div>

    <div class="mapa" data-mapa tabindex="0" aria-label="Árvore da família. Arraste ou use as setas para andar por ela.">
      <div class="mapa__camada" data-camada></div>
      <div class="mapa__camada mapa__camada--ramos" data-camada-ramos></div>

      <details class="mapa__painel" data-sobre-o-mapa>
        <summary>Ajustar a árvore</summary>
        <form data-controles>
          <label class="arvore__campo">
            <span>Partir de</span>
            <select name="centro">
              <option value="">{nomesDosCentros}</option>
              {ordenados.filter((i) => comLaco.has(i.id)).map((i) => <option value={i.id}>{i.nome}</option>)}
            </select>
          </label>
          <label class="arvore__campo">
            <span>Destacar</span>
            <select name="nucleo">
              <option value="">Família inteira</option>
              {nucleos.map((n) => <option value={n.id}>Família {n.nome}</option>)}
            </select>
          </label>
          <fieldset class="arvore__camadas">
            <legend>Mostrar</legend>
            <label class="marcar"><input type="checkbox" name="outros" checked /><span>Outras famílias</span></label>
            <label class="marcar"><input type="checkbox" name="consideracao" checked /><span>Consideração e coração</span></label>
            <label class="marcar"><input type="checkbox" name="ex" checked /><span>Ex-casais</span></label>
            <label class="marcar"><input type="checkbox" name="bichos" checked /><span>Bichos</span></label>
            <label class="marcar"><input type="checkbox" name="amigos" /><span>Amigos sem lugar na família</span></label>
          </fieldset>
        </form>
      </details>

      <p class="mapa__foco" data-sobre-o-mapa data-ficha-do-foco aria-live="polite"></p>

      <div class="mapa__zoom" data-sobre-o-mapa>
        <button type="button" data-ir-ao-foco>Ir ao foco</button>
        <button type="button" data-ver-tudo>Ver tudo</button>
        <button type="button" data-zoom-menos aria-label="Afastar">−</button>
        <span data-zoom-atual>100%</span>
        <button type="button" data-zoom-mais aria-label="Aproximar">+</button>
      </div>

      <details class="mapa__legenda" data-sobre-o-mapa open>
        <summary>Legenda</summary>
        <ul>
        {nucleos.map((n, i) => <li><i class="amostra-cor" style={`background: var(--arvore-familia-${i % 4})`}></i> {n.nome}</li>)}
        <li><i class="amostra-cor amostra-cor--fora"></i> amigos e de fora</li>
        <li><i class="amostra amostra--casal"></i> casal</li>
        <li><i class="amostra amostra--ex"></i> não estão mais juntos</li>
        <li><i class="amostra amostra--filhos"></i> pais e filhos</li>
        <li><i class="amostra amostra--coracao"></i> consideração ou coração</li>
        <li><i class="amostra amostra--bicho"></i> bichos da família</li>
        <li><b class="amostra-botao">♥ 2</b> abre os laços do coração de alguém</li>
        </ul>
      </details>
    </div>
    <noscript>
      {/* Sem script não há desenho: o mapa vazio e os controles dele saem, e fica só o aviso */}
      <style is:inline>
        [data-mapa], .arvore__topo p { display: none !important; }
      </style>
      <div class="arvore__sem-script miolo">
        <Vazio frase="A árvore precisa de JavaScript para ser desenhada. As ligações de cada pessoa também aparecem na página dela, em Pessoas.">
          <a class="acao" href="/pessoas">Ver as pessoas</a>
        </Vazio>
      </div>
    </noscript>

    <p class="arvore__rodape miolo">
      <span data-sem-lacos hidden></span>
      <a class="acao acao--quieta" href="/pessoas/nova">Cadastrar uma pessoa</a>
    </p>
  </div>

  <script type="application/json" id="dados-da-arvore" set:html={JSON.stringify(dados).replace(/</g, '\\u003c')} />
</Visual>

<script>
  import { montarArvore, type DadosDaArvore } from '../lib/cliente/arvore';
  import { buscaDePessoa } from '../lib/cliente/busca-pessoa';

  const raiz = document.querySelector<HTMLElement>('[data-arvore]');
  const bruto = document.getElementById('dados-da-arvore')?.textContent;
  if (raiz && bruto) {
    montarArvore(raiz, JSON.parse(bruto) as DadosDaArvore);
    // "Partir de": busca com sugestão no lugar da lista com todo mundo
    const centro = raiz.querySelector<HTMLSelectElement>('select[name="centro"]');
    if (centro) buscaDePessoa(centro);
  }
</script>
