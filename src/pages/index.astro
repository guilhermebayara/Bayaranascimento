---
// Painel pessoal, a página inicial (docs/decisoes.md, "Painel pessoal como página inicial").
// A ideia da tela (docs/visual.md): na primeira visita, a carta de Natal assinada à mão. Depois, o
// que entrou de novo, como o envelope do laboratório que chega com fotos que a pessoa ainda não
// viu. Aniversários e atalhos, em segundo plano.
//
// A composição segue as respostas do Gui ao QA de design de 17/11/2026 (docs/qa/2026-11-17-perguntas.md,
// P13 a P28): na primeira visita, só a carta; sem novidade, a mesa recebe "Neste dia" ou a memória
// para contar; contar vem antes de "Neste dia"; os cartões se ajustam a quantos são. Quem decide
// onde cada parte fica é composicaoDoInicio(), em src/lib/painel.ts.
//
// É a página que só a pessoa vê, e por isso tem cara própria (pedido do Gui, 16/11/2026): a página
// inteira tingida na cor da família dela, o conteúdo em cartões, o nome dela sublinhado a caneta e
// o aviso "Só você vê esta página". As regras ficam em src/lib/painel.ts.
import '../visual/telas/painel.css';
import Visual from '../layouts/Visual.astro';
import Avisos from '../components/Avisos.astro';
import Carta from '../components/Carta.astro';
import Contar from '../components/painel/Contar.astro';
import Fila from '../components/painel/Fila.astro';
import IconeDoTipo from '../components/visual/IconeDoTipo.astro';
import Polaroid from '../components/visual/Polaroid.astro';
import Rabisco from '../components/visual/Rabisco.astro';
import Recado from '../components/visual/Recado.astro';
import Retrato from '../components/visual/Retrato.astro';
import { familiaMaisRecente } from '../lib/familias';
import { seusRascunhos } from '../lib/conta';
import {
  TITULO_DA_PROXIMIDADE,
  aniversarios,
  anoDaUltimaVisita,
  chegarAoPainel,
  composicaoDoInicio,
  emOutrosAnos,
  hojeNoBrasil,
  memoriaParaContar,
  nomeParaQuemOlha,
  novidades,
  voceNoAcervo,
  type Dia,
} from '../lib/painel';
import { Familia, possessivo, type Tratamento } from '../lib/parentesco';
import { enderecoDoRetrato } from '../lib/retratos';
import { semLogin } from '../lib/servidor/acesso';
import {
  comoOsExesAparecem,
  familiasDe,
  listarCasais,
  listarFiliacoes,
  listarAvisos,
  listarIntegrantes,
  listarMemorias,
  listarNucleos,
  listarRelatosPublicadosDesde,
  listarRelatosRegistradosPor,
  memoriasComRelatoDe,
  obterCarta,
  obterVisitas,
  pessoasQueONaoVe,
  salvarVisitas,
} from '../lib/servidor/repositorio';
import { corDaPessoa, corDoNucleo, diaMesCurto, estiloDoTipo, legendaLugarAno, nomeDaDecada } from '../lib/visual';

// Os endereços antigos da linha do tempo ("/?nucleo=...") continuam funcionando. Os recados de uma
// ação ("?ok=", "?erro=") são do painel e ficam aqui. "hoje" só vale fora da produção (abaixo).
const DO_PAINEL = ['ok', 'erro', 'hoje'];
if ([...Astro.url.searchParams.keys()].some((k) => !DO_PAINEL.includes(k))) return Astro.redirect(`/explorar${Astro.url.search}`, 301);

const { usuario } = Astro.locals;
const agora = new Date();
const carta = await obterCarta();
const chegada = chegarAoPainel(await obterVisitas(usuario.pessoa), agora, Boolean(carta));
await salvarVisitas(usuario.pessoa, chegada.registro);

const integrantes = await listarIntegrantes();
const nucleos = await listarNucleos();
const ordemDosNucleos = nucleos.map((n) => n.id);
const achar = (id: string) => integrantes.find((i) => i.id === id);
const nome = (id: string) => achar(id)?.apelido ?? achar(id)?.nome ?? id;
const eu = achar(usuario.pessoa);
const naoVe = await pessoasQueONaoVe(usuario);
const retratoDe = (id: string) => {
  const pessoa = achar(id);
  return pessoa?.retrato && !naoVe.has(id) ? enderecoDoRetrato(pessoa.retrato) : null;
};
const familiaDe = (id: string) => corDaPessoa(achar(id) ? familiasDe(achar(id)!) : [], ordemDosNucleos);
const tratamentos = new Map<string, Tratamento>(integrantes.map((i) => [i.id, i.tratamento]));
const filiacoes = await listarFiliacoes();
const casais = await listarCasais(usuario);
const familia = new Familia(filiacoes, casais, tratamentos);
// A cor do painel é a da família mais recente de quem vê: a que a pessoa formou com quem casou.
// A Giovanna e o Magno veem a cor da família que criaram juntos (decisão do Gui, 16/11/2026).
const minhaFamilia = familiaMaisRecente({ familias: new Map(integrantes.map((i) => [i.id, familiasDe(i)])), casais, filiacoes }, usuario.pessoa);
const corDoPainel = corDoNucleo(minhaFamilia, ordemDosNucleos);
/**
 * O nome e o parentesco do ponto de vista de quem olha: "Tia Cida" para o sobrinho, sem "sua tia"
 * embaixo, e "Lourdes", "sua irmã", para a irmã da Tia Lourdes (nomeParaQuemOlha, em src/lib/painel.ts).
 */
const paraQuemOlha = (id: string) => {
  const relacao = familia.relacao(usuario.pessoa, id);
  return nomeParaQuemOlha(nome(id), relacao ? possessivo(relacao, achar(id)?.tratamento ?? null) : undefined);
};
const nomeVisto = (id: string) => paraQuemOlha(id).nome;

// Só o que a pessoa pode ver, da mais antiga para a mais nova. No painel, só o que foi publicado.
const todas = await listarMemorias(usuario);
const memorias = todas.filter((m) => m.situacao === 'publicada');
const porId = new Map(memorias.map((m) => [m.id, m]));
const recentes = [...memorias].reverse();
const minhas = recentes.filter((m) => m.integrantes.includes(usuario.pessoa));
const acervo = voceNoAcervo(minhas);

// --- O que entrou de novo -------------------------------------------------------------------
const novo = chegada.novidadesDesde
  ? novidades(memorias, await listarRelatosPublicadosDesde(usuario, chegada.novidadesDesde), chegada.novidadesDesde, usuario.pessoa)
  : { memorias: [], relatos: [] };
// Aprovado pelo Gui em 17/11/2026 (pergunta 3 do PR do grupo "pessoal"): na mesa cabem duas memórias e um relato, como
// no conceito. O resto fica numa linha, com o caminho para "Entraram por último", no Explorar.
const naMesa = novo.memorias.slice(0, 2);
const relatoNaMesa = novo.relatos[0];
// O bilhete do relato novo: o rótulo diz só "Relato novo" e o título da memória vem numa linha própria (P24)
const relatoDaFila = relatoNaMesa && {
  memoriaId: relatoNaMesa.memoriaId,
  titulo: porId.get(relatoNaMesa.memoriaId)?.titulo ?? '',
  texto: relatoNaMesa.texto ?? '',
  por: nomeVisto(relatoNaMesa.por),
  registradoPor: relatoNaMesa.registradoPor !== relatoNaMesa.por ? nomeVisto(relatoNaMesa.registradoPor) : null,
};
const foraDaMesa = novo.memorias.length - naMesa.length + novo.relatos.length - (relatoNaMesa ? 1 : 0);
const POR_EXTENSO = ['nenhuma', 'uma', 'duas', 'três', 'quatro', 'cinco', 'seis', 'sete', 'oito', 'nove', 'dez'];
const contar = (n: number, um: string, varios: string, masculino = false) => {
  const numero = n === 1 && masculino ? 'um' : n === 2 && masculino ? 'dois' : (POR_EXTENSO[n] ?? String(n));
  return `${numero} ${n === 1 ? um : varios}`;
};
const partesDoResumo = [
  novo.memorias.length > 0 ? contar(novo.memorias.length, 'memória', 'memórias') : '',
  novo.relatos.length > 0 ? contar(novo.relatos.length, 'relato', 'relatos', true) : '',
].filter(Boolean);
const verbo = novo.memorias.length + novo.relatos.length > 1 ? 'Entraram' : 'Entrou';

// --- O dia de hoje ----------------------------------------------------------------------------
// Fora da produção, "?hoje=2026-12-24" mostra o painel como num outro dia, para conferir os
// aniversários e o "Neste dia, em outros anos" (e para as capturas saírem sempre iguais).
function diaPedido(): Dia | undefined {
  const m = semLogin() ? /^(\d{4})-(\d{2})-(\d{2})$/.exec(Astro.url.searchParams.get('hoje') ?? '') : null;
  return m ? { ano: Number(m[1]), mes: Number(m[2]), dia: Number(m[3]) } : undefined;
}
const hoje = diaPedido() ?? hojeNoBrasil(agora);
const ultimaVisita = chegada.novidadesDesde ? hojeNoBrasil(new Date(`${chegada.novidadesDesde.replace(' ', 'T')}Z`)) : undefined;

// --- Os próximos aniversários (30 dias) ------------------------------------------------------------
// Ex discreto ou fora sai dos aniversários de quem escolheu (resposta do Gui à sessão F, 18/11/2026)
const exesQueSaem = await comoOsExesAparecem(usuario);
const proximos = aniversarios(integrantes, hoje, new Set([...naoVe, ...exesQueSaem.keys()]), usuario.pessoa);
const quando = (emDias: number, dia: number, mes: number) => (emDias === 0 ? 'Hoje' : emDias === 1 ? 'Amanhã' : diaMesCurto({ dia, mes }));

// --- A pessoa no acervo e uma memória para contar ---------------------------------------------
// Nunca a mesma memória que já está entre as novidades
const paraContar = memoriaParaContar(memorias, await memoriasComRelatoDe(usuario.pessoa), usuario.pessoa, new Set(novo.memorias.map((m) => m.id)));

// --- Neste dia, em outros anos ------------------------------------------------------------------
const outrosAnos = emOutrosAnos(memorias, hoje);

const primeiroAno = memorias[0]?.ano;
const ultimoAno = memorias.at(-1)?.ano;
const decadas = [...new Set(recentes.map((m) => Math.floor(m.ano / 10) * 10))];

// --- Os rascunhos da pessoa -------------------------------------------------------------------
// Uma linha na abertura, para continuar o que ficou pela metade (P6). A lista mora em "Sua conta".
const rascunhos = seusRascunhos(usuario.pessoa, await listarMemorias(usuario, { rascunhos: true }), await listarRelatosRegistradosPor(usuario));
const quantosRascunhos = rascunhos.memorias.length + rascunhos.relatos.length;
const oRascunho = rascunhos.memorias[0] ? `/nova?id=${rascunhos.memorias[0].id}` : rascunhos.relatos[0] ? `/memorias/${rascunhos.relatos[0].memoriaId}/relato` : undefined;

// --- Onde cada parte fica -----------------------------------------------------------------------
const composicao = composicaoDoInicio({
  memoriasNovas: novo.memorias.length,
  relatosNovos: novo.relatos.length,
  outrosAnos: outrosAnos?.itens.length ?? 0,
  contar: Boolean(paraContar),
  aniversarios: proximos.length > 0,
  voce: Boolean(eu && minhas.length > 0),
});

const cartaNoAlto = chegada.cartaNoAlto && carta && eu;
// Os avisos ficam no alto, junto das novidades (docs/decisoes.md, "Avisos")
const avisos = cartaNoAlto ? [] : await listarAvisos(usuario);
const ok = Astro.url.searchParams.get('ok');
const erro = Astro.url.searchParams.get('erro');
---

<Visual titulo="Início" secao="painel" familia={corDoPainel} intimo>
  {
    (ok || erro) && (
      <div class="miolo painel__recado">
        <Recado erro={Boolean(erro)}>{erro ?? ok}</Recado>
      </div>
    )
  }
  {
    // Na primeira visita, só a carta. "Abrir o acervo" traz ao Início normal, e a carta vira o link discreto (P14, P15)
    cartaNoAlto && <Carta para={usuario.nome} carta={carta} fotos={minhas.filter((m) => m.fotos.length > 0)} acao={{ href: '/', texto: 'Abrir o acervo' }} />
  }
  {
    !cartaNoAlto && (
      <section class="novo miolo grade" aria-labelledby="ola">
        <header class:list={['novo__abre', { 'novo__abre--sem-envelope': !composicao.envelope }]}>
          <p class="rotulo suave">Só você vê esta página</p>
          <h1 class="t-1" id="ola">
            Oi,{' '}
            <span class="sublinhado">
              {usuario.nome}
              <Rabisco desenho="sublinha" />
            </span>
            .
          </h1>
          {/* Aprovado pelo Gui em 17/11/2026 (pergunta 4 do PR do grupo "pessoal"): a frase de quem chega sem visita anterior */}
          <p class="serifa t-abertura novo__resumo">
            {partesDoResumo.length > 0
              ? `${verbo} ${partesDoResumo.join(' e ')} desde a sua última visita.`
              : ultimaVisita
                ? 'Nada de novo desde a sua última visita.'
                : 'Que bom que você chegou.'}
          </p>
          <Avisos avisos={avisos} onde="inicio" />
          {quantosRascunhos > 0 && (
            <p class="novo__rascunho">
              <span>{quantosRascunhos === 1 ? 'Você tem um rascunho.' : `Você tem ${quantosRascunhos} rascunhos.`}</span>
              <a class="acao" href={quantosRascunhos === 1 && oRascunho ? oRascunho : '/conta#rascunhos'}>
                {quantosRascunhos === 1 ? 'Continuar o rascunho' : 'Ver seus rascunhos'}
              </a>
            </p>
          )}
          <p class="novo__carta">
            {ultimaVisita && <span class="suave">{`Sua última visita foi em ${diaMesCurto(ultimaVisita)}${anoDaUltimaVisita(ultimaVisita, hoje)}.`}</span>}
            {carta && (
              <a class="acao acao--quieta" href="/carta">
                Carta de Natal
              </a>
            )}
          </p>
          {composicao.envelope && (
            <div class="novo__envelope">
              <Rabisco desenho="envelope" />
            </div>
          )}
        </header>

        {composicao.mesa === 'novidades' && (
          <div class="novo__direita">
            {naMesa.length > 0 && (
              <ol class="novo__mesa">
                {naMesa.map((m) => (
                  <li class="novidade novidade--memoria" style={estiloDoTipo(m.tipo)}>
                    <a href={`/memorias/${m.id}`}>
                      <Polaroid id={m.id} fotos={m.fotos} legenda={legendaLugarAno(m.lugar, m.ano)} alt="" cedo forma tipo={m.tipo} />
                      <span class="novidade__sobre rotulo">
                        <IconeDoTipo tipo={m.tipo} />
                        Memória nova · {nomeVisto(m.criadaPor)} adicionou
                      </span>
                      <strong class="novidade__titulo serifa t-3">{m.titulo}</strong>
                    </a>
                  </li>
                ))}
              </ol>
            )}
            {!composicao.filaInteira && <Fila relato={relatoDaFila} resto={foraDaMesa} />}
          </div>
        )}
        {composicao.mesa === 'novidades' && composicao.filaInteira && <Fila relato={relatoDaFila} resto={foraDaMesa} inteira />}

        {
          // Sem novidade, no computador, a mesa recebe "Neste dia", como fotos tiradas da caixa (P13).
          // No celular, quem aparece é o cartão de baixo, depois da memória para contar.
          composicao.mesa === 'outros-anos' && outrosAnos && (
            <section class="novo__direita novo__caixa" aria-labelledby="da-caixa">
              <h2 class="cartao__titulo rotulo" id="da-caixa">
                <IconeDoTipo tipo="outro" />
                {TITULO_DA_PROXIMIDADE[outrosAnos.proximidade]}
              </h2>
              <ol class="novo__mesa">
                {outrosAnos.itens.slice(0, 2).map((m) => (
                  <li class="novidade novidade--memoria" style={estiloDoTipo(m.tipo)}>
                    <a href={`/memorias/${m.id}`}>
                      <Polaroid id={m.id} fotos={m.fotos} legenda={legendaLugarAno(m.lugar, m.ano)} alt="" cedo forma tipo={m.tipo} />
                      <span class="novidade__sobre rotulo">
                        <IconeDoTipo tipo={m.tipo} />
                        Em {m.ano}
                      </span>
                      <strong class="novidade__titulo serifa t-3">{m.titulo}</strong>
                    </a>
                  </li>
                ))}
                {outrosAnos.itens.slice(2).map((m) => (
                  <li class="novidade novidade--outro" style={estiloDoTipo(m.tipo)}>
                    <a class="outro-ano" href={`/memorias/${m.id}`}>
                      <span class="outro-ano__foto">
                        <Polaroid id={m.id} fotos={m.fotos} legenda={legendaLugarAno(m.lugar, m.ano)} alt="" monte={false} tipo={m.tipo} />
                      </span>
                      <span class="outro-ano__texto">
                        <span class="outro-ano__ano serifa">em {m.ano}</span>
                        <strong class="outro-ano__titulo">{m.titulo}</strong>
                      </span>
                    </a>
                  </li>
                ))}
              </ol>
            </section>
          )
        }

        {/* Sem novidade e sem "Neste dia", a mesa recebe a memória para contar (P13) */}
        {composicao.mesa === 'contar' && paraContar && <Contar memoria={paraContar} />}
      </section>
    )
  }

  {
    !cartaNoAlto && (
      <div class="cartoes miolo" data-colunas={composicao.naFileira} data-faixa={composicao.outrosAnosEmFaixa ? (paraContar ? 'com-contar' : 'sozinha') : undefined}>
        {/* Contar vem logo depois das novidades, antes de "Neste dia" (P16) */}
        {composicao.mesa !== 'contar' && paraContar && <Contar memoria={paraContar} />}

        {outrosAnos && (
          <section
            class:list={['cartao', 'outros-anos', { 'outros-anos--faixa': composicao.outrosAnosEmFaixa, 'outros-anos--so-celular': composicao.mesa === 'outros-anos' }]}
            aria-labelledby="outros-anos"
          >
            <h2 class="cartao__titulo rotulo" id="outros-anos">
              <IconeDoTipo tipo="outro" />
              {TITULO_DA_PROXIMIDADE[outrosAnos.proximidade]}
            </h2>
            <ol class="outros-anos__lista">
              {outrosAnos.itens.map((m) => (
                <li style={estiloDoTipo(m.tipo)}>
                  <a class="outro-ano" href={`/memorias/${m.id}`}>
                    <span class="outro-ano__foto">
                      <Polaroid id={m.id} fotos={m.fotos} legenda={legendaLugarAno(m.lugar, m.ano)} alt="" monte={false} tipo={m.tipo} />
                    </span>
                    <span class="outro-ano__texto">
                      <span class="outro-ano__ano serifa">em {m.ano}</span>
                      <strong class="outro-ano__titulo">{m.titulo}</strong>
                    </span>
                  </a>
                </li>
              ))}
            </ol>
          </section>
        )}

        {proximos.length > 0 && (
          <section class="cartao aniversarios" aria-labelledby="aniversarios" style={estiloDoTipo('aniversario')}>
            <h2 class="cartao__titulo rotulo" id="aniversarios">
              <IconeDoTipo tipo="aniversario" />
              Próximos aniversários
            </h2>
            <ul>
              {proximos.map((a) => {
                const quem = paraQuemOlha(a.pessoa.id);
                return (
                  <li>
                    <a class="aniversario" href={`/pessoas/${a.pessoa.id}`}>
                      <Retrato nome={quem.nome} foto={retratoDe(a.pessoa.id)} familia={familiaDe(a.pessoa.id)} />
                      <span class="aniversario__quem">
                        <strong>{quem.nome}</strong>
                        <span class="suave">{[quem.parentesco, a.faz ? `faz ${a.faz} ${a.faz === 1 ? 'ano' : 'anos'}` : ''].filter(Boolean).join(', ')}</span>
                      </span>
                      <span class="aniversario__dia serifa">{quando(a.emDias, a.dia, a.mes)}</span>
                    </a>
                  </li>
                );
              })}
            </ul>
          </section>
        )}

        {eu && minhas.length > 0 && (
          // Proposta B do conceito da sessão H (escolha do Gui, 18/11/2026): o retrato vira a assinatura do
          // cartão, o corpo é uma frase com o número grande, e as fotos das memórias mais recentes em que a
          // pessoa aparece ficam embaixo, pequenas, como fotos soltas da caixa
          <section class="cartao voce" aria-labelledby="voce">
            <h2 class="voce__alto" id="voce">
              <Retrato nome={usuario.nome} foto={retratoDe(usuario.pessoa)} familia={corDoPainel} redondo />
              <span class="rotulo">Você no acervo</span>
            </h2>
            <p class="voce__frase serifa">
              Você aparece em <span class="voce__numero">{acervo.quantas}</span> {acervo.quantas === 1 ? 'memória' : 'memórias'}
              {acervo.de && <span class="voce__anos">, de {acervo.de} a {acervo.ate}</span>}.
            </p>
            {acervo.comFoto.length > 0 && (
              <ul class="voce__fotos" aria-label="As mais recentes em que você aparece">
                {acervo.comFoto.map((m) => (
                  <li>
                    <a href={`/memorias/${m.id}`} aria-label={m.titulo}>
                      <img src={`/fotos/${(m.fotos.find((f) => f.principal) ?? m.fotos[0])!.chave}`} alt="" loading="lazy" decoding="async" />
                    </a>
                  </li>
                ))}
              </ul>
            )}
            <p class="voce__links">
              <a class="acao" href={`/pessoas/${usuario.pessoa}`}>
                Ver sua página
              </a>
              <a class="acao" href={`/arvore?centro=${usuario.pessoa}`}>
                Ver a árvore a partir de você
              </a>
            </p>
          </section>
        )}
      </div>
    )
  }

  {
    !cartaNoAlto && (
      <section class="caminho miolo" aria-labelledby="caminho">
        <p class="rotulo suave">
          {memorias.length} {memorias.length === 1 ? 'memória' : 'memórias'}
          {primeiroAno && ultimoAno && primeiroAno !== ultimoAno ? ` · de ${primeiroAno} a ${ultimoAno}` : ''}
        </p>
        {/* O convite usa a palavra do menu (P1) e desce um degrau: a saudação é o único título grande (P20) */}
        <h2 class="caminho__titulo t-2" id="caminho">
          <a href="/explorar">
            Explorar todas as memórias <Rabisco desenho="seta" />
          </a>
        </h2>
        {decadas.length > 1 && (
          <ul class="caminho__decadas" aria-label="Ir para a década">
            {decadas.map((d) => (
              <li>
                <a class="serifa t-3" href={`/explorar#decada-${d}`}>
                  {`${nomeDaDecada(d).rotulo} ${nomeDaDecada(d).numero}`}
                </a>
              </li>
            ))}
          </ul>
        )}
      </section>
    )
  }

  {
    // Só fora da produção. Separado do convite por um fio, com o rótulo "Teste" (P28)
    semLogin() && (
      <form method="post" action="/api/painel" class="miolo painel__teste">
        <div class="painel__teste-linha">
