---
import Segmentado from '../../../components/visual/Segmentado.astro';
import FasesDepois from '../../../components/formularios/FasesDepois.astro';
import Pagina from '../../../components/formularios/Pagina.astro';
import FichaDoIntegrante from '../../../components/FichaDoIntegrante.astro';
import ConfirmarRemocao from '../../../components/ConfirmarRemocao.astro';
import ZonaDePerigo from '../../../components/visual/ZonaDePerigo.astro';
import Recado from '../../../components/visual/Recado.astro';
import CampoAno from '../../../components/CampoAno.astro';
import Opcoes from '../../../components/Opcoes.astro';
import ComoSeReferir from '../../../components/ComoSeReferir.astro';
import CampoData from '../../../components/CampoData.astro';
import Retrato from '../../../components/visual/Retrato.astro';
import { formatarData, jaFaleceu, vidaSemRotulo } from '../../../lib/datas';
import { enderecoDoRetrato } from '../../../lib/retratos';
import { corDaPessoa } from '../../../lib/visual';
import { FASES, Familia, PAPEIS, nomeDoPapel, periodosDasFases, PROXIMIDADES, QUALIDADES, estaoJuntos, type Papel, type Qualidade, type TipoDeFase } from '../../../lib/parentesco';
import { pessoasComAcesso } from '../../../lib/servidor/acesso';
import { podeEditarIntegrante, podeMexerEmLaco, podeMudarLacoDoCoracao, podeMudarQuemVeOCasal } from '../../../lib/servidor/permissoes';
import { casalDesfeito, opcoesDeQuemVe, opcoesDoModo } from '../../../lib/ex-casal';
import { enderecoDoLaco } from '../../../lib/pagina-do-laco';
import { comoOsExesAparecem, familiasDe, listarCasais, listarFiliacoes, listarIntegrantesQueVe, listarLacosDoCoracao, listarLacosResumidos, listarNucleos } from '../../../lib/servidor/repositorio';

const { usuario } = Astro.locals;
// Quem só existe num laço privado de outra pessoa não é editado nem oferecido nos laços (C1)
const integrantes = await listarIntegrantesQueVe(usuario);
const pessoa = integrantes.find((i) => i.id === Astro.params.id);
if (!pessoa) return new Response('Pessoa não encontrada', { status: 404 });

const comAcesso = await pessoasComAcesso();
// Quem não acessa o site não cuida da própria ficha (regra em podeEditarIntegrante): o texto diz quem cuida
const quemCuida = (() => {
  const nome = pessoa.apelido ?? pessoa.nome;
  const t = pessoa.tratamento;
  const da = t === 'ela' ? `da ${nome}` : t === 'ele' ? `do ${nome}` : `de ${nome}`;
  const queEla = t === 'ela' ? 'ela' : t === 'ele' ? 'ele' : nome;
  const cadastrou = t === 'ela' ? 'quem a cadastrou' : t === 'ele' ? 'quem o cadastrou' : 'quem fez o cadastro';
  return `A ficha ${da} é cuidada por quem é da mesma família que ${queEla}, por ${cadastrou} e pelos administradores.`;
})();
const podeFicha = podeEditarIntegrante(usuario, pessoa, comAcesso).ok;
const podeLacos = podeMexerEmLaco(usuario, [pessoa]).ok;
// Laço do coração qualquer pessoa cria, entre ela e quem quiser. Por isso a página abre para todos.
const ehMinha = pessoa.id === usuario.pessoa;
// Chegando do cadastro, esta página é a segunda etapa: só os laços
const recemCadastrada = Astro.url.searchParams.has('novo');

const familia = new Familia(await listarFiliacoes(), await listarCasais(usuario));
const nome = (id: string) => {
  const i = integrantes.find((x) => x.id === id);
  return i?.apelido ?? i?.nome ?? id;
};
const chamar = pessoa.apelido ?? pessoa.nome;
const pais = familia.pais(pessoa.id);
const filhos = familia.filhos(pessoa.id);
const casais = familia.casais(pessoa.id);
// Ex-casal (decisões do Gui, 18/11/2026; src/lib/ex-casal.ts): num casal desfeito, quem vê é das duas
// pessoas, com a opção das famílias escolhidas, e cada uma escolhe como a outra aparece para ela
const modosDosExes = await comoOsExesAparecem(usuario);
const todasAsFamilias = await listarNucleos();
const quemVeTexto = (c: { visibilidade: string; nucleos?: string[] }) =>
  c.visibilidade === 'privado' ? 'só os dois veem' : c.visibilidade === 'nucleos' ? `só ${(c.nucleos ?? []).map((n) => `a família ${todasAsFamilias.find((f) => f.id === n)?.nome ?? n}`).join(' e ')} vê` : 'todos veem';
const outros = integrantes.filter((i) => i.id !== pessoa.id).sort((a, b) => a.nome.localeCompare(b.nome, 'pt-BR'));
const lacosDoCoracao = await listarLacosDoCoracao(usuario);
// Na própria página, todos os laços da pessoa. Na página de outra, só o laço com ela.
const meusLacos = lacosDoCoracao.filter((l) => l.dono === usuario.pessoa && (ehMinha || l.pessoa === pessoa.id));
// Os administradores mudam os laços do coração de outras pessoas que veem ("Administradores podem mais",
// 16/11/2026): os desta pessoa e os de outras com ela. O "só eu vejo" de outra pessoa nem chega aqui.
const lacosDeOutros = lacosDoCoracao.filter(
  (l) => l.dono !== usuario.pessoa && (l.dono === pessoa.id || l.pessoa === pessoa.id) && podeMudarLacoDoCoracao(usuario, l).ok && integrantes.some((i) => i.id === l.dono) && integrantes.some((i) => i.id === l.pessoa),
);
// Laço resumido: só entre pessoas de fora das famílias (ver api/lacos.ts)
const deFora = familiasDe(pessoa).length === 0;
const resumidos = (await listarLacosResumidos()).filter((l) => l.a === pessoa.id || l.b === pessoa.id);
const podeRemoverResumido = (l: { criadoPor: string | null }) => usuario.admin || l.criadoPor === usuario.pessoa;
// Quando o caminho completo já existe pela árvore (o irmão do Ed cadastrado como pai do Caio, com os pais
// dos dois), o atalho sobra: a página oferece a troca
const pelaArvore = (l: { a: string; b: string }) => {
  const r = familia.relacao(l.a, l.b);
  return r && !r.consideracao ? r.texto : undefined;
};
const abas = [
  ...(podeLacos
    ? [
        { valor: 'filho-de', nome: 'Pais', frase: `${chamar} é ${nomeDoPapel('filho', pessoa.tratamento)} de alguém` },
        { valor: 'pai-de', nome: 'Filhos', frase: `alguém é filho ou filha de ${chamar}` },
        { valor: 'casal', nome: 'Casal', frase: 'namoro, casamento ou ex' },
      ]
    : []),
  { valor: 'coracao', nome: 'Do coração', frase: ehMinha ? 'amigo, afilhado, alguém que é como da família' : `com ${chamar}, de você ou da família toda` },
  ...(deFora ? [{ valor: 'resumido', nome: 'Parente de amigo', frase: `alguém da família de ${chamar}, sem cadastrar quem fica no meio` }] : []),
];
const papeis = Object.entries(PAPEIS) as [Papel, string][];
const proximidades: [string, string][] = [['', 'Não dizer'], ...Object.entries(PROXIMIDADES)];
const tratamentoDe = (id: string) => integrantes.find((i) => i.id === id)?.tratamento ?? null;
const temLacos = pais.length + filhos.length + casais.length + resumidos.length + meusLacos.length > 0;
// Cadastro guiado (pedidos do Gui, 16/11/2026): depois da ficha, a primeira pergunta é se a pessoa é
// da família ou do coração, e cada caminho tem as perguntas que fazem sentido para ele, uma por tela.
// Da família: pais, casal, filhos. Do coração: o laço com quem está cadastrando, o casal, parentes que
// estão no acervo (amigos quase nunca têm os pais cadastrados). Bicho vai direto para a família dele.
// "outro" é o modo completo, com todos os tipos de laço; quem prefere pode deixar sempre assim (cookie).
const COOKIE_COMPLETO = 'lacos-completos';
const modoPedido = Astro.url.searchParams.get('modo');
if (modoPedido === 'sempre') Astro.cookies.set(COOKIE_COMPLETO, '1', { path: '/', maxAge: 60 * 60 * 24 * 365, sameSite: 'lax', httpOnly: true });
if (modoPedido === 'guiado') Astro.cookies.delete(COOKIE_COMPLETO, { path: '/' });
const sempreCompleto = modoPedido === 'sempre' || (modoPedido !== 'guiado' && Astro.cookies.get(COOKIE_COMPLETO)?.value === '1');
type Ramo = 'familia' | 'coracao';
const RAMOS: Record<Ramo, readonly string[]> = {
  familia: pessoa.tipo === 'bicho' ? ['pais'] : ['pais', 'casal', 'filhos'],
  coracao: ['coracao', 'casal', 'parentes'],
};
const passoPedido = Astro.url.searchParams.get('passo');
const ramoPedido = Astro.url.searchParams.get('ramo');
const passo: string =
  passoPedido && ['inicio', 'pais', 'casal', 'filhos', 'coracao', 'parentes', 'fim', 'outro'].includes(passoPedido)
    ? passoPedido
    : sempreCompleto
      ? 'outro'
      : pessoa.tipo === 'bicho'
        ? 'pais'
        : 'inicio';
const ramo: Ramo = passo === 'coracao' || passo === 'parentes' ? 'coracao' : passo === 'pais' || passo === 'filhos' ? 'familia' : ramoPedido === 'coracao' ? 'coracao' : 'familia';
const PASSOS = RAMOS[ramo];
const guiado = recemCadastrada && podeLacos && passo !== 'outro';
const enderecoDoPasso = (p: string, r: Ramo = ramo) => `/pessoas/${pessoa.id}/editar?novo=1&passo=${p}&ramo=${r}`;
const proximoPasso = (p: string): string => (PASSOS.indexOf(p) + 1 < PASSOS.length ? PASSOS[PASSOS.indexOf(p) + 1] : 'fim');
const passoAnterior = (p: string): string | undefined => (PASSOS.indexOf(p) > 0 ? PASSOS[PASSOS.indexOf(p) - 1] : pessoa.tipo === 'bicho' ? undefined : 'inicio');
const NOMES_DOS_PASSOS: Record<string, string> = {
  inicio: 'Ligação',
  perguntas: 'Perguntas',
  pais: pessoa.tipo === 'bicho' ? 'Família' : 'Pais',
  casal: 'Casal',
  filhos: 'Filhos',
  coracao: 'Laço',
  parentes: 'Parentes',
  fim: 'Pronto',
};
// Antes de escolher o caminho, a trilha não promete perguntas que talvez nem venham
const TRILHA = pessoa.tipo === 'bicho' ? [...PASSOS, 'fim'] : passo === 'inicio' ? ['inicio', 'perguntas', 'fim'] : ['inicio', ...PASSOS, 'fim'];
const PERGUNTAS: Record<string, { titulo: string; dica: string; laco: string; rotulo: string }> = {
  pais: {
    titulo: pessoa.tipo === 'bicho' ? `Quem é a família de ${chamar}?` : `Quem são os pais de ${chamar}?`,
    dica: pessoa.tipo === 'bicho' ? 'As famílias tratam os bichinhos como filhos: escolha de quem ele é.' : 'Um de cada vez. Depois de adicionar o primeiro, dá para adicionar o outro.',
    laco: 'filho-de',
    rotulo: pessoa.tipo === 'bicho' ? 'De quem é' : 'Pai ou mãe',
  },
  casal: { titulo: `${chamar} tem ou teve um casal?`, dica: 'Namoro, casamento, união, e também quem já se separou.', laco: 'casal', rotulo: 'Com quem' },
  filhos: { titulo: `${chamar} tem filhos?`, dica: 'Bichinhos da família também entram aqui.', laco: 'pai-de', rotulo: 'Filho ou filha' },
  coracao: { titulo: `O que ${chamar} é para você?`, dica: 'Do jeito que você chama: amiga, padrinho, vó de coração.', laco: 'coracao', rotulo: '' },
  parentes: {
    titulo: `Alguém da família de ${chamar} está no acervo?`,
    dica: `Um filho, um sobrinho, a mãe. Dá para dizer o parentesco sem cadastrar quem fica no meio.`,
    laco: 'resumido',
    rotulo: 'Quem',
  },
};
const jaNoPasso = (p: string): { nome: string; texto: string }[] =>
  p === 'pais'
    ? pais.map((x) => ({ nome: nome(x.responsavel), texto: nomeDoPapel('pai', tratamentoDe(x.responsavel)) }))
    : p === 'casal'
      ? casais.map((c) => ({ nome: nome(c.outro), texto: FASES[c.casal.fases[c.casal.fases.length - 1]?.tipo ?? 'namoro'].toLowerCase() }))
      : p === 'filhos'
        ? filhos.map((f) => ({ nome: nome(f.filho), texto: nomeDoPapel('filho', tratamentoDe(f.filho)) }))
        : p === 'coracao'
          ? meusLacos.filter((l) => l.pessoa === pessoa.id).map((l) => ({ nome: 'Você', texto: l.nome }))
          : p === 'parentes'
            ? resumidos.map((l) => ({ nome: nome(l.a === pessoa.id ? l.b : l.a), texto: l.a === pessoa.id ? `${nomeDoPapel(l.papel, tratamentoDe(l.b))} de ${chamar}` : `${chamar} é ${nomeDoPapel(l.papel, pessoa.tratamento)}` }))
            : [];
const volta = guiado ? `${enderecoDoPasso(passo)}#guia` : `/pessoas/${pessoa.id}/editar${recemCadastrada ? '?novo=1&passo=outro' : ''}#lacos`;
// "De consideração" saiu daqui: agora é o laço do coração que a família toda reconhece
const qualidades = (Object.entries(QUALIDADES) as [Qualidade, string][]).filter(([id]) => id !== 'consideracao');
// Na edição de uma filiação antiga de consideração, a opção continua lá para não trocar sem querer
const opcoesDeFiliacao = (atual?: Qualidade): [string, string][] => (atual === 'consideracao' ? (Object.entries(QUALIDADES) as [string, string][]) : qualidades);
const fases = Object.entries(FASES) as [TipoDeFase, string][];
// No cadastro guiado e no "Adicionar laço" completo, "Como estão hoje?" só oferece o que é estar junto:
// o fim tem um caminho só, "Já terminou" (respostas do Gui à P109 e à 47-N3, 17/11/2026). A separação, a
// amizade e o resto da história entram em "O que aconteceu depois?", já no cadastro (decisão do Gui,
// 18/11/2026; FasesDepois.astro) e também na edição do casal.
const FASES_DE_QUEM_ESTA_JUNTO: readonly TipoDeFase[] = ['namoro', 'noivado', 'casamento', 'uniao'];
const fasesDeHoje = fases.filter(([id]) => FASES_DE_QUEM_ESTA_JUNTO.includes(id));
// O que acontece ao remover um laço: some da árvore e das páginas, e não vai para a lixeira (resposta do Gui à 47-N2, 17/11/2026)
const FRASE_DO_LACO = 'O laço some da árvore e das páginas das duas pessoas. Não vai para a lixeira.';
const FRASE_DO_CASAL = 'O casal some da árvore e das páginas das duas pessoas. Não vai para a lixeira.';
// Aprovado pelo Gui em 17/11/2026 (pergunta 8 do PR do grupo "formularios"): a linha pequena acima do título e os textos novos da abertura

// --- Proposta A do conceito da sessão E (escolha do Gui, 18/11/2026) --------------------------------
// Uma página só: a ficha num resumo de uma linha, que abre no lugar, e cada grupo de laços num cartão,
// com o seu próprio "Adicionar", já no tipo certo. À esquerda, o índice com a ficha e cada grupo.
const nucleos = await listarNucleos();
const ordemDosNucleos = nucleos.map((n) => n.id);
const achar = (id: string) => integrantes.find((i) => i.id === id);
// A lista já vem sem quem só existe num laço privado de outra pessoa: o retrato segue a mesma regra
const retratoDe = (id: string) => (achar(id)?.retrato ? enderecoDoRetrato(achar(id)!.retrato!) : null);
const familiaDe = (id: string) => corDaPessoa(achar(id) ? familiasDe(achar(id)!) : [], ordemDosNucleos);
const faleceu = (id: string) => Boolean(achar(id) && jaFaleceu(achar(id)!));
// O resumo da ficha, numa linha: só o que existe
const resumoDaFicha = [
  pessoa.tipo === 'bicho' ? (pessoa.especie ?? 'bichinho') : null,
  pessoa.tratamento,
  vidaSemRotulo(pessoa, true),
  familiasDe(pessoa).map((id) => nucleos.find((n) => n.id === id)?.nome).filter(Boolean).join(' e '),
].filter(Boolean).join(' · ');
const sobreCurto = pessoa.sobre ? (pessoa.sobre.length > 90 ? `${pessoa.sobre.slice(0, 90).trimEnd()}…` : pessoa.sobre) : 'Sem história escrita ainda.';
type TipoNovo = 'filho-de' | 'pai-de' | 'casal' | 'coracao' | 'resumido';
type Grupo = { id: string; titulo: string; quantos: number; novo?: { laco: TipoNovo; rotulo: string; resto: string; comQuem: string } };
const grupos: Grupo[] = [
  ...(podeLacos
    ? [
        { id: 'pais', titulo: 'Pais', quantos: pais.length, novo: { laco: 'filho-de' as const, rotulo: 'Adicionar pai ou mãe', resto: 'pai ou mãe', comQuem: 'Pai ou mãe' } },
        { id: 'casal', titulo: casais.length > 1 ? 'Casais' : 'Casal', quantos: casais.length, novo: { laco: 'casal' as const, rotulo: 'Adicionar casal', resto: 'casal', comQuem: 'Com quem' } },
        { id: 'filhos', titulo: 'Filhos', quantos: filhos.length, novo: { laco: 'pai-de' as const, rotulo: 'Adicionar filho ou filha', resto: 'filho ou filha', comQuem: 'Filho ou filha' } },
      ]
    : []),
  {
    id: 'coracao',
    titulo: ehMinha ? 'Seus laços do coração' : `Seu laço do coração com ${chamar}`,
    quantos: meusLacos.length,
    novo: { laco: 'coracao' as const, rotulo: 'Adicionar laço do coração', resto: 'laço do coração', comQuem: 'Com quem' },
  },
  // "Parentes de fora das famílias": o laço resumido só vale entre quem é de fora (ver api/lacos.ts)
  ...(deFora || resumidos.length > 0
    ? [{ id: 'parentes', titulo: 'Parentes de fora das famílias', quantos: resumidos.length, novo: deFora ? { laco: 'resumido' as const, rotulo: 'Adicionar parente', resto: 'parente', comQuem: 'Quem' } : undefined }]
    : []),
  ...(lacosDeOutros.length > 0 ? [{ id: 'outros', titulo: 'Laços do coração de outras pessoas', quantos: lacosDeOutros.length }] : []),
];
const quantosLacos = grupos.reduce((n, g) => n + g.quantos, 0);
// A conta ao lado do título: pessoas, e no casal, casais
const conta = (g: Grupo) => (g.id === 'casal' ? `${g.quantos} ${g.quantos === 1 ? 'casal' : 'casais'}` : `${g.quantos} ${g.quantos === 1 ? 'pessoa' : 'pessoas'}`);
---

<Pagina titulo={chamar} aba={`Editar ${chamar}`} rotulo={recemCadastrada ? 'Nova pessoa' : 'Editar página e laços'} nucleos={familiasDe(pessoa)} secao="pessoas" larga={!guiado}>
  <Fragment slot="abertura">
    {!recemCadastrada && (
      <p>
        <a href={`/pessoas/${pessoa.id}`}>Voltar para a página</a>
        {/* O histórico da ficha e dos laços (onda 2), para quem pode mexer em alguma das duas coisas */}
        {(podeFicha || podeLacos) && (
          <>
            {' · '}
            <a href={`/pessoas/${pessoa.id}/historico`}>Ver o histórico</a>
          </>
        )}
      </p>
    )}
    {/* O índice: a ficha e cada grupo de laços, com quantas pessoas tem. No computador, onde há mouse,
        ele acompanha a rolagem (telas/formulario.css) */}
    {
      !guiado && (
        <nav class="indice-lacos" aria-label="Nesta página">
          {!recemCadastrada && (
            <a class="indice-lacos__ficha" href="#ficha">
              Ficha
            </a>
          )}
          <p class="rotulo suave">Laços · {quantosLacos}</p>
          <ul>
            {grupos.map((g) => (
              <li>
                <a href={`#grupo-${g.id}`}>
                  <span>{g.titulo}</span>
                  <span class="ficha suave">{g.quantos > 0 ? g.quantos : 'ninguém'}</span>
                </a>
              </li>
            ))}
          </ul>
        </nav>
      )
    }
  </Fragment>
  {
    recemCadastrada && (
      <ol class="etapas etapas--fluxo" aria-label="Etapas">
        <li><span data-feita="true"><b>1</b><span>Quem é</span></span></li>
        {guiado ? (
          TRILHA.map((p, n) => (
            <li>
              <span aria-current={p === passo ? 'step' : undefined} data-feita={String(n < TRILHA.indexOf(passo))}>
                <b>{n + 2}</b>
                <span>{NOMES_DOS_PASSOS[p]}</span>
              </span>
            </li>
          ))
        ) : (
          <li><span aria-current="step"><b>2</b><span>Laços</span></span></li>
        )}
      </ol>
    )
  }
  {
    guiado && passo === 'inicio' && (
      <section class="painel guia" id="guia">
        <h2>Como {chamar} se liga a vocês?</h2>
        <p class="dica">Escolha o caminho, e as perguntas seguintes são só as que fazem sentido para ele.</p>
        <ul class="escolhas">
          <li>
            <a class="escolha" href={enderecoDoPasso('pais', 'familia')}>
              <strong>Da família</strong>
              <span>Parente de sangue, por adoção ou por casamento. Vamos perguntar pais, casal e filhos.</span>
            </a>
          </li>
          <li>
            <a class="escolha" href={enderecoDoPasso('coracao', 'coracao')}>
              <strong>Do coração</strong>
              <span>Amigo, padrinho, alguém que é como da família. Vamos perguntar o que {chamar} é para você.</span>
            </a>
          </li>
        </ul>
        <p class="guia__completo">
          Prefere ver todos os tipos de laço de uma vez? <a href={`/pessoas/${pessoa.id}/editar?novo=1&passo=outro`}>Ver todos os tipos de laço</a>
        </p>
      </section>
    )
  }

  {
    guiado && passo !== 'fim' && passo !== 'inicio' && (
      <section class="painel guia" id="guia">
        <h2>{PERGUNTAS[passo].titulo}</h2>
        <p class="dica">{PERGUNTAS[passo].dica}</p>
        {jaNoPasso(passo).length > 0 && (
          <ul class="lacos">
            {jaNoPasso(passo).map((x) => (
              <li class="laco">
                <p class="laco__linha">
                  <strong>{x.nome}</strong>
                  <span>{x.texto}</span>
                </p>
              </li>
            ))}
          </ul>
        )}
        {passo === 'parentes' && !deFora ? (
          <p class="dica">{chamar} já é de uma das famílias, e dentro delas o caminho é cadastrado inteiro, pelos pais e filhos. Siga para a próxima pergunta.</p>
        ) : (
        <form method="post" action="/api/lacos" class="casal guia__form">
          <input type="hidden" name="acao" value="adicionar" />
          <input type="hidden" name="volta" value={volta} />
          <input type="hidden" name="sujeito" value={pessoa.id} />
          <input type="hidden" name="laco" value={PERGUNTAS[passo].laco} />
          {/* O título só aparece depois de alguém ser adicionado: antes, a pergunta já diz tudo (P110) */}
          {jaNoPasso(passo).length > 0 && <h3 class="casal__titulo">Adicionar mais alguém</h3>}
          {passo === 'coracao' && <input type="hidden" name="reconhece" value="eu" />}
          {passo !== 'coracao' && (<>
          <label class="campo">
            <span>{PERGUNTAS[passo].rotulo}</span>
            <select name="pessoa">
              <option value="">Escolha</option>
              {outros.map((i) => <option value={i.id}>{i.nome}</option>)}
            </select>
          </label>
          <label class="campo">
            <span>ou alguém que ainda não está no acervo</span>
            <input type="text" name="nomeNovo" maxlength="80" autocomplete="off" placeholder="Escreva o nome" />
          </label>
          <ComoSeReferir id="rotulo-tratamento-novo-guia" />
          </>)}
          {passo === 'coracao' ? (
            <>
              <label class="campo">
                <span>Nome do laço</span>
                <input type="text" name="nomeDoLaco" maxlength="40" autocomplete="off" required placeholder="Ex.: amiga, padrinho, vó de coração" />
              </label>
              <label class="campo">
                <span>Lugar na árvore <small>(opcional)</small></span>
                <select name="papel">
                  <option value="">Não aparece na árvore</option>
                  {papeis.map(([id, rotulo]) => <option value={id}>Como se fosse {rotulo}</option>)}
                </select>
              </label>
              <Opcoes nome="proximidade" rotulo="Proximidade" opcoes={proximidades} id="rotulo-proximidade-guia" dica="Só você vê." />
              <label class="marcar">
                <input type="checkbox" name="privado" />
                <span>Só eu vejo este laço</span>
              </label>
              <p class="dica">O laço é seu. Para a família toda reconhecer {chamar} como filho, irmão ou pai de consideração, use "Ver todos os tipos de laço".</p>
            </>
          ) : passo === 'parentes' ? (
            <>
              <label class="campo">
                <span>É o quê de {chamar}?</span>
                <select name="papelResumido">
                  {papeis.map(([id, rotulo]) => <option value={id}>{rotulo[0].toUpperCase() + rotulo.slice(1)} de {chamar}</option>)}
                </select>
              </label>
            </>
          ) : passo === 'casal' ? (
            <>
              <Opcoes nome="faseTipo" rotulo="Como estão hoje?" opcoes={fasesDeHoje} valor="casamento" id="rotulo-fase-guia" />
              <div class="em-linha__campo">
                <label for="guia-fase-inicio">Começou em <small>(se souber)</small></label>
                <CampoAno id="guia-fase-inicio" nome="faseInicio" />
              </div>
              <label class="marcar">
                <input type="checkbox" name="terminou" data-revela="terminou-guia" />
                <span>Já terminou</span>
              </label>
              <div class="em-linha__campo" data-depende="terminou-guia" hidden>
                <label for="guia-fase-fim">Terminou em</label>
                <CampoAno id="guia-fase-fim" nome="faseFim" />
              </div>
              <FasesDepois id="guia-fase-depois" rotuloDaPrimeira="rotulo-fase-guia" />
            </>
          ) : (
            <>
              <Opcoes nome="qualidade" rotulo="Filiação" opcoes={opcoesDeFiliacao()} valor="biologica" id="rotulo-qualidade-guia" />
              <div class="campo" data-adocao data-depende="adocao" hidden>
                <span>Data da adoção <small>(se souber)</small></span>
                <CampoData prefixo="adocao" id="adocao-guia" />
              </div>
            </>
          )}
          {/* Uma ação principal por tela: antes de adicionar alguém, é "Adicionar"; depois, "Próxima pergunta".
              Seguir fica na mesma linha da ação principal, à vista, e não no pé, longe da pergunta
              (observação do Gui, 18/11/2026) */}
          <div class="acoes acoes--pergunta">
            <button class={jaNoPasso(passo).length > 0 ? 'botao botao--leve' : 'botao'} type="submit">Adicionar</button>
            <a class={jaNoPasso(passo).length > 0 ? 'botao' : 'botao botao--leve'} href={enderecoDoPasso(proximoPasso(passo))} data-seguir>{jaNoPasso(passo).length > 0 ? 'Próxima pergunta' : 'Pular esta pergunta'}</a>
          </div>
        </form>
        )}
        {(passoAnterior(passo) || (passo === 'parentes' && !deFora)) && (
          <p class="acoes acoes--guia">
            {passoAnterior(passo) && <a class="botao botao--leve" href={enderecoDoPasso(passoAnterior(passo)!)}>Voltar</a>}
            {/* Sem formulário nesta pergunta (parentes de quem já é das famílias), seguir é a ação principal */}
            {passo === 'parentes' && !deFora && <a class="botao" href={enderecoDoPasso(proximoPasso(passo))} data-seguir>Próxima pergunta</a>}
          </p>
        )}
        <p class="guia__completo"><a href={`/pessoas/${pessoa.id}/editar?novo=1&passo=outro`}>Ver todos os tipos de laço</a></p>
      </section>
    )
  }

  {
    guiado && passo === 'fim' && (
      <section class="painel guia" id="guia">
        <h2>{chamar} está no acervo</h2>
        {temLacos ? (
          <ul class="lacos">
            {[...new Set([...RAMOS.familia, ...RAMOS.coracao])].flatMap((p) => jaNoPasso(p)).map((x) => (
              <li class="laco">
                <p class="laco__linha">
                  <strong>{x.nome}</strong>
                  <span>{x.texto}</span>
                </p>
              </li>
            ))}
          </ul>
        ) : (
          <p class="dica">Nenhum laço por enquanto. Dá para adicionar depois, na página de {chamar}.</p>
        )}
        {ramo === 'familia' ? (
          <p class="dica">{chamar} também é do seu coração? <a href={enderecoDoPasso('coracao', 'coracao')}>Adicionar um laço do coração</a></p>
        ) : (
          pessoa.tipo !== 'bicho' && <p class="dica">{chamar} tem pais ou filhos no acervo? <a href={enderecoDoPasso('pais', 'familia')}>Perguntar pela família</a></p>
        )}
        <p class="acoes">
          <a class="botao" href={`/pessoas/${pessoa.id}`}>Ver a página de {chamar}</a>
          {/* Aqui o link diz o que a pessoa vem fazer: adicionar um laço (P112) */}
          <a class="botao botao--leve" href={`/pessoas/${pessoa.id}/editar?novo=1&passo=outro`}>{temLacos ? 'Adicionar outro laço' : 'Adicionar um laço'}</a>
          <a class="botao botao--leve" href="/pessoas/nova">Cadastrar outra pessoa</a>
        </p>
      </section>
    )
  }

  {!guiado && (
  <div class="editar-pessoa">
    {/* A ficha vem antes dos laços: primeiro quem a pessoa é, depois com quem ela se liga (QA de UX, 16/11/2026).
        Fechada, é um resumo de uma linha; "Editar a ficha" abre os campos no lugar. Quem chega por #ficha
        (a conta, o aviso de ficha não salva, o índice) encontra a ficha aberta. Sem script, o resumo abre ao toque. */}
    {
      !recemCadastrada && (
        <section class="ficha-da-pessoa" id="ficha" aria-labelledby="titulo-ficha">
          <h2 class="rotulo suave" id="titulo-ficha">Ficha</h2>
          {podeFicha ? (
            <details class="cartao-da-ficha" data-ficha-cartao>
              <summary>
                <span class="cartao-da-ficha__retrato">
                  <Retrato nome={chamar} foto={retratoDe(pessoa.id)} familia={familiaDe(pessoa.id)} falecido={jaFaleceu(pessoa)} cedo />
                </span>
                <span class="cartao-da-ficha__quem">
                  <strong>{pessoa.nome}</strong>
                  {resumoDaFicha && <span class="ficha suave">{resumoDaFicha}</span>}
                  <span class="suave cartao-da-ficha__sobre">{sobreCurto}</span>
                </span>
                <span class="acao cartao-da-ficha__abre">
                  <span class="cartao-da-ficha__editar">Editar a ficha</span>
                  <span class="cartao-da-ficha__fechar">Fechar</span>
                </span>
              </summary>
              <div class="cartao-da-ficha__campos">
                <FichaDoIntegrante integrante={pessoa} />
              </div>
            </details>
          ) : (
            <div class="cartao-da-ficha">
              <div class="cartao-da-ficha__linha">
                <span class="cartao-da-ficha__retrato">
                  <Retrato nome={chamar} foto={retratoDe(pessoa.id)} familia={familiaDe(pessoa.id)} falecido={jaFaleceu(pessoa)} cedo />
                </span>
                <span class="cartao-da-ficha__quem">
                  <strong>{pessoa.nome}</strong>
                  {resumoDaFicha && <span class="ficha suave">{resumoDaFicha}</span>}
                </span>
              </div>
              {comAcesso.has(pessoa.id) ? (
                <p class="dica">A ficha de {chamar} só pode ser alterada por {pessoa.tratamento === 'ela' ? 'ela mesma' : pessoa.tratamento === 'ele' ? 'ele mesmo' : 'quem é dono da página'}.</p>
              ) : (
                <p class="dica">{quemCuida}</p>
              )}
            </div>
          )}
        </section>
      )
    }

  <section class="lacos-da-pessoa" id="lacos" aria-labelledby="titulo-lacos">
    <h2 class="rotulo suave" id="titulo-lacos">Laços de {chamar}</h2>
    {recemCadastrada && podeLacos && (
      <p class="dica guia__completo">
        Você está vendo todos os tipos de laço.{' '}
        {sempreCompleto ? (
          <>Esta etapa sempre abre assim para você. <a href={`/pessoas/${pessoa.id}/editar?novo=1&passo=inicio&modo=guiado`}>Voltar para as perguntas guiadas</a></>
        ) : (
          <>
            <a href={`/pessoas/${pessoa.id}/editar?novo=1&passo=inicio`}>Voltar para as perguntas guiadas</a> ou <a href={`/pessoas/${pessoa.id}/editar?novo=1&passo=outro&modo=sempre`}>abrir sempre assim</a>
          </>
        )}
      </p>
    )}
    {/* A ficha e os laços são salvos em separado. Se a ficha foi mexida e um laço foi salvo antes dela,
        o que estava escrito volta para os campos e este aviso aparece (P114). O link abre a ficha de volta. */}
    {!recemCadastrada && podeFicha && (
      <div data-ficha-pendente hidden>
        <Recado>
          A ficha tem mudanças que ainda não foram salvas. O que você escreveu continua lá.
          <span data-ficha-pendente-foto hidden> A mudança na foto não ficou guardada: faça de novo antes de salvar.</span>{' '}
          <a href="#ficha">Voltar à ficha para salvar</a>
        </Recado>
      </div>
    )}

    {/* Cada grupo de laços é um cartão: o título, as pessoas e, no pé, o "Adicionar" daquele grupo, já no
        tipo certo. Vazio, o grupo fica numa linha só. Cada laço tem "Editar", e remover fica dentro da edição. */}
    <div class="grupos-de-lacos">
    {grupos.map((g) => (
      <section class:list={['grupo-de-lacos', { 'grupo-de-lacos--vazio': g.quantos === 0 }]} id={`grupo-${g.id}`} aria-labelledby={`titulo-grupo-${g.id}`}>
        <header class="grupo-de-lacos__titulo">
          <h3 id={`titulo-grupo-${g.id}`}>{g.titulo}</h3>
          {g.quantos > 0 ? <span class="ficha suave">{conta(g)}</span> : <span class="suave grupo-de-lacos__nenhum">nenhum ainda.</span>}
        </header>
        {g.id === 'outros' && (
          <p class="dica">Como administrador, você muda o nome do laço e o lugar na árvore. A proximidade e o “só eu vejo” ficam com quem definiu o laço. A mudança fica guardada com o seu nome.</p>
        )}
        {g.quantos > 0 && (
          <ul class="lacos">
            {g.id === 'pais' && pais.map((p) => (
              <li class="laco">
                <div class="laco__quem">
                  <Retrato nome={nome(p.responsavel)} foto={retratoDe(p.responsavel)} familia={familiaDe(p.responsavel)} falecido={faleceu(p.responsavel)} />
                  <p class="laco__linha">
                    <strong>{nome(p.responsavel)}</strong>
                    {faleceu(p.responsavel) && <span class="so-leitor">, já faleceu</span>}
                    <span>{nomeDoPapel('pai', tratamentoDe(p.responsavel))} de {chamar}{p.qualidade === 'adotiva' && (`, adoção${p.adocao ? ` em ${formatarData({ ano: p.adocao.ano, mes: p.adocao.mes, dia: p.adocao.dia, aproximada: false })}` : ''}`)}{p.qualidade === 'consideracao' && ', de consideração'}</span>
                  </p>
                </div>
                <details class="editar" data-editar>
                  <summary class="botao botao--leve">Editar</summary>
                  <div class="editar__caixa">
                    <form method="post" action="/api/lacos">
                      <input type="hidden" name="volta" value={volta} />
                      <input type="hidden" name="acao" value="filiacao-salvar" />
                      <input type="hidden" name="filho" value={pessoa.id} />
                      <input type="hidden" name="responsavel" value={p.responsavel} />
                      <Opcoes nome="qualidade" rotulo="Filiação" opcoes={opcoesDeFiliacao(p.qualidade)} valor={p.qualidade} id={`rotulo-qualidade-${p.responsavel}`} />
                      <div class="campo" data-adocao data-depende="adocao" hidden={p?.qualidade !== 'adotiva'}>
                        <span>Data da adoção <small>(se souber)</small></span>
                        <CampoData prefixo="adocao" id={`adocao-${p.responsavel}`} ano={p?.adocao?.ano} mes={p?.adocao?.mes} dia={p?.adocao?.dia} />
                      </div>
                      <div class="acoes"><button class="botao" type="submit">Salvar</button><button class="botao botao--leve" type="button" data-editar-cancelar hidden>Cancelar</button></div>
                    </form>
                    <ZonaDePerigo menor nivel={4}>
                    <p>{FRASE_DO_LACO}</p>
                    <form method="post" action="/api/lacos" class="editar__remover">
                      <input type="hidden" name="volta" value={volta} />
                      <input type="hidden" name="filho" value={pessoa.id} />
                      <input type="hidden" name="responsavel" value={p.responsavel} />
                      <ConfirmarRemocao rotulo="Remover este laço" pergunta={`Remover o laço entre ${chamar} e ${nome(p.responsavel)}?`} acao="filiacao-remover" />
                    </form>
                    </ZonaDePerigo>
                  </div>
                </details>
              </li>
            ))}

            {g.id === 'casal' && casais.map((c) => {
              const periodos = periodosDasFases(c.casal.fases);
              return (
                <li class="laco laco--casal">
                  <div class="laco__quem">
                    <Retrato nome={nome(c.outro)} foto={retratoDe(c.outro)} familia={familiaDe(c.outro)} falecido={faleceu(c.outro)} />
                    <p class="laco__linha">
                      <strong>{chamar} e {nome(c.outro)}</strong>
                      {faleceu(c.outro) && <span class="so-leitor">, {nome(c.outro)} já faleceu</span>}
                      <span>{estaoJuntos(c.casal) ? 'juntos' : 'não estão mais juntos'}{c.casal.visibilidade !== 'todos' && `, ${quemVeTexto(c.casal)}`}</span>
                    </p>
                  </div>
                  <p class="laco__ver"><a href={enderecoDoLaco(pessoa.id, c.outro)}>Ver o laço</a></p>
                  {/* As fases como uma linha do tempo: o que aconteceu e quando */}
                  <ol class="fases">
                    {c.casal.fases.map((fase, n) => (
                      <li>
                        <strong>{FASES[fase.tipo]}</strong>
                        {periodos[n] && <span>{periodos[n]}</span>}
                      </li>
                    ))}
                  </ol>
                  <details class="editar" data-editar>
                    <summary class="botao botao--leve">Editar o casal</summary>
                    <div class="editar__caixa">
                      <form method="post" action="/api/lacos">
                        <input type="hidden" name="volta" value={volta} />
                        <input type="hidden" name="acao" value="casal-salvar" />
                        <input type="hidden" name="a" value={pessoa.id} />
                        <input type="hidden" name="b" value={c.outro} />
                        <p class="dica">As fases ficam na ordem em que aconteceram, e cada uma termina quando a seguinte começa. Toque numa fase para mudar.</p>
                        {c.casal.fases.map((fase, n) => (
                          <details class="fase">
                            <summary>
                              <span class="fase__nome">
                                <span class="fase__texto">{n + 1}. {FASES[fase.tipo]}{periodos[n] && `, ${periodos[n]}`}</span>
                                {/* Só aparece com "Remover esta fase" marcada, para a marca não sumir da vista (P120) */}
                                {c.casal.fases.length > 1 && <small class="fase__sai">será removida ao salvar</small>}
                              </span>
                              <span class="fase__mudar">Mudar</span>
                            </summary>
                            <fieldset>
                              <legend class="oculto-visualmente">{n + 1}ª fase</legend>
                              <Opcoes nome={`fase-${n}-tipo`} rotulo="O que foi" opcoes={fases} valor={fase.tipo} id={`rotulo-fase-${c.casal.id}-${n}`} />
                              <div class="em-linha">
                                <div class="em-linha__campo">
                                  <label for={`fase-${c.casal.id}-${n}-inicio`}>Começou em</label>
                                  <CampoAno id={`fase-${c.casal.id}-${n}-inicio`} nome={`fase-${n}-inicio`} valor={fase.inicioAno} />
                                </div>
                                {/* Uma fase acaba quando a seguinte começa: o fim só é pedido na última, ou onde já foi preenchido */}
                                {n === c.casal.fases.length - 1 || fase.fimAno ? (
                                  <div class="em-linha__campo">
                                    <label for={`fase-${c.casal.id}-${n}-fim`}>Terminou em <small>(se já acabou)</small></label>
                                    <CampoAno id={`fase-${c.casal.id}-${n}-fim`} nome={`fase-${n}-fim`} valor={fase.fimAno} />
                                  </div>
                                ) : (
                                  <input type="hidden" name={`fase-${n}-fim`} value="" />
                                )}
                              </div>
                              {c.casal.fases.length > 1 && (
                                <label class="marcar">
                                  <input type="checkbox" name={`fase-${n}-remover`} data-remover-fase />
                                  <span>Remover esta fase</span>
                                </label>
                              )}
                            </fieldset>
                          </details>
                        ))}
                        <fieldset class="fase--nova">
                          {/* Título de seção pequeno, como "Quem vê" (observação do Gui, 18/11/2026) */}
                          <legend class="rotulo suave">O que aconteceu depois? <small>(opcional)</small></legend>
                          <Opcoes nome={`fase-${c.casal.fases.length}-tipo`} rotulo="O que foi" opcoes={fases} id={`rotulo-fase-${c.casal.id}-nova`} />
                          <div class="em-linha__campo">
                            <label for={`fase-${c.casal.id}-nova-inicio`}>Em que ano?</label>
                            <CampoAno id={`fase-${c.casal.id}-nova-inicio`} nome={`fase-${c.casal.fases.length}-inicio`} />
                          </div>
                        </fieldset>
                        {/* A escolha vale para o casal inteiro: separada das fases, com o nome do que é (P121) */}
                        {!casalDesfeito(c.casal) ? (
                          <div class="quem-ve" role="group" aria-labelledby={`rotulo-quem-ve-${c.casal.id}`}>
                            <p class="rotulo suave" id={`rotulo-quem-ve-${c.casal.id}`}>Quem vê</p>
                            <label class="marcar">
                              <input type="checkbox" name="visibilidade" value="privado" checked={c.casal.visibilidade === 'privado'} />
                              <span>Só os dois veem este casal</span>
                            </label>
                          </div>
                        ) : podeMudarQuemVeOCasal(usuario, c.casal, comAcesso).ok ? (
                          // Casal desfeito: todos, famílias escolhidas ou só os dois, das duas pessoas do casal
                          <div class="quem-ve" role="group" aria-labelledby={`rotulo-quem-ve-${c.casal.id}`} data-quem-ve-do-casal>
                            <p class="rotulo suave" id={`rotulo-quem-ve-${c.casal.id}`}>Quem vê este laço</p>
                            <div class="opcoes" role="radiogroup">
                              {opcoesDeQuemVe().map((o) => (
                                <label class="opcao">
                                  <input type="radio" name="visibilidade" value={o.valor} checked={c.casal.visibilidade === o.valor} />
                                  <span>{o.rotulo}</span>
                                </label>
                              ))}
                            </div>
                            {opcoesDeQuemVe().map((o) => (
                              <p class="dica" data-dica-de={o.valor} hidden={c.casal.visibilidade !== o.valor}>{o.dica}</p>
                            ))}
                            <div class="quem-ve__familias" data-familias-do-casal>
                              <p class="rotulo suave">Quais famílias veem?</p>
                              <div class="opcoes">
                                {todasAsFamilias.map((f) => (
                                  <label class="opcao">
                                    <input type="checkbox" name="familiasDoCasal" value={f.id} checked={(c.casal.nucleos ?? []).includes(f.id)} />
                                    <span>{f.nome}</span>
                                  </label>
                                ))}
                              </div>
                            </div>
                          </div>
                        ) : (
                          <div class="quem-ve">
                            <p class="rotulo suave">Quem vê este laço</p>
                            <p class="dica">{quemVeTexto(c.casal).charAt(0).toUpperCase() + quemVeTexto(c.casal).slice(1)}. Só {chamar} e {nome(c.outro)} mudam quem vê.</p>
                          </div>
                        )}
                        {casalDesfeito(c.casal) && [c.casal.a, c.casal.b].includes(usuario.pessoa) && (() => {
                          // Como o ex aparece para quem olha: só para ela, sem mudar o que os outros veem
                          const outro = c.casal.a === usuario.pessoa ? c.casal.b : c.casal.a;
                          const modo = modosDosExes.get(outro) ?? 'presente';
                          return (
                            <div class="quem-ve" role="group" aria-labelledby={`rotulo-como-aparece-${c.casal.id}`} data-como-aparece>
                              <p class="rotulo suave" id={`rotulo-como-aparece-${c.casal.id}`}>Como {nome(outro)} aparece para você</p>
                              <div class="opcoes" role="radiogroup">
                                {opcoesDoModo(nome(outro)).map((o) => (
                                  <label class="opcao">
                                    <input type="radio" name="comoAparece" value={o.valor} checked={modo === o.valor} />
                                    <span>{o.rotulo}</span>
                                  </label>
                                ))}
                              </div>
                              {opcoesDoModo(nome(outro)).map((o) => (
                                <p class="dica" data-dica-de={o.valor} hidden={modo !== o.valor}>{o.dica}</p>
                              ))}
                              <p class="dica">Só muda para você. Os outros continuam vendo como antes.</p>
                            </div>
                          );
                        })()}
                        <div class="acoes"><button class="botao" type="submit">Salvar o casal</button><button class="botao botao--leve" type="button" data-editar-cancelar hidden>Cancelar</button></div>
                      </form>
                      <ZonaDePerigo menor nivel={4}>
                      <p>{FRASE_DO_CASAL}</p>
                      <form method="post" action="/api/lacos" class="editar__remover">
                        <input type="hidden" name="volta" value={volta} />
                        <input type="hidden" name="id" value={c.casal.id} />
                        <ConfirmarRemocao
                          rotulo="Apagar, foi cadastrado por engano"
                          pergunta={`Apagar o casal ${chamar} e ${nome(c.outro)}? Para registrar uma separação, acrescente a fase Separação em vez de apagar.`}
                          acao="casal-remover"
                          confirmar="Apagar"
                          semValidar
                        />
                      </form>
                      </ZonaDePerigo>
                    </div>
                  </details>
                </li>
              );
            })}

            {g.id === 'filhos' && filhos.map((f) => (
              <li class="laco">
                <div class="laco__quem">
                  <Retrato nome={nome(f.filho)} foto={retratoDe(f.filho)} familia={familiaDe(f.filho)} falecido={faleceu(f.filho)} />
                  <p class="laco__linha">
                    <strong>{nome(f.filho)}</strong>
                    {faleceu(f.filho) && <span class="so-leitor">, já faleceu</span>}
                    <span>{nomeDoPapel('filho', tratamentoDe(f.filho))} de {chamar}{f.qualidade === 'adotiva' && (`, adoção${f.adocao ? ` em ${formatarData({ ano: f.adocao.ano, mes: f.adocao.mes, dia: f.adocao.dia, aproximada: false })}` : ''}`)}{f.qualidade === 'consideracao' && ', de consideração'}</span>
                  </p>
                </div>
                <details class="editar" data-editar>
                  <summary class="botao botao--leve">Editar</summary>
                  <div class="editar__caixa">
                    <form method="post" action="/api/lacos">
                      <input type="hidden" name="volta" value={volta} />
                      <input type="hidden" name="acao" value="filiacao-salvar" />
                      <input type="hidden" name="filho" value={f.filho} />
                      <input type="hidden" name="responsavel" value={pessoa.id} />
                      <Opcoes nome="qualidade" rotulo="Filiação" opcoes={opcoesDeFiliacao(f.qualidade)} valor={f.qualidade} id={`rotulo-qualidade-${f.filho}`} />
                      <div class="campo" data-adocao data-depende="adocao" hidden={f?.qualidade !== 'adotiva'}>
                        <span>Data da adoção <small>(se souber)</small></span>
                        <CampoData prefixo="adocao" id={`adocao-${f.filho}`} ano={f?.adocao?.ano} mes={f?.adocao?.mes} dia={f?.adocao?.dia} />
                      </div>
                      <div class="acoes"><button class="botao" type="submit">Salvar</button><button class="botao botao--leve" type="button" data-editar-cancelar hidden>Cancelar</button></div>
                    </form>
                    <ZonaDePerigo menor nivel={4}>
                    <p>{FRASE_DO_LACO}</p>
                    <form method="post" action="/api/lacos" class="editar__remover">
                      <input type="hidden" name="volta" value={volta} />
                      <input type="hidden" name="filho" value={f.filho} />
                      <input type="hidden" name="responsavel" value={pessoa.id} />
                      <ConfirmarRemocao rotulo="Remover este laço" pergunta={`Remover o laço entre ${chamar} e ${nome(f.filho)}?`} acao="filiacao-remover" />
                    </form>
                    </ZonaDePerigo>
                  </div>
                </details>
              </li>
            ))}

            {g.id === 'coracao' && meusLacos.map((l) => (
              <li class="laco">
                <div class="laco__quem">
                  <Retrato nome={nome(l.pessoa)} foto={retratoDe(l.pessoa)} familia={familiaDe(l.pessoa)} falecido={faleceu(l.pessoa)} />
                  <p class="laco__linha">
                    <strong>{nome(l.pessoa)}</strong>
                    {faleceu(l.pessoa) && <span class="so-leitor">, já faleceu</span>}
                    <span>
                      {[l.nome, l.papel && `como se fosse ${PAPEIS[l.papel]}`, l.proximidade && PROXIMIDADES[l.proximidade].toLowerCase(), l.privado && 'só você vê']
                        .filter(Boolean)
                        .join(', ')}
                    </span>
                  </p>
                </div>
                <details class="editar" data-editar>
                  <summary class="botao botao--leve">Editar</summary>
                  <div class="editar__caixa">
                    <form method="post" action="/api/lacos">
                      <input type="hidden" name="volta" value={volta} />
                      <input type="hidden" name="acao" value="coracao-salvar" />
                      <input type="hidden" name="pessoa" value={l.pessoa} />
                      <label class="campo">
                        <span>Nome do laço</span>
                        <input type="text" name="nomeDoLaco" maxlength="40" autocomplete="off" required value={l.nome} />
                      </label>
                      <label class="campo">
                        <span>Lugar na árvore</span>
                        <select name="papel">
                          <option value="">Não aparece na árvore</option>
                          {papeis.map(([id, rotulo]) => <option value={id} selected={id === l.papel}>Como se fosse {rotulo}</option>)}
                        </select>
                      </label>
                      <Opcoes nome="proximidade" rotulo="Proximidade" opcoes={proximidades} valor={l.proximidade} id={`rotulo-proximidade-${l.id}`} dica="Só você vê." />
                      <label class="marcar">
                        <input type="checkbox" name="privado" checked={l.privado} />
                        <span>Só eu vejo este laço</span>
                      </label>
                      <div class="acoes"><button class="botao" type="submit">Salvar</button><button class="botao botao--leve" type="button" data-editar-cancelar hidden>Cancelar</button></div>
                    </form>
                    <ZonaDePerigo menor nivel={4}>
                    <p>{FRASE_DO_LACO}</p>
                    <form method="post" action="/api/lacos" class="editar__remover">
                      <input type="hidden" name="volta" value={volta} />
                      <input type="hidden" name="id" value={l.id} />
                      <ConfirmarRemocao rotulo="Remover este laço" pergunta={`Remover o seu laço do coração com ${nome(l.pessoa)}?`} acao="coracao-remover" />
                    </form>
                    </ZonaDePerigo>
                  </div>
                </details>
              </li>
            ))}

            {g.id === 'parentes' && resumidos.map((l) => (
              <li class="laco">
                <div class="laco__quem">
                  <Retrato nome={nome(l.a === pessoa.id ? l.b : l.a)} foto={retratoDe(l.a === pessoa.id ? l.b : l.a)} familia={familiaDe(l.a === pessoa.id ? l.b : l.a)} falecido={faleceu(l.a === pessoa.id ? l.b : l.a)} />
                  <p class="laco__linha">
                    <strong>{nome(l.a === pessoa.id ? l.b : l.a)}</strong>
                    {faleceu(l.a === pessoa.id ? l.b : l.a) && <span class="so-leitor">, já faleceu</span>}
                    <span>{l.a === pessoa.id ? `${nomeDoPapel(l.papel, tratamentoDe(l.b))} de ${chamar}` : `${chamar} é ${nomeDoPapel(l.papel, pessoa.tratamento)} de ${nome(l.a)}`}</span>
                  </p>
                </div>
                {pelaArvore(l) && (
                  <p class="dica">O caminho completo já está cadastrado: pela árvore, {nome(l.b)} é {pelaArvore(l)} de {nome(l.a)}. Este atalho não é mais preciso.</p>
                )}
                {pelaArvore(l) && podeLacos ? (
                  <form method="post" action="/api/lacos" class="acoes">
                    <input type="hidden" name="volta" value={volta} />
                    <input type="hidden" name="id" value={l.id} />
                    <button class="botao botao--leve" type="submit" name="acao" value="resumido-remover">Trocar pelo caminho completo</button>
                  </form>
                ) : (
                  podeRemoverResumido(l) && (
                    <details class="editar" data-editar>
                      <summary class="botao botao--leve">Editar</summary>
                      <div class="editar__caixa">
                        <form method="post" action="/api/lacos">
                          <input type="hidden" name="volta" value={volta} />
                          <input type="hidden" name="acao" value="resumido-salvar" />
                          <input type="hidden" name="sujeito" value={l.a} />
                          <input type="hidden" name="pessoa" value={l.b} />
                          <label class="campo">
                            <span>{nome(l.b)} é o quê de {nome(l.a)}?</span>
                            <select name="papelResumido">
                              {papeis.map(([id, rotulo]) => <option value={id} selected={id === l.papel}>{rotulo[0].toUpperCase() + rotulo.slice(1)} de {nome(l.a)}</option>)}
                            </select>
                          </label>
                          <div class="acoes"><button class="botao" type="submit">Salvar</button><button class="botao botao--leve" type="button" data-editar-cancelar hidden>Cancelar</button></div>
                        </form>
                        <ZonaDePerigo menor nivel={4}>
                        <p>{FRASE_DO_LACO}</p>
                        <form method="post" action="/api/lacos" class="editar__remover">
                          <input type="hidden" name="volta" value={volta} />
                          <input type="hidden" name="id" value={l.id} />
                          <ConfirmarRemocao rotulo="Remover este laço" pergunta={`Remover o laço entre ${chamar} e ${nome(l.a === pessoa.id ? l.b : l.a)}?`} acao="resumido-remover" />
                        </form>
                        </ZonaDePerigo>
                      </div>
                    </details>
                  )
                )}
              </li>
            ))}

            {g.id === 'outros' && lacosDeOutros.map((l) => (
              <li class="laco">
                <div class="laco__quem">
                  <Retrato nome={nome(l.pessoa)} foto={retratoDe(l.pessoa)} familia={familiaDe(l.pessoa)} falecido={faleceu(l.pessoa)} />
                  <p class="laco__linha">
                    <strong>{nome(l.pessoa)}</strong>
                    {faleceu(l.pessoa) && <span class="so-leitor">, já faleceu</span>}
                    <span>{[`${l.nome} de ${nome(l.dono)}`, l.papel && `como se fosse ${PAPEIS[l.papel]}`].filter(Boolean).join(', ')}</span>
                  </p>
                </div>
                <details class="editar" data-editar>
                  <summary class="botao botao--leve">Editar</summary>
                  <div class="editar__caixa">
                    <form method="post" action="/api/lacos">
                      <input type="hidden" name="volta" value={volta} />
                      <input type="hidden" name="acao" value="coracao-salvar" />
                      <input type="hidden" name="dono" value={l.dono} />
                      <input type="hidden" name="pessoa" value={l.pessoa} />
                      <label class="campo">
                        <span>Nome do laço</span>
                        <input type="text" name="nomeDoLaco" maxlength="40" autocomplete="off" required value={l.nome} />
                      </label>
                      <label class="campo">
                        <span>Lugar na árvore</span>
                        <select name="papel">
                          <option value="">Não aparece na árvore</option>
                          {papeis.map(([id, rotulo]) => <option value={id} selected={id === l.papel}>Como se fosse {rotulo}</option>)}
                        </select>
                      </label>
                      <div class="acoes"><button class="botao" type="submit">Salvar</button><button class="botao botao--leve" type="button" data-editar-cancelar hidden>Cancelar</button></div>
                    </form>
                    <ZonaDePerigo menor nivel={4}>
                    <p>{FRASE_DO_LACO}</p>
                    <form method="post" action="/api/lacos" class="editar__remover">
                      <input type="hidden" name="volta" value={volta} />
                      <input type="hidden" name="id" value={l.id} />
                      <ConfirmarRemocao rotulo="Remover este laço" pergunta={`Remover o laço do coração de ${nome(l.dono)} com ${nome(l.pessoa)}?`} acao="coracao-remover" />
                    </form>
                    </ZonaDePerigo>
                  </div>
                </details>
              </li>
            ))}
          </ul>
        )}

        {/* Adicionar mora no grupo, já no tipo certo: a pessoa vê os laços que existem antes de criar um
            repetido. No grupo vazio, fica na linha do título */}
        {g.novo && (
          <details class="adicionar" data-adicionar>
            <summary class="acao">{g.quantos === 0 ? <>Adicionar<span class="so-leitor"> {g.novo.resto}</span></> : g.novo.rotulo}</summary>
            <div class="adicionar__caixa">
              <form method="post" action="/api/lacos" class="casal novo-laco" data-novo-laco data-laco={g.novo.laco} data-minha={ehMinha ? 'sim' : 'nao'}>
                <input type="hidden" name="acao" value="adicionar" />
                <input type="hidden" name="volta" value={volta} />
                <input type="hidden" name="sujeito" value={pessoa.id} />
                <input type="hidden" name="laco" value={g.novo.laco} />

                {/* O laço do coração pergunta primeiro quem o reconhece, num seletor segmentado (o padrão do
                    "Quem pode ver?"), com uma frase curta da opção escolhida: os campos de baixo mudam de
                    propósito, e a frase diz o que muda (correção do Gui, 18/11/2026) */}
                {g.novo.laco === 'coracao' && podeLacos && (
                  <div class="campo reconhece">
                    <span id={`rotulo-reconhece-${g.id}`}>Quem reconhece este laço?</span>
                    <Segmentado
                      rotulo="Quem reconhece este laço"
                      nome="reconhece"
                      explicacao={`frase-reconhece-${g.id}`}
                      opcoes={[
                        { valor: 'eu', texto: 'Só eu', atual: true },
                        { valor: 'familia', texto: 'A família toda' },
                      ]}
                    />
                    <p class="reconhece__frase" id={`frase-reconhece-${g.id}`} aria-live="polite">
                      <span data-para="coracao-so-eu">{ehMinha ? 'Um laço seu, que só vale para você.' : `Um laço entre você e ${chamar}, que só vale para você.`}</span>
                      <span data-para="coracao-familia" hidden>{ehMinha ? 'Um parente de consideração seu, que vale para a família toda.' : `Um parente de consideração de ${chamar}, que vale para a família toda.`}</span>
                    </p>
                  </div>
                )}

                {/* Com quem: fora da troca, e só quando o título não diz com quem é. Na própria página, nas duas
                    opções; na página de outra pessoa, o "só eu" já é com ela, e só a família toda pergunta */}
                <div class="novo-laco__quem" data-para={g.novo.laco === 'coracao' ? 'coracao-meu coracao-familia' : undefined} hidden={g.novo.laco === 'coracao'}>
                  <div class="em-linha">
                    <label>
                      {g.novo.laco === 'coracao' ? (
                        <>
                          {ehMinha ? <span>Com quem?</span> : <span>Quem?</span>}
                        </>
                      ) : (
                        <span>{g.novo.comQuem}</span>
                      )}
                      <select name="pessoa">
                        <option value="">Escolha</option>
                        {outros.map((i) => <option value={i.id}>{i.nome}</option>)}
                      </select>
                    </label>
                    <label>
                      <span>ou alguém que ainda não está no acervo</span>
                      <input type="text" name="nomeNovo" maxlength="80" autocomplete="off" placeholder="Escreva o nome" />
                    </label>
                  </div>
                  <ComoSeReferir id={`rotulo-tratamento-novo-${g.id}`} />
                </div>

                {(g.novo.laco === 'filho-de' || g.novo.laco === 'pai-de') && (
                  <>
                    <Opcoes nome="qualidade" rotulo="Filiação" opcoes={opcoesDeFiliacao()} valor="biologica" id={`rotulo-qualidade-novo-${g.id}`} />
                    <div class="campo" data-adocao data-depende="adocao" hidden>
                      <span>Data da adoção <small>(se souber)</small></span>
                      <CampoData prefixo="adocao" id={`adocao-novo-${g.id}`} />
                    </div>
                    <p class="dica">Para quem criou ou é tratado como filho sem ser de sangue nem adotado, use "Adicionar laço do coração" e escolha "A família toda".</p>
                  </>
                )}

                {g.novo.laco === 'casal' && (
                  <>
                    {/* Como no guiado, só as fases de estar junto (resposta do Gui à 47-N3, 17/11/2026) */}
                    <Opcoes nome="faseTipo" rotulo="Como estão hoje?" opcoes={fasesDeHoje} valor="casamento" id="rotulo-fase-novo" />
                    <div class="em-linha">
                      <div class="em-linha__campo">
                        <label for="fase-nova-inicio">Começou em</label>
                        <CampoAno id="fase-nova-inicio" nome="faseInicio" />
                      </div>
                      <div class="em-linha__campo" data-depende="terminou-novo" hidden>
                        <label for="fase-nova-fim">Terminou em</label>
                        <CampoAno id="fase-nova-fim" nome="faseFim" />
                      </div>
                    </div>
                    <label class="marcar">
                      <input type="checkbox" name="terminou" data-revela="terminou-novo" />
                      <span>Já terminou</span>
                    </label>
                    <FasesDepois id={`fase-depois-${g.id}`} rotuloDaPrimeira="rotulo-fase-novo" />
                    <p class="dica">Os anos são opcionais. A história também pode ser contada depois, na edição do casal.</p>
                    <label class="marcar">
                      <input type="checkbox" name="visibilidade" value="privado" />
                      <span>Só os dois veem este casal</span>
                    </label>
                  </>
                )}

                {g.novo.laco === 'coracao' && (
                  <div class="reconhece__troca">
                    {/* Só eu: o nome, o lugar (opcional), a proximidade e quem vê, tudo seu */}
                    <div class="reconhece__painel" data-para="coracao-so-eu">
                      <label class="campo">
                        <span>Nome do laço</span>
                        <input type="text" name="nomeDoLaco" maxlength="40" autocomplete="off" placeholder="Ex.: amigo-irmão, afilhada, vó de coração" />
                        <span class="dica">Do jeito que você chama. É o que a família vê.</span>
                      </label>
                      <label class="campo">
                        <span>Lugar na árvore <small>(opcional)</small></span>
                        <select name="papel">
                          <option value="">Não aparece na árvore</option>
                          {papeis.map(([id, rotulo]) => <option value={id}>Como se fosse {rotulo}</option>)}
                        </select>
                      </label>
                      <Opcoes nome="proximidade" rotulo="Proximidade" opcoes={proximidades} id={`rotulo-proximidade-novo-${g.id}`} dica="Só você vê." />
                      <label class="marcar">
                        <input type="checkbox" name="privado" />
                        <span>Só eu vejo este laço</span>
                      </label>
                    </div>
                    {/* A família toda: o lugar na árvore, que é o laço inteiro */}
                    <div class="reconhece__painel" data-para="coracao-familia" hidden>
                      <label class="campo">
                        <span>{ehMinha ? 'É o quê seu?' : `É o quê de ${chamar}?`}</span>
                        <select name="papel">
                          <option value="filho">Filho ou filha</option>
                          <option value="pai">Pai ou mãe</option>
                          <option value="irmao">Irmão ou irmã</option>
                        </select>
                        <span class="dica">Tio, avô, primo e sobrinho passam pela pessoa do meio: um tio de consideração é irmão de consideração do pai ou da mãe, e é cadastrado na página dele ou dela.</span>
                      </label>
                    </div>
                  </div>
                )}

                {g.novo.laco === 'resumido' && (
                  <>
                    <label class="campo">
                      <span>É o quê de {chamar}?</span>
                      <select name="papelResumido">
                        {papeis.map(([id, rotulo]) => <option value={id}>{rotulo[0].toUpperCase() + rotulo.slice(1)} de {chamar}</option>)}
                      </select>
                    </label>
                    <p class="dica">Para a família de quem é de fora, como o sobrinho de um amigo: dá para dizer o parentesco sem cadastrar quem fica no meio. Dentro das famílias, o caminho é cadastrado inteiro.</p>
                  </>
                )}

                <div class="acoes"><button class="botao" type="submit">Adicionar</button><button class="botao botao--leve" type="button" data-editar-cancelar hidden>Cancelar</button></div>
              </form>
            </div>
          </details>
        )}
      </section>
    ))}
    </div>
  </section>
  </div>
  )}

  {
    recemCadastrada && !guiado && (
      <p class="acoes">
        <a class="botao" href={`/pessoas/${pessoa.id}`}>Concluir</a>
        <a class="botao botao--leve" href="/pessoas/nova">Cadastrar outra pessoa</a>
      </p>
    )
  }

</Pagina>

<script>
  import { buscaDePessoa } from '../../../lib/cliente/busca-pessoa';
  import { ligarCamposDeAno } from '../../../lib/cliente/etapas';
  import { ligarDatas } from '../../../lib/cliente/datas';
  import { camposDo, devolver, type Guardado } from '../../../lib/cliente/guardar-formulario';

  // Os anos das fases do casal têm os mesmos botões −10, −1, +1 e +10 dos outros formulários
  ligarCamposDeAno(document);

  // Data da adoção: aparece quando "Adotiva" está marcada, em cada formulário de filiação
  for (const formulario of document.querySelectorAll<HTMLFormElement>('form:has([data-adocao])')) {
    const bloco = formulario.querySelector<HTMLElement>('[data-adocao]')!;
    const aplicarAdocao = () => {
      bloco.hidden = formulario.querySelector<HTMLInputElement>('input[name="qualidade"]:checked')?.value !== 'adotiva';
    };
    for (const r of formulario.querySelectorAll('input[name="qualidade"]')) r.addEventListener('change', aplicarAdocao);
    aplicarAdocao();
    ligarDatas(formulario, [{ ano: 'adocaoAno', mes: 'adocaoMes', dia: 'adocaoDia' }]);
  }

  // "Com quem": busca com sugestão, e "Cadastrar" para quem ainda não está no acervo
  for (const comQuem of document.querySelectorAll<HTMLSelectElement>('form select[name="pessoa"]')) {
    buscaDePessoa(comQuem, { nomeNovo: comQuem.form!.querySelector<HTMLInputElement>('input[name="nomeNovo"]') ?? undefined });
  }
  // "Como se referir" aparece quando há um nome novo, com o nome no rótulo
  for (const bloco of document.querySelectorAll<HTMLElement>('[data-como-se-referir]')) {
    const nomeNovo = bloco.closest('form')?.querySelector<HTMLInputElement>('input[name="nomeNovo"]');
    const rotulo = bloco.querySelector<HTMLElement>('[id^="rotulo-"]');
    if (!nomeNovo) continue;
    const aplicarNome = () => {
      const nome = nomeNovo.value.trim();
      bloco.hidden = !nome;
      if (rotulo) rotulo.textContent = nome ? `Como se referir a ${nome}?` : 'Como se referir a quem você está cadastrando?';
    };
    nomeNovo.addEventListener('input', aplicarNome);
    aplicarNome();
  }
  // "Adicionar laço do coração" mostra os campos de "Só eu" ou de "A família toda". Os outros grupos já
  // abrem no tipo certo, com os campos daquele laço
  for (const form of document.querySelectorAll<HTMLFormElement>('[data-novo-laco][data-laco="coracao"]')) {
    const minha = form.dataset.minha === 'sim';
    const aplicar = () => {
      // Na própria página, o laço do coração também pede "com quem". Quando a família toda reconhece,
      // o laço é entre a pessoa da página e outra, então "com quem" aparece em qualquer página.
      const daFamilia = form.querySelector<HTMLInputElement>('input[name="reconhece"]:checked')?.value === 'familia';
      const chaves = ['coracao', daFamilia ? 'coracao-familia' : 'coracao-so-eu', ...(minha && !daFamilia ? ['coracao-meu'] : [])];
      for (const bloco of form.querySelectorAll<HTMLElement>('[data-para]')) {
        const mostra = bloco.dataset.para!.split(' ').some((c) => chaves.includes(c));
        bloco.hidden = !mostra;
        for (const el of bloco.querySelectorAll<HTMLInputElement | HTMLSelectElement>('input, select')) el.disabled = !mostra;
      }
    };
    for (const r of form.querySelectorAll('input[name="reconhece"]')) r.addEventListener('change', aplicar);
    aplicar();
  }

  // A ficha fechada num resumo: quem chega por #ficha (a conta, o índice, o aviso de ficha não salva)
  // encontra a ficha aberta
  const cartaoDaFicha = document.querySelector<HTMLDetailsElement>('[data-ficha-cartao]');
  if (cartaoDaFicha) {
    const abrirFicha = () => {
      if (location.hash === '#ficha') cartaoDaFicha.open = true;
    };
    abrirFicha();
    addEventListener('hashchange', abrirFicha);
    // Um link para #ficha com o endereço já em #ficha não muda o endereço: abre do mesmo jeito
    for (const link of document.querySelectorAll<HTMLAnchorElement>('a[href="#ficha"]')) link.addEventListener('click', () => (cartaoDaFicha.open = true));
  }

  // Um laço em edição por vez: abrir um fecha os outros, para a página não virar um formulário enorme.
  // "Adicionar" de cada grupo entra na mesma conta
  const edicoes = [...document.querySelectorAll<HTMLDetailsElement>('[data-editar], [data-adicionar]')];
  for (const edicao of edicoes) {
    edicao.addEventListener('toggle', () => {
      if (!edicao.open) return;
      // Fechar um editor aberto mais acima encurta a página: o laço tocado fica onde o dedo tocou
      const antes = edicao.getBoundingClientRect().top;
      for (const outra of edicoes) if (outra !== edicao) outra.open = false;
      const salto = edicao.getBoundingClientRect().top - antes;
      if (salto) window.scrollBy({ top: salto, behavior: 'instant' });
    });
  }

  // "Cancelar" no editor de um laço: desfaz o que foi mexido nele, fecha o cartão e devolve o foco ao
  // "Editar". Sem JavaScript o botão não aparece, e o "Editar" continua fechando o cartão.
  for (const cancelar of document.querySelectorAll<HTMLButtonElement>('[data-editar-cancelar]')) {
    const edicao = cancelar.closest<HTMLDetailsElement>('[data-editar], [data-adicionar]');
    const formulario = cancelar.form;
    if (!edicao || !formulario) continue;
    cancelar.hidden = false;
    cancelar.addEventListener('click', () => {
      formulario.reset();
      // O que depende dos campos (a data da adoção, o aviso de data) se acerta com os eventos de sempre
      for (const el of formulario.elements) {
        el.dispatchEvent(new Event('input', { bubbles: true }));
        el.dispatchEvent(new Event('change', { bubbles: true }));
      }
      for (const aberta of edicao.querySelectorAll<HTMLDetailsElement>('details[open]')) aberta.open = false;
      edicao.open = false;
      edicao.querySelector('summary')?.focus();
    });
  }

  // A ficha e os laços são salvos em separado, e salvar um laço recarrega a página. Para o que foi
  // escrito na ficha não se perder, ele é guardado nesta aba ao salvar um laço e volta para os campos
  // na página seguinte, com um aviso. Salvar a ficha apaga o que estava guardado.
  const ficha = document.querySelector<HTMLFormElement>('[data-ficha]');
  const aviso = document.querySelector<HTMLElement>('[data-ficha-pendente]');
  if (ficha && aviso) {
    const CHAVE = `ficha-pendente:${location.pathname}`;
    const VALIDADE = 30 * 60 * 1000;
    // Como a ficha veio do servidor, antes de qualquer devolução
    const comoVeio = JSON.stringify(camposDo(ficha));
    const fotoMexida = () => Boolean(ficha.querySelector<HTMLInputElement>('[data-retrato-arquivo]')?.files?.length || ficha.querySelector<HTMLInputElement>('[data-tirar-retrato-campo]')?.value);
    const devolverPendente = () => {
      let pendente: (Guardado & { foto?: boolean }) | undefined;
      try {
        const bruto = sessionStorage.getItem(CHAVE);
        pendente = bruto ? JSON.parse(bruto) : undefined;
        sessionStorage.removeItem(CHAVE);
      } catch {
        pendente = undefined;
      }
      if (!pendente || Date.now() - pendente.quando > VALIDADE) return;
      devolver(ficha, pendente);
      aviso.hidden = false;
      const daFoto = aviso.querySelector<HTMLElement>('[data-ficha-pendente-foto]');
      if (daFoto) daFoto.hidden = !pendente.foto;
    };
    // Depois dos scripts da página, para o que depende dos campos se acertar com a devolução
    if (document.readyState === 'complete') devolverPendente();
    else addEventListener('load', devolverPendente, { once: true });
    for (const outro of document.querySelectorAll<HTMLFormElement>('form')) {
      if (outro === ficha) continue;
      outro.addEventListener('submit', () => {
        const campos = camposDo(ficha);
        const foto = fotoMexida();
        if (JSON.stringify(campos) === comoVeio && !foto) return;
        try {
          sessionStorage.setItem(CHAVE, JSON.stringify({ quando: Date.now(), campos, foto }));
        } catch {
          // Sem sessionStorage, a ficha só não é refeita
        }
      });
    }
    ficha.addEventListener('submit', () => {
      try {
        sessionStorage.removeItem(CHAVE);
      } catch {
        // nada a apagar
      }
    });
  }

  // Ex-casal: a dica de cada escolha acompanha o que está marcado. Sem script, aparece a da escolha
  // com que a página abriu, e as famílias ficam sempre à vista.
  for (const grupo of document.querySelectorAll<HTMLElement>('[data-quem-ve-do-casal], [data-como-aparece]')) {
    const familias = grupo.querySelector<HTMLElement>('[data-familias-do-casal]');
    const aplicar = () => {
      const marcado = grupo.querySelector<HTMLInputElement>('.opcoes[role="radiogroup"] input:checked')?.value;
      for (const dica of grupo.querySelectorAll<HTMLElement>('[data-dica-de]')) dica.hidden = dica.dataset.dicaDe !== marcado;
      if (familias) familias.hidden = marcado !== 'nucleos';
    };
    grupo.addEventListener('change', aplicar);
    aplicar();
  }

  // "Já terminou": a data de fim só aparece quando o casal já acabou. Desmarcar apaga a data.
  for (const caixa of document.querySelectorAll<HTMLInputElement>('[data-revela]')) {
    const alvo = document.querySelector<HTMLElement>(`[data-depende="${caixa.dataset.revela}"]`);
    if (!alvo) continue;
    const campo = alvo.querySelector<HTMLInputElement>('input');
    const aplicarFim = () => {
      alvo.hidden = !caixa.checked;
      if (!caixa.checked && campo) campo.value = '';
    };
    caixa.addEventListener('change', aplicarFim);
    aplicarFim();
  }
</script>
