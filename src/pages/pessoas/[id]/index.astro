---
import Base from '../../../layouts/Base.astro';
import LinhaDoTempo from '../../../components/LinhaDoTempo.astro';
import { datasDeVida } from '../../../lib/datas';
import { FASES, Familia, estaoJuntos, lacoParaODono, periodoDaFase, possessivo, type Tratamento } from '../../../lib/parentesco';
import { pessoasComAcesso } from '../../../lib/servidor/acesso';
import { podeEditarIntegrante, podeMexerEmLaco } from '../../../lib/servidor/permissoes';
import { familiasDe, listarCasais, listarFiliacoes, listarIntegrantes, listarLacosDoCoracao, listarLacosResumidos, listarMemorias, listarNucleos } from '../../../lib/servidor/repositorio';
import { nomeDoPapel } from '../../../lib/parentesco';

const { usuario } = Astro.locals;
const integrantes = await listarIntegrantes();
const pessoa = integrantes.find((i) => i.id === Astro.params.id);
if (!pessoa) return new Response('Pessoa não encontrada', { status: 404 });

const nucleos = await listarNucleos();
const memorias = await listarMemorias(usuario, { integrante: pessoa.id });
const dosNucleos = familiasDe(pessoa).map((id) => nucleos.find((n) => n.id === id)?.nome).filter(Boolean);
const resumo = [pessoa.tipo === 'bicho' ? (pessoa.especie ?? 'bicho') : '', dosNucleos.join(' e ')].filter(Boolean).join(', ');

const tratamentos = new Map<string, Tratamento>(integrantes.map((i) => [i.id, i.tratamento]));
const familia = new Familia(await listarFiliacoes(), await listarCasais(usuario), tratamentos);
const achar = (id: string) => integrantes.find((i) => i.id === id);
const nome = (id: string) => achar(id)?.apelido ?? achar(id)?.nome ?? id;
const chamar = pessoa.apelido ?? pessoa.nome;
// O que cada parente é desta pessoa: "mãe", "irmão", "filho de consideração"
const papel = (id: string) => familia.relacao(pessoa.id, id)?.texto;
const paraVoce = pessoa.id === usuario.pessoa ? undefined : familia.relacao(usuario.pessoa, pessoa.id);

const pais = familia.pais(pessoa.id).map((p) => p.responsavel);
const grupos = [
  { titulo: 'Pais', ids: pais },
  { titulo: 'Irmãos', ids: familia.irmaos(pessoa.id).map((i) => i.id) },
  { titulo: 'Filhos', ids: familia.filhos(pessoa.id).map((f) => f.filho) },
  { titulo: 'Avós', ids: [...new Set(pais.flatMap((p) => familia.pais(p).map((a) => a.responsavel)))] },
].filter((g) => g.ids.length > 0);
const casais = familia.casais(pessoa.id);
// Laços do coração: os que a pessoa escolheu, e os de quem a escolheu
const lacos = await listarLacosDoCoracao(usuario);
const escolhidos = lacos.filter((l) => l.dono === pessoa.id);
const escolhidaPor = lacos.filter((l) => l.pessoa === pessoa.id);
// Sem parentesco calculado, vale o laço do coração de quem está olhando
const meuLaco = paraVoce ? undefined : escolhidaPor.find((l) => l.dono === usuario.pessoa);
// Sem filiação nem casal, a árvore a partir da pessoa seria só ela: o botão não aparece
const temLacoDeArvore = pais.length > 0 || familia.filhos(pessoa.id).length > 0 || casais.length > 0;
// Parentes de fora das famílias, sem o caminho inteiro ("Caio é sobrinho do Ed")
const resumidos = (await listarLacosResumidos()).filter((l) => l.a === pessoa.id || l.b === pessoa.id);
const temFamilia = grupos.length > 0 || casais.length > 0 || escolhidos.length > 0 || escolhidaPor.length > 0 || resumidos.length > 0;

const podeEditar = podeEditarIntegrante(usuario, pessoa, await pessoasComAcesso()).ok || podeMexerEmLaco(usuario, [pessoa]).ok;
---

<Base titulo={pessoa.nome}>
  <div class="abertura">
    <h1>{pessoa.nome}</h1>
    {resumo && <p>{resumo}</p>}
    {paraVoce && <p class="parentesco">{chamar} é {possessivo(paraVoce, pessoa.tratamento)}.</p>}
    {meuLaco && <p class="parentesco">{chamar} é {lacoParaODono(meuLaco.nome, pessoa.tratamento)}.</p>}
    {datasDeVida(pessoa).map((linha) => <p class="dica">{linha}</p>)}
    {pessoa.sobre && <div class="bio">{pessoa.sobre.split(/\n{2,}/).map((p) => <p>{p}</p>)}</div>}
    <p class="acoes">
      {temLacoDeArvore && <a class="botao botao--leve" href={`/arvore?centro=${pessoa.id}`}>Ver na árvore</a>}
      <a class="botao botao--leve" href={`/pessoas/${pessoa.id}/editar`}>{podeEditar ? 'Editar página e laços' : 'Adicionar laço'}</a>
    </p>
  </div>

  {
    temFamilia && (
      <section class="familia">
        <h2>Família e laços</h2>
        <dl>
          {casais.length > 0 && (
            <div>
              <dt>Casal</dt>
              {casais.map((c) => (
                <dd>
                  <a href={`/pessoas/${c.outro}`}>{nome(c.outro)}</a>
                  <span>{papel(c.outro) ?? (estaoJuntos(c.casal) ? '' : 'ex')}</span>
                  <small>
                    {c.casal.fases
                      .map((fase) => [FASES[fase.tipo].toLowerCase(), periodoDaFase(fase)].filter(Boolean).join(' '))
                      .join(', depois ')}
                    {c.casal.visibilidade === 'privado' && ' (só os dois veem)'}
                  </small>
                </dd>
              ))}
            </div>
          )}
          {grupos.map((g) => (
            <div>
              <dt>{g.titulo}</dt>
              {g.ids.map((id) => (
                <dd>
                  <a href={`/pessoas/${id}`}>{nome(id)}</a>
                  <span>{papel(id)}</span>
                </dd>
              ))}
            </div>
          ))}
          {resumidos.length > 0 && (
            <div>
              <dt>Parentes</dt>
              {resumidos.map((l) => {
                const outro = l.a === pessoa.id ? l.b : l.a;
                return (
                  <dd>
                    <a href={`/pessoas/${outro}`}>{nome(outro)}</a>
                    <span>{l.a === pessoa.id ? nomeDoPapel(l.papel, achar(outro)?.tratamento ?? null) : `${chamar} é ${nomeDoPapel(l.papel, pessoa.tratamento)}`}</span>
                  </dd>
                );
              })}
            </div>
          )}
          {escolhidos.length > 0 && (
            <div>
              <dt>Laços do coração</dt>
              {escolhidos.map((l) => (
                <dd>
                  <a href={`/pessoas/${l.pessoa}`}>{nome(l.pessoa)}</a>
                  <span>{l.dono === usuario.pessoa ? lacoParaODono(l.nome, achar(l.pessoa)?.tratamento ?? null) : l.nome}</span>
                  {l.privado && <small>só você vê</small>}
                </dd>
              ))}
            </div>
          )}
          {escolhidaPor.length > 0 && (
            <div>
              <dt>No coração de</dt>
              {escolhidaPor.map((l) => (
                <dd>
                  <a href={`/pessoas/${l.dono}`}>{nome(l.dono)}</a>
                  <span>{l.dono === usuario.pessoa ? `${lacoParaODono(l.nome, pessoa.tratamento)} (você)` : `chama de ${l.nome}`}</span>
                  {l.privado && <small>só você vê</small>}
                </dd>
              ))}
            </div>
          )}
        </dl>
      </section>
    )
  }

  <LinhaDoTempo memorias={memorias} integrantes={integrantes} nucleos={nucleos} vazio={`Nenhuma memória com ${pessoa.nome} por enquanto.`} />
</Base>
