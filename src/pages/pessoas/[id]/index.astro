---
// A página da pessoa: o verbete (proposta A do conceito da sessão L, escolhida pelo Gui em 18/11/2026;
// o estudo está em docs/visual/conceito-pessoa-do-zero/leia-me.md). A página diz quem a pessoa é, como
// um verbete de enciclopédia com a ficha de um site de genealogia ao lado: o parentesco de quem olha
// como a linha maior, uma frase de abertura, o quadro com o retrato, os dados, a família de perto e o
// que ela é para você (o círculo e o laço de vocês), as palavras dela (relatos e áudios) e a vida em
// memórias, pela idade, com a linha do tempo e o mural como opção. Os laços ficam quietos, no fim.
// A cor da família entra no alto do quadro, atrás do retrato, e marca as idades e as citações.
import '../../../visual/telas/linha.css';
import '../../../visual/telas/explorar.css';
import '../../../visual/telas/pessoa.css';
import Visual from '../../../layouts/Visual.astro';
import Linha from '../../../components/explorar/Linha.astro';
import Mural from '../../../components/explorar/Mural.astro';
import VidaPorIdade from '../../../components/pessoa/VidaPorIdade.astro';
import Mensagem from '../../../components/conversa/Mensagem.astro';
import Carimbo from '../../../components/visual/Carimbo.astro';
import Gente from '../../../components/visual/Gente.astro';
import PilulaDeFamilia from '../../../components/visual/PilulaDeFamilia.astro';
import Recado from '../../../components/visual/Recado.astro';
import Retrato from '../../../components/visual/Retrato.astro';
import Vazio from '../../../components/visual/Vazio.astro';
import { TAMANHO_PADRAO, lerFotosDoMural, fotosDoMuralNoEndereco } from '../../../lib/explorar';
import QuaisFotos from '../../../components/explorar/QuaisFotos.astro';
import { FORMAS_DA_VIDA, contaDaFamiliaDePerto, enderecoDaVida, fraseDoAcervo, nomeDoGrupoDePerto, lerFormaDaVida, mostraRascunhoNaVida, nomeDaFormaDaVida } from '../../../lib/pagina-da-pessoa';
import { montarPaginaDaPessoa, type Ligada } from '../../../lib/servidor/pagina-da-pessoa';
import { listarCapitulos } from '../../../lib/servidor/repositorio';

const { usuario } = Astro.locals;
// Quem só existe num laço privado de outra pessoa responde como quem não existe (C1, 17/11/2026)
const p = await montarPaginaDaPessoa(usuario, Astro.params.id!, Astro.url.searchParams.get('datas') === '1');
if (!p) return new Response('Pessoa não encontrada', { status: 404 });
const { pessoa, chamar } = p;
const plural = (n: number, um: string, varios: string) => `${n} ${n === 1 ? um : varios}`;

// A forma de ver as memórias (pedido do Gui, 18/11/2026): pela idade é o padrão, e a linha do tempo e
// o mural continuam como opção. A escolha fica no endereço ("ver") e troca sem recarregar
const forma = lerFormaDaVida(Astro.url.searchParams);
const fotosDoMural = lerFotosDoMural(Astro.url.searchParams);
const memorias = mostraRascunhoNaVida(forma) ? p.todasComEla : p.publicadas;
const comIdade = Boolean(pessoa.nascimentoAno);

// A frase de abertura do verbete: o primeiro parágrafo de "Sobre" ou, sem ele, o que o acervo sabe.
// O resto de "Sobre" vem em "Nas palavras de"
const sobre = pessoa.sobre?.split(/\n{2,}/).map((t) => t.trim()).filter(Boolean) ?? [];
const abertura =
  sobre[0] ?? fraseDoAcervo({ nome: chamar, memorias: p.publicadas.length, de: p.periodo?.de, ate: p.periodo?.ate, relatos: p.relatos.length, eu: p.ehMinha });
const restoDoSobre = sobre.slice(1);

// A família de perto, para o quadro, como um pedaço da árvore: os pais em cima, a pessoa com o casal no
// meio, os filhos embaixo e os irmãos à parte. Fechada, a seção mostra o resumo (os retratos e a conta)
const grupo = (chave: string) => p.grupos.find((g) => g.chave === chave)?.linhas ?? [];
const pais = grupo('pais');
const casais = grupo('casal');
const filhos = grupo('filhos');
const irmaos = grupo('irmaos');
const pertoNaArvore = [...pais, ...casais, ...filhos, ...irmaos];
const resumoDaArvore = contaDaFamiliaDePerto({ pais, casais: casais.length, filhos, irmaos });
const maiuscula = (t: string) => t.charAt(0).toUpperCase() + t.slice(1);
const RELATOS_A_VISTA = 3;
const recado = Astro.url.searchParams.get('erro') ?? Astro.url.searchParams.get('ok');
---
<Visual titulo={pessoa.nome} secao="pessoas" nucleos={p.familiasDaPessoa.map((f) => f.id)} familia={p.familiaDaPessoa}>
  <article class="verbete">
    {/* A faixa de recados (data-recados): vazia e escondida sem recado, para o formulário no lugar achá-la */}
    {recado ? (
      <div class="miolo verbete__recado" data-recados>
        <Recado erro={Boolean(Astro.url.searchParams.get('erro'))}>{recado}</Recado>
      </div>
    ) : (
      <p data-recados hidden />
    )}
    <div class="verbete__alto miolo grade">
      {/* A abertura é uma região: "Como você chama" troca o nome no lugar, sem recarregar (no-lugar.ts) */}
      <div class="regiao" data-regiao="abertura">
        <header class="verbete__abre">
          {(p.ehMinha || p.especie) && (
            <p class="verbete__carimbo">
              <Carimbo itens={[p.ehMinha && 'Você', p.especie]} />
            </p>
          )}
          {/* O parentesco de quem olha é a linha grande ("sua mãe"), e o nome vem logo abaixo. Na própria
              página e na de quem não tem laço com quem olha, o nome é a linha grande */}
          {p.parentesco && <p class="verbete__laco">{p.parentesco}</p>}
          {/* "Nome (apelido)", como na lista de Pessoas: o apelido que quem olha vê, o seu ou o da família */}
          <h1 class:list={['verbete__nome', p.parentesco ? 't-2' : 't-1']}>
            {pessoa.nome}
            {p.apelidoNoTitulo && <span class="verbete__apelido"> ({p.apelidoNoTitulo})</span>}
          </h1>
          {p.falecida && <p class="verbete__memoria em-memoria">em memória</p>}
          <p class="verbete__abertura">{abertura}</p>
          {/* A ação principal fica no alto, junto do título: a que alimenta o acervo, a memória nova */}
          <p class="verbete__acoes">
            <a class="botao" href={`/nova?com=${pessoa.id}`}>
              Nova memória com {p.comQuem}
            </a>
            <a class="acao" href={`/pessoas/${pessoa.id}/editar`}>
              {p.podeEditar ? 'Editar página e laços' : 'Adicionar laço'}
            </a>
            {p.ehMinha && (
              <a class="acao acao--quieta" href="/conta">
                Sua conta
              </a>
            )}
          </p>
          {/* "Como você chama", só seu (src/lib/apelidos.ts): o apelido que quem olha dá à pessoa. Salva no
              lugar, sem recarregar; sem script, é o formulário comum */}
          {!p.ehMinha && (
            <details class="como-chama" id="como-voce-chama">
              <summary class="acao acao--quieta">{p.meuApelido ? `Você chama de ${p.meuApelido}` : `Como você chama ${pessoa.nome}?`}</summary>
              <form class="como-chama__form" method="post" action="/api/apelidos" data-no-lugar="abertura" data-chave="como-chama">
                <input type="hidden" name="pessoa" value={pessoa.id} />
                <label class="campo">
                  <span class="so-leitor">Como você chama {pessoa.nome}?</span>
                  <input class="campo__entrada" type="text" name="apelido" maxlength="40" autocomplete="off" value={p.meuApelido ?? ''} placeholder="Ex.: Tia Lu, Vó, Dinho" />
                </label>
                <p class="campo__dica">Só você vê. No site inteiro, para você, {pessoa.nome} aparece assim.</p>
                <p class="como-chama__acoes">
                  <button class="acao" type="submit">Salvar</button>
                  {p.meuApelido && (
                    <button class="acao acao--quieta" type="submit" name="apelido" value="">
                      Voltar a {p.nomeDaFamilia}
                    </button>
                  )}
                </p>
              </form>
            </details>
          )}
        </header>
      </div>

      {/* O quadro, como o painel da árvore (pedido do Gui, 18/11/2026): o retrato no alto, sobre a cor da
          família, e as partes em sanfona, uma aberta por vez. "Dados" chega aberta; "Na árvore" e "Você e
          Fulano" chegam fechadas, com um resumo do que mostram. No computador com mouse, o quadro acompanha
          a rolagem e, se a parte aberta não couber na tela, rola por dentro. No celular, logo depois da abertura */}
      <aside class="verbete__quadro quadro" aria-label={`Ficha de ${chamar}`}>
        <div class="verbete__capa" data-familia={p.familiaDaPessoa}>
          <div class="verbete__retrato">
            {p.falecida ? (
              // Acender a foto (pedido do Gui, 18/11/2026): tocar no retrato grande acende, e ele fica aceso
              // enquanto se está na página. Com mouse e pelo teclado, acende também só de passar ou focar
              <button class="verbete__acender" type="button" data-acender aria-pressed="false" aria-label={`Acender a foto de ${chamar}`}>
                <Retrato nome={chamar} foto={p.retrato} familia={p.familiaDaPessoa} falecido cedo grande />
              </button>
            ) : (
              <Retrato nome={chamar} foto={p.retrato} familia={p.familiaDaPessoa} cedo grande />
            )}
          </div>
        </div>

        <details class="quadro__secao" name="quadro-da-pessoa" open>
          <summary>
            <span class="quadro__nome">Dados</span>
          </summary>
          <div class="quadro__corpo dados">
            {p.nascimento && (
              <div class="dados__datas">
                <div class="dados__data">
                  <p class="rotulo suave">Nasceu</p>
                  <p class="dados__grande">{p.nascimento.grande}</p>
                  {p.nascimento.pequena && <p class="ficha suave">{p.nascimento.pequena}</p>}
                </div>
                {/* O falecimento fica oculto (decisão do Gui, 17/11/2026) e só aparece para quem pedir. Vai na
                    página escondido, e "Mostrar datas" o mostra no lugar; sem script, o link recarrega com ?datas=1 */}
                {p.falecimento && (
                  <div class="dados__data" data-falecimento hidden={!p.mostrarDatas}>
                    <p class="rotulo suave">Faleceu</p>
                    <p class="dados__grande">{p.falecimento.grande}</p>
                    {p.falecimento.pequena && <p class="ficha suave">{p.falecimento.pequena}</p>}
                  </div>
                )}
              </div>
            )}
            {p.temDataOculta && (
              <a class="acao acao--quieta dados__mostrar" href={p.mostrarDatas ? `/pessoas/${pessoa.id}` : `/pessoas/${pessoa.id}?datas=1`} data-mostrar-datas>
                {p.mostrarDatas ? 'Esconder datas' : 'Mostrar datas'}
              </a>
            )}
            {p.familiasDaPessoa.length > 0 && (
              <div class="dados__familias">
                <p class="rotulo suave">{p.familiasDaPessoa.length === 1 ? 'Família' : 'Famílias'}</p>
                <p class="pilulas-de-familia">
                  {p.familiasDaPessoa.map((f) => (
                    <PilulaDeFamilia href={`/pessoas?familia=${f.id}`} familia={f.cor}>
                      {f.nome}
                    </PilulaDeFamilia>
                  ))}
                </p>
              </div>
            )}
            {/* No acervo: os números como os de um álbum, cada um levando à parte dele na página */}
            <ul class="dados__numeros" aria-label="No acervo">
              <li>
                <a href="#memorias-com">
                  <strong>{p.publicadas.length}</strong>
                  <span>{p.publicadas.length === 1 ? 'memória' : 'memórias'}</span>
                </a>
              </li>
              <li>
                <a href="#palavras">
                  <strong>{p.relatos.length}</strong>
                  <span>{p.relatos.length === 1 ? 'relato' : 'relatos'}</span>
                </a>
              </li>
              <li>
                <a href="#palavras">
                  <strong>{p.audios.length}</strong>
                  <span>{p.audios.length === 1 ? 'áudio' : 'áudios'}</span>
                </a>
              </li>
            </ul>
            {/* O histórico da página (alterações da ficha e dos laços), só para quem pode mudá-la */}
            {p.podeEditar && (
              <a class="acao acao--quieta" href={`/pessoas/${pessoa.id}/historico`}>
                Ver o histórico da página
              </a>
            )}
          </div>
        </details>

        {pertoNaArvore.length > 0 && (
          <details class="quadro__secao" name="quadro-da-pessoa">
            <summary>
              <span class="quadro__nome">Na árvore</span>
              <span class="quadro__resumo" aria-hidden="true">
                <span class="quadro__rostos">
                  {pertoNaArvore.slice(0, 4).map((l) => (
                    <Retrato nome={l.nome} foto={l.foto} familia={l.familia} falecido={l.falecido} redondo />
                  ))}
                </span>
              </span>
              <span class="quadro__conta ficha suave">{resumoDaArvore}</span>
            </summary>
            <div class="quadro__corpo vizinhanca">
              {/* Um pedaço da árvore: os pais em cima, a pessoa com o casal no meio, os filhos embaixo */}
              <div class="arvorezinha">
                {pais.length > 0 && (
                  <div class="arvorezinha__nivel">
                    <p class="ficha suave">{maiuscula(nomeDoGrupoDePerto('pais', pais))}</p>
                    <ul>
                      {pais.map((l: Ligada) => (
                        <li>
                          <a class="vizinhanca__quem" href={`/pessoas/${l.id}`}>
                            <Retrato nome={l.nome} foto={l.foto} familia={l.familia} falecido={l.falecido} />
                            <span>{l.nome}</span>
                            {l.falecido && <span class="so-leitor">, já faleceu</span>}
                          </a>
                        </li>
                      ))}
                    </ul>
                  </div>
                )}
                <div class="arvorezinha__nivel arvorezinha__nivel--meio">
                  <ul>
                    <li>
                      <span class="vizinhanca__quem vizinhanca__quem--ela" aria-current="page">
                        <Retrato nome={chamar} foto={p.retrato} familia={p.familiaDaPessoa} falecido={p.falecida} />
                        <span>{p.ehMinha ? 'Você' : chamar}</span>
                      </span>
                    </li>
                    {casais.map((l: Ligada) => (
                      <li class="arvorezinha__casal">
                        <a class="vizinhanca__quem" href={`/pessoas/${l.id}`}>
                          <Retrato nome={l.nome} foto={l.foto} familia={l.familia} falecido={l.falecido} />
                          <span>{l.nome}</span>
                          {l.falecido && <span class="so-leitor">, já faleceu</span>}
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>
                {filhos.length > 0 && (
                  <div class="arvorezinha__nivel">
                    <p class="ficha suave">{maiuscula(nomeDoGrupoDePerto('filhos', filhos))}</p>
                    <ul>
                      {filhos.map((l: Ligada) => (
                        <li>
                          <a class="vizinhanca__quem" href={`/pessoas/${l.id}`}>
                            <Retrato nome={l.nome} foto={l.foto} familia={l.familia} falecido={l.falecido} />
                            <span>{l.nome}</span>
                            {l.falecido && <span class="so-leitor">, já faleceu</span>}
                          </a>
                        </li>
                      ))}
                    </ul>
                  </div>
                )}
              </div>
              {irmaos.length > 0 && (
                <div class="vizinhanca__irmaos">
                  <p class="ficha suave">{maiuscula(nomeDoGrupoDePerto('irmaos', irmaos))}</p>
                  <ul>
                    {irmaos.map((l: Ligada) => (
                      <li>
                        <a class="vizinhanca__quem" href={`/pessoas/${l.id}`}>
                          <Retrato nome={l.nome} foto={l.foto} familia={l.familia} falecido={l.falecido} />
                          <span>{l.nome}</span>
                          {l.falecido && <span class="so-leitor">, já faleceu</span>}
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>
              )}
              {/* Sem filiação nem casal, a árvore a partir da pessoa seria só ela: o botão não aparece */}
              {p.temLacoDeArvore && (
                <p class="vizinhanca__ir">
                  <a class="acao" href={`/arvore?centro=${pessoa.id}`}>
                    Ver na árvore
                  </a>
                </p>
              )}
            </div>
          </details>
        )}

        {/* Você e a pessoa (decisão do Gui, 18/11/2026): o lugar dela no seu círculo, que só você vê, e a
            página do laço de vocês. Na própria página, o caminho para o seu círculo */}
        {(p.circulo || p.lacoComVoce) && (
          <details class="quadro__secao" name="quadro-da-pessoa">
            <summary>
              <span class="quadro__nome">Você e {chamar}</span>
              {p.circulo && <span class="quadro__conta ficha suave">{p.circulo.faixa}</span>}
            </summary>
            <div class="quadro__corpo verbete__voce">
              {p.circulo && (
                <p>
                  No seu círculo: <strong>{p.circulo.faixa}</strong>
                  <span class="ficha suave verbete__so-voce">só você vê</span>
                </p>
              )}
              <p class="verbete__voce-acoes">
                {p.lacoComVoce && (
                  <a class="acao" href={p.lacoComVoce}>
                    Ver o laço de vocês
                  </a>
                )}
                {p.circulo && (
                  <a class="acao acao--quieta" href="/circulo">
                    Ver seu círculo
                  </a>
                )}
              </p>
            </div>
          </details>
        )}
        {p.ehMinha && (
          <p class="quadro__pe">
            <a class="acao" href="/circulo">
              Ver seu círculo
            </a>
          </p>
        )}
      </aside>

      {/* Nas palavras dela: o resto de "Sobre" e os relatos que ela contou, como as mensagens da conversa
          na página da memória (pedido do Gui, 18/11/2026): os balões de texto, os áudios com tocar e as fotos.
          Os relatos com áudio vêm primeiro. Só os que quem olha pode ver (listarRelatosDe passa por veORelato) */}
      {(p.relatos.length > 0 || restoDoSobre.length > 0) && (
        <section class="verbete__palavras" id="palavras" aria-labelledby="titulo-palavras">
          <h2 class="t-2" id="titulo-palavras">
            {p.ehMinha ? 'Nas suas palavras' : `Nas palavras de ${chamar}`}
          </h2>
          {restoDoSobre.length > 0 && (
            <div class="palavras__sobre">
              {restoDoSobre.map((t) => (
                <p>{t}</p>
              ))}
            </div>
          )}
          {p.relatos.length > 0 && (
            <ol class="palavras__relatos" id="audios">
              {p.relatos.slice(0, RELATOS_A_VISTA).map((r) => (
                <li class="palavra voz" id={`palavra-${r.id}`}>
                  <p class="palavra__de ficha suave">
                    {r.memoriaAno} ·{' '}
                    <a class="acao acao--quieta" href={`/memorias/${r.memoriaId}#relato-${r.id}`}>
                      {r.memoriaTitulo}
                    </a>
                  </p>
                  <ol class="voz__mensagens">
                    {r.mensagens.map((m) => (
                      <Mensagem mensagem={m} de={chamar} />
                    ))}
                  </ol>
                </li>
              ))}
            </ol>
          )}
          {p.relatos.length > RELATOS_A_VISTA && (
            <details class="palavras__mais">
              <summary class="acao">Ver {p.relatos.length - RELATOS_A_VISTA === 1 ? 'o outro relato' : `os outros ${p.relatos.length - RELATOS_A_VISTA} relatos`}</summary>
              <ol class="palavras__relatos">
                {p.relatos.slice(RELATOS_A_VISTA).map((r) => (
                  <li class="palavra voz" id={`palavra-${r.id}`}>
                    <p class="palavra__de ficha suave">
                      {r.memoriaAno} ·{' '}
                      <a class="acao acao--quieta" href={`/memorias/${r.memoriaId}#relato-${r.id}`}>
                        {r.memoriaTitulo}
                      </a>
                    </p>
                    <ol class="voz__mensagens">
                      {r.mensagens.map((m) => (
                        <Mensagem mensagem={m} de={chamar} />
                      ))}
                    </ol>
                  </li>
                ))}
              </ol>
            </details>
          )}
        </section>
      )}

      {/* A vida em memórias. A região troca de conteúdo sem recarregar a página, como no Explorar
          (explorar-troca.ts): pela idade (o padrão), a linha do tempo e o mural. No computador, as três
          ficam na coluna da esquerda, ao lado do quadro, adaptadas à largura dela */}
      <section class:list={['verbete__vida', `verbete__vida--${forma}`]} aria-labelledby="memorias-com" data-explorar>
        <header class="vida__abre miolo">
          <h2 class="t-2" id="memorias-com">
            {p.ehMinha ? 'Sua vida em memórias' : `A vida de ${chamar} em memórias`}
          </h2>
          {p.todasComEla.length > 1 && (
            <div class="controles vida__controles">
              <div class="controle">
                <p class="controle__nome rotulo suave" id="controle-forma">
                  Forma de ver
                </p>
                <nav class="linha__opcoes" aria-labelledby="controle-forma">
                  {FORMAS_DA_VIDA.map((f) => (
                    <a href={`${enderecoDaVida(pessoa.id, f)}#memorias-com`} data-opcao={f} aria-current={f === forma ? 'page' : undefined}>
                      {nomeDaFormaDaVida(f, comIdade)}
                    </a>
                  ))}
                </nav>
              </div>
              {forma === 'mural' && <QuaisFotos atual={fotosDoMural} endereco={(f) => `${enderecoDaVida(pessoa.id, forma, fotosDoMuralNoEndereco(f))}#memorias-com`} />}
            </div>
          )}
        </header>
        {memorias.length === 0 ? (
          <div class="miolo">
            <Vazio frase={`Nenhuma memória com ${pessoa.nome} por enquanto.`}>
              <a class="acao" href={`/nova?com=${pessoa.id}`}>
                Nova memória com {p.comQuem}
              </a>
            </Vazio>
          </div>
        ) : forma === 'mural' ? (
          <div class="linha linha--mural">
            <Mural memorias={memorias} ordem="recentes" tamanho={TAMANHO_PADRAO} fotos={fotosDoMural} />
          </div>
        ) : forma === 'linha' ? (
          <Linha memorias={memorias} capitulos={await listarCapitulos(usuario)} integrantes={p.integrantes} nucleos={p.nucleos} ordem="recentes" trilhos={false} />
        ) : (
          <VidaPorIdade memorias={memorias} nascimentoAno={pessoa.nascimentoAno} />
        )}
      </section>
    </div>

    {/* Família e laços, quieta, no fim, como o "ver também" do verbete. O casal e os laços do coração
        levam também à página do laço */}
    {p.grupos.length > 0 && (
      <section class="verbete__lacos miolo" aria-labelledby="lacos">
        <header class="lacos__abre">
          <h2 class="t-2" id="lacos">
            Família e laços
          </h2>
          <p class="ficha suave">{plural(p.genteNosLacos, 'pessoa', 'pessoas')}</p>
        </header>
        <div class="lacos__grupos">
          {p.grupos.map((g) => (
            <div class="lacos__grupo">
              <h3 class="ficha">{g.titulo}</h3>
              <ul>
                {g.linhas.map((l) => (
                  <li>
                    <Gente href={`/pessoas/${l.id}`} nome={l.nome} foto={l.foto} familia={l.familia} laco={l.laco} detalhe={l.detalhe} falecido={l.falecido} />
                    {(g.chave === 'casal' || g.chave === 'coracao') && (
                      <a class="acao acao--quieta lacos__laco" href={l.enderecoDoLaco}>
                        Ver o laço
                      </a>
                    )}
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </section>
    )}
  </article>
</Visual>

<script>
  // Quem chega pela ficha da árvore ("Como você chama") encontra a pergunta aberta, com o foco nela
  const comoChama = document.querySelector<HTMLDetailsElement>('#como-voce-chama');
  if (comoChama && location.hash === '#como-voce-chama') {
    comoChama.open = true;
    comoChama.querySelector<HTMLInputElement>('input[name="apelido"]')?.focus();
  }
</script>

<script>
  // "Como você chama" salva no lugar, sem recarregar (no-lugar.ts); os áudios das mensagens tocam com a onda
  import { ligarNoLugar } from '../../../lib/cliente/no-lugar';
  import { ligarAudioDaMensagem } from '../../../lib/cliente/conversa';
  ligarNoLugar();
  for (const audio of document.querySelectorAll<HTMLElement>('.palavra [data-audio]')) ligarAudioDaMensagem(audio);

  // "Mostrar datas" mostra o falecimento no lugar, sem recarregar (pedido do Gui, 18/11/2026: o mínimo de
  // recarregamentos no site todo). O endereço acompanha, para o link continuar servindo. Sem script, recarrega
  const mostrar = document.querySelector<HTMLAnchorElement>('[data-mostrar-datas]');
  const falecimento = document.querySelector<HTMLElement>('[data-falecimento]');
  if (mostrar && falecimento) {
    mostrar.setAttribute('role', 'button');
    mostrar.setAttribute('aria-pressed', String(!falecimento.hidden));
    mostrar.addEventListener('click', (evento) => {
      evento.preventDefault();
      falecimento.hidden = !falecimento.hidden;
      mostrar.textContent = falecimento.hidden ? 'Mostrar datas' : 'Esconder datas';
      mostrar.setAttribute('aria-pressed', String(!falecimento.hidden));
      const endereco = new URL(location.href);
      if (falecimento.hidden) endereco.searchParams.delete('datas');
      else endereco.searchParams.set('datas', '1');
      history.replaceState(history.state, '', endereco);
    });
  }

  // As outras formas de ver são buscadas assim que a página se acomoda, para a troca ser imediata
  import { adiantar } from '../../../lib/cliente/explorar-troca';
  const adiantarFormas = () => {
    for (const link of document.querySelectorAll<HTMLAnchorElement>('[data-explorar] .controles a[data-opcao]:not([aria-current])')) adiantar(new URL(link.href));
  };
  if ('requestIdleCallback' in window) requestIdleCallback(adiantarFormas, { timeout: 3000 });
  else setTimeout(adiantarFormas, 1500);
</script>

<script>
  // Trocar a forma de ver não recarrega a página nem tira a pessoa do lugar, como no Explorar.
  // Sem script, cada opção é um link comum, que volta a esta parte da página.
  import { ligarTroca } from '../../../lib/cliente/explorar-troca';
  ligarTroca();
</script>

<script>
  // Acender a foto de quem faleceu: o toque liga e desliga, e fica como está enquanto se está na página
  for (const botao of document.querySelectorAll<HTMLButtonElement>('[data-acender]')) {
    botao.addEventListener('click', () => {
      const aceso = botao.getAttribute('aria-pressed') !== 'true';
      botao.setAttribute('aria-pressed', String(aceso));
      botao.querySelector('.retrato')?.classList.toggle('retrato--aceso', aceso);
    });
  }
</script>
