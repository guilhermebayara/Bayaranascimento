---
// A página da pessoa. A ideia da tela (docs/visual.md): o retrato e a voz. O retrato recortado, o
// parentesco grande, do ponto de vista de quem olha ("sua avó"), e os áudios em que ela fala. A
// lista de laços fica quieta, e as memórias com ela vêm no fim, na linha do tempo.
// Respostas do Gui ao QA de design (17/11/2026, P102 a P108): o atalho "Ouvir a voz de Fulano" no
// alto, quando há áudio que quem olha pode ouvir; no celular, os laços recolhidos numa linha; o
// botão cheio é "Nova memória com Fulano"; a própria página diz "você"; e o nascimento entra no
// carimbo, sem rótulo.
import Recado from '../../../components/visual/Recado.astro';
import '../../../visual/telas/linha.css';
import '../../../visual/telas/explorar.css';
import '../../../visual/telas/lista.css';
import '../../../visual/telas/pessoa.css';
import Visual from '../../../layouts/Visual.astro';
import TrocaDaProposta from '../../../components/pessoa/TrocaDaProposta.astro';
import { temAcervoDeExemplo } from '../../../lib/servidor/ambiente';
import Linha from '../../../components/explorar/Linha.astro';
import Lista from '../../../components/explorar/Lista.astro';
import Mural from '../../../components/explorar/Mural.astro';
import Audio from '../../../components/visual/Audio.astro';
import Carimbo from '../../../components/visual/Carimbo.astro';
import Gente from '../../../components/visual/Gente.astro';
import Retrato from '../../../components/visual/Retrato.astro';
import Vazio from '../../../components/visual/Vazio.astro';
import { duracaoEmTexto } from '../../../lib/audios';
import { formatarData, jaFaleceu, vidaSemRotulo } from '../../../lib/datas';
import { FORMAS_DA_PESSOA, NOMES_DAS_FORMAS, TAMANHO_PADRAO, enderecoDaPessoa, lerFormaDaPessoa, mostraRascunho } from '../../../lib/explorar';
import { apareceComoCasal, apareceComoCoracao, exDoAmigo, viraramAmigos } from '../../../lib/ex-casal';
import { FASES, Familia, estaoJuntos, lacoParaODono, nomeDoPapel, periodosDasFases, possessivo, type Tratamento } from '../../../lib/parentesco';
import { enderecoDoRetrato } from '../../../lib/retratos';
import { apelidoAoLado } from '../../../lib/ordem-das-pessoas';
import { pessoasComAcesso } from '../../../lib/servidor/acesso';
import { podeEditarIntegrante, podeMexerEmLaco } from '../../../lib/servidor/permissoes';
import {
  familiasDe,
  comoOsExesAparecem,
  listarAudiosDe,
  listarCapitulos,
  listarCasais,
  listarFiliacoes,
  listarIntegrantesQueVe,
  listarLacosDoCoracao,
  listarLacosResumidos,
  listarMemorias,
  listarMeusApelidos,
  memoriasComAudio,
  listarNucleos,
  pessoasQueONaoVe,
} from '../../../lib/servidor/repositorio';
import { corDaPessoa } from '../../../lib/visual';

// O nome de um laço do coração entra no meio da frase em minúscula, como na árvore
const minuscula = (texto: string) => texto.charAt(0).toLowerCase() + texto.slice(1);
const { usuario } = Astro.locals;
// Conceito da sessão L, só nas prévias: "?proposta=a" ou "b" abre uma das duas propostas, e a escolha
// fica num cookie para seguir de uma pessoa a outra; "?proposta=hoje" volta à página de hoje
const propostaPedida = temAcervoDeExemplo() ? (Astro.url.searchParams.get('proposta') ?? Astro.cookies.get('proposta-pessoa')?.value ?? null) : null;
if (Astro.url.searchParams.has('proposta') && temAcervoDeExemplo()) Astro.cookies.set('proposta-pessoa', propostaPedida ?? 'hoje', { path: '/', maxAge: 60 * 60 * 24 * 30 });
if (propostaPedida === 'a' || propostaPedida === 'b') {
  const resto = new URLSearchParams(Astro.url.searchParams);
  resto.delete('proposta');
  return Astro.rewrite(`/conceito/pessoa/${propostaPedida}/${Astro.params.id}${resto.size ? `?${resto}` : ''}`);
}
// Quem só existe num laço privado de outra pessoa responde como quem não existe (C1, 17/11/2026)
const integrantes = await listarIntegrantesQueVe(usuario);
const pessoa = integrantes.find((i) => i.id === Astro.params.id);
if (!pessoa) return new Response('Pessoa não encontrada', { status: 404 });

const nucleos = await listarNucleos();
const ordemDosNucleos = nucleos.map((n) => n.id);
// Da mais recente para a mais antiga, como em toda linha do tempo do site
const todasComEla = (await listarMemorias(usuario, { integrante: pessoa.id })).reverse();
// A forma de ver as memórias com a pessoa (pedido do Gui, 17/11/2026): a linha do tempo, que é o
// padrão, o mural e a lista, as mesmas do Explorar. A escolha fica no endereço ("ver"). Como lá,
// o rascunho só aparece na linha do tempo e na lista de quem escreveu.
const forma = lerFormaDaPessoa(Astro.url.searchParams);
const memorias = mostraRascunho(forma) ? todasComEla : todasComEla.filter((m) => m.situacao !== 'rascunho');
const dosNucleos = familiasDe(pessoa).map((id) => nucleos.find((n) => n.id === id)?.nome).filter((n): n is string => Boolean(n));
const especie = pessoa.tipo === 'bicho' ? (pessoa.especie ?? 'bichinho') : null;

const tratamentos = new Map<string, Tratamento>(integrantes.map((i) => [i.id, i.tratamento]));
const filiacoes = await listarFiliacoes();
const familia = new Familia(filiacoes, await listarCasais(usuario), tratamentos);
// Data da adoção, quando a filiação entre esta pessoa e o parente é adotiva e alguém informou
const adocaoCom = (id: string) => {
  const f = filiacoes.find((x) => x.qualidade === 'adotiva' && ((x.filho === pessoa.id && x.responsavel === id) || (x.responsavel === pessoa.id && x.filho === id)));
  return f?.adocao ? `adoção em ${formatarData({ ano: f.adocao.ano, mes: f.adocao.mes, dia: f.adocao.dia, aproximada: false })}` : undefined;
};
const achar = (id: string) => integrantes.find((i) => i.id === id);
const nome = (id: string) => achar(id)?.apelido ?? achar(id)?.nome ?? id;
const chamar = pessoa.apelido ?? pessoa.nome;
// O apelido que quem olha deu (só ele vê). A pergunta usa o nome da ficha (defeito visto pelo Gui depois
// da sessão I: ela usava o apelido da família); "Voltar a" usa o de sempre, que é o que volta
const meuApelido = (await listarMeusApelidos(usuario.pessoa)).get(pessoa.id);
const apelidoNoTitulo = apelidoAoLado(pessoa.nome, pessoa.apelido);
const nomeDaFamilia = (pessoa.apelidoDaFamilia !== undefined ? pessoa.apelidoDaFamilia : null) ?? pessoa.nome;
const naoVe = await pessoasQueONaoVe(usuario);
const retratoDe = (id: string) => (achar(id)?.retrato && !naoVe.has(id) ? enderecoDoRetrato(achar(id)!.retrato!) : null);
const familiaDe = (id: string) => corDaPessoa(achar(id) ? familiasDe(achar(id)!) : [], ordemDosNucleos);
// O que cada parente é desta pessoa: "mãe", "irmão", "filho de consideração".
// Na própria página, com o possessivo, como os laços do coração: "sua mãe", "sua vó de consideração".
const ehMinha = pessoa.id === usuario.pessoa;
const papel = (id: string) => {
  const relacao = familia.relacao(pessoa.id, id);
  if (!relacao) return undefined;
  return ehMinha ? possessivo(relacao, achar(id)?.tratamento ?? null) : relacao.texto;
};
const paraVoce = ehMinha ? undefined : familia.relacao(usuario.pessoa, pessoa.id);

const pais = familia.pais(pessoa.id).map((p) => p.responsavel);
const grupos = [
  { titulo: 'Pais', ids: pais },
  { titulo: 'Irmãos', ids: familia.irmaos(pessoa.id).map((i) => i.id) },
  { titulo: 'Filhos', ids: familia.filhos(pessoa.id).map((f) => f.filho) },
  { titulo: 'Avós', ids: [...new Set(pais.flatMap((p) => familia.pais(p).map((a) => a.responsavel)))] },
].filter((g) => g.ids.length > 0);
const casais = familia.casais(pessoa.id);
// Laços do coração: os que a pessoa escolheu, e os de quem a escolheu
const lacos = await listarLacosDoCoracao(usuario);
const escolhidos = lacos.filter((l) => l.dono === pessoa.id);
const escolhidaPor = lacos.filter((l) => l.pessoa === pessoa.id);
// Sem parentesco calculado, vale o laço do coração de quem está olhando
const meuLaco = paraVoce || ehMinha ? undefined : escolhidaPor.find((l) => l.dono === usuario.pessoa);
// Sem filiação nem casal, a árvore a partir da pessoa seria só ela: o botão não aparece
const temLacoDeArvore = pais.length > 0 || familia.filhos(pessoa.id).length > 0 || casais.some((c) => apareceComoCasal(c.casal));
// Parentes de fora das famílias, sem o caminho inteiro ("Caio é sobrinho do Ed")
const resumidos = (await listarLacosResumidos()).filter((l) => l.a === pessoa.id || l.b === pessoa.id);

// Os áudios em que a pessoa fala (os dos relatos dela), nas memórias que quem olha vê
const audiosDaPessoa = await listarAudiosDe(usuario, pessoa.id);
const podeEditar = podeEditarIntegrante(usuario, pessoa, await pessoasComAcesso()).ok || podeMexerEmLaco(usuario, [pessoa]).ok;

// O parentesco grande: "sua avó" ou "seu amigo-irmão". Na própria página e na de quem não tem laço
// com quem olha, o nome é a linha grande.
const parentesco = paraVoce ? possessivo(paraVoce, pessoa.tratamento) : meuLaco ? lacoParaODono(meuLaco.nome, pessoa.tratamento) : null;
// O nascimento e o falecimento entram no carimbo, sem rótulo: "1999", "4 de maio de 1942 a 2019"
// O falecimento fica oculto (decisão do Gui, 17/11/2026): só entra para quem pedir em "Mostrar
// datas", que recarrega a página com `?datas=1`. Sem script.
const faleceu = (id: string) => Boolean(achar(id) && jaFaleceu(achar(id)!));
const mostrarDatas = Astro.url.searchParams.get('datas') === '1';
const temDataOculta = Boolean(pessoa.falecimentoAno);
const vida = vidaSemRotulo(pessoa, mostrarDatas);
// Na própria página, o carimbo diz "você" e a memória nova é "com você" (P107)
const comQuem = ehMinha ? 'você' : chamar;
const plural = (n: number, um: string, varios: string) => `${n} ${n === 1 ? um : varios}`;
// A história de um casal numa linha: "namoro 2025, depois separação 2025, depois amizade desde 2025"
const historiaDoCasal = (casal: (typeof casais)[number]['casal']) =>
  casal.fases.map((fase, n) => [FASES[fase.tipo].toLowerCase(), periodosDasFases(casal.fases)[n]].filter(Boolean).join(' ')).join(', depois ') +
  (casal.visibilidade === 'privado' ? ' (só os dois veem)' : casal.visibilidade === 'nucleos' ? ' (só as famílias escolhidas veem)' : '');

// Como os exes aparecem para quem olha: só vale na página de quem escolheu
const modosDosExes = ehMinha ? await comoOsExesAparecem(usuario) : new Map<string, 'discreto' | 'fora'>();
// Os grupos de laços, cada um com as suas linhas
type Linha = { id: string; laco?: string | null; detalhe?: string | null };
const partes: { titulo: string; linhas: Linha[] }[] = [
  {
    titulo: 'Casal',
    // A fase decide (decisões do Gui, 18/11/2026; comoOCasalAparece): só o que é família fica em "Casal".
    // O namoro e o ex que virou amigo entram nos laços do coração, e o namoro que acabou sem nunca ter
    // sido da família não aparece aqui
    linhas: casais.filter((c) => apareceComoCasal(c.casal)).map((c) => ({
      id: c.outro,
      laco: papel(c.outro) ?? (estaoJuntos(c.casal) ? null : 'ex'),
      detalhe: historiaDoCasal(c.casal),
    })),
  },
  ...grupos.map((g) => ({ titulo: g.titulo, linhas: g.ids.map((id) => ({ id, laco: papel(id), detalhe: adocaoCom(id) })) })),
  {
    titulo: 'Parentes',
    linhas: resumidos.map((l) => {
      const outro = l.a === pessoa.id ? l.b : l.a;
      return { id: outro, laco: l.a === pessoa.id ? nomeDoPapel(l.papel, achar(outro)?.tratamento ?? null) : `${chamar} é ${nomeDoPapel(l.papel, pessoa.tratamento)}` };
    }),
  },
  {
    titulo: 'Laços do coração',
    linhas: [
      ...escolhidos.map((l) => ({
        id: l.pessoa,
        laco: l.dono === usuario.pessoa ? lacoParaODono(l.nome, achar(l.pessoa)?.tratamento ?? null) : minuscula(l.nome),
        detalhe: l.privado ? 'só você vê' : null,
      })),
      // O ex que virou amigo: "amigo" e, logo abaixo, só "ex-namorado" (pedido do Gui, 18/11/2026), sem datas.
      // O namoro: "namorada", com a história do casal
      ...casais
        .filter((c) => apareceComoCoracao(c.casal) && !escolhidos.some((l) => l.pessoa === c.outro))
        .map((c) => ({
          id: c.outro,
          laco: papel(c.outro) ?? (viraramAmigos(c.casal) ? (achar(c.outro)?.tratamento === 'ela' ? 'amiga' : 'amigo') : achar(c.outro)?.tratamento === 'ela' ? 'namorada' : 'namorado'),
          detalhe: viraramAmigos(c.casal) ? exDoAmigo(c.casal, achar(c.outro)?.tratamento ?? null) : historiaDoCasal(c.casal),
        })),
    ],
  },
  {
    titulo: 'No coração de',
    linhas: escolhidaPor.map((l) => ({
      id: l.dono,
      laco: l.dono === usuario.pessoa ? `${lacoParaODono(l.nome, pessoa.tratamento)} (você)` : `chama de ${minuscula(l.nome)}`,
      detalhe: l.privado ? 'só você vê' : null,
    })),
  },
]
  // Na própria página, o ex que a pessoa deixou discreto ou fora sai dos laços (src/lib/ex-casal.ts)
  .map((p) => (ehMinha && modosDosExes.size > 0 ? { ...p, linhas: p.linhas.filter((l) => !modosDosExes.has(l.id)) } : p))
  .filter((p) => p.linhas.length > 0);
// Quantas pessoas há nos laços, sem contar duas vezes quem aparece em dois grupos
const genteNosLacos = new Set(partes.flatMap((parte) => parte.linhas.map((l) => l.id))).size;
---

<Visual titulo={pessoa.nome} secao="pessoas" nucleos={familiasDe(pessoa)}>
  {temAcervoDeExemplo() && <TrocaDaProposta atual="hoje" id={pessoa.id} />}
  <article class="pessoa-pagina">
    {(Astro.url.searchParams.get('ok') || Astro.url.searchParams.get('erro')) && (
      <div class="miolo pessoa-pagina__recado">
        <Recado erro={Boolean(Astro.url.searchParams.get('erro'))}>{Astro.url.searchParams.get('erro') ?? Astro.url.searchParams.get('ok')}</Recado>
      </div>
    )}
    <header class="quem-e bloco">
      <div class="miolo grade">
        <div class="quem-e__retrato">
          {jaFaleceu(pessoa) ? (
            // Acender a foto (pedido do Gui, 18/11/2026): tocar no retrato grande acende, e ele fica aceso
            // enquanto se está na página. Com mouse e pelo teclado, acende também só de passar ou focar
            <button class="quem-e__acender" type="button" data-acender aria-pressed="false" aria-label={`Acender a foto de ${chamar}`}>
              <Retrato nome={chamar} foto={retratoDe(pessoa.id)} familia={familiaDe(pessoa.id)} falecido cedo />
            </button>
          ) : (
            <Retrato nome={chamar} foto={retratoDe(pessoa.id)} familia={familiaDe(pessoa.id)} cedo />
          )}
        </div>
        <div class="quem-e__texto">
          {(ehMinha || especie || dosNucleos.length > 0 || vida) && (
            <p class="quem-e__sobre">
              <Carimbo itens={[ehMinha && 'Você', especie, dosNucleos.join(' e '), vida]} />
            </p>
          )}
          {/* Aprovado pelo Gui em 17/11/2026 (pergunta 6 do PR do grupo "pessoal"): o parentesco é a linha grande, e o nome vem logo abaixo */}
          {parentesco && <p class="quem-e__laco">{parentesco}</p>}
          {/* "Nome (apelido)", como na lista de Pessoas: o apelido que quem olha vê, o seu ou o da família */}
          <h1 class:list={['quem-e__nome', parentesco ? 't-2' : 't-1']}>
            {pessoa.nome}
            {apelidoNoTitulo && <span class="quem-e__apelido"> ({apelidoNoTitulo})</span>}
          </h1>
          {jaFaleceu(pessoa) && <p class="quem-e__memoria em-memoria">em memória</p>}
          {temDataOculta && (
            <p class="quem-e__datas">
              <a class="acao acao--quieta" href={mostrarDatas ? `/pessoas/${pessoa.id}` : `/pessoas/${pessoa.id}?datas=1`}>
                {mostrarDatas ? 'Esconder datas' : 'Mostrar datas'}
              </a>
            </p>
          )}
          {/* O atalho para a voz (P102): só conta e só leva aos áudios que quem olha pode ouvir, os
              mesmos da lista de baixo (listarAudiosDe) */}
          {audiosDaPessoa.length > 0 && (
            <p class="quem-e__voz">
              <a class="acao" href="#audios">
                Ouvir a voz de {chamar} · {plural(audiosDaPessoa.length, 'áudio', 'áudios')}
              </a>
            </p>
          )}
          {/* A ação principal fica no alto, junto do título (decisão do Gui, 16/11/2026). É a que
              alimenta o acervo: a memória nova (P104). Editar e a árvore vêm como texto. */}
          <p class="quem-e__acoes">
            <a class="botao" href={`/nova?com=${pessoa.id}`}>
              Nova memória com {comQuem}
            </a>
            <a class="acao" href={`/pessoas/${pessoa.id}/editar`}>
              {podeEditar ? 'Editar página e laços' : 'Adicionar laço'}
            </a>
            {temLacoDeArvore && (
              <a class="acao" href={`/arvore?centro=${pessoa.id}`}>
                Ver na árvore
              </a>
            )}
            {ehMinha && (
              <a class="acao acao--quieta" href="/conta">
                Sua conta
              </a>
            )}
          </p>
          {/* "Como você chama", só seu (decisão do Gui, 18/11/2026; src/lib/apelidos.ts): o apelido que quem
              olha dá à pessoa, que só ele vê, no site inteiro */}
          {!ehMinha && (
            <details class="como-chama" id="como-voce-chama">
              <summary class="acao acao--quieta">{meuApelido ? `Você chama de ${meuApelido}` : `Como você chama ${pessoa.nome}?`}</summary>
              <form class="como-chama__form" method="post" action="/api/apelidos">
                <input type="hidden" name="pessoa" value={pessoa.id} />
                <label class="campo">
                  <span class="so-leitor">Como você chama {pessoa.nome}?</span>
                  <input class="campo__entrada" type="text" name="apelido" maxlength="40" autocomplete="off" value={meuApelido ?? ''} placeholder="Ex.: Tia Lu, Vó, Dinho" />
                </label>
                <p class="campo__dica">Só você vê. No site inteiro, para você, {pessoa.nome} aparece assim.</p>
                <p class="como-chama__acoes">
                  <button class="acao" type="submit">Salvar</button>
                  {meuApelido && (
                    <button class="acao acao--quieta" type="submit" name="apelido" value="">
                      Voltar a {nomeDaFamilia}
                    </button>
                  )}
                </p>
              </form>
            </details>
          )}
        </div>
      </div>
    </header>

    {
      (pessoa.sobre || audiosDaPessoa.length > 0) && (
        <div class="voz miolo grade">
          {pessoa.sobre && (
            <section class="voz__sobre" aria-labelledby="sobre">
              <h2 class="rotulo suave" id="sobre">
                Sobre {chamar}
              </h2>
              <div class="voz__texto">
                {pessoa.sobre.split(/\n{2,}/).map((p) => (
                  <p>{p}</p>
                ))}
              </div>
            </section>
          )}
          {audiosDaPessoa.length > 0 && (
            <section class="voz__audios" id="audios" aria-labelledby="titulo-audios">
              <h2 class="t-2" id="titulo-audios">
                A voz de {chamar}
              </h2>
              {audiosDaPessoa.length > 1 && <p class="rotulo suave">{audiosDaPessoa.length} áudios</p>}
              <ol class="voz__lista">
                {audiosDaPessoa.map((audio) => (
                  <li>
                    <p class="voz__memoria">
                      <a class="serifa" href={`/memorias/${audio.memoriaId}`}>
                        {audio.memoriaTitulo}
                      </a>
                    </p>
                    <Audio rotulo={`Áudio · ${duracaoEmTexto(audio.duracao)}`} src={`/audios/${audio.chave}`} transcricao={audio.transcricao} />
                  </li>
                ))}
              </ol>
            </section>
          )}
        </div>
      )
    }

    {
      partes.length > 0 && (
        <section class="lacos miolo" aria-labelledby="lacos" data-lacos>
          {/* No celular os laços ficam fechados numa linha, que abre no lugar (P103). O botão só
              aparece com script; sem ele, a lista fica aberta, como no computador. */}
          <h2 class="rotulo suave" id="lacos">
            <span class="lacos__titulo">Família e laços</span>
            <button class="lacos__abre" type="button" aria-expanded="false" aria-controls="lista-de-lacos" hidden>
              Família e laços · {plural(genteNosLacos, 'pessoa', 'pessoas')}
            </button>
          </h2>
          <script is:inline>
            {
              const lacos = document.currentScript.closest('[data-lacos]');
              const botao = lacos.querySelector('button');
              botao.hidden = false;
              lacos.setAttribute('data-recolhe', '');
              botao.addEventListener('click', () => botao.setAttribute('aria-expanded', String(lacos.toggleAttribute('data-aberta'))));
            }
          </script>
          <div class="lacos__grupos" id="lista-de-lacos">
            {partes.map((parte) => (
              <div class="lacos__grupo">
                <h3 class="ficha">{parte.titulo}</h3>
                <ul>
                  {parte.linhas.map((l) => (
                    <li>
                      <Gente href={`/pessoas/${l.id}`} nome={nome(l.id)} foto={retratoDe(l.id)} familia={familiaDe(l.id)} laco={l.laco} detalhe={l.detalhe} falecido={faleceu(l.id)} />
                    </li>
                  ))}
                </ul>
              </div>
            ))}
          </div>
        </section>
      )
    }

    {/* Decidido pelo Gui em 17/11/2026 (pergunta 8 do PR do grupo "pessoal"): todas as memórias com a pessoa, com a
        "Forma de ver" do Explorar: linha do tempo (o padrão), mural e lista */}
    <section class="com" aria-labelledby="memorias-com">
      <header class="com__abre miolo">
        {memorias.length > 0 && (
          <p class="rotulo suave">
            {memorias.length} {memorias.length === 1 ? 'memória' : 'memórias'}
          </p>
        )}
        <h2 class="t-2" id="memorias-com">
          Memórias com {chamar}
        </h2>
      </header>
      {/* A região troca de conteúdo sem recarregar a página, como no Explorar (explorar-troca.ts) */}
      <div data-explorar>
        {todasComEla.length > 1 && (
          <div class="controles com__controles miolo">
            <div class="controle">
              <p class="controle__nome rotulo suave" id="controle-forma">
                Forma de ver
              </p>
              <nav class="linha__opcoes" aria-labelledby="controle-forma">
                {FORMAS_DA_PESSOA.map((f) => (
                  <a href={`${enderecoDaPessoa(pessoa.id, f)}#memorias-com`} data-opcao={f} aria-current={f === forma ? 'page' : undefined}>
                    {NOMES_DAS_FORMAS[f]}
                  </a>
                ))}
              </nav>
            </div>
          </div>
        )}
        {memorias.length === 0 ? (
          <div class="miolo">
            <Vazio frase={`Nenhuma memória com ${pessoa.nome} por enquanto.`}>
              <a class="acao" href={`/nova?com=${pessoa.id}`}>
                Nova memória com {comQuem}
              </a>
            </Vazio>
          </div>
        ) : forma === 'mural' ? (
          <div class="linha linha--mural">
            <Mural memorias={memorias} ordem="recentes" tamanho={TAMANHO_PADRAO} />
          </div>
        ) : forma === 'lista' ? (
          <div class="linha linha--lista">
            <Lista memorias={memorias} capitulos={await listarCapitulos(usuario)} integrantes={integrantes} ordem="recentes" comAudio={await memoriasComAudio(usuario)} />
          </div>
        ) : (
          <Linha memorias={memorias} capitulos={await listarCapitulos(usuario)} integrantes={integrantes} nucleos={nucleos} ordem="recentes" trilhos={false} />
        )}
      </div>
    </section>
  </article>
</Visual>

<script>
  // Quem chega pela ficha da árvore ("Como você chama") encontra a pergunta aberta, com o foco nela
  const comoChama = document.querySelector<HTMLDetailsElement>('#como-voce-chama');
  if (comoChama && location.hash === '#como-voce-chama') {
    comoChama.open = true;
    comoChama.querySelector<HTMLInputElement>('input[name="apelido"]')?.focus();
  }
</script>


<script>
  // Trocar a forma de ver não recarrega a página nem tira a pessoa do lugar, como no Explorar.
  // Sem script, cada opção é um link comum, que volta a esta parte da página.
  import { ligarTroca } from '../../../lib/cliente/explorar-troca';
  ligarTroca();
</script>

<script>
  // Acender a foto de quem faleceu: o toque liga e desliga, e fica como está enquanto se está na página
  for (const botao of document.querySelectorAll<HTMLButtonElement>('[data-acender]')) {
    botao.addEventListener('click', () => {
      const aceso = botao.getAttribute('aria-pressed') !== 'true';
      botao.setAttribute('aria-pressed', String(aceso));
      botao.querySelector('.retrato')?.classList.toggle('retrato--aceso', aceso);
    });
  }
</script>
