---
// A página da pessoa. A ideia da tela (docs/visual.md): o retrato e a voz. O retrato recortado, o
// parentesco grande, do ponto de vista de quem olha ("sua avó"), e os áudios em que ela fala. A
// lista de laços fica quieta, e as memórias com ela vêm no fim, na linha do tempo.
import '../../../visual/telas/linha.css';
import '../../../visual/telas/pessoa.css';
import Visual from '../../../layouts/Visual.astro';
import Linha from '../../../components/explorar/Linha.astro';
import Audio from '../../../components/visual/Audio.astro';
import Carimbo from '../../../components/visual/Carimbo.astro';
import Gente from '../../../components/visual/Gente.astro';
import Retrato from '../../../components/visual/Retrato.astro';
import Vazio from '../../../components/visual/Vazio.astro';
import { duracaoEmTexto } from '../../../lib/audios';
import { datasDeVida, formatarData } from '../../../lib/datas';
import { FASES, Familia, estaoJuntos, lacoParaODono, nomeDoPapel, periodosDasFases, possessivo, type Tratamento } from '../../../lib/parentesco';
import { enderecoDoRetrato } from '../../../lib/retratos';
import { pessoasComAcesso } from '../../../lib/servidor/acesso';
import { podeEditarIntegrante, podeMexerEmLaco } from '../../../lib/servidor/permissoes';
import {
  familiasDe,
  listarAudiosDe,
  listarCapitulos,
  listarCasais,
  listarFiliacoes,
  listarIntegrantes,
  listarLacosDoCoracao,
  listarLacosResumidos,
  listarMemorias,
  listarNucleos,
  pessoasQueONaoVe,
} from '../../../lib/servidor/repositorio';
import { corDaPessoa } from '../../../lib/visual';

const { usuario } = Astro.locals;
const integrantes = await listarIntegrantes();
const pessoa = integrantes.find((i) => i.id === Astro.params.id);
if (!pessoa) return new Response('Pessoa não encontrada', { status: 404 });

const nucleos = await listarNucleos();
const ordemDosNucleos = nucleos.map((n) => n.id);
// Da mais recente para a mais antiga, como em toda linha do tempo do site
const memorias = (await listarMemorias(usuario, { integrante: pessoa.id })).reverse();
const dosNucleos = familiasDe(pessoa).map((id) => nucleos.find((n) => n.id === id)?.nome).filter((n): n is string => Boolean(n));
const especie = pessoa.tipo === 'bicho' ? (pessoa.especie ?? 'bicho') : null;

const tratamentos = new Map<string, Tratamento>(integrantes.map((i) => [i.id, i.tratamento]));
const filiacoes = await listarFiliacoes();
const familia = new Familia(filiacoes, await listarCasais(usuario), tratamentos);
// Data da adoção, quando a filiação entre esta pessoa e o parente é adotiva e alguém informou
const adocaoCom = (id: string) => {
  const f = filiacoes.find((x) => x.qualidade === 'adotiva' && ((x.filho === pessoa.id && x.responsavel === id) || (x.responsavel === pessoa.id && x.filho === id)));
  return f?.adocao ? `adoção em ${formatarData({ ano: f.adocao.ano, mes: f.adocao.mes, dia: f.adocao.dia, aproximada: false })}` : undefined;
};
const achar = (id: string) => integrantes.find((i) => i.id === id);
const nome = (id: string) => achar(id)?.apelido ?? achar(id)?.nome ?? id;
const chamar = pessoa.apelido ?? pessoa.nome;
const naoVe = await pessoasQueONaoVe(usuario);
const retratoDe = (id: string) => (achar(id)?.retrato && !naoVe.has(id) ? enderecoDoRetrato(achar(id)!.retrato!) : null);
const familiaDe = (id: string) => corDaPessoa(achar(id) ? familiasDe(achar(id)!) : [], ordemDosNucleos);
// O que cada parente é desta pessoa: "mãe", "irmão", "filho de consideração".
// Na própria página, com o possessivo, como os laços do coração: "sua mãe", "sua vó de consideração".
const ehMinha = pessoa.id === usuario.pessoa;
const papel = (id: string) => {
  const relacao = familia.relacao(pessoa.id, id);
  if (!relacao) return undefined;
  return ehMinha ? possessivo(relacao, achar(id)?.tratamento ?? null) : relacao.texto;
};
const paraVoce = ehMinha ? undefined : familia.relacao(usuario.pessoa, pessoa.id);

const pais = familia.pais(pessoa.id).map((p) => p.responsavel);
const grupos = [
  { titulo: 'Pais', ids: pais },
  { titulo: 'Irmãos', ids: familia.irmaos(pessoa.id).map((i) => i.id) },
  { titulo: 'Filhos', ids: familia.filhos(pessoa.id).map((f) => f.filho) },
  { titulo: 'Avós', ids: [...new Set(pais.flatMap((p) => familia.pais(p).map((a) => a.responsavel)))] },
].filter((g) => g.ids.length > 0);
const casais = familia.casais(pessoa.id);
// Laços do coração: os que a pessoa escolheu, e os de quem a escolheu
const lacos = await listarLacosDoCoracao(usuario);
const escolhidos = lacos.filter((l) => l.dono === pessoa.id);
const escolhidaPor = lacos.filter((l) => l.pessoa === pessoa.id);
// Sem parentesco calculado, vale o laço do coração de quem está olhando
const meuLaco = paraVoce || ehMinha ? undefined : escolhidaPor.find((l) => l.dono === usuario.pessoa);
// Sem filiação nem casal, a árvore a partir da pessoa seria só ela: o botão não aparece
const temLacoDeArvore = pais.length > 0 || familia.filhos(pessoa.id).length > 0 || casais.length > 0;
// Parentes de fora das famílias, sem o caminho inteiro ("Caio é sobrinho do Ed")
const resumidos = (await listarLacosResumidos()).filter((l) => l.a === pessoa.id || l.b === pessoa.id);

// Os áudios em que a pessoa fala (os dos relatos dela), nas memórias que quem olha vê
const audiosDaPessoa = await listarAudiosDe(usuario, pessoa.id);
const podeEditar = podeEditarIntegrante(usuario, pessoa, await pessoasComAcesso()).ok || podeMexerEmLaco(usuario, [pessoa]).ok;

// O parentesco grande: "sua avó" ou "seu amigo-irmão". Na própria página e na de quem não tem laço
// com quem olha, o nome é a linha grande.
const parentesco = paraVoce ? possessivo(paraVoce, pessoa.tratamento) : meuLaco ? lacoParaODono(meuLaco.nome, pessoa.tratamento) : null;
// "Nascimento: 4 de maio de 1942" vira dois itens de carimbo, sem o rótulo quando é só o nascimento
const vida = datasDeVida(pessoa);

// Os grupos de laços, cada um com as suas linhas
type Linha = { id: string; laco?: string | null; detalhe?: string | null };
const partes: { titulo: string; linhas: Linha[] }[] = [
  {
    titulo: 'Casal',
    linhas: casais.map((c) => ({
      id: c.outro,
      laco: papel(c.outro) ?? (estaoJuntos(c.casal) ? null : 'ex'),
      detalhe:
        c.casal.fases.map((fase, n) => [FASES[fase.tipo].toLowerCase(), periodosDasFases(c.casal.fases)[n]].filter(Boolean).join(' ')).join(', depois ') +
        (c.casal.visibilidade === 'privado' ? ' (só os dois veem)' : ''),
    })),
  },
  ...grupos.map((g) => ({ titulo: g.titulo, linhas: g.ids.map((id) => ({ id, laco: papel(id), detalhe: adocaoCom(id) })) })),
  {
    titulo: 'Parentes',
    linhas: resumidos.map((l) => {
      const outro = l.a === pessoa.id ? l.b : l.a;
      return { id: outro, laco: l.a === pessoa.id ? nomeDoPapel(l.papel, achar(outro)?.tratamento ?? null) : `${chamar} é ${nomeDoPapel(l.papel, pessoa.tratamento)}` };
    }),
  },
  {
    titulo: 'Laços do coração',
    linhas: escolhidos.map((l) => ({
      id: l.pessoa,
      laco: l.dono === usuario.pessoa ? lacoParaODono(l.nome, achar(l.pessoa)?.tratamento ?? null) : l.nome,
      detalhe: l.privado ? 'só você vê' : null,
    })),
  },
  {
    titulo: 'No coração de',
    linhas: escolhidaPor.map((l) => ({
      id: l.dono,
      laco: l.dono === usuario.pessoa ? `${lacoParaODono(l.nome, pessoa.tratamento)} (você)` : `chama de ${l.nome}`,
      detalhe: l.privado ? 'só você vê' : null,
    })),
  },
].filter((p) => p.linhas.length > 0);
---

<Visual titulo={pessoa.nome} secao="pessoas" nucleos={familiasDe(pessoa)}>
  <article class="pessoa-pagina">
    <header class="quem-e bloco">
      <div class="miolo grade">
        <div class="quem-e__retrato">
          <Retrato nome={chamar} foto={retratoDe(pessoa.id)} familia={familiaDe(pessoa.id)} cedo />
        </div>
        <div class="quem-e__texto">
          {(especie || dosNucleos.length > 0) && (
            <p class="quem-e__sobre">
              <Carimbo itens={[especie, dosNucleos.join(' e ')]} />
            </p>
          )}
          {/* PROVISÓRIO (pergunta 6 do PR do grupo "pessoal"): o parentesco é a linha grande, e o nome vem logo abaixo */}
          {parentesco && <p class="quem-e__laco">{parentesco}</p>}
          <h1 class:list={['quem-e__nome', parentesco ? 't-2' : 't-1']}>{pessoa.nome}</h1>
          {vida.length > 0 && <p class="quem-e__vida ficha">{vida.join(' · ')}</p>}
          {/* A ação principal fica no alto, junto do título (decisão do Gui, 16/11/2026) */}
          <p class="quem-e__acoes">
            <a class="botao" href={`/pessoas/${pessoa.id}/editar`}>
              {podeEditar ? 'Editar página e laços' : 'Adicionar laço'}
            </a>
            {temLacoDeArvore && (
              <a class="acao" href={`/arvore?centro=${pessoa.id}`}>
                Ver na árvore
              </a>
            )}
            <a class="acao" href={`/nova?com=${pessoa.id}`}>
              Nova memória com {chamar}
            </a>
          </p>
        </div>
      </div>
    </header>

    {
      (pessoa.sobre || audiosDaPessoa.length > 0) && (
        <div class="voz miolo grade">
          {pessoa.sobre && (
            <section class="voz__sobre" aria-labelledby="sobre">
              <h2 class="rotulo suave" id="sobre">
                Sobre {chamar}
              </h2>
              <div class="voz__texto">
                {pessoa.sobre.split(/\n{2,}/).map((p) => (
                  <p>{p}</p>
                ))}
              </div>
            </section>
          )}
          {audiosDaPessoa.length > 0 && (
            <section class="voz__audios" id="audios" aria-labelledby="titulo-audios">
              <h2 class="t-2" id="titulo-audios">
                A voz de {chamar}
              </h2>
              {audiosDaPessoa.length > 1 && <p class="rotulo suave">{audiosDaPessoa.length} áudios</p>}
              <ol class="voz__lista">
                {audiosDaPessoa.map((audio) => (
                  <li>
                    <p class="voz__memoria">
                      <a class="serifa" href={`/memorias/${audio.memoriaId}`}>
                        {audio.memoriaTitulo}
                      </a>
                    </p>
                    <Audio rotulo={`Áudio · ${duracaoEmTexto(audio.duracao)}`} src={`/audios/${audio.chave}`} transcricao={audio.transcricao} />
                  </li>
                ))}
              </ol>
            </section>
          )}
        </div>
      )
    }

    {
      partes.length > 0 && (
        <section class="lacos miolo" aria-labelledby="lacos">
          <h2 class="rotulo suave" id="lacos">
            Família e laços
          </h2>
          <div class="lacos__grupos">
            {partes.map((parte) => (
              <div class="lacos__grupo">
                <h3 class="ficha">{parte.titulo}</h3>
                <ul>
                  {parte.linhas.map((l) => (
                    <li>
                      <Gente href={`/pessoas/${l.id}`} nome={nome(l.id)} foto={retratoDe(l.id)} familia={familiaDe(l.id)} laco={l.laco} detalhe={l.detalhe} />
                    </li>
                  ))}
                </ul>
              </div>
            ))}
          </div>
        </section>
      )
    }

    {/* PROVISÓRIO (pergunta 8 do PR do grupo "pessoal"): todas as memórias, na linha do tempo do Explorar */}
    <section class="com" aria-labelledby="memorias-com">
      <header class="com__abre miolo">
        {memorias.length > 0 && (
          <p class="rotulo suave">
            {memorias.length} {memorias.length === 1 ? 'memória' : 'memórias'}
          </p>
        )}
        <h2 class="t-2" id="memorias-com">
          Memórias com {chamar}
        </h2>
      </header>
      {
        memorias.length === 0 ? (
          <div class="miolo">
            <Vazio frase={`Nenhuma memória com ${pessoa.nome} por enquanto.`}>
              <a class="acao" href={`/nova?com=${pessoa.id}`}>
                Nova memória com {chamar}
              </a>
            </Vazio>
          </div>
        ) : (
          <Linha memorias={memorias} capitulos={await listarCapitulos(usuario)} integrantes={integrantes} nucleos={nucleos} ordem="recentes" trilhos={false} />
        )
      }
    </section>
  </article>
</Visual>
