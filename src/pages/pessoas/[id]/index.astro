---
// A página da pessoa: o verbete (proposta A do conceito da sessão L, escolhida pelo Gui em 18/11/2026;
// o estudo está em docs/visual/conceito-pessoa-do-zero/leia-me.md). A página diz quem a pessoa é, como
// um verbete de enciclopédia com a ficha de um site de genealogia ao lado: o parentesco de quem olha
// como a linha maior, uma frase de abertura, o quadro com o retrato, os dados, a família de perto e o
// que ela é para você (o círculo e o laço de vocês), as palavras dela (relatos e áudios) e a vida em
// memórias, pela idade, com a linha do tempo e o mural como opção. Os laços ficam quietos, no fim.
// A cor da família entra no alto do quadro, atrás do retrato, e marca as idades e as citações.
import '../../../visual/telas/linha.css';
import '../../../visual/telas/explorar.css';
import '../../../visual/telas/pessoa.css';
import Visual from '../../../layouts/Visual.astro';
import Linha from '../../../components/explorar/Linha.astro';
import Mural from '../../../components/explorar/Mural.astro';
import VidaPorIdade from '../../../components/pessoa/VidaPorIdade.astro';
import Audio from '../../../components/visual/Audio.astro';
import Carimbo from '../../../components/visual/Carimbo.astro';
import Gente from '../../../components/visual/Gente.astro';
import PilulaDeFamilia from '../../../components/visual/PilulaDeFamilia.astro';
import Recado from '../../../components/visual/Recado.astro';
import Retrato from '../../../components/visual/Retrato.astro';
import Vazio from '../../../components/visual/Vazio.astro';
import { TAMANHO_PADRAO } from '../../../lib/explorar';
import { FORMAS_DA_VIDA, enderecoDaVida, fraseDoAcervo, lerFormaDaVida, mostraRascunhoNaVida, nomeDaFormaDaVida } from '../../../lib/pagina-da-pessoa';
import { montarPaginaDaPessoa, type Ligada } from '../../../lib/servidor/pagina-da-pessoa';
import { listarCapitulos } from '../../../lib/servidor/repositorio';

const { usuario } = Astro.locals;
// Quem só existe num laço privado de outra pessoa responde como quem não existe (C1, 17/11/2026)
const p = await montarPaginaDaPessoa(usuario, Astro.params.id!, Astro.url.searchParams.get('datas') === '1');
if (!p) return new Response('Pessoa não encontrada', { status: 404 });
const { pessoa, chamar } = p;
const plural = (n: number, um: string, varios: string) => `${n} ${n === 1 ? um : varios}`;

// A forma de ver as memórias (pedido do Gui, 18/11/2026): pela idade é o padrão, e a linha do tempo e
// o mural continuam como opção. A escolha fica no endereço ("ver") e troca sem recarregar
const forma = lerFormaDaVida(Astro.url.searchParams);
const memorias = mostraRascunhoNaVida(forma) ? p.todasComEla : p.publicadas;
const comIdade = Boolean(pessoa.nascimentoAno);

// A frase de abertura do verbete: o primeiro parágrafo de "Sobre" ou, sem ele, o que o acervo sabe.
// O resto de "Sobre" vem em "Nas palavras de"
const sobre = pessoa.sobre?.split(/\n{2,}/).map((t) => t.trim()).filter(Boolean) ?? [];
const abertura =
  sobre[0] ?? fraseDoAcervo({ nome: chamar, memorias: p.publicadas.length, de: p.periodo?.de, ate: p.periodo?.ate, relatos: p.relatos.length, eu: p.ehMinha });
const restoDoSobre = sobre.slice(1);

// A família de perto, para o quadro: quem está acima, ao lado e abaixo na árvore
const grupo = (chave: string) => p.grupos.find((g) => g.chave === chave)?.linhas ?? [];
const vizinhanca = [
  { rotulo: 'Pais', gente: grupo('pais') },
  { rotulo: grupo('casal').length === 1 ? 'Casal' : 'Casais', gente: grupo('casal') },
  { rotulo: 'Irmãos', gente: grupo('irmaos') },
  { rotulo: 'Filhos', gente: grupo('filhos') },
].filter((g) => g.gente.length > 0);
const RELATOS_A_VISTA = 3;
const recado = Astro.url.searchParams.get('erro') ?? Astro.url.searchParams.get('ok');
---

<Visual titulo={pessoa.nome} secao="pessoas" nucleos={p.familiasDaPessoa.map((f) => f.id)}>
  <article class="verbete">
    {recado && (
      <div class="miolo verbete__recado">
        <Recado erro={Boolean(Astro.url.searchParams.get('erro'))}>{recado}</Recado>
      </div>
    )}
    <div class="verbete__alto miolo grade">
      <header class="verbete__abre">
        {(p.ehMinha || p.especie) && (
          <p class="verbete__carimbo">
            <Carimbo itens={[p.ehMinha && 'Você', p.especie]} />
          </p>
        )}
        {/* O parentesco de quem olha é a linha grande ("sua mãe"), e o nome vem logo abaixo. Na própria
            página e na de quem não tem laço com quem olha, o nome é a linha grande */}
        {p.parentesco && <p class="verbete__laco">{p.parentesco}</p>}
        {/* "Nome (apelido)", como na lista de Pessoas: o apelido que quem olha vê, o seu ou o da família */}
        <h1 class:list={['verbete__nome', p.parentesco ? 't-2' : 't-1']}>
          {pessoa.nome}
          {p.apelidoNoTitulo && <span class="verbete__apelido"> ({p.apelidoNoTitulo})</span>}
        </h1>
        {p.falecida && <p class="verbete__memoria em-memoria">em memória</p>}
        <p class="verbete__abertura">{abertura}</p>
        {/* A ação principal fica no alto, junto do título: a que alimenta o acervo, a memória nova */}
        <p class="verbete__acoes">
          <a class="botao" href={`/nova?com=${pessoa.id}`}>
            Nova memória com {p.comQuem}
          </a>
          <a class="acao" href={`/pessoas/${pessoa.id}/editar`}>
            {p.podeEditar ? 'Editar página e laços' : 'Adicionar laço'}
          </a>
          {p.ehMinha && (
            <a class="acao acao--quieta" href="/conta">
              Sua conta
            </a>
          )}
        </p>
        {/* "Como você chama", só seu (src/lib/apelidos.ts): o apelido que quem olha dá à pessoa */}
        {!p.ehMinha && (
          <details class="como-chama" id="como-voce-chama">
            <summary class="acao acao--quieta">{p.meuApelido ? `Você chama de ${p.meuApelido}` : `Como você chama ${pessoa.nome}?`}</summary>
            <form class="como-chama__form" method="post" action="/api/apelidos">
              <input type="hidden" name="pessoa" value={pessoa.id} />
              <label class="campo">
                <span class="so-leitor">Como você chama {pessoa.nome}?</span>
                <input class="campo__entrada" type="text" name="apelido" maxlength="40" autocomplete="off" value={p.meuApelido ?? ''} placeholder="Ex.: Tia Lu, Vó, Dinho" />
              </label>
              <p class="campo__dica">Só você vê. No site inteiro, para você, {pessoa.nome} aparece assim.</p>
              <p class="como-chama__acoes">
                <button class="acao" type="submit">Salvar</button>
                {p.meuApelido && (
                  <button class="acao acao--quieta" type="submit" name="apelido" value="">
                    Voltar a {p.nomeDaFamilia}
                  </button>
                )}
              </p>
            </form>
          </details>
        )}
      </header>

      {/* O quadro ao lado, como o de um verbete: o retrato no alto, na cor da família, os dados, a
          família de perto e o que a pessoa é para você. No celular, logo depois da abertura */}
      <aside class="verbete__quadro" aria-label={`Ficha de ${chamar}`}>
        <div class="verbete__capa" data-familia={p.familiaDaPessoa}>
          <div class="verbete__retrato">
            {p.falecida ? (
              // Acender a foto (pedido do Gui, 18/11/2026): tocar no retrato grande acende, e ele fica aceso
              // enquanto se está na página. Com mouse e pelo teclado, acende também só de passar ou focar
              <button class="verbete__acender" type="button" data-acender aria-pressed="false" aria-label={`Acender a foto de ${chamar}`}>
                <Retrato nome={chamar} foto={p.retrato} familia={p.familiaDaPessoa} falecido cedo />
              </button>
            ) : (
              <Retrato nome={chamar} foto={p.retrato} familia={p.familiaDaPessoa} cedo />
            )}
          </div>
        </div>
        <div class="verbete__ficha">
          <dl class="verbete__dados">
            {p.vida && (
              <div>
                <dt class="rotulo suave">Nasceu</dt>
                <dd>
                  {p.vida}
                  {/* O falecimento fica oculto (decisão do Gui, 17/11/2026): só para quem pedir */}
                  {p.temDataOculta && (
                    <a class="acao acao--quieta verbete__datas" href={p.mostrarDatas ? `/pessoas/${pessoa.id}` : `/pessoas/${pessoa.id}?datas=1`}>
                      {p.mostrarDatas ? 'Esconder datas' : 'Mostrar datas'}
                    </a>
                  )}
                </dd>
              </div>
            )}
            {p.familiasDaPessoa.length > 0 && (
              <div>
                <dt class="rotulo suave">{p.familiasDaPessoa.length === 1 ? 'Família' : 'Famílias'}</dt>
                <dd class="pilulas-de-familia">
                  {p.familiasDaPessoa.map((f) => (
                    <PilulaDeFamilia href={`/pessoas?familia=${f.id}`} familia={f.cor}>
                      {f.nome}
                    </PilulaDeFamilia>
                  ))}
                </dd>
              </div>
            )}
            <div>
              <dt class="rotulo suave">No acervo</dt>
              <dd>
                {plural(p.publicadas.length, 'memória', 'memórias')}
                {p.relatos.length > 0 && <>, {plural(p.relatos.length, 'relato', 'relatos')}</>}
                {p.audios.length > 0 && (
                  <>
                    , <a class="acao acao--quieta" href="#palavras">{plural(p.audios.length, 'áudio', 'áudios')}</a>
                  </>
                )}
              </dd>
            </div>
          </dl>

          {vizinhanca.length > 0 && (
            <section class="vizinhanca" aria-labelledby="vizinhanca">
              <h2 class="rotulo suave" id="vizinhanca">
                Na árvore
              </h2>
              {vizinhanca.map((g) => (
                <div class="vizinhanca__nivel">
                  <p class="ficha suave">{g.rotulo}</p>
                  <ul>
                    {g.gente.map((l: Ligada) => (
                      <li>
                        <a class="vizinhanca__quem" href={`/pessoas/${l.id}`}>
                          <Retrato nome={l.nome} foto={l.foto} familia={l.familia} falecido={l.falecido} />
                          <span>{l.nome}</span>
                          {l.falecido && <span class="so-leitor">, já faleceu</span>}
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>
              ))}
              {/* Sem filiação nem casal, a árvore a partir da pessoa seria só ela: o botão não aparece */}
              {p.temLacoDeArvore && (
                <p class="vizinhanca__ir">
                  <a class="acao" href={`/arvore?centro=${pessoa.id}`}>
                    Ver na árvore
                  </a>
                </p>
              )}
            </section>
          )}
          {vizinhanca.length === 0 && p.temLacoDeArvore && (
            <p>
              <a class="acao" href={`/arvore?centro=${pessoa.id}`}>
                Ver na árvore
              </a>
            </p>
          )}

          {/* Você e a pessoa (decisão do Gui, 18/11/2026): o lugar dela no seu círculo, que só você vê,
              e a página do laço de vocês. Na própria página, o caminho para o seu círculo */}
          {(p.circulo || p.lacoComVoce) && (
            <section class="verbete__voce" aria-labelledby="voce-e">
              <h2 class="rotulo suave" id="voce-e">
                Você e {chamar}
              </h2>
              {p.circulo && (
                <p>
                  No seu círculo: <strong>{p.circulo.faixa}</strong>
                  <span class="ficha suave verbete__so-voce">só você vê</span>
                </p>
              )}
              <p class="verbete__voce-acoes">
                {p.lacoComVoce && (
                  <a class="acao" href={p.lacoComVoce}>
                    Ver o laço de vocês
                  </a>
                )}
                {p.circulo && (
                  <a class="acao acao--quieta" href="/circulo">
                    Ver seu círculo
                  </a>
                )}
              </p>
            </section>
          )}
          {p.ehMinha && (
            <p class="verbete__voce">
              <a class="acao" href="/circulo">
                Ver seu círculo
              </a>
            </p>
          )}
        </div>
      </aside>

      {/* Nas palavras dela: o resto de "Sobre", os áudios dos relatos e os trechos dos relatos, só os
          que quem olha pode ver (listarAudiosDe e listarRelatosDe passam por veORelato) */}
      {(p.relatos.length > 0 || p.audios.length > 0 || restoDoSobre.length > 0) && (
        <section class="verbete__palavras" id="palavras" aria-labelledby="titulo-palavras">
          <h2 class="t-2" id="titulo-palavras">
            {p.ehMinha ? 'Nas suas palavras' : `Nas palavras de ${chamar}`}
          </h2>
          {restoDoSobre.length > 0 && (
            <div class="palavras__sobre">
              {restoDoSobre.map((t) => (
                <p>{t}</p>
              ))}
            </div>
          )}
          {p.audios.length > 0 && (
            <ol class="palavras__audios" id="audios">
              {p.audios.map((a) => (
                <li>
                  <a class="serifa" href={`/memorias/${a.memoriaId}`}>
                    {a.memoriaTitulo}
                  </a>
                  <Audio rotulo={`Áudio · ${a.duracaoEmTexto}`} src={`/audios/${a.chave}`} transcricao={a.transcricao} />
                </li>
              ))}
            </ol>
          )}
          {p.relatos.length > 0 && (
            <ol class="palavras__relatos">
              {p.relatos.slice(0, RELATOS_A_VISTA).map((r) => (
                <li>
                  <blockquote class="palavras__trecho">{r.trecho}</blockquote>
                  <p class="ficha suave">
                    {r.memoriaAno} ·{' '}
                    <a class="acao acao--quieta" href={`/memorias/${r.memoriaId}`}>
                      {r.memoriaTitulo}
                    </a>
                  </p>
                </li>
              ))}
            </ol>
          )}
          {p.relatos.length > RELATOS_A_VISTA && (
            <details class="palavras__mais">
              <summary class="acao">Ver {p.relatos.length - RELATOS_A_VISTA === 1 ? 'o outro relato' : `os outros ${p.relatos.length - RELATOS_A_VISTA} relatos`}</summary>
              <ol class="palavras__relatos">
                {p.relatos.slice(RELATOS_A_VISTA).map((r) => (
                  <li>
                    <blockquote class="palavras__trecho">{r.trecho}</blockquote>
                    <p class="ficha suave">
                      {r.memoriaAno} ·{' '}
                      <a class="acao acao--quieta" href={`/memorias/${r.memoriaId}`}>
                        {r.memoriaTitulo}
                      </a>
                    </p>
                  </li>
                ))}
              </ol>
            </details>
          )}
        </section>
      )}

      {/* A vida em memórias. A região troca de conteúdo sem recarregar a página, como no Explorar
          (explorar-troca.ts): pela idade (o padrão), a linha do tempo e o mural */}
      <section class:list={['verbete__vida', `verbete__vida--${forma}`]} aria-labelledby="memorias-com" data-explorar>
        <header class="vida__abre miolo">
          <h2 class="t-2" id="memorias-com">
            {p.ehMinha ? 'Sua vida em memórias' : `A vida de ${chamar} em memórias`}
          </h2>
          {p.todasComEla.length > 1 && (
            <div class="controles vida__controles">
              <div class="controle">
                <p class="controle__nome rotulo suave" id="controle-forma">
                  Forma de ver
                </p>
                <nav class="linha__opcoes" aria-labelledby="controle-forma">
                  {FORMAS_DA_VIDA.map((f) => (
                    <a href={`${enderecoDaVida(pessoa.id, f)}#memorias-com`} data-opcao={f} aria-current={f === forma ? 'page' : undefined}>
                      {nomeDaFormaDaVida(f, comIdade)}
                    </a>
                  ))}
                </nav>
              </div>
            </div>
          )}
        </header>
        {memorias.length === 0 ? (
          <div class="miolo">
            <Vazio frase={`Nenhuma memória com ${pessoa.nome} por enquanto.`}>
              <a class="acao" href={`/nova?com=${pessoa.id}`}>
                Nova memória com {p.comQuem}
              </a>
            </Vazio>
          </div>
        ) : forma === 'mural' ? (
          <div class="linha linha--mural">
            <Mural memorias={memorias} ordem="recentes" tamanho={TAMANHO_PADRAO} />
          </div>
        ) : forma === 'linha' ? (
          <Linha memorias={memorias} capitulos={await listarCapitulos(usuario)} integrantes={p.integrantes} nucleos={p.nucleos} ordem="recentes" trilhos={false} />
        ) : (
          <VidaPorIdade memorias={memorias} nascimentoAno={pessoa.nascimentoAno} />
        )}
      </section>
    </div>

    {/* Família e laços, quieta, no fim, como o "ver também" do verbete. O casal e os laços do coração
        levam também à página do laço */}
    {p.grupos.length > 0 && (
      <section class="verbete__lacos miolo" aria-labelledby="lacos">
        <header class="lacos__abre">
          <h2 class="t-2" id="lacos">
            Família e laços
          </h2>
          <p class="ficha suave">{plural(p.genteNosLacos, 'pessoa', 'pessoas')}</p>
        </header>
        <div class="lacos__grupos">
          {p.grupos.map((g) => (
            <div class="lacos__grupo">
              <h3 class="ficha">{g.titulo}</h3>
              <ul>
                {g.linhas.map((l) => (
                  <li>
                    <Gente href={`/pessoas/${l.id}`} nome={l.nome} foto={l.foto} familia={l.familia} laco={l.laco} detalhe={l.detalhe} falecido={l.falecido} />
                    {(g.chave === 'casal' || g.chave === 'coracao') && (
                      <a class="acao acao--quieta lacos__laco" href={l.enderecoDoLaco}>
                        Ver o laço
                      </a>
                    )}
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </section>
    )}
  </article>
</Visual>

<script>
  // Quem chega pela ficha da árvore ("Como você chama") encontra a pergunta aberta, com o foco nela
  const comoChama = document.querySelector<HTMLDetailsElement>('#como-voce-chama');
  if (comoChama && location.hash === '#como-voce-chama') {
    comoChama.open = true;
    comoChama.querySelector<HTMLInputElement>('input[name="apelido"]')?.focus();
  }
</script>

<script>
  // Trocar a forma de ver não recarrega a página nem tira a pessoa do lugar, como no Explorar.
  // Sem script, cada opção é um link comum, que volta a esta parte da página.
  import { ligarTroca } from '../../../lib/cliente/explorar-troca';
  ligarTroca();
</script>

<script>
  // Acender a foto de quem faleceu: o toque liga e desliga, e fica como está enquanto se está na página
  for (const botao of document.querySelectorAll<HTMLButtonElement>('[data-acender]')) {
    botao.addEventListener('click', () => {
      const aceso = botao.getAttribute('aria-pressed') !== 'true';
      botao.setAttribute('aria-pressed', String(aceso));
      botao.querySelector('.retrato')?.classList.toggle('retrato--aceso', aceso);
    });
  }
</script>
