---
import Base from '../../layouts/Base.astro';
import Abertura from '../../components/Abertura.astro';
import { familiasDe, listarIntegrantes, listarMemorias, listarNucleos } from '../../lib/servidor/repositorio';

const { usuario } = Astro.locals;
const integrantes = await listarIntegrantes();
const nucleos = await listarNucleos();
const memorias = await listarMemorias(usuario);
const contar = (id: string) => memorias.filter((m) => m.integrantes.includes(id)).length;
const grupos = [
  // Membros e parentes de cada família juntos, sem diferença na tela
  ...nucleos.map((n) => ({ nome: n.nome, membros: integrantes.filter((i) => familiasDe(i).includes(n.id)) })),
  { nome: 'Outras pessoas', membros: integrantes.filter((i) => familiasDe(i).length === 0) },
].filter((g) => g.membros.length > 0);
---

<Base titulo="Pessoas">
  <Abertura titulo="Pessoas">
    <p>Quem aparece nas memórias da família, por núcleo.</p>
    <p class="acoes"><a class="botao botao--leve" href="/pessoas/nova">Cadastrar pessoa</a> <a class="botao botao--leve" href="/arvore">Ver a árvore</a></p>
  </Abertura>
  {
    grupos.map((grupo) => (
      <section class="grupo">
        <h2>{grupo.nome}</h2>
        <ul class="pessoas">
          {grupo.membros.map((p) => {
            const n = contar(p.id);
            return (
              <li>
                <a href={`/pessoas/${p.id}`}>
                  <strong>{p.nome}</strong>
                  <span>
                    {p.tipo === 'bicho' && `${p.especie ?? 'bicho'}, `}
                    {n} {n === 1 ? 'memória' : 'memórias'}
                  </span>
                </a>
              </li>
            );
          })}
        </ul>
      </section>
    ))
  }
</Base>
