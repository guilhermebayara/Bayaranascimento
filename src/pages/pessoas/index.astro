---
// A lista de pessoas: quem aparece nas memórias, por família, cada família com a sua cor. Cada
// pessoa é uma linha com o retrato, o nome, o que ela é para quem olha ("sua avó") e a conta das
// memórias em que aparece.
// Respostas do Gui ao QA de design (17/11/2026, P98 a P101): "Procurar pelo nome" no alto; dentro de
// cada família, a ordem é por geração, dos mais velhos aos mais novos, com os bichos no fim, e quem
// preferir troca para a ordem alfabética (`?ordem=nome`, sem script); a conta do bloco vem por
// extenso; e a linha das memórias some quando a conta é zero.
// Proposta B do conceito da sessão E (escolha do Gui, 17/11/2026): no computador, o alto vira um
// índice na coluna da esquerda, que acompanha a lista onde há mouse; cada família é uma faixa colorida
// que abre e fecha (details, sem script); a pílula de família filtra a lista, uma família por vez
// (`?familia=`, junto com `?ordem=`); no celular, só a busca fica à vista, e "Famílias e ordem" abre o
// resto.
// "Nome (apelido)" (decisão do Gui, 18/11/2026, depois da sessão H): cada pessoa aparece como "Alexsander
// (Lugh)", com o apelido que quem olha vê (o seu, senão o da família, que `listarIntegrantes` já trocou), e
// a busca acha pelos dois. Regras em src/lib/ordem-das-pessoas.ts.
import '../../visual/telas/pessoas.css';
import Visual from '../../layouts/Visual.astro';
import Gente from '../../components/visual/Gente.astro';
import PilulaDeFamilia from '../../components/visual/PilulaDeFamilia.astro';
import { Familia, calcularGeracoes, possessivo, type Tratamento } from '../../lib/parentesco';
import { jaFaleceu } from '../../lib/datas';
import { apelidoAoLado, enderecoDePessoas, familiaPedida, gruposDaFamilia, nomeComApelido, ordemPedida, ordenarPessoas } from '../../lib/ordem-das-pessoas';
import { enderecoDoRetrato } from '../../lib/retratos';
import { familiasDe, listarCasais, listarFiliacoes, listarIntegrantesQueVe, listarMemorias, listarNucleos, pessoasQueONaoVe, type Integrante } from '../../lib/servidor/repositorio';
import { corDaPessoa, corDoNucleo } from '../../lib/visual';

const { usuario } = Astro.locals;
// Quem só existe num laço privado de outra pessoa não entra na lista (C1, 17/11/2026)
const integrantes = await listarIntegrantesQueVe(usuario);
// "Procurar pelo nome" sem script: a lista suspensa manda `?ir=<pessoa>`, e a página leva até ela
const ir = Astro.url.searchParams.get('ir');
if (ir && integrantes.some((i) => i.id === ir)) return Astro.redirect(`/pessoas/${ir}`);
const ordem = ordemPedida(Astro.url.searchParams.get('ordem'));
const filiacoes = await listarFiliacoes();
const casais = await listarCasais(usuario);
const geracoes = calcularGeracoes(
  integrantes.map((i) => i.id),
  filiacoes,
  casais,
);
const naOrdem = (membros: Integrante[]) => ordenarPessoas(membros, geracoes, ordem);
const nucleos = await listarNucleos();
const ordemDosNucleos = nucleos.map((n) => n.id);
const memorias = await listarMemorias(usuario);
const contar = (id: string) => memorias.filter((m) => m.integrantes.includes(id)).length;
const todosOsGrupos = [
  // Membros e parentes de cada família juntos, sem diferença na tela
  ...nucleos.map((n) => ({ id: n.id, nome: n.nome, cor: corDoNucleo(n.id, ordemDosNucleos), membros: naOrdem(integrantes.filter((i) => familiasDe(i).includes(n.id))) })),
  { id: 'outras', nome: 'Outras pessoas', cor: 'tudo', membros: naOrdem(integrantes.filter((i) => familiasDe(i).length === 0)) },
].filter((g) => g.membros.length > 0);
// A pílula marcada mostra só aquela família; "Todas" mostra todas. Família que não está na lista vale "Todas".
const familiaEmUso = familiaPedida(Astro.url.searchParams.get('familia'), todosOsGrupos.map((g) => g.id));
const grupos = gruposDaFamilia(todosOsGrupos, familiaEmUso);

// O que cada pessoa é para quem olha: "sua avó", "seu primo". Sem laço calculado, a linha fica sem.
// Aprovado pelo Gui em 17/11/2026 (pergunta 3 do PR do grupo "familia"): o parentesco de quem olha na lista de pessoas
const tratamentos = new Map<string, Tratamento>(integrantes.map((i) => [i.id, i.tratamento]));
const familia = new Familia(filiacoes, casais, tratamentos);
const paraVoce = (p: Integrante) => {
  if (p.id === usuario.pessoa) return 'você';
  const relacao = familia.relacao(usuario.pessoa, p.id);
  return relacao ? possessivo(relacao, p.tratamento) : null;
};
const plural = (n: number, um: string, varios: string) => `${n} ${n === 1 ? um : varios}`;
// A conta por extenso, no alto e em cada bloco. Quem é de duas famílias aparece nas duas (resposta
// do Gui, P99), então a soma dos blocos passa da conta do alto, e os números soltos convidavam a somar.
const contaDe = (lista: Integrante[]) => {
  const bichos = lista.filter((i) => i.tipo === 'bicho').length;
  return [lista.length > bichos ? plural(lista.length - bichos, 'pessoa', 'pessoas') : null, bichos > 0 ? plural(bichos, 'bichinho', 'bichinhos') : null].filter(Boolean).join(' · ');
};
const conta = contaDe(integrantes);
const naoVe = await pessoasQueONaoVe(usuario);
const temPagina = integrantes.some((i) => i.id === usuario.pessoa);
const detalhe = (p: Integrante) => {
  const n = contar(p.id);
  // Sem memória nenhuma, a linha da conta não aparece (P101)
  return [p.tipo === 'bicho' ? (p.especie ?? 'bichinho') : null, n > 0 ? plural(n, 'memória', 'memórias') : null].filter(Boolean).join(' · ') || null;
};
const porNome = [...integrantes].sort((a, b) => a.nome.localeCompare(b.nome, 'pt-BR'));
// A troca de ordem guarda a família, e a pílula de família guarda a ordem
const ORDENS = [
  { id: 'geracao', texto: 'Por geração', href: enderecoDePessoas(familiaEmUso, 'geracao') },
  { id: 'nome', texto: 'De A a Z', href: enderecoDePessoas(familiaEmUso, 'nome') },
];
// O que está valendo, para o controle fechado do celular dizer sem abrir (como os filtros do Explorar)
const escolhido = [todosOsGrupos.find((g) => g.id === familiaEmUso)?.nome, ordem === 'nome' ? 'De A a Z' : null].filter(Boolean).join(' · ');
---

<Visual titulo="Pessoas" secao="pessoas">
  <div class="pessoas-pagina miolo">
    <header class="pessoas-pagina__indice">
      {/* O que esta página é: o título, com a conta colada nele, e a frase de apoio */}
      <div class="pessoas-pagina__abre">
        <h1 class="serifa t-2">Pessoas</h1>
        <p class="rotulo suave">{conta}</p>
        <p class="pessoas-pagina__frase suave">Quem aparece nas memórias da família, por família.</p>
      </div>

      {/* Achar alguém: a busca sempre à vista; as famílias e a ordem, no celular, quando a pessoa pede */}
      <form class="pessoas-pagina__busca" method="get" action="/pessoas" data-procurar>
        <label class="pessoas-pagina__rotulo rotulo suave" for="procurar-pessoa">Procurar pelo nome</label>
        <div class="pessoas-pagina__campo">
          <select id="procurar-pessoa" name="ir" required>
            <option value="">Escreva o nome</option>
            {porNome.map((p) => <option value={p.id}>{nomeComApelido(p.nome, p.apelido)}</option>)}
          </select>
          <button class="acao" type="submit">Abrir a página</button>
        </div>
      </form>
      <div class="pessoas-pagina__controles" data-controles>
        {/* Sem script o botão não aparece e as escolhas ficam à vista */}
        <button class="pessoas-pagina__abre-controles" type="button" aria-expanded="false" aria-controls="familias-e-ordem" hidden>
          <span>
            Famílias e ordem{escolhido && <span class="pessoas-pagina__escolhido"> · {escolhido}</span>}
          </span>
        </button>
        <div class="pessoas-pagina__escolhas" id="familias-e-ordem">
          {
            todosOsGrupos.length > 1 && (
              <div class="pessoas-pagina__familias">
                <p class="rotulo suave" id="rotulo-familias">
                  Família
                </p>
                <nav class="pilulas-de-familia" aria-labelledby="rotulo-familias">
                  <PilulaDeFamilia href={enderecoDePessoas(null, ordem)} familia="tudo" atual={familiaEmUso === null}>
                    Todas
                  </PilulaDeFamilia>
                  {todosOsGrupos.map((g) => (
                    <PilulaDeFamilia href={enderecoDePessoas(g.id, ordem)} familia={g.cor} atual={familiaEmUso === g.id} conta={g.membros.length}>
                      {g.nome}
                    </PilulaDeFamilia>
                  ))}
                </nav>
              </div>
            )
          }
          <nav class="pessoas-pagina__ordem" aria-labelledby="rotulo-ordem">
            <p class="rotulo suave" id="rotulo-ordem">
              Ordem
            </p>
            <p class="pessoas-pagina__opcoes">
              {ORDENS.map((o) => (
                <a class="acao acao--quieta" href={o.href} aria-current={o.id === ordem ? 'true' : undefined}>
                  {o.texto}
                </a>
              ))}
            </p>
          </nav>
        </div>
      </div>

      {/* O que dá para fazer daqui. Na proposta B não há botão cheio: a tela é de procurar */}
      <p class="pessoas-pagina__acoes">
        <a class="acao" href="/pessoas/nova">Cadastrar pessoa</a>
        <a class="acao" href="/arvore">Ver a árvore</a>
        {/* Seu círculo mora no menu da conta; daqui, um link discreto para quem procurar (decisão do Gui, 17/11/2026) */}
        {temPagina && <a class="acao acao--quieta" href="/circulo">Ver seu círculo</a>}
      </p>
    </header>

    <div class="pessoas-pagina__lista">
      {
        grupos.map((grupo) => (
          <details class="familia-de-gente" data-familia={grupo.cor} open>
            {/* A faixa da família abre e fecha a lista dela, sem script. Nasce aberta. */}
            <summary class="familia-de-gente__nome">
              <h2 class="serifa t-2" id={`familia-${grupo.id}`}>
                {grupo.nome}
              </h2>
              <span class="rotulo suave">{contaDe(grupo.membros)}</span>
            </summary>
            <ul class="familia-de-gente__lista" aria-labelledby={`familia-${grupo.id}`}>
              {grupo.membros.map((p) => (
                <li>
                  <Gente
                    href={`/pessoas/${p.id}`}
                    nome={p.nome}
                    apelido={apelidoAoLado(p.nome, p.apelido)}
                    foto={p.retrato && !naoVe.has(p.id) ? enderecoDoRetrato(p.retrato) : null}
                    familia={corDaPessoa(familiasDe(p), ordemDosNucleos)}
                    laco={paraVoce(p)}
                    detalhe={detalhe(p)}
                    falecido={jaFaleceu(p)}
                  />
                </li>
              ))}
            </ul>
          </details>
        ))
      }
    </div>
  </div>
</Visual>

<script>
  import { buscaDePessoa } from '../../lib/cliente/busca-pessoa';

  // "Procurar pelo nome": a busca de pessoa que o site já tem. Escolher alguém abre a página dela.
  const formulario = document.querySelector<HTMLFormElement>('[data-procurar]');
  const lista = formulario?.querySelector<HTMLSelectElement>('select');
  if (formulario && lista) {
    buscaDePessoa(lista);
    formulario.querySelector<HTMLButtonElement>('button')!.hidden = true;
    lista.addEventListener('change', () => {
      if (lista.value) location.href = `/pessoas/${encodeURIComponent(lista.value)}`;
    });
    formulario.addEventListener('submit', (e) => {
      e.preventDefault();
      if (lista.value) location.href = `/pessoas/${encodeURIComponent(lista.value)}`;
    });
    // Ao voltar para a lista, o campo começa vazio de novo
    addEventListener('pageshow', () => {
      lista.value = '';
      lista.dispatchEvent(new Event('busca:atualizar'));
    });
  }

  // "Famílias e ordem": no celular, as famílias e a ordem ficam guardadas atrás de um controle, e só a
  // busca fica à vista. No computador o CSS esconde o controle e mostra tudo. Sem script, tudo à vista.
  const controles = document.querySelector<HTMLElement>('[data-controles]');
  const abre = controles?.querySelector<HTMLButtonElement>('button');
  if (controles && abre) {
    controles.setAttribute('data-recolhe', '');
    abre.hidden = false;
    abre.addEventListener('click', () => {
      const aberta = !controles.hasAttribute('data-aberta');
      controles.toggleAttribute('data-aberta', aberta);
      abre.setAttribute('aria-expanded', String(aberta));
    });
  }
</script>
