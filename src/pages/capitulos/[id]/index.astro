---
// A página do capítulo. A ideia da tela (docs/visual.md): abertura de capítulo de livro. O título,
// o período e as pessoas ficam à esquerda (parados, no computador com mouse) e, à direita, os
// marcos numerados: cada memória do capítulo com o número dela, a data e o lugar em mono.
import '../../../visual/telas/linha.css';
import '../../../visual/telas/explorar.css';
import '../../../visual/telas/lista.css';
import '../../../visual/telas/capitulo.css';
import Visual from '../../../layouts/Visual.astro';
import Entrada from '../../../components/capitulos/Entrada.astro';
import Lista from '../../../components/explorar/Lista.astro';
import Mural from '../../../components/explorar/Mural.astro';
import Carimbo from '../../../components/visual/Carimbo.astro';
import Gente from '../../../components/visual/Gente.astro';
import Pilula from '../../../components/visual/Pilula.astro';
import Polaroid from '../../../components/visual/Polaroid.astro';
import SinalDoCapitulo from '../../../components/visual/SinalDoCapitulo.astro';
import Vazio from '../../../components/visual/Vazio.astro';
import {
  FORMAS_DO_CAPITULO,
  NOMES_DAS_FORMAS_DO_CAPITULO,
  detalheDoCruzamento,
  ehEpoca,
  enderecoDoCapitulo,
  formatarPeriodo,
  lerFormaDoCapitulo,
  memoriaDoCapitulo,
  nomeDoModo,
  periodoDasMemorias,
  sobreposicao,
  tituloDasMemorias,
  type Capitulo,
} from '../../../lib/capitulos';
import { TAMANHO_PADRAO, fotosDoMuralNoEndereco, lerFotosDoMural } from '../../../lib/explorar';
import QuaisFotos from '../../../components/explorar/QuaisFotos.astro';
import { jaFaleceu, maisRecentesPrimeiro } from '../../../lib/datas';
import { coresDosCapitulos } from '../../../lib/linha-capitulos';
import { enderecoDoRetrato } from '../../../lib/retratos';
import { podeEditarCapitulo } from '../../../lib/servidor/permissoes';
import { familiasDe, listarCapitulos, listarCasais, listarIntegrantesQueVe, listarMemorias, listarNucleos, listarTemas, memoriasComAudio, pessoasQueONaoVe, type Memoria } from '../../../lib/servidor/repositorio';
import { coresDasPessoas } from '../../../lib/familias';
import { carimboDaData, estiloDoCapitulo, estiloDoTipo, legendaLugarAno, listaCurta } from '../../../lib/visual';

const { usuario } = Astro.locals;
const capitulos = await listarCapitulos(usuario);
const capitulo = capitulos.find((c) => c.id === Astro.params.id);
// Capítulo que a pessoa não pode ver é como se não existisse
if (!capitulo) return new Response('Capítulo não encontrado', { status: 404 });

const todas = await listarMemorias(usuario);
const dentro = capitulos.filter((c) => c.dentroDe === capitulo.id);
// As memórias de um capítulo, só entre as que a pessoa pode ver
const memoriasDe = (c: Capitulo, comFilhos = true): Memoria[] => {
  // Por período: as do período e, se o capítulo for de alguém, só as dessas pessoas ou famílias
  if (c.modo === 'epoca') return todas.filter((m) => memoriaDoCapitulo(m, c));
  const ids = new Set([c.id, ...(comFilhos ? capitulos.filter((x) => x.dentroDe === c.id).map((x) => x.id) : [])]);
  return todas.filter((m) => m.capitulos.some((id) => ids.has(id)));
};
const periodoDe = (c: Capitulo) => (c.modo === 'epoca' ? (c.inicio ? { inicio: c.inicio, fim: c.fim } : null) : periodoDasMemorias(memoriasDe(c)));

const memorias = memoriasDe(capitulo);
const periodo = periodoDe(capitulo);
const textoDoPeriodo = periodo ? formatarPeriodo(periodo.inicio, periodo.fim, capitulo.modo === 'epoca', capitulo.modo === 'epoca') : '';
const maior = capitulo.dentroDe ? capitulos.find((c) => c.id === capitulo.dentroDe) : undefined;

// Relações pelo tempo, sem ninguém marcar: o que aconteceu dentro deste período, e as épocas em que ele caiu.
// "Aconteceu durante" só fala de épocas, que valem para todos: um capítulo de outra pessoa não entra.
const outros = capitulos.filter((c) => c.id !== capitulo.id && c.dentroDe !== capitulo.id && c.id !== capitulo.dentroDe);
const cruzamentos = periodo
  ? outros
      .map((c) => ({ c, p: periodoDe(c) }))
      .filter((x): x is { c: Capitulo; p: NonNullable<ReturnType<typeof periodoDe>> } => Boolean(x.p))
  : [];
const aconteceramAqui =
  capitulo.modo === 'epoca'
    ? cruzamentos.map((x) => ({ ...x, como: sobreposicao(x.p, periodo!) })).filter((x) => x.como !== 'nada')
    : [];
const epocas = cruzamentos.filter((x) => ehEpoca(x.c)).map((x) => ({ ...x, como: sobreposicao(periodo!, x.p) })).filter((x) => x.como !== 'nada');

const temas = (await listarTemas()).filter((t) => capitulo.temas.includes(t.id));
// Quem só existe num laço privado de outra pessoa não aparece em "de quem é" nem em "Quem aparece" (C1)
const integrantes = await listarIntegrantesQueVe(usuario);
const nucleos = await listarNucleos();
const ordemDosNucleos = nucleos.map((n) => n.id);
const corDe = coresDasPessoas(integrantes, await listarCasais(usuario), ordemDosNucleos);
const restritoA = capitulo.visibilidade === 'nucleos' ? capitulo.nucleos.map((id) => nucleos.find((n) => n.id === id)?.nome).filter(Boolean) : [];
// De quem é o capítulo por período, para quem chega entender por que só algumas memórias do período entram
const achar = (id: string) => integrantes.find((x) => x.id === id);
const nomeDe = (id: string) => {
  const i = achar(id);
  return i ? (i.apelido ?? i.nome) : undefined;
};
const deQuem = [
  ...capitulo.pessoas.map(nomeDe),
  ...capitulo.familias.map((id) => nucleos.find((n) => n.id === id)?.nome).map((n) => n && `família ${n}`),
].filter((x): x is string => Boolean(x));
const juntar = (nomes: string[]) => (nomes.length <= 1 ? nomes.join('') : `${nomes.slice(0, -1).join(', ')} e ${nomes[nomes.length - 1]}`);
const podeEditar = podeEditarCapitulo(usuario, capitulo).ok;
const contar = (n: number) => `${n} ${n === 1 ? 'memória' : 'memórias'}`;

// A cor do capítulo é a do trilho dele na linha do tempo; a época é o chão e fica na cor da tela
const cores = coresDosCapitulos(
  [...todas].reverse(),
  capitulos.map((c) => (ehEpoca(c) ? { ...c, deTodos: true } : c)),
);
const cor = cores.get(capitulo.id);

// Os marcos: as memórias do capítulo, das mais recentes para as mais antigas, como em toda linha do
// tempo do site. O número de cada uma é a posição dela na história, contada do começo.
// Aprovado pelo Gui em 17/11/2026 (pergunta 1 do PR do grupo "familia"): a ordem dos marcos e o sentido dos números
const marcos = maisRecentesPrimeiro(memorias).map((m, i, lista) => ({ m, numero: lista.length - i }));
const digitos = Math.max(2, String(marcos.length).length);

// A forma de ver (P69 do QA de design de 17/11/2026): os marcos, que são o padrão, o mural e a lista
// do Explorar, na própria página. No mural e na lista, como lá, o rascunho não entra.
const forma = lerFormaDoCapitulo(Astro.url.searchParams);
const fotosDoMural = lerFotosDoMural(Astro.url.searchParams);
const publicadas = maisRecentesPrimeiro(memorias).filter((m) => m.situacao !== 'rascunho');
const nomeDoEditar = capitulo.modo === 'reunido' ? (podeEditar ? 'Escolher memórias e editar' : 'Escolher memórias') : podeEditar ? (ehEpoca(capitulo) ? 'Editar época' : 'Editar capítulo') : null;
// O selo: o que o capítulo é e a quem ele é restrito. O capítulo de dentro diz de qual faz parte (P70)
const selo = [maior ? null : nomeDoModo(capitulo), restritoA.length > 0 ? `Só ${restritoA.join(' e ')}` : null];

// Quem aparece: as pessoas que mais estão nas memórias do capítulo, com a conta de cada uma
// Decidido pelo Gui em 17/11/2026 (pergunta 2 do PR do grupo "familia"): "Quem aparece" fica, com até seis
// pessoas. Na tela grande, com retrato e conta; no celular, uma linha de nomes corrida, sem fotos.
const naoVe = await pessoasQueONaoVe(usuario);
const contagem = new Map<string, number>();
for (const m of memorias) for (const id of m.integrantes) contagem.set(id, (contagem.get(id) ?? 0) + 1);
const aparecem = [...contagem.entries()]
  .filter(([id]) => achar(id))
  .sort((a, b) => b[1] - a[1] || nomeDe(a[0])!.localeCompare(nomeDe(b[0])!, 'pt-BR'));
const QUANTOS = 6;
const sobram = Math.max(0, aparecem.length - QUANTOS);
// As famílias do capítulo dão a assinatura e a cor da tela: as marcadas em "quem vê" ou em "de quem é"
const familiasDaTela = [...new Set([...(capitulo.visibilidade === 'nucleos' ? capitulo.nucleos : []), ...capitulo.familias])];
---

<Visual titulo={capitulo.titulo} secao="capitulos" nucleos={familiasDaTela}>
  <article class="capitulo miolo grade" style={cor === undefined ? undefined : estiloDoCapitulo(cor)}>
    <header class="capitulo__capa">
      {/* O que fica parado no computador com mouse: o selo, o título, o período e as ações (P68 do QA
          de design de 17/11/2026). A abertura, as notas e "Quem aparece" rolam com a página. No
          celular este bloco se desfaz (display: contents) e a abertura sobe para antes das ações (P65). */}
      <div class="capitulo__parado">
        <p class="capitulo__selo">
          {maior && (
            <a class="capitulo__maior rotulo" href={`/capitulos/${maior.id}`}>
              Capítulo de “{maior.titulo}”
            </a>
          )}
          {selo.some(Boolean) && <Carimbo itens={selo} />}
        </p>
        <h1 class="capitulo__titulo serifa t-1">{capitulo.titulo}</h1>
        <p class="capitulo__periodo">
          {textoDoPeriodo && <Pilula>{textoDoPeriodo}</Pilula>}
          <span class="ficha suave">{contar(memorias.length)}</span>
        </p>
        {deQuem.length > 0 && <p class="capitulo__de-quem suave">Entram as memórias do período com {juntar(deQuem)}.</p>}
        {/* A página é de leitura: o botão cheio é o de contar, e editar fica como texto (P67). No
            reunido, qualquer um coloca as memórias que pode corrigir; a ficha, só quem pode editar. */}
        {(capitulo.modo === 'reunido' || nomeDoEditar) && (
          <p class="capitulo__acoes">
            {capitulo.modo === 'reunido' && (
              <a class="botao" href={`/nova?capitulo=${capitulo.id}`}>
                Nova memória neste capítulo
              </a>
            )}
            {nomeDoEditar && (
              <a class="acao" href={`/capitulos/${capitulo.id}/editar`}>
                {nomeDoEditar}
              </a>
            )}
          </p>
        )}
      </div>
      {capitulo.abertura && (
        <div class="capitulo__abertura serifa t-abertura">
          {capitulo.abertura.split(/\n{2,}/).map((p) => (
            <p>{p}</p>
          ))}
        </div>
      )}
      <dl class="capitulo__notas">
        {epocas.length > 0 && (
          <div>
            <dt class="rotulo suave">Aconteceu durante</dt>
            <dd>
              {epocas.map(({ c, como }) => (
                <span>
                  <a class="acao acao--quieta" href={`/capitulos/${c.id}`}>
                    {c.titulo}
                  </a>
                  {como === 'parte' && <span class="suave"> (em parte)</span>}
                </span>
              ))}
            </dd>
          </div>
        )}
        {temas.length > 0 && (
          <div>
            <dt class="rotulo suave">Temas</dt>
            <dd>
              {temas.map((t) => (
                <a class="acao acao--quieta" href={`/temas/${t.id}`}>
                  {t.nome}
                </a>
              ))}
            </dd>
          </div>
        )}
      </dl>
        {/* Decidido pelo Gui em 17/11/2026 (pergunta 4 do PR do grupo "familia"): no celular, a capa fica no alto, e
            "Quem aparece" é só uma linha de nomes, para não empurrar as memórias */}
        {aparecem.length > 0 && (
          <section class="capitulo__gente" aria-labelledby="quem-aparece">
            <h2 class="rotulo suave" id="quem-aparece">
              Quem aparece
            </h2>
            {/* Cada nome da linha leva à página da pessoa, com a linha alta para o toque (resposta do
                Gui à P66 do QA de design de 17/11/2026: fica como está) */}
            {/* No celular, uma linha de nomes corrida, sem fotos, com a conta de cada pessoa (pedido do
                Gui, 17/11/2026). A partir de 62rem, a lista com os retratos, logo abaixo. */}
            <p class="capitulo__nomes ficha">
              {aparecem.slice(0, QUANTOS).map(([id, n], i) => (
                <>
                  {i > 0 && ', '}
                  <a href={`/pessoas/${id}`}>
                    {nomeDe(id)} ({n})
                  </a>
                </>
              ))}
            </p>
            <ul>
              {aparecem.slice(0, QUANTOS).map(([id, n]) => (
                <li>
                  <Gente
                    href={`/pessoas/${id}`}
                    nome={nomeDe(id)!}
                    foto={achar(id)?.retrato && !naoVe.has(id) ? enderecoDoRetrato(achar(id)!.retrato!) : null}
                    familia={corDe(id)}
                    detalhe={contar(n)}
                    falecido={Boolean(achar(id) && jaFaleceu(achar(id)!))}
                  />
                </li>
              ))}
            </ul>
            {sobram > 0 && (
              <p class="ficha suave">
                e mais {sobram} {sobram === 1 ? 'pessoa' : 'pessoas'}
              </p>
            )}
          </section>
        )}
    </header>

    <div class="capitulo__corpo">
      {
        dentro.length > 0 && (
          <section class="capitulo__parte" aria-labelledby="de-dentro">
            <h2 class="rotulo suave" id="de-dentro">
              Capítulos dentro deste
            </h2>
            <ol class="indice">
              {dentro.map((c) => {
                const p = periodoDe(c);
                return (
                  <li>
                    <Entrada href={`/capitulos/${c.id}`} titulo={c.titulo} periodo={p ? formatarPeriodo(p.inicio, p.fim, false, c.modo === 'epoca') : undefined} detalhe={contar(memoriasDe(c).length)} cor={cores.get(c.id)} dentro />
                  </li>
                );
              })}
            </ol>
          </section>
        )
      }

      {
        aconteceramAqui.length > 0 && (
          <section class="capitulo__parte" aria-labelledby="neste-periodo">
            <h2 class="rotulo suave" id="neste-periodo">
              Aconteceu neste período
            </h2>
            <ol class="indice">
              {aconteceramAqui.map(({ c, p, como }) => (
                <li>
                  <Entrada
                    href={`/capitulos/${c.id}`}
                    titulo={c.titulo}
                    periodo={formatarPeriodo(p.inicio, p.fim, c.modo === 'epoca', c.modo === 'epoca')}
                    detalhe={detalheDoCruzamento(como)}
                    cor={cores.get(c.id)}
                    dentro
                  />
                </li>
              ))}
            </ol>
          </section>
        )
      }

      {/* A região troca de conteúdo sem recarregar a página, como no Explorar (explorar-troca.ts) */}
      <section class="capitulo__parte capitulo__memorias" aria-labelledby="marcos" data-explorar>
        <h2 class="rotulo suave" id="marcos">
          {tituloDasMemorias(capitulo, memorias.length)}
        </h2>
        {marcos.length > 1 && (
          <div class="controles capitulo__controles">
            <div class="controle">
              <p class="controle__nome rotulo suave" id="controle-forma">
                Forma de ver
              </p>
              <nav class="linha__opcoes" aria-labelledby="controle-forma">
                {FORMAS_DO_CAPITULO.map((f) => (
                  <a href={`${enderecoDoCapitulo(capitulo.id, f)}#marcos`} data-opcao={f} aria-current={f === forma ? 'page' : undefined}>
                    {NOMES_DAS_FORMAS_DO_CAPITULO[f]}
                  </a>
                ))}
              </nav>
            </div>
            {forma === 'mural' && <QuaisFotos atual={fotosDoMural} endereco={(f) => `${enderecoDoCapitulo(capitulo.id, 'mural', fotosDoMuralNoEndereco(f))}#marcos`} />}
            <p class="capitulo__tv">
              <a class="acao acao--quieta" href={`/explorar?capitulo=${capitulo.id}&ver=tv`}>
                Passar no modo TV
              </a>
            </p>
          </div>
        )}
        {
          marcos.length === 0 ? (
            <Vazio frase={capitulo.modo === 'epoca' ? 'Nenhuma memória registrada neste período ainda.' : `Este capítulo ainda não tem memórias. Use "${podeEditar ? 'Escolher memórias e editar' : 'Escolher memórias'}", no alto, para escolher.`} />
          ) : forma === 'mural' ? (
            <div class="linha linha--mural capitulo__larga">
              <Mural memorias={publicadas} ordem="recentes" tamanho={TAMANHO_PADRAO} fotos={fotosDoMural} />
            </div>
          ) : forma === 'lista' ? (
            <div class="linha linha--lista capitulo__larga">
              <Lista memorias={publicadas} capitulos={capitulos} integrantes={integrantes} ordem="recentes" comAudio={await memoriasComAudio(usuario)} />
            </div>
          ) : (
            <ol class="marcos" reversed>
              {marcos.map(({ m, numero }) => {
                const nomes = m.integrantes.map(nomeDe).filter((n): n is string => Boolean(n));
                const deDentro = dentro.filter((c) => m.capitulos.includes(c.id));
                return (
                  <li class="marco" style={estiloDoTipo(m.tipo)}>
                    <span class="marco__numero serifa" aria-hidden="true">
                      {String(numero).padStart(digitos, '0')}
                    </span>
                    <div class="marco__texto">
                      <p>
                        <Carimbo itens={[carimboDaData(m), m.lugar]} />
                      </p>
                      <h3 class="marco__titulo serifa t-3">
                        <a href={`/memorias/${m.id}`}>{m.titulo}</a>
                      </h3>
                      {nomes.length > 0 && <p class="ficha suave">Com {listaCurta(nomes, 4)}</p>}
                      {deDentro.length > 0 && (
                        <p class="marco__sinais ficha suave">
                          {deDentro.map((c) => (
                            <SinalDoCapitulo id={c.id} titulo={c.titulo} cor={cores.get(c.id) ?? 0} />
                          ))}
                        </p>
                      )}
                    </div>
                    {/* A foto vai sem legenda: o lugar e o ano já estão no carimbo ao lado (P72) */}
                    <a class="marco__foto" href={`/memorias/${m.id}`} tabindex="-1" aria-hidden="true">
                      <Polaroid id={m.id} fotos={m.fotos} legenda="" tipo={m.tipo} monte={false} alt="" />
                    </a>
                  </li>
                );
              })}
            </ol>
          )
        }
      </section>
    </div>
  </article>
</Visual>

<script>
  // Trocar a forma de ver não recarrega a página nem tira a pessoa do lugar, como no Explorar.
  // Sem script, cada opção é um link comum, que volta a esta parte da página.
  import { ligarTroca } from '../../../lib/cliente/explorar-troca';
  ligarTroca();

  // A capa só fica parada quando cabe inteira na janela (QA de design, 17/11/2026)
  const capa = document.querySelector<HTMLElement>('.capitulo__parado');
  if (capa) {
    const medir = () => capa.classList.toggle('capitulo__parado--solta', capa.offsetHeight > window.innerHeight - 64);
    medir();
    window.addEventListener('resize', medir);
    window.addEventListener('load', medir);
  }
</script>
