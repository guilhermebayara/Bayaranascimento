---
// Conceito da revisão visual: "Sua conta" (docs/decisoes.md). A tela é desenhada na fase 3.
// Esta página só existe para o retrato do topo ter aonde levar: ela junta, sem desenho próprio,
// o que a conta vai guardar e já existe hoje no site, inclusive o que saiu do menu e do rodapé.
import '../../visual/telas/sobre.css';
import Visual from '../../layouts/Visual.astro';
import { conceitoDisponivel, naoEncontrado } from '../../lib/servidor/conceito';

if (!conceitoDisponivel()) return naoEncontrado();

const { usuario } = Astro.locals;
---

<Visual titulo="Sua conta" secao="conta">
  <div class="sobre miolo">
    <header class="sobre__abre">
      <p class="rotulo suave">Só você vê esta página</p>
      <h1 class="t-1">Sua conta</h1>
      <p class="sobre__texto">
        Esta tela ainda vai ser desenhada, junto com as outras, na fase 3. Por enquanto ela só leva ao que já existe e vai morar aqui.
      </p>
    </header>
    <section aria-labelledby="suas-coisas">
      <h2 class="sobre__titulo" id="suas-coisas">O que é seu</h2>
      <p class="conta__links">
        <a class="acao" href={`/pessoas/${usuario.pessoa}`}>Ver sua página</a>
        <a class="acao" href={`/pessoas/${usuario.pessoa}/editar`}>Editar seus dados e seus laços</a>
        <a class="acao" href="/rascunhos">Rascunhos</a>
        <a class="acao" href="/lixeira">Lixeira</a>
      </p>
    </section>
    {
      usuario.admin && (
        <section aria-labelledby="administracao">
          <h2 class="sobre__titulo" id="administracao">Administração</h2>
          <p class="conta__links">
            <a class="acao" href="/admin/tipos">Tipos de momento</a>
            <a class="acao" href="/api/copia" download>
              Baixar cópia do acervo
            </a>
          </p>
        </section>
      )
    }
  </div>
</Visual>
