---
// Proposta B do conceito da página da pessoa (sessão L): o álbum. A página é o álbum da pessoa, no
// padrão do perfil das redes que a família usa: a capa com o retrato, o que ela é para você e os
// números ("35 memórias · 11 relatos · 14 laços"), e embaixo as abas que trocam no lugar: as fotos
// (a caixa de fotografias dela), o que ela contou, a família e o sobre. Só nas prévias, por
// "?proposta=b" na página da pessoa.
import '../../../../visual/telas/linha.css';
import '../../../../visual/telas/explorar.css';
import '../../../../visual/telas/conceito-pessoa.css';
import Visual from '../../../../layouts/Visual.astro';
import TrocaDaProposta from '../../../../components/pessoa/TrocaDaProposta.astro';
import Mural from '../../../../components/explorar/Mural.astro';
import Audio from '../../../../components/visual/Audio.astro';
import Carimbo from '../../../../components/visual/Carimbo.astro';
import PilulaDeFamilia from '../../../../components/visual/PilulaDeFamilia.astro';
import Retrato from '../../../../components/visual/Retrato.astro';
import Vazio from '../../../../components/visual/Vazio.astro';
import { TAMANHO_PADRAO } from '../../../../lib/explorar';
import { conceitoDisponivel, naoEncontrado } from '../../../../lib/servidor/conceito';
import { montarPaginaDaPessoa } from '../../../../lib/servidor/pagina-da-pessoa';

if (!conceitoDisponivel()) return naoEncontrado();
const { usuario } = Astro.locals;
const p = await montarPaginaDaPessoa(usuario, Astro.params.id!, Astro.url.searchParams.get('datas') === '1');
if (!p) return new Response('Pessoa não encontrada', { status: 404 });
const { pessoa, chamar } = p;
const plural = (n: number, um: string, varios: string) => `${n} ${n === 1 ? um : varios}`;

// As abas, como no perfil das redes. A que abre é a primeira com conteúdo
const ABAS = [
  { id: 'fotos', nome: 'Memórias', conta: p.publicadas.length },
  { id: 'contou', nome: 'Relatos', conta: p.relatos.length + p.audios.length },
  { id: 'familia', nome: 'Família', conta: p.genteNosLacos },
  { id: 'sobre', nome: 'Sobre', conta: null },
] as const;
type Aba = (typeof ABAS)[number]['id'];
const pedida = Astro.url.searchParams.get('aba');
const aba: Aba = (ABAS.find((a) => a.id === pedida)?.id ?? ABAS.find((a) => a.conta === null || a.conta > 0)!.id) as Aba;
const enderecoDaAba = (a: Aba) => `/pessoas/${pessoa.id}?aba=${a}#abas`;
const sobre = pessoa.sobre?.split(/\n{2,}/).map((t) => t.trim()).filter(Boolean) ?? [];
---

<Visual titulo={pessoa.nome} secao="pessoas" nucleos={p.familiasDaPessoa.map((f) => f.id)}>
  <TrocaDaProposta atual="b" id={pessoa.id} />
  <article class="album">
    <header class="album__capa bloco">
      <div class="miolo album__capa-grade">
        <div class="album__retrato">
          {p.falecida ? (
            <button class="verbete__acender" type="button" data-acender aria-pressed="false" aria-label={`Acender a foto de ${chamar}`}>
              <Retrato nome={chamar} foto={p.retrato} familia={p.familiaDaPessoa} falecido cedo />
            </button>
          ) : (
            <Retrato nome={chamar} foto={p.retrato} familia={p.familiaDaPessoa} cedo />
          )}
        </div>
        <div class="album__quem">
          {p.parentesco && <p class="album__laco">{p.parentesco}</p>}
          <h1 class:list={['album__nome', p.parentesco ? 't-2' : 't-1']}>
            {pessoa.nome}
            {p.apelidoNoTitulo && <span class="suave"> ({p.apelidoNoTitulo})</span>}
          </h1>
          {p.falecida && <p class="em-memoria">em memória</p>}
          {(p.ehMinha || p.especie || p.vida || p.familiasDaPessoa.length > 0) && (
            <p class="album__carimbo">
              <Carimbo itens={[p.ehMinha && 'Você', p.especie, p.familiasDaPessoa.map((f) => f.nome).join(' e '), p.vida]} />
            </p>
          )}
        </div>
        <ul class="album__numeros" aria-label="No acervo">
          {ABAS.filter((a) => a.conta !== null).map((a) => (
            <li>
              <a href={enderecoDaAba(a.id)} data-para-aba={a.id}>
                <strong>{a.conta}</strong>
                <span>{a.id === 'fotos' ? (a.conta === 1 ? 'memória' : 'memórias') : a.id === 'contou' ? (a.conta === 1 ? 'relato' : 'relatos') : a.conta === 1 ? 'laço' : 'laços'}</span>
              </a>
            </li>
          ))}
        </ul>
        <div class="album__acoes">
          <a class="botao" href={`/nova?com=${pessoa.id}`}>Nova memória com {p.comQuem}</a>
          <p class="album__links">
            {p.temLacoDeArvore && <a class="acao" href={`/arvore?centro=${pessoa.id}`}>Ver na árvore</a>}
            {p.lacoComVoce && <a class="acao" href={p.lacoComVoce}>Você e {chamar}</a>}
            <a class="acao acao--quieta" href={`/pessoas/${pessoa.id}/editar`}>{p.podeEditar ? 'Editar página e laços' : 'Adicionar laço'}</a>
          </p>
          {p.circulo && (
            <p class="album__circulo">
              <a class="acao acao--quieta" href="/circulo">No seu círculo: {p.circulo.faixa}</a> <span class="ficha suave">só você vê</span>
            </p>
          )}
        </div>
      </div>
    </header>

    <div class="album__abas miolo" id="abas" role="tablist" aria-label={`O álbum de ${chamar}`} data-abas>
      {ABAS.map((a) => (
        <a role="tab" id={`aba-${a.id}`} href={enderecoDaAba(a.id)} aria-selected={a.id === aba ? 'true' : 'false'} aria-controls={`painel-${a.id}`} data-aba={a.id}>
          {a.nome}
          {a.conta !== null && a.conta > 0 && <small>{a.conta}</small>}
        </a>
      ))}
    </div>

    <section class="album__painel" role="tabpanel" id="painel-fotos" aria-labelledby="aba-fotos" hidden={aba !== 'fotos'}>
      {p.publicadas.length === 0 ? (
        <div class="miolo">
          <Vazio frase={`Nenhuma memória com ${pessoa.nome} por enquanto.`}>
            <a class="acao" href={`/nova?com=${pessoa.id}`}>Nova memória com {p.comQuem}</a>
          </Vazio>
        </div>
      ) : (
        <div class="linha linha--mural">
          <Mural memorias={p.publicadas} ordem="recentes" tamanho={TAMANHO_PADRAO} />
        </div>
      )}
    </section>

    <section class="album__painel miolo" role="tabpanel" id="painel-contou" aria-labelledby="aba-contou" hidden={aba !== 'contou'}>
      {p.relatos.length === 0 && p.audios.length === 0 ? (
        <Vazio frase={p.ehMinha ? 'Você ainda não contou nenhuma memória.' : `${chamar} ainda não contou nenhuma memória.`} />
      ) : (
        <div class="contou">
          {p.audios.length > 0 && (
            <section class="contou__voz" aria-labelledby="voz">
              <h2 class="t-3" id="voz">{p.ehMinha ? 'A sua voz' : `A voz de ${chamar}`}</h2>
              <ol>
                {p.audios.map((a) => (
                  <li>
                    <a class="serifa" href={`/memorias/${a.memoriaId}`}>{a.memoriaTitulo}</a>
                    <Audio rotulo={`Áudio · ${a.duracaoEmTexto}`} src={`/audios/${a.chave}`} transcricao={a.transcricao} />
                  </li>
                ))}
              </ol>
            </section>
          )}
          {p.relatos.length > 0 && (
            <ol class="contou__relatos">
              {p.relatos.map((r) => (
                <li>
                  <a class="contou__relato" href={`/memorias/${r.memoriaId}#relato-${r.id}`}>
                    <span class="ficha suave">{r.memoriaAno}</span>
                    <span class="contou__titulo">{r.memoriaTitulo}</span>
                    <span class="contou__trecho">{r.trecho}</span>
                    <span class="mao contou__assina">{chamar}</span>
                  </a>
                </li>
              ))}
            </ol>
          )}
        </div>
      )}
    </section>

    <section class="album__painel miolo" role="tabpanel" id="painel-familia" aria-labelledby="aba-familia" hidden={aba !== 'familia'}>
      {p.grupos.length === 0 ? (
        <Vazio frase={`Ninguém ligado a ${chamar} por enquanto.`}>
          <a class="acao" href={`/pessoas/${pessoa.id}/editar`}>Adicionar laço</a>
        </Vazio>
      ) : (
        <>
          {p.temLacoDeArvore && (
            <p class="familia-b__arvore">
              <a class="acao" href={`/arvore?centro=${pessoa.id}`}>Ver {p.ehMinha ? 'sua árvore' : `a árvore de ${chamar}`}</a>
            </p>
          )}
          {p.grupos.map((g) => (
            <section class="familia-b__grupo" aria-label={g.titulo}>
              <h2 class="ficha">{g.titulo}</h2>
              <ul>
                {g.linhas.map((l) => (
                  <li class="familia-b__pessoa">
                    <a href={`/pessoas/${l.id}`}>
                      <Retrato nome={l.nome} foto={l.foto} familia={l.familia} falecido={l.falecido} />
                      <strong>{l.nome}</strong>
                      {l.laco && <span class="suave">{l.laco}</span>}
                      {l.falecido && <span class="em-memoria">em memória</span>}
                    </a>
                    <a class="acao acao--quieta familia-b__laco" href={l.enderecoDoLaco}>Ver o laço</a>
                  </li>
                ))}
              </ul>
            </section>
          ))}
        </>
      )}
    </section>

    <section class="album__painel miolo" role="tabpanel" id="painel-sobre" aria-labelledby="aba-sobre" hidden={aba !== 'sobre'}>
      <div class="sobre-b">
        <div class="sobre-b__texto">
          {sobre.length > 0 ? sobre.map((t) => <p>{t}</p>) : <Vazio frase={`Ninguém escreveu sobre ${chamar} ainda.`}><a class="acao" href={`/pessoas/${pessoa.id}/editar#ficha`}>Escrever sobre {p.comQuem}</a></Vazio>}
        </div>
        <dl class="verbete__dados sobre-b__dados">
          {p.vida && (
            <div>
              <dt class="rotulo suave">Nasceu</dt>
              <dd>
                {p.vida}
                {p.temDataOculta && (
                  <a class="acao acao--quieta verbete__datas" href={p.mostrarDatas ? `/pessoas/${pessoa.id}?aba=sobre` : `/pessoas/${pessoa.id}?aba=sobre&datas=1`}>
                    {p.mostrarDatas ? 'Esconder datas' : 'Mostrar datas'}
                  </a>
                )}
              </dd>
            </div>
          )}
          {p.familiasDaPessoa.length > 0 && (
            <div>
              <dt class="rotulo suave">{p.familiasDaPessoa.length === 1 ? 'Família' : 'Famílias'}</dt>
              <dd class="pilulas-de-familia">
                {p.familiasDaPessoa.map((f) => (
                  <PilulaDeFamilia href={`/pessoas?familia=${f.id}`} familia={f.cor}>{f.nome}</PilulaDeFamilia>
                ))}
              </dd>
            </div>
          )}
          {p.periodo && (
            <div>
              <dt class="rotulo suave">Nas memórias</dt>
              <dd>{p.periodo.de === p.periodo.ate ? p.periodo.de : `de ${p.periodo.de} a ${p.periodo.ate}`}</dd>
            </div>
          )}
        </dl>
      </div>
    </section>
  </article>
</Visual>

<script>
  // As abas trocam no lugar, sem recarregar e sem perder a rolagem; o endereço acompanha. Sem script,
  // cada aba é um link que abre a página nela. Os números da capa levam à aba deles.
  const abas = document.querySelector<HTMLElement>('[data-abas]');
  if (abas) {
    const ir = (id: string, foco = false) => {
      for (const a of abas.querySelectorAll<HTMLAnchorElement>('[data-aba]')) {
        const sim = a.dataset.aba === id;
        a.setAttribute('aria-selected', String(sim));
        a.tabIndex = sim ? 0 : -1;
        document.getElementById(`painel-${a.dataset.aba}`)!.hidden = !sim;
        if (sim && foco) a.focus();
      }
      const url = new URL(location.href);
      url.searchParams.set('aba', id);
      history.replaceState(null, '', `${url.pathname}${url.search}`);
    };
    for (const a of document.querySelectorAll<HTMLAnchorElement>('[data-aba], [data-para-aba]')) {
      a.addEventListener('click', (e) => {
        e.preventDefault();
        ir(a.dataset.aba ?? a.dataset.paraAba!);
        if (a.dataset.paraAba) abas.scrollIntoView({ block: 'start' });
      });
    }
    // Setas para os lados passam de uma aba à outra, como nas abas do sistema
    abas.addEventListener('keydown', (e) => {
      if (e.key !== 'ArrowRight' && e.key !== 'ArrowLeft') return;
      const lista = [...abas.querySelectorAll<HTMLAnchorElement>('[data-aba]')];
      const atual = lista.findIndex((a) => a.getAttribute('aria-selected') === 'true');
      const proxima = lista[(atual + (e.key === 'ArrowRight' ? 1 : lista.length - 1)) % lista.length]!;
      ir(proxima.dataset.aba!, true);
    });
    for (const a of abas.querySelectorAll<HTMLAnchorElement>('[data-aba]')) a.tabIndex = a.getAttribute('aria-selected') === 'true' ? 0 : -1;
  }
  for (const botao of document.querySelectorAll<HTMLButtonElement>('[data-acender]')) {
    botao.addEventListener('click', () => {
      const aceso = botao.getAttribute('aria-pressed') !== 'true';
      botao.setAttribute('aria-pressed', String(aceso));
      botao.querySelector('.retrato')?.classList.toggle('retrato--aceso', aceso);
    });
  }
</script>
