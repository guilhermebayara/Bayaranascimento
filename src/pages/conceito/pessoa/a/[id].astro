---
// Proposta A do conceito da página da pessoa (sessão L): o verbete. A página diz quem a pessoa é,
// como um verbete de enciclopédia ou a ficha de um site de genealogia: a frase de abertura, um quadro
// ao lado com o retrato, os dados e a família de perto (a vizinhança dela na árvore), e a vida dela
// em memórias, em ordem, contada pela idade. Só nas prévias, por "?proposta=a" na página da pessoa.
import '../../../../visual/telas/conceito-pessoa.css';
import Visual from '../../../../layouts/Visual.astro';
import TrocaDaProposta from '../../../../components/pessoa/TrocaDaProposta.astro';
import Audio from '../../../../components/visual/Audio.astro';
import Carimbo from '../../../../components/visual/Carimbo.astro';
import Gente from '../../../../components/visual/Gente.astro';
import PilulaDeFamilia from '../../../../components/visual/PilulaDeFamilia.astro';
import Polaroid from '../../../../components/visual/Polaroid.astro';
import Retrato from '../../../../components/visual/Retrato.astro';
import Vazio from '../../../../components/visual/Vazio.astro';
import { conceitoDisponivel, naoEncontrado } from '../../../../lib/servidor/conceito';
import { montarPaginaDaPessoa, type Ligada } from '../../../../lib/servidor/pagina-da-pessoa';
import { carimboDaData, estiloDoTipo, legendaLugarAno } from '../../../../lib/visual';

if (!conceitoDisponivel()) return naoEncontrado();
const { usuario } = Astro.locals;
const p = await montarPaginaDaPessoa(usuario, Astro.params.id!, Astro.url.searchParams.get('datas') === '1');
if (!p) return new Response('Pessoa não encontrada', { status: 404 });
const { pessoa, chamar } = p;
const plural = (n: number, um: string, varios: string) => `${n} ${n === 1 ? um : varios}`;

// A frase de abertura do verbete: o primeiro parágrafo de "Sobre" ou, sem ele, o que o acervo sabe
const sobre = pessoa.sobre?.split(/\n{2,}/).map((t) => t.trim()).filter(Boolean) ?? [];
const abertura =
  sobre[0] ??
  (p.publicadas.length === 0
    ? `${chamar} ainda não aparece em nenhuma memória do acervo.`
    : `${chamar} aparece em ${plural(p.publicadas.length, 'memória', 'memórias')} do acervo${p.periodo && p.periodo.de !== p.periodo.ate ? `, de ${p.periodo.de} a ${p.periodo.ate}` : p.periodo ? `, de ${p.periodo.de}` : ''}${p.relatos.length ? `, e contou ${p.relatos.length === 1 ? 'uma delas' : `${p.relatos.length} delas`}` : ''}.`);
const restoDoSobre = sobre.length > 0 ? sobre.slice(1) : [];

// A vida em memórias, pela idade: "Dos 20 aos 29 anos". Sem o ano de nascimento, pelas décadas.
const comIdade = Boolean(pessoa.nascimentoAno);
type Fase = { chave: string; titulo: string; quando: string; memorias: typeof p.publicadas };
const fases: Fase[] = [];
for (const m of p.publicadas) {
  const idade = p.idadeEm(m.ano);
  const chave = comIdade && idade !== null ? `i${Math.floor(idade / 10)}` : `d${Math.floor(m.ano / 10)}`;
  let fase = fases.find((f) => f.chave === chave);
  if (!fase) {
    if (comIdade && idade !== null) {
      const de = Math.floor(idade / 10) * 10;
      const titulo = de === 0 ? 'Até os 9 anos' : `Dos ${de} aos ${de + 9} anos`;
      fase = { chave, titulo, quando: `${pessoa.nascimentoAno! + de} a ${pessoa.nascimentoAno! + de + 9}`, memorias: [] };
    } else {
      const d = Math.floor(m.ano / 10) * 10;
      fase = { chave, titulo: `Anos ${d}`, quando: `${d} a ${d + 9}`, memorias: [] };
    }
    fases.push(fase);
  }
  fase.memorias.push(m);
}

// A família de perto, para o quadro: quem está acima, ao lado e abaixo na árvore
const grupo = (chave: string) => p.grupos.find((g) => g.chave === chave)?.linhas ?? [];
const acima = grupo('pais');
const aoLado = grupo('casal');
const abaixo = grupo('filhos');
const irmaos = grupo('irmaos');
const temVizinhanca = acima.length + aoLado.length + abaixo.length + irmaos.length > 0;
const RELATOS_A_VISTA = 3;
---

<Visual titulo={pessoa.nome} secao="pessoas" nucleos={p.familiasDaPessoa.map((f) => f.id)}>
  <TrocaDaProposta atual="a" id={pessoa.id} />
  <article class="verbete miolo grade">
    <header class="verbete__abre">
      {(p.ehMinha || p.especie) && (
        <p class="verbete__carimbo">
          <Carimbo itens={[p.ehMinha && 'Você', p.especie]} />
        </p>
      )}
      {p.parentesco && <p class="verbete__laco">{p.parentesco}</p>}
      <h1 class:list={['verbete__nome', p.parentesco ? 't-2' : 't-1']}>
        {pessoa.nome}
        {p.apelidoNoTitulo && <span class="suave"> ({p.apelidoNoTitulo})</span>}
      </h1>
      {p.falecida && <p class="em-memoria verbete__em-memoria">em memória</p>}
      <p class="verbete__abertura">{abertura}</p>
      <p class="verbete__acoes">
        <a class="botao" href={`/nova?com=${pessoa.id}`}>Nova memória com {p.comQuem}</a>
        <a class="acao" href={`/pessoas/${pessoa.id}/editar`}>{p.podeEditar ? 'Editar página e laços' : 'Adicionar laço'}</a>
      </p>
    </header>

    <aside class="verbete__quadro" aria-label={`Ficha de ${chamar}`}>
      <div class="verbete__retrato">
        {p.falecida ? (
          <button class="verbete__acender" type="button" data-acender aria-pressed="false" aria-label={`Acender a foto de ${chamar}`}>
            <Retrato nome={chamar} foto={p.retrato} familia={p.familiaDaPessoa} falecido cedo />
          </button>
        ) : (
          <Retrato nome={chamar} foto={p.retrato} familia={p.familiaDaPessoa} cedo />
        )}
      </div>
      <dl class="verbete__dados">
        {p.vida && (
          <div>
            <dt class="rotulo suave">Nasceu</dt>
            <dd>
              {p.vida}
              {p.temDataOculta && (
                <a class="acao acao--quieta verbete__datas" href={p.mostrarDatas ? `/pessoas/${pessoa.id}` : `/pessoas/${pessoa.id}?datas=1`}>
                  {p.mostrarDatas ? 'Esconder datas' : 'Mostrar datas'}
                </a>
              )}
            </dd>
          </div>
        )}
        {p.familiasDaPessoa.length > 0 && (
          <div>
            <dt class="rotulo suave">{p.familiasDaPessoa.length === 1 ? 'Família' : 'Famílias'}</dt>
            <dd class="pilulas-de-familia">
              {p.familiasDaPessoa.map((f) => (
                <PilulaDeFamilia href={`/pessoas?familia=${f.id}`} familia={f.cor}>
                  {f.nome}
                </PilulaDeFamilia>
              ))}
            </dd>
          </div>
        )}
        <div>
          <dt class="rotulo suave">No acervo</dt>
          <dd>
            {plural(p.publicadas.length, 'memória', 'memórias')}
            {p.relatos.length > 0 && <>, {plural(p.relatos.length, 'relato', 'relatos')}</>}
            {p.audios.length > 0 && <>, {plural(p.audios.length, 'áudio', 'áudios')}</>}
          </dd>
        </div>
      </dl>

      {temVizinhanca && (
        <section class="vizinhanca" aria-labelledby="vizinhanca">
          <h2 class="rotulo suave" id="vizinhanca">Na árvore</h2>
          {[
            { rotulo: 'Pais', gente: acima },
            { rotulo: aoLado.length === 1 ? 'Casal' : 'Casais', gente: aoLado },
            { rotulo: 'Irmãos', gente: irmaos },
            { rotulo: 'Filhos', gente: abaixo },
          ]
            .filter((g) => g.gente.length > 0)
            .map((g) => (
              <div class="vizinhanca__nivel">
                <p class="ficha suave">{g.rotulo}</p>
                <ul>
                  {g.gente.map((l: Ligada) => (
                    <li>
                      <a class="vizinhanca__quem" href={`/pessoas/${l.id}`}>
                        <Retrato nome={l.nome} foto={l.foto} familia={l.familia} falecido={l.falecido} />
                        <span>{l.nome}</span>
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            ))}
          {p.temLacoDeArvore && (
            <p class="vizinhanca__ir">
              <a class="acao" href={`/arvore?centro=${pessoa.id}`}>Ver na árvore</a>
            </p>
          )}
        </section>
      )}

      {(p.circulo || p.lacoComVoce) && (
        <section class="verbete__voce" aria-labelledby="voce-e">
          <h2 class="rotulo suave" id="voce-e">Você e {chamar}</h2>
          {p.circulo && (
            <p>
              No seu círculo: <strong>{p.circulo.faixa}</strong> <span class="ficha suave">só você vê</span>
            </p>
          )}
          <p class="verbete__voce-acoes">
            {p.lacoComVoce && <a class="acao" href={p.lacoComVoce}>Ver o laço de vocês</a>}
            {p.circulo && <a class="acao acao--quieta" href="/circulo">Ver seu círculo</a>}
          </p>
        </section>
      )}
    </aside>

    <section class="verbete__vida" aria-labelledby="vida">
      <h2 class="t-2" id="vida">{p.ehMinha ? 'Sua vida em memórias' : `A vida de ${chamar} em memórias`}</h2>
      {fases.length === 0 ? (
        <Vazio frase={`Nenhuma memória com ${pessoa.nome} por enquanto.`}>
          <a class="acao" href={`/nova?com=${pessoa.id}`}>Nova memória com {p.comQuem}</a>
        </Vazio>
      ) : (
        fases.map((fase) => (
          <section class="vida__fase" aria-label={fase.titulo}>
            <header class="vida__titulo">
              <h3 class="t-3">{fase.titulo}</h3>
              <p class="ficha suave">{fase.quando} · {plural(fase.memorias.length, 'memória', 'memórias')}</p>
            </header>
            <ol class="vida__memorias">
              {fase.memorias.map((m) => (
                <li style={estiloDoTipo(m.tipo)}>
                  <a class="vida__memoria" href={`/memorias/${m.id}`}>
                    <span class="vida__foto">
                      <Polaroid id={m.id} fotos={m.fotos} legenda="" tipo={m.tipo} monte={false} reta />
                    </span>
                    <span class="vida__texto">
                      <span class="ficha suave">
                        {carimboDaData(m)}
                        {comIdade && p.idadeEm(m.ano) !== null && <> · {p.idadeEm(m.ano) === 0 ? 'no ano em que nasceu' : `aos ${p.idadeEm(m.ano)} anos`}</>}
                      </span>
                      <span class="vida__memoria-titulo">{m.titulo}</span>
                      {m.lugar && <span class="suave">{m.lugar}</span>}
                    </span>
                  </a>
                </li>
              ))}
            </ol>
          </section>
        ))
      )}
    </section>

    {(p.relatos.length > 0 || p.audios.length > 0 || restoDoSobre.length > 0) && (
      <section class="verbete__palavras" aria-labelledby="palavras" id="audios">
        <h2 class="t-2" id="palavras">{p.ehMinha ? 'Nas suas palavras' : `Nas palavras de ${chamar}`}</h2>
        {restoDoSobre.length > 0 && (
          <div class="palavras__sobre">
            {restoDoSobre.map((t) => <p>{t}</p>)}
          </div>
        )}
        {p.audios.length > 0 && (
          <ol class="palavras__audios">
            {p.audios.map((a) => (
              <li>
                <a class="serifa" href={`/memorias/${a.memoriaId}`}>{a.memoriaTitulo}</a>
                <Audio rotulo={`Áudio · ${a.duracaoEmTexto}`} src={`/audios/${a.chave}`} transcricao={a.transcricao} />
              </li>
            ))}
          </ol>
        )}
        {p.relatos.length > 0 && (
          <ol class="palavras__relatos">
            {p.relatos.slice(0, RELATOS_A_VISTA).map((r) => (
              <li>
                <blockquote class="palavras__trecho">{r.trecho}</blockquote>
                <p class="ficha suave">
                  {r.memoriaAno} · <a class="acao acao--quieta" href={`/memorias/${r.memoriaId}#relato-${r.id}`}>{r.memoriaTitulo}</a>
                </p>
              </li>
            ))}
          </ol>
        )}
        {p.relatos.length > RELATOS_A_VISTA && (
          <details class="palavras__mais">
            <summary class="acao">Ver os outros {p.relatos.length - RELATOS_A_VISTA} relatos</summary>
            <ol class="palavras__relatos">
              {p.relatos.slice(RELATOS_A_VISTA).map((r) => (
                <li>
                  <blockquote class="palavras__trecho">{r.trecho}</blockquote>
                  <p class="ficha suave">
                    {r.memoriaAno} · <a class="acao acao--quieta" href={`/memorias/${r.memoriaId}#relato-${r.id}`}>{r.memoriaTitulo}</a>
                  </p>
                </li>
              ))}
            </ol>
          </details>
        )}
      </section>
    )}

    {p.grupos.length > 0 && (
      <section class="verbete__lacos" aria-labelledby="lacos">
        <h2 class="t-2" id="lacos">Família e laços</h2>
        <p class="ficha suave">{plural(p.genteNosLacos, 'pessoa', 'pessoas')}</p>
        <div class="lacos-a">
          {p.grupos.map((g) => (
            <div class="lacos-a__grupo">
              <h3 class="ficha">{g.titulo}</h3>
              <ul>
                {g.linhas.map((l) => (
                  <li>
                    <Gente href={`/pessoas/${l.id}`} nome={l.nome} foto={l.foto} familia={l.familia} laco={l.laco} detalhe={l.detalhe} falecido={l.falecido} />
                    {(g.chave === 'casal' || g.chave === 'coracao') && (
                      <a class="acao acao--quieta lacos-a__laco" href={l.enderecoDoLaco}>
                        O laço com {l.nome}
                      </a>
                    )}
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </section>
    )}
  </article>
</Visual>

<script>
  for (const botao of document.querySelectorAll<HTMLButtonElement>('[data-acender]')) {
    botao.addEventListener('click', () => {
      const aceso = botao.getAttribute('aria-pressed') !== 'true';
      botao.setAttribute('aria-pressed', String(aceso));
      botao.querySelector('.retrato')?.classList.toggle('retrato--aceso', aceso);
    });
  }
</script>
