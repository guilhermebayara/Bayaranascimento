---
// CONCEITO do círculo dentro do quadro do mapa (docs/decisoes.md, "Onda 1", "Círculo"). Serve para
// escolher o quadro: mostra a pessoa no centro e as três faixas, em anéis na tela grande e em faixas
// empilhadas no celular. Nada é gravado: a proximidade de cada pessoa é só um palpite pelo
// parentesco, e o slider muda o desenho na hora, sem guardar. A tabela de proximidade, o arrastar e
// "Fora do círculo" de verdade vêm na construção. Só existe onde há acervo de exemplo.
import '../../../visual/telas/arvore.css';
import '../../../visual/telas/mapa-conceito.css';
import Visual from '../../../layouts/Visual.astro';
import Retrato from '../../../components/visual/Retrato.astro';
import TrocaDoConceito from '../../../components/conceito/TrocaDoConceito.astro';
import { conceitoDisponivel, naoEncontrado } from '../../../lib/servidor/conceito';
import { Familia, lacoParaODono, possessivo, type Tratamento } from '../../../lib/parentesco';
import { enderecoDoRetrato } from '../../../lib/retratos';
import { familiasDe, listarCasais, listarFiliacoes, listarIntegrantesQueVe, listarLacosDoCoracao, listarNucleos, pessoasQueONaoVe } from '../../../lib/servidor/repositorio';
import { corDaPessoa } from '../../../lib/visual';

if (!conceitoDisponivel()) return naoEncontrado();
const proposta = Astro.url.searchParams.get('quadro') === 'b' ? 'b' : 'a';

const { usuario } = Astro.locals;
const integrantes = await listarIntegrantesQueVe(usuario);
const filiacoes = await listarFiliacoes();
const casais = await listarCasais(usuario);
const lacos = (await listarLacosDoCoracao(usuario)).filter((l) => l.dono === usuario.pessoa);
const ordemDosNucleos = (await listarNucleos()).map((n) => n.id);
const naoVe = await pessoasQueONaoVe(usuario);
const familia = new Familia(filiacoes, casais, new Map<string, Tratamento>(integrantes.map((i) => [i.id, i.tratamento])));
const eu = integrantes.find((i) => i.id === usuario.pessoa)!;

const FAIXAS = [
  { id: 1, nome: 'Muito próximo', meio: 16 },
  { id: 2, nome: 'Próximo', meio: 50 },
  { id: 3, nome: 'Conhecido', meio: 83 },
];
// O palpite do conceito: a faixa sai do parentesco escrito. Na construção, sai da distância na árvore.
const faixaDe = (texto: string | null, doCoracao: number | null | undefined) => {
  if (doCoracao) return doCoracao;
  if (!texto) return doCoracao === null ? 2 : 3;
  if (/^(mãe|pai|irmã|irmão|filh|espos|marido|companheir|noiv|namorad)/.test(texto)) return 1;
  if (/^(avó|avô|net|tia|tio|sobrinh|cunhad|sogr|genro|nora)/.test(texto)) return 2;
  return 3;
};
// Um número fixo por pessoa, para a posição dentro da faixa não mudar a cada visita
const sorte = (id: string) => [...id].reduce((s, c) => (s * 31 + c.charCodeAt(0)) % 997, 7) / 997;

const gente = integrantes
  .filter((i) => i.id !== eu.id)
  .map((i) => {
    const relacao = familia.relacao(eu.id, i.id);
    const meu = lacos.find((l) => l.pessoa === i.id);
    const faixa = faixaDe(relacao?.texto ?? null, meu ? meu.proximidade : undefined);
    return {
      id: i.id,
      nome: i.apelido ?? i.nome,
      laco: relacao ? possessivo(relacao, i.tratamento) : meu ? lacoParaODono(meu.nome, i.tratamento) : i.tipo === 'bicho' ? (i.especie ?? 'bicho') : '',
      foto: i.retrato && !naoVe.has(i.id) ? enderecoDoRetrato(i.retrato) : null,
      cor: corDaPessoa(familiasDe(i), ordemDosNucleos),
      faixa,
      // A proximidade contínua, de 0 (colado) a 99 (a borda do círculo). 100 é "Fora do círculo".
      proximidade: Math.round(FAIXAS[faixa - 1]!.meio + (sorte(i.id) - 0.5) * 20),
    };
  });

// Em cada anel, as pessoas se espalham pela volta inteira. O raio vem da proximidade.
const RAIO = (proximidade: number) => 9.5 + proximidade * 0.39;
const porFaixa = FAIXAS.map((f, n) => {
  const pessoas = gente.filter((g) => g.faixa === f.id).sort((a, b) => a.proximidade - b.proximidade || a.nome.localeCompare(b.nome, 'pt-BR'));
  // Vizinhos de proximidade parecida ficam em lados opostos da volta, para não se cobrirem
  const volta = pessoas.map((_, i) => (i % 2 === 0 ? i / 2 : pessoas.length - (i + 1) / 2));
  return {
    ...f,
    pessoas: pessoas.map((p, i) => {
      // No alto de cada anel fica o nome da faixa: a volta deixa esse trecho livre
      const vao = [80, 56, 40][n]!;
      const angulo = -90 + vao / 2 + ((360 - vao) / Math.max(pessoas.length, 1)) * (volta[i]! + 0.5);
      return { ...p, angulo: Math.round(angulo * 10) / 10 };
    }),
  };
});
const cor = corDaPessoa(familiasDe(eu), ordemDosNucleos);
const posicao = (angulo: number, proximidade: number) => {
  const r = RAIO(proximidade);
  const rad = (angulo * Math.PI) / 180;
  return `--x: ${(r * Math.cos(rad)).toFixed(2)}; --y: ${(r * Math.sin(rad)).toFixed(2)}`;
};
---

<Visual titulo="Seu círculo" secao="pessoas" familia={cor} intimo mapa>
  <div class="quadro quadro--circulo" data-circulo data-proposta={proposta}>
    <TrocaDoConceito tela="circulo" proposta={proposta} />
    <div class="mapa mapa--circulo">
      <div class="circulo-area">
        <div class="circulo">
          {[3, 2, 1].map((n) => <i class={`circulo__anel circulo__anel--${n}`} aria-hidden="true"></i>)}
          <p class="circulo__eu">
            <Retrato nome={eu.nome} foto={eu.retrato ? enderecoDoRetrato(eu.retrato) : null} familia={cor} redondo cedo />
            <span>Você</span>
          </p>
          {porFaixa.map((f) => (
            <section class="circulo__faixa" data-faixa={f.id} aria-labelledby={`faixa-${f.id}`}>
              <h2 class="rotulo" id={`faixa-${f.id}`}>
                {f.nome}
              </h2>
              <ul>
                {f.pessoas.map((p) => (
                  <li style={posicao(p.angulo, p.proximidade)}>
                    <button type="button" class="circulo__pessoa" data-pessoa={p.id} data-nome={p.nome} data-laco={p.laco} data-angulo={p.angulo} data-proximidade={p.proximidade}>
                      <Retrato nome={p.nome} foto={p.foto} familia={p.cor} redondo />
                      <span>{p.nome}</span>
                    </button>
                  </li>
                ))}
              </ul>
            </section>
          ))}
        </div>
      </div>

      <aside class="pm" data-quadro aria-label="Sobre o seu círculo">
        <header class="pm__alto">
          <h1 class="serifa">Seu círculo</h1>
          <button type="button" class="pm__abre" data-abrir-painel aria-expanded="false" aria-controls="corpo-do-painel">Mais</button>
        </header>
        <p class="pm__dica">Só você vê o seu círculo. Toque em alguém para aproximar ou afastar.</p>
        <div class="pm__ficha" data-ficha-do-circulo aria-live="polite"></div>
        <div class="pm__corpo" id="corpo-do-painel">
          <nav class="pm__ver" aria-label="Forma de ver as pessoas">
            <span class="segmentado">
              <a href="/pessoas">Por família</a>
              <a href={`/conceito/mapa/circulo?quadro=${proposta}`} aria-current="true">Seu círculo</a>
            </span>
          </nav>
          <form class="pm__busca" data-procurar>
            <label class="arvore__campo">
              <span>Procurar no círculo</span>
              <select name="quem">
                <option value="">Escreva o nome</option>
                {[...gente].sort((a, b) => a.nome.localeCompare(b.nome, 'pt-BR')).map((p) => <option value={p.id}>{p.nome}</option>)}
              </select>
            </label>
          </form>
          <details class="pm__secao" name={proposta === 'a' ? 'painel-do-mapa' : undefined}>
            <summary>Fora do círculo</summary>
            <p class="pm__texto">Ninguém está fora do seu círculo. Quem você afastar até o fim aparece aqui, e daqui volta.</p>
          </details>
          <details class="pm__secao" name={proposta === 'a' ? 'painel-do-mapa' : undefined} data-legenda>
            <summary>Legenda</summary>
            <div class="legenda legenda--circulo">
              <ul>
                {FAIXAS.map((f) => <li><i class={`amostra-anel amostra-anel--${f.id}`}></i> {f.nome}</li>)}
              </ul>
              <p>Aparecem a família que você vê, os seus laços do coração, quem já faleceu e os bichos.</p>
            </div>
          </details>
        </div>
      </aside>
    </div>
  </div>
</Visual>

<template id="ficha-do-circulo">
  <strong></strong>
  <span class="mapa__foco-quem"></span>
  <button type="button" class="mapa__foco-fechar" data-fechar-ficha aria-label="Fechar">×</button>
  <a href="/pessoas">Ver a página</a>
  <label class="pm__proximidade">
    <span>Proximidade</span>
    <output></output>
    <input type="range" min="0" max="100" step="1" />
  </label>
</template>

<script>
  import { buscaDePessoa } from '../../../lib/cliente/busca-pessoa';
  import { painelDoMapa } from '../../../lib/cliente/painel-do-mapa';

  // CONCEITO: tocar em alguém abre a ficha com o slider, e o slider muda o lugar da pessoa no anel.
  // Nada é guardado.
  const raiz = document.querySelector<HTMLElement>('[data-circulo]');
  const ficha = raiz?.querySelector<HTMLElement>('[data-ficha-do-circulo]');
  const molde = document.querySelector<HTMLTemplateElement>('#ficha-do-circulo');
  if (raiz && ficha && molde) {
    const painel = painelDoMapa(raiz);
    const nomeDaFaixa = (v: number) => (v >= 100 ? 'Fora do círculo' : v < 33 ? 'Muito próximo' : v < 66 ? 'Próximo' : 'Conhecido');
    let aberta: HTMLButtonElement | null = null;
    const fechar = () => {
      aberta?.removeAttribute('aria-pressed');
      const voltarPara = ficha.contains(document.activeElement) ? aberta : null;
      aberta = null;
      ficha.replaceChildren();
      voltarPara?.focus();
    };
    const abrir = (botao: HTMLButtonElement) => {
      aberta?.removeAttribute('aria-pressed');
      aberta = botao;
      botao.setAttribute('aria-pressed', 'true');
      ficha.replaceChildren(molde.content.cloneNode(true));
      // O retrato da ficha é uma cópia do retrato do círculo, que é a peça do sistema
      ficha.prepend(botao.querySelector('.retrato')!.cloneNode(true));
      ficha.querySelector('strong')!.textContent = botao.dataset.nome ?? '';
      ficha.querySelector('.mapa__foco-quem')!.textContent = botao.dataset.laco ?? '';
      ficha.querySelector<HTMLAnchorElement>('a')!.href = `/pessoas/${botao.dataset.pessoa}`;
      const slider = ficha.querySelector<HTMLInputElement>('input')!;
      const saida = ficha.querySelector('output')!;
      slider.value = botao.dataset.proximidade ?? '50';
      slider.setAttribute('aria-valuetext', nomeDaFaixa(Number(slider.value)));
      saida.textContent = nomeDaFaixa(Number(slider.value));
      slider.addEventListener('input', () => {
        const v = Number(slider.value);
        const raio = 9.5 + Math.min(v, 99) * 0.39;
        const rad = (Number(botao.dataset.angulo) * Math.PI) / 180;
        const item = botao.closest<HTMLElement>('li')!;
        item.style.setProperty('--x', (raio * Math.cos(rad)).toFixed(2));
        item.style.setProperty('--y', (raio * Math.sin(rad)).toFixed(2));
        item.toggleAttribute('data-fora', v >= 100);
        botao.dataset.proximidade = String(v);
        slider.setAttribute('aria-valuetext', nomeDaFaixa(v));
        saida.textContent = nomeDaFaixa(v);
      });
    };
    raiz.addEventListener('click', (e) => {
      const alvo = e.target as HTMLElement;
      if (alvo.closest('[data-fechar-ficha]')) return fechar();
      const botao = alvo.closest<HTMLButtonElement>('.circulo__pessoa');
      if (botao) return botao === aberta ? fechar() : abrir(botao);
    });
    raiz.addEventListener('keydown', (e) => {
      if (e.key !== 'Escape' || e.defaultPrevented || !aberta) return;
      if ((e.target as HTMLElement).closest('.pm__corpo')) return;
      e.preventDefault();
      const botao = aberta;
      fechar();
      botao.focus();
    });
    const quem = raiz.querySelector<HTMLSelectElement>('select[name="quem"]');
    if (quem) {
      buscaDePessoa(quem);
      quem.addEventListener('change', () => {
        const botao = raiz.querySelector<HTMLButtonElement>(`.circulo__pessoa[data-pessoa="${CSS.escape(quem.value)}"]`);
        if (!botao) return;
        painel.fechar();
        abrir(botao);
        botao.focus();
        quem.value = '';
        quem.dispatchEvent(new Event('busca:atualizar'));
      });
      quem.form?.addEventListener('submit', (e) => e.preventDefault());
    }
  }
</script>
