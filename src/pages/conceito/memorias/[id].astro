---
// Conceito da revisão visual: a página da memória.
// A ideia da tela: a foto e o verso. A frente é a imagem grande; o verso é a ficha em mono, como
// o carimbo do laboratório, e os relatos como bilhetes assinados à mão. A ordem é a de docs/visual.md.
import '../../../visual/telas/memoria.css';
import Visual from '../../../layouts/Visual.astro';
import Audio from '../../../components/visual/Audio.astro';
import Bilhete from '../../../components/visual/Bilhete.astro';
import Carimbo from '../../../components/visual/Carimbo.astro';
import Dado from '../../../components/visual/Dado.astro';
import Etiqueta from '../../../components/visual/Etiqueta.astro';
import Ficha from '../../../components/visual/Ficha.astro';
import Retrato from '../../../components/visual/Retrato.astro';
import Polaroid from '../../../components/visual/Polaroid.astro';
import Rabisco from '../../../components/visual/Rabisco.astro';
import { memoriaDoCapitulo } from '../../../lib/capitulos';
import { tipoDaMemoria } from '../../../lib/tipos';
import { formatarData } from '../../../lib/datas';
import { duracaoEmTexto } from '../../../lib/audios';
import { Familia, possessivo, type Tratamento } from '../../../lib/parentesco';
import { enderecoDoRetrato } from '../../../lib/retratos';
import { conceitoDisponivel, naoEncontrado } from '../../../lib/servidor/conceito';
import { podeEditarMemoria, podeExcluirMemoria } from '../../../lib/servidor/permissoes';
import {
  familiasDe,
  listarAudiosDosRelatos,
  listarCapitulos,
  listarCasais,
  listarFiliacoes,
  listarIntegrantes,
  listarMemorias,
  listarNucleos,
  listarRelatos,
  listarTemas,
  obterMemoria,
  pessoasQueONaoVe,
} from '../../../lib/servidor/repositorio';
import { carimboDaData, corDaPessoa, estiloDoTipo, giroDoId, legendaLugarAno, trechoDoRelato } from '../../../lib/visual';

if (!conceitoDisponivel()) return naoEncontrado();

const { usuario, tipos } = Astro.locals;
const memoria = await obterMemoria(usuario, Astro.params.id ?? '');
// Rascunho se edita no formulário. Memória que a pessoa não vê é como se não existisse.
if (!memoria) return new Response('Memória não encontrada', { status: 404 });
if (memoria.situacao === 'rascunho') return Astro.redirect(`/nova?id=${memoria.id}`);

const integrantes = await listarIntegrantes();
const nucleos = await listarNucleos();
const ordemDosNucleos = nucleos.map((n) => n.id);
const relatos = await listarRelatos(usuario, memoria.id);
const audiosDosRelatos = await listarAudiosDosRelatos(relatos.map((r) => r.id));
const achar = (id: string) => integrantes.find((i) => i.id === id);
const nome = (id: string) => achar(id)?.apelido ?? achar(id)?.nome ?? id;

// Retratos em "Quem estava": só de quem a pessoa vê. Sem retrato, as iniciais sobre a cor da família.
const naoVe = memoria.integrantes.length ? await pessoasQueONaoVe(usuario) : new Set<string>();
const retratoDe = (id: string) => {
  const pessoa = achar(id);
  return pessoa?.retrato && !naoVe.has(id) ? enderecoDoRetrato(pessoa.retrato) : null;
};
const familiaDe = (id: string) => corDaPessoa(achar(id) ? familiasDe(achar(id)!) : [], ordemDosNucleos);
// O parentesco do ponto de vista de quem olha: "sua avó"
const tratamentos = new Map<string, Tratamento>(integrantes.map((i) => [i.id, i.tratamento]));
const familia = new Familia(await listarFiliacoes(), await listarCasais(usuario), tratamentos);
const paraVoce = (id: string) => {
  if (id === usuario.pessoa) return 'você';
  const relacao = familia.relacao(usuario.pessoa, id);
  return relacao ? possessivo(relacao, achar(id)?.tratamento ?? null) : undefined;
};

const tipo = tipoDaMemoria(tipos, memoria);
const dosNucleos = memoria.nucleos.map((id) => nucleos.find((n) => n.id === id)?.nome).filter((n): n is string => Boolean(n));
const podeEditar = podeEditarMemoria(usuario, memoria).ok;
const podeExcluir = podeExcluirMemoria(usuario, memoria).ok;
// Capítulos: os reunidos em que foi colocada e os por período em que a data cai, se forem de quem está nela
const capitulos = (await listarCapitulos(usuario)).filter((c) => memoriaDoCapitulo(memoria, c));
const temas = (await listarTemas()).filter((t) => memoria.temas.includes(t.id));
const temMeuRelato = relatos.some((r) => r.por === usuario.pessoa);
const textoDaAcao = temMeuRelato ? 'Editar meu relato' : 'Escrever meu relato';

// O trecho da abertura vem do primeiro relato publicado que tem texto
const relatoDaAbertura = relatos.find((r) => r.situacao === 'publicada' && r.texto.trim());
const trecho = relatoDaAbertura ? trechoDoRelato(relatoDaAbertura.texto) : undefined;

// Vizinhas na linha do tempo, entre as que a pessoa vê
const todas = await listarMemorias(usuario);
const posicao = todas.findIndex((m) => m.id === memoria.id);
const antes = todas[posicao - 1];
const depois = todas[posicao + 1];

// A cor e a assinatura acompanham os núcleos da memória; aberta a todos, as famílias juntas
const corDaTela = memoria.visibilidade === 'nucleos' ? undefined : 'tudo';
const outrasFotos = memoria.fotos.length > 1;

// Fotos que vieram com um relato ("Fotos pelo relato", em docs/decisoes.md, ainda a construir).
// A proposta: a foto é uma só e é da memória. Ela aparece com todas as outras, na parede e na
// galeria, e também no bilhete do relato que a trouxe, pequena, abrindo a mesma galeria.
// FIXO: o banco ainda não liga a foto ao relato. Para mostrar a ideia, nestas memórias de exemplo
// as últimas fotos fazem de conta que vieram com o relato de uma pessoa.
const FIXO_FOTOS_DOS_RELATOS: Record<string, Record<string, number>> = {
  '2025-natal': { gui: 2 },
  '1992-chegada-do-gui': { 'vo-bela': 1 },
};
const doRelato = new Map<number, string>();
for (const [pessoa, quantas] of Object.entries(FIXO_FOTOS_DOS_RELATOS[memoria.id] ?? {})) {
  if (!relatos.some((r) => r.por === pessoa && r.situacao === 'publicada')) continue;
  for (let n = Math.max(1, memoria.fotos.length - quantas); n < memoria.fotos.length; n++) doRelato.set(n, pessoa);
}
const fotosDoRelato = (pessoa: string) => memoria.fotos.map((foto, n) => ({ foto, n })).filter(({ n }) => doRelato.get(n) === pessoa);
---

<Visual titulo={memoria.titulo} nucleos={memoria.nucleos} familia={corDaTela}>
  <article class="memoria">
    <div class="abre__fundo" style={estiloDoTipo(memoria.tipo)}>
    <header class:list={['abre miolo grade', memoria.fotos.length === 0 && 'abre--sem-foto']}>
      <div class="abre__texto">
        <p class="abre__sobre">
          <Carimbo itens={[carimboDaData(memoria), memoria.lugar]} />
          {memoria.visibilidade === 'nucleos' && <span class="selo">Só {dosNucleos.join(' e ')}</span>}
          {memoria.exemplo && <span class="selo">exemplo</span>}
        </p>
        <h1 class="t-1">{memoria.titulo}</h1>
        {
          trecho && relatoDaAbertura && (
            <blockquote class="abre__trecho">
              <p class="serifa t-abertura">“{trecho}”</p>
              <footer>
                <span class="mao">{nome(relatoDaAbertura.por)}</span>
              </footer>
            </blockquote>
          )
        }
        {/* Atalho pequeno no alto para quem chega querendo contar; o convite grande fica no fim */}
        <p class="abre__atalho">
          <a class="acao" href={`/memorias/${memoria.id}/relato`}>
            {textoDaAcao}
          </a>
        </p>
      </div>
      {
        memoria.fotos.length > 0 && (
          // Com mais de uma foto e espaço, as de trás se abrem em leque. Cada foto abre a galeria nela.
          <div class:list={['abre__foto', outrasFotos && `abre__foto--leque abre__foto--${Math.min(memoria.fotos.length, 3)}`]}>
            <Polaroid id={memoria.id} fotos={memoria.fotos} legenda={legendaLugarAno(memoria.lugar, memoria.ano)} cedo galeria />
          </div>
        )
      }
    </header>
    </div>

    <div class="corpo grade">
      <aside class="dados" aria-label="Ficha da memória">
        <Ficha>
          <Dado rotulo="Quando">{formatarData(memoria)}</Dado>
          {
            memoria.lugar && (
              <Dado rotulo="Onde">{memoria.lugar}</Dado>
            )
          }
          <Dado rotulo="Tipo">
              <Etiqueta tipo={memoria.tipo} rotulo={tipo.rotulo} />
            </Dado>
          {
            capitulos.length > 0 && (
              <Dado rotulo={capitulos.length === 1 ? 'Capítulo' : 'Capítulos'}>
                  {capitulos.map((c) => (
                    <a href={`/capitulos/${c.id}`}>{c.titulo}</a>
                  ))}
                </Dado>
            )
          }
          {
            temas.length > 0 && (
              <Dado rotulo="Temas">
                  {temas.map((t) => (
                    <a href={`/temas/${t.id}`}>{t.nome}</a>
                  ))}
                </Dado>
            )
          }
          {
            dosNucleos.length > 0 && (
              <Dado rotulo="Famílias">{dosNucleos.join(', ')}</Dado>
            )
          }
        </Ficha>
      </aside>

      <div class="corpo__conteudo">
        {
          memoria.integrantes.length > 0 && (
            <section class="parte" aria-labelledby="quem-estava">
              <h2 class="parte__titulo" id="quem-estava">
                Quem estava
              </h2>
              <ul class="quem">
                {memoria.integrantes.map((id) => (
                  <li>
                    <a class="pessoa" href={`/pessoas/${id}`}>
                      <Retrato nome={nome(id)} foto={retratoDe(id)} familia={familiaDe(id)} />
                      <span class="pessoa__nome">{nome(id)}</span>
                      {paraVoce(id) && <span class="pessoa__laco ficha suave">{paraVoce(id)}</span>}
                    </a>
                  </li>
                ))}
              </ul>
            </section>
          )
        }

        {
          relatos.length > 0 && (
            <section class="parte" aria-labelledby="relatos">
              <h2 class="parte__titulo" id="relatos">
                {relatos.length === 1 ? 'Relato' : 'Relatos'}
              </h2>
              <div class="relatos">
                {relatos.map((relato) => {
                  const audios = audiosDosRelatos.get(relato.id) ?? [];
                  return (
                    <Bilhete por={nome(relato.por)} registradoPor={relato.registradoPor !== relato.por ? nome(relato.registradoPor) : null}>
                      <h3 class="so-leitor">Contado por {nome(relato.por)}</h3>
                      {relato.situacao === 'rascunho' && <p class="selo bilhete__selo">Rascunho, só você vê</p>}
                      {audios.map((audio, n) => (
                        <Audio
                          rotulo={`${audios.length > 1 ? `Áudio ${n + 1}` : 'Áudio'}${audio.duracao ? ` · ${duracaoEmTexto(audio.duracao)}` : ''}`}
                          src={`/audios/${audio.chave}`}
                          transcricao={audio.transcricao}
                        />
                      ))}
                      {relato.texto.trim() && (
                        <div class="bilhete__texto">
                          {relato.texto.split(/\n{2,}/).map((paragrafo) => (
                            <p>{paragrafo}</p>
                          ))}
                        </div>
                      )}
                      {/* As fotos que vieram com este relato: as mesmas da memória, pequenas, abrindo a mesma galeria */}
                      {fotosDoRelato(relato.por).length > 0 && (
                        <ul class="bilhete__fotos" aria-label={`Fotos que vieram com o relato de ${nome(relato.por)}`}>
                          {fotosDoRelato(relato.por).map(({ foto, n }) => (
                            <li>
                              <a class="monte" href={`/fotos/${foto.chave}`} data-galeria={n} aria-label={`Ver a foto${foto.legenda ? `: ${foto.legenda}` : ''}`}>
                                <span class="polaroid" style={`--giro: ${giroDoId(`${memoria.id}-${n}`)}deg`}>
                                  <span class="polaroid__foto">
                                    <img src={`/fotos/${foto.chave}`} alt={foto.legenda ?? ''} loading="lazy" decoding="async" />
                                  </span>
                                  <span class="polaroid__legenda" />
                                </span>
                              </a>
                            </li>
                          ))}
                        </ul>
                      )}
                    </Bilhete>
                  );
                })}
              </div>
            </section>
          )
        }

        {
          // A parede de fotos: todas as fotos da memória como fotos reveladas, com a legenda de cada uma.
          // Tocar numa abre a galeria, com a foto inteira.
          outrasFotos && (
            <section class="parte" aria-labelledby="fotos">
              <h2 class="parte__titulo" id="fotos">
                Fotos
              </h2>
              <ul class="parede">
                {memoria.fotos.map((foto, n) => (
                  <li>
                    <a class="monte" href={`/fotos/${foto.chave}`} data-galeria={n} aria-label={`Ver a foto inteira${foto.legenda ? `: ${foto.legenda}` : ''}`}>
                      <figure class="polaroid" style={`--giro: ${giroDoId(`${memoria.id}-${n}`)}deg`}>
                        <span class="polaroid__foto">
                          <img src={`/fotos/${foto.chave}`} alt={foto.legenda ?? ''} loading="lazy" decoding="async" />
                        </span>
                        <figcaption class="polaroid__legenda">{foto.legenda ?? ''}</figcaption>
                      </figure>
                    </a>
                  </li>
                ))}
              </ul>
            </section>
          )
        }
      </div>
    </div>

    {/* O convite para contar: um bilhete em branco com o nome de quem está vendo, à espera do relato dela */}
    <section class="convite miolo" aria-labelledby="convite" style={estiloDoTipo(memoria.tipo)}>
      <div class="convite__mesa">
        <span class="convite__forma" aria-hidden="true" />
        <div class:list={['convite__bilhete bilhete', temMeuRelato && 'convite__bilhete--feito']}>
          <p class="convite__para rotulo suave">
            <Retrato nome={usuario.nome} foto={retratoDe(usuario.pessoa)} familia={familiaDe(usuario.pessoa)} />
            Para {usuario.nome}
          </p>
          <h2 class="convite__titulo serifa" id="convite">
            {temMeuRelato ? 'Você já contou esse dia.' : 'Cada pessoa conta o dia do jeito que lembra.'}
          </h2>
          {
            !temMeuRelato && (
              <div class="convite__linhas" aria-hidden="true">
                <span />
                <span />
                <span />
              </div>
            )
          }
          <p class="convite__pe">
            <span class="convite__assina">
              <span class="mao">{usuario.nome}</span>
              <Rabisco desenho="sublinha" />
            </span>
            <a class="botao" href={`/memorias/${memoria.id}/relato`}>
              {textoDaAcao}
            </a>
          </p>
        </div>
      </div>
    </section>
  </article>

  {/* A galeria: a foto inteira, uma de cada vez, sem sair da página. As fotos ficam numa fila que
      rola para o lado com a rolagem do próprio aparelho: a foto acompanha o dedo e a seguinte entra,
      como no álbum de fotos do celular. Sem script, cada foto continua sendo um link para a imagem. */}
  {
    memoria.fotos.length > 0 && (
      <dialog class="galeria" data-galeria-caixa aria-label="Fotos desta memória">
        <div class="galeria__topo">
          <p class="rotulo" data-galeria-conta aria-live="polite" />
          <button type="button" class="galeria__fechar" data-galeria-fechar>
            Fechar
          </button>
        </div>
        <ul class="galeria__fila" data-galeria-fila>
          {memoria.fotos.map((foto, n) => (
            <li class="galeria__quadro">
              <figure>
                <img src={`/fotos/${foto.chave}`} alt={foto.legenda ?? ''} loading="lazy" decoding="async" />
                <figcaption>
                  <span class="galeria__legenda">{foto.legenda ?? ''}</span>
                  {doRelato.has(n) && <span class="ficha suave">Veio com o relato de {nome(doRelato.get(n)!)}</span>}
                </figcaption>
              </figure>
            </li>
          ))}
        </ul>
        <div class="galeria__passos">
          <button type="button" class="galeria__passo galeria__passo--antes" data-galeria-passo="-1">
            Anterior
          </button>
          <button type="button" class="galeria__passo galeria__passo--depois" data-galeria-passo="1">
            Próxima
          </button>
        </div>
      </dialog>
    )
  }

  <nav class="vizinhas miolo" aria-label="Outras memórias">
    {
      [
        { rotulo: 'Antes', m: antes },
        { rotulo: 'Depois', m: depois },
      ].map(({ rotulo, m }) => (
        <div class:list={['vizinha', rotulo === 'Depois' && 'vizinha--depois']}>
          {m && (
            <a href={`/conceito/memorias/${m.id}`}>
              <span class="rotulo suave">
                {rotulo} · {carimboDaData(m)}
              </span>
              <strong class="serifa t-3">{m.titulo}</strong>
            </a>
          )}
        </div>
      ))
    }
  </nav>

  <p class="servico miolo">
    {
      podeEditar && (
        <a class="acao acao--quieta" href={`/nova?id=${memoria.id}`}>
          Corrigir esta memória
        </a>
      )
    }
    <a class="acao acao--quieta" href={`/memorias/${memoria.id}/historico`}>
      Histórico de alterações
    </a>
    {
      podeExcluir && (
        <a class="acao acao--quieta" href={`/memorias/${memoria.id}/excluir`}>
          Excluir memória
        </a>
      )
    }
  </p>
</Visual>

<script>
  // A galeria de fotos da memória. Abre na foto tocada e mostra a imagem inteira. As fotos ficam
  // numa fila que rola para o lado: no toque, a foto acompanha o dedo e para na seguinte (é a
  // rolagem do próprio aparelho, com encaixe); os botões e as setas do teclado fazem a mesma
  // passagem, deslizando. O botão de voltar do aparelho fecha a galeria em vez de sair da página.
  const caixa = document.querySelector<HTMLDialogElement>('[data-galeria-caixa]');
  const fila = caixa?.querySelector<HTMLElement>('[data-galeria-fila]');
  if (caixa && fila && typeof caixa.showModal === 'function') {
    const total = fila.children.length;
    const conta = caixa.querySelector<HTMLElement>('[data-galeria-conta]')!;
    const passos = [...caixa.querySelectorAll<HTMLButtonElement>('[data-galeria-passo]')];
    const calmo = matchMedia('(prefers-reduced-motion: reduce)');
    let atual = 0;
    // Para onde a fila está indo, enquanto desliza por um botão ou pelo teclado
    let destino = 0;
    let deslizando = 0;
    let noHistorico = false;

    const anotar = () => {
      conta.textContent = total > 1 ? `Foto ${atual + 1} de ${total}` : 'Foto';
      for (const b of passos) {
        b.hidden = total < 2;
        // Na ponta, o botão só fica apagado (aria-disabled): desligado de verdade, ele engoliria as
        // setas do teclado de quem está com o foco nele
        b.setAttribute('aria-disabled', String(Number(b.dataset.galeriaPasso) < 0 ? destino === 0 : destino === total - 1));
      }
    };
    const ir = (n: number, deslizar = true) => {
      destino = Math.max(0, Math.min(total - 1, n));
      const suave = deslizar && !calmo.matches;
      clearTimeout(deslizando);
      if (suave) deslizando = window.setTimeout(() => (deslizando = 0), 700);
      else {
        deslizando = 0;
        atual = destino;
      }
      fila.scrollTo({ left: destino * fila.clientWidth, behavior: suave ? 'smooth' : 'instant' });
      anotar();
    };
    // A foto da vez é a que está no meio da fila: vale para o dedo, para o botão e para o teclado
    fila.addEventListener(
      'scroll',
      () => {
        const n = Math.round(fila.scrollLeft / Math.max(1, fila.clientWidth));
        if (n === atual) return;
        atual = n;
        if (!deslizando) destino = n;
        anotar();
      },
      { passive: true },
    );
    const abrir = (n: number) => {
      if (!caixa.open) {
        caixa.showModal();
        history.pushState({ galeria: true }, '');
        noHistorico = true;
      }
      ir(n, false);
    };

    document.addEventListener('click', (evento) => {
      const link = evento.target instanceof Element ? evento.target.closest<HTMLAnchorElement>('a[data-galeria]') : null;
      // Abrir em outra aba continua funcionando: o link leva à imagem
      if (!link || evento.button !== 0 || evento.metaKey || evento.ctrlKey || evento.shiftKey || evento.altKey) return;
      evento.preventDefault();
      abrir(Number(link.dataset.galeria));
    });
    caixa.querySelector('[data-galeria-fechar]')?.addEventListener('click', () => caixa.close());
    for (const b of passos) b.addEventListener('click', () => ir(destino + Number(b.dataset.galeriaPasso)));
    caixa.addEventListener('keydown', (evento) => {
      if (evento.key !== 'ArrowRight' && evento.key !== 'ArrowLeft') return;
      evento.preventDefault();
      ir(destino + (evento.key === 'ArrowRight' ? 1 : -1));
    });
    // Se a tela muda de tamanho ou vira, a foto da vez continua no lugar
    addEventListener('resize', () => caixa.open && ir(atual, false));
    // Fechada pelo botão ou pelo Esc: desfaz a entrada que a galeria pôs no histórico
    caixa.addEventListener('close', () => {
      if (!noHistorico) return;
      noHistorico = false;
      history.back();
    });
    // O voltar do aparelho, com a galeria aberta, fecha a galeria
    addEventListener('popstate', () => {
      if (!caixa.open) return;
      noHistorico = false;
      caixa.close();
    });
  }
</script>
