---
// Conceito da revisão visual: o painel pessoal, a página inicial (docs/decisoes.md, "Painel pessoal").
// A ideia da tela: na primeira visita, a carta de Natal assinada à mão. Depois, o que entrou de
// novo, como o envelope do laboratório que chega com fotos que a pessoa ainda não viu.
// Aniversários e atalhos, em segundo plano.
//
// O painel é a única página que só a pessoa vê, e por isso tem cara própria (pedido do Gui,
// 16/11/2026): a página inteira tingida na cor da família dela, o conteúdo em cartões, o nome
// dela sublinhado a caneta e o aviso "Só você vê esta página". O resto do site é revista sobre
// papel; aqui é o canto da pessoa.
//
// A parte funcional do painel ainda não existe (a carta no banco, as datas de visita, o que entrou
// de novo). Aqui, o que falta é dado de exemplo fixo, marcado como FIXO. O que já existe no acervo
// (memórias, fotos, relatos, retratos, parentesco) é lido de verdade, com a visibilidade de quem olha.
import '../../visual/telas/painel.css';
import Visual from '../../layouts/Visual.astro';
import Bilhete from '../../components/visual/Bilhete.astro';
import Carimbo from '../../components/visual/Carimbo.astro';
import IconeDoTipo from '../../components/visual/IconeDoTipo.astro';
import Retrato from '../../components/visual/Retrato.astro';
import Polaroid from '../../components/visual/Polaroid.astro';
import Rabisco from '../../components/visual/Rabisco.astro';
import { familiaMaisRecente } from '../../lib/familias';
import { TITULO_DA_PROXIMIDADE, emOutrosAnos } from '../../lib/painel';
import { Familia, possessivo, type Tratamento } from '../../lib/parentesco';
import { enderecoDoRetrato } from '../../lib/retratos';
import { conceitoDisponivel, naoEncontrado } from '../../lib/servidor/conceito';
import {
  familiasDe,
  listarCasais,
  listarFiliacoes,
  listarIntegrantes,
  listarMemorias,
  listarNucleos,
  listarRelatos,
  pessoasQueONaoVe,
  type Memoria,
} from '../../lib/servidor/repositorio';
import { carimboDaData, corDaPessoa, corDoNucleo, estiloDoTipo, legendaLugarAno, trechoDoRelato } from '../../lib/visual';

if (!conceitoDisponivel()) return naoEncontrado();

const { usuario } = Astro.locals;
// FIXO: no painel de verdade, a primeira visita vem do banco. No conceito, vem do endereço.
const primeiraVisita = Astro.url.searchParams.get('visita') === 'primeira';

const integrantes = await listarIntegrantes();
const nucleos = await listarNucleos();
const ordemDosNucleos = nucleos.map((n) => n.id);
const achar = (id: string) => integrantes.find((i) => i.id === id);
const nome = (id: string) => achar(id)?.apelido ?? achar(id)?.nome ?? id;
const eu = achar(usuario.pessoa);
const naoVe = await pessoasQueONaoVe(usuario);
const retratoDe = (id: string) => {
  const pessoa = achar(id);
  return pessoa?.retrato && !naoVe.has(id) ? enderecoDoRetrato(pessoa.retrato) : null;
};
const familiaDe = (id: string) => corDaPessoa(achar(id) ? familiasDe(achar(id)!) : [], ordemDosNucleos);
const tratamentos = new Map<string, Tratamento>(integrantes.map((i) => [i.id, i.tratamento]));
const filiacoes = await listarFiliacoes();
const casais = await listarCasais(usuario);
const familia = new Familia(filiacoes, casais, tratamentos);
// A cor do painel é a da família mais recente de quem vê: a que a pessoa formou com quem casou.
// A Giovanna e o Magno veem a cor da família que criaram juntos (decisão do Gui, 16/11/2026).
const minhaFamilia = familiaMaisRecente({ familias: new Map(integrantes.map((i) => [i.id, familiasDe(i)])), casais, filiacoes }, usuario.pessoa);
const corDoPainel = corDoNucleo(minhaFamilia, ordemDosNucleos);
const paraVoce = (id: string) => {
  const relacao = familia.relacao(usuario.pessoa, id);
  return relacao ? possessivo(relacao, achar(id)?.tratamento ?? null) : undefined;
};

// Só o que a pessoa pode ver, da mais antiga para a mais nova
const memorias = (await listarMemorias(usuario)).filter((m) => m.situacao === 'publicada');
const recentes = [...memorias].reverse();
const minhas = recentes.filter((m) => m.integrantes.includes(usuario.pessoa));

// --- O que entrou de novo -------------------------------------------------------------------
// FIXO: quais memórias e qual relato são "novos" e as datas das visitas. As memórias e o relato
// em si são lidos do acervo, então quem não pode ver uma delas não a vê aqui.
// O dia fixo é a véspera de Natal, quando o site é dado de presente: é também o dia em que
// "Neste dia, em outros anos" mais tem o que mostrar no acervo de exemplo.
const HOJE = { ano: 2026, mes: 12, dia: 24 };
const HOJE_POR_EXTENSO = '24 dez 2026';
const ULTIMA_VISITA = '17 dez';
const MEMORIAS_NOVAS = ['2026-jantar-de-casamento', '2026-pao-de-queijo-da-vo-bela', '2025-festa-junina', '2026-primeira-noite-em-casa'];
const RELATO_NOVO = { memoria: '2023-chico-chega', por: 'lucas-magno' };

const novas = MEMORIAS_NOVAS.map((id) => memorias.find((m) => m.id === id))
  .filter((m): m is Memoria => Boolean(m) && m!.criadaPor !== usuario.pessoa && m!.fotos.length > 0)
  .slice(0, 2);
const memoriaDoRelato = memorias.find((m) => m.id === RELATO_NOVO.memoria);
const relatoNovo =
  memoriaDoRelato && RELATO_NOVO.por !== usuario.pessoa
    ? (await listarRelatos(usuario, memoriaDoRelato.id)).find((r) => r.por === RELATO_NOVO.por && r.situacao === 'publicada')
    : undefined;
const porExtenso = ['nenhuma', 'uma', 'duas', 'três'];
const partesDoResumo = [
  novas.length > 0 ? `${porExtenso[novas.length]} ${novas.length === 1 ? 'memória' : 'memórias'}` : '',
  relatoNovo ? 'um relato' : '',
].filter(Boolean);
const verbo = novas.length + (relatoNovo ? 1 : 0) > 1 ? 'Entraram' : 'Entrou';

// --- Aniversários dos próximos 30 dias --------------------------------------------------------
// FIXO: dia, mês e idade. O acervo de exemplo ainda não tem mês e dia de nascimento. Quem
// aparece, o retrato e o parentesco são lidos do acervo: só gente viva que a pessoa vê.
const ANIVERSARIOS = [
  { id: 'vo-bela', dia: '28 dez', faz: 84 },
  { id: 'lucas-magno', dia: '6 jan', faz: 0 },
  { id: 'elizete', dia: '12 jan', faz: 0 },
  { id: 'chico', dia: '19 jan', faz: 4 },
];
const aniversarios = ANIVERSARIOS.filter((a) => a.id !== usuario.pessoa && achar(a.id) && !achar(a.id)!.falecido && !naoVe.has(a.id)).slice(0, 3);

// --- A pessoa no acervo e uma memória para contar ---------------------------------------------
// Lidos do acervo: em quantas memórias aparece, e a mais recente, com foto, em que ainda não contou nada.
let paraContar: Memoria | undefined;
// Nunca a mesma memória que já está entre as novidades
for (const m of minhas.filter((x) => x.fotos.length > 0 && !novas.includes(x)).slice(0, 12)) {
  const relatos = await listarRelatos(usuario, m.id);
  if (!relatos.some((r) => r.por === usuario.pessoa)) {
    paraContar = m;
    break;
  }
}

// --- Neste dia, em outros anos ------------------------------------------------------------------
// Lido do acervo: as memórias que a pessoa vê e que aconteceram neste dia, nesta semana ou neste
// mês em outros anos (src/lib/painel.ts). Só o dia de hoje é FIXO.
const outrosAnos = emOutrosAnos(memorias, HOJE);

const primeiroAno = memorias[0]?.ano;
const ultimoAno = memorias.at(-1)?.ano;
const decadas = [...new Set(recentes.map((m) => Math.floor(m.ano / 10) * 10))];

// As fotos que acompanham a carta: as mais recentes em que a pessoa aparece
const fotosDaCarta = minhas.filter((m) => m.fotos.length > 0).slice(0, 3);
---

<Visual titulo="Início" secao="painel" familia={corDoPainel} intimo>
  {
    primeiraVisita ? (
      <section class="carta bloco" data-familia="tudo" aria-labelledby="saudacao">
        <div class="miolo grade">
          <header class="carta__frente">
            <p>
              <Carimbo itens={['Natal de 2026', 'Belo Horizonte']} />
            </p>
            <h1 class="carta__saudacao" id="saudacao">
              {usuario.nome},
            </h1>
          </header>
          <div class="carta__verso">
            {/* FIXO: carta de exemplo. A de verdade é escrita no site pelo Gui, pela Giovanna e pelo Magno, que assinam os três, e fica no banco. */}
            <p class="serifa t-abertura">Este acervo é o nosso presente de Natal para você.</p>
            <div class="carta__texto">
              <p>
                Juntamos aqui as fotos que estavam espalhadas pelos celulares e pelas gavetas, e as histórias que a gente só ouve quando a família se senta à mesa.
                Cada memória diz quando foi e quem estava lá.
              </p>
              <p>
                O acervo está só começando. Ele cresce toda vez que alguém conta o que lembra, por escrito ou com a própria voz. Você está em muitas destas histórias, e
                a sua versão delas ainda está faltando.
              </p>
              <p>Feliz Natal.</p>
            </div>
            <p class="carta__assina">
              <span class="mao">Gui</span>
              <span class="mao">Giovanna</span>
              <span class="mao">Magno</span>
              <Rabisco desenho="coracao" />
            </p>
            <p class="carta__acao">
              <a class="botao" href="/conceito">
                Abrir o acervo
              </a>
            </p>
            <p class="selo">Carta de exemplo</p>
          </div>
          {fotosDaCarta.length > 0 && (
            <div class="carta__fotos" aria-hidden="true">
              {fotosDaCarta.map((m) => (
                <div class="carta__foto">
                  <Polaroid id={m.id} fotos={m.fotos} legenda={legendaLugarAno(m.lugar, m.ano)} alt="" monte={false} cedo />
                </div>
              ))}
            </div>
          )}
        </div>
      </section>
    ) : (
      <section class="novo miolo grade" aria-labelledby="ola">
        <header class="novo__abre">
          <p class="rotulo suave">
            Só você vê esta página
            <br />
            {HOJE_POR_EXTENSO}
          </p>
          <h1 class="t-1" id="ola">
            Oi,{' '}
            <span class="sublinhado">
              {usuario.nome}
              <Rabisco desenho="sublinha" />
            </span>
            .
          </h1>
          <p class="serifa t-abertura novo__resumo">
            {partesDoResumo.length > 0 ? `${verbo} ${partesDoResumo.join(' e ')} desde a sua última visita.` : 'Nada de novo desde a sua última visita.'}
          </p>
          <p class="novo__carta">
            <span class="suave">Sua última visita foi em {ULTIMA_VISITA}.</span>
            <a class="acao acao--quieta" href="/conceito?visita=primeira">
              Carta de Natal
            </a>
          </p>
          <div class="novo__envelope">
            <Rabisco desenho="envelope" />
          </div>
        </header>
        {(novas.length > 0 || relatoNovo) && (
          <ol class="novo__mesa">
            {novas.map((m) => (
              <li class="novidade novidade--memoria" style={estiloDoTipo(m.tipo)}>
                <a href={`/memorias/${m.id}`}>
                  <Polaroid id={m.id} fotos={m.fotos} legenda={legendaLugarAno(m.lugar, m.ano)} alt="" cedo forma />
                  <span class="novidade__sobre rotulo">
                    <IconeDoTipo tipo={m.tipo} />
                    Memória nova · {nome(m.criadaPor)} adicionou
                  </span>
                  <strong class="novidade__titulo serifa t-3">{m.titulo}</strong>
                </a>
              </li>
            ))}
            {relatoNovo && memoriaDoRelato && (
              <li class="novidade novidade--relato" style={estiloDoTipo('causo')}>
                <Bilhete por={nome(relatoNovo.por)} href={`/memorias/${memoriaDoRelato.id}`}>
                  <span class="novidade__sobre rotulo">
                    <IconeDoTipo tipo="causo" />
                    Relato novo · em {memoriaDoRelato.titulo}
                  </span>
                  <span class="bilhete__texto">“{trechoDoRelato(relatoNovo.texto, 120)}”</span>
                </Bilhete>
              </li>
            )}
          </ol>
        )}
      </section>
    )
  }

  {
    outrosAnos && (
      <section class="outros-anos miolo" aria-labelledby="outros-anos">
        <div class="cartao">
          <h2 class="cartao__titulo rotulo" id="outros-anos">
            <IconeDoTipo tipo="outro" />
            {TITULO_DA_PROXIMIDADE[outrosAnos.proximidade]}
          </h2>
          <ol class="outros-anos__lista">
            {outrosAnos.itens.map((m) => (
              <li style={estiloDoTipo(m.tipo)}>
                <a class="outro-ano" href={`/memorias/${m.id}`}>
                  <span class="outro-ano__foto">
                    <Polaroid id={m.id} fotos={m.fotos} legenda={legendaLugarAno(m.lugar, m.ano)} alt="" monte={false} tipo={m.tipo} />
                  </span>
                  <span class="outro-ano__texto">
                    <span class="outro-ano__ano serifa">em {m.ano}</span>
                    <strong class="outro-ano__titulo">{m.titulo}</strong>
                  </span>
                </a>
              </li>
            ))}
          </ol>
        </div>
      </section>
    )
  }

  <div class="cartoes miolo">
    {
      aniversarios.length > 0 && (
        <section class="cartao aniversarios" aria-labelledby="aniversarios" style={estiloDoTipo('aniversario')}>
          <h2 class="cartao__titulo rotulo" id="aniversarios">
            <IconeDoTipo tipo="aniversario" />
            Aniversários dos próximos 30 dias
          </h2>
          <ul>
            {aniversarios.map((a) => (
              <li>
                <a class="aniversario" href={`/pessoas/${a.id}`}>
                  <Retrato nome={nome(a.id)} foto={retratoDe(a.id)} familia={familiaDe(a.id)} />
                  <span class="aniversario__quem">
                    <strong>{nome(a.id)}</strong>
                    <span class="suave">{[paraVoce(a.id), a.faz ? `faz ${a.faz} anos` : ''].filter(Boolean).join(', ')}</span>
                  </span>
                  <span class="aniversario__dia serifa">{a.dia}</span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    {
      eu && (
        <section class="cartao voce" aria-labelledby="voce">
          <h2 class="cartao__titulo rotulo" id="voce">
            Você no acervo
          </h2>
          <div class="voce__conta">
            <Retrato nome={usuario.nome} foto={retratoDe(usuario.pessoa)} familia={corDoPainel} />
            <p>
              <span class="voce__numero serifa">{minhas.length}</span>
              <span class="voce__texto serifa">{minhas.length === 1 ? 'memória em que você aparece' : 'memórias em que você aparece'}</span>
            </p>
          </div>
          <p class="voce__links">
            <a class="acao" href={`/pessoas/${usuario.pessoa}`}>
              Ver sua página
            </a>
            <a class="acao" href={`/arvore?centro=${usuario.pessoa}`}>
              Ver a árvore a partir de você
            </a>
          </p>
        </section>
      )
    }

    {
      paraContar && (
        <section class="cartao contar" aria-labelledby="contar" style={estiloDoTipo(paraContar.tipo)}>
          <h2 class="cartao__titulo rotulo">Você estava lá e ainda não contou</h2>
          <div class="contar__miolo">
            <div class="contar__foto">
              <Polaroid id={paraContar.id} fotos={paraContar.fotos} legenda={legendaLugarAno(paraContar.lugar, paraContar.ano)} alt="" monte={false} />
            </div>
            <div class="contar__texto">
              <p class="contar__titulo serifa t-3" id="contar">
                {paraContar.titulo}
              </p>
              <p class="ficha suave">{carimboDaData(paraContar)}</p>
              <p class="contar__acao">
                <a class="botao" href={`/memorias/${paraContar.id}/relato`}>
                  Escrever meu relato
                </a>
              </p>
            </div>
          </div>
        </section>
      )
    }
  </div>

  <section class="caminho miolo" aria-labelledby="caminho">
    <p class="rotulo suave">
      {memorias.length} memórias{primeiroAno && ultimoAno && primeiroAno !== ultimoAno ? ` · de ${primeiroAno} a ${ultimoAno}` : ''}
    </p>
    <h2 class="caminho__titulo t-1" id="caminho">
      <a href="/explorar">
        Ver a linha do tempo inteira <Rabisco desenho="seta" />
      </a>
    </h2>
    {
      decadas.length > 1 && (
        <ul class="caminho__decadas" aria-label="Ir para a década">
          {decadas.map((d) => (
            <li>
              <a class="serifa t-3" href={`/explorar#decada-${d}`}>
                {d}
              </a>
            </li>
          ))}
        </ul>
      )
    }
  </section>
</Visual>
