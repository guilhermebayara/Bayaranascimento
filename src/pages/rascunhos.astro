---
import Pagina from '../components/formularios/Pagina.astro';
import Vazio from '../components/visual/Vazio.astro';
import { formatarData } from '../lib/datas';
import { listarMemorias, listarRascunhosDeRelato } from '../lib/servidor/repositorio';

const { usuario } = Astro.locals;
const memorias = await listarMemorias(usuario, { rascunhos: true });
const relatos = await listarRascunhosDeRelato(usuario);
// PROVISÓRIO (pergunta 8 do PR do grupo "formularios"): a linha pequena acima do título e os textos novos da abertura
---

<Pagina titulo="Rascunhos" rotulo="Sua conta" secao="conta" larga>
  <Fragment slot="abertura">
    <p>O que você começou e ainda não publicou. Só você vê esta lista.</p>
    {/* A lixeira fica junto dos rascunhos (decisão do Gui, 16/11/2026) */}
    <p class="acoes">
      <a class="acao" href="/lixeira">Ver a lixeira: o que foi descartado ou excluído</a>
    </p>
  </Fragment>

  {
    memorias.length === 0 && relatos.length === 0 && (
      <Vazio frase="Você não tem rascunhos.">
        <a class="acao" href="/nova">Registrar uma memória</a>
      </Vazio>
    )
  }

  {
    memorias.length > 0 && (
      <section class="painel">
        <h2>Memórias</h2>
        <ul class="linhas">
          {memorias.map((m) => (
            <li>
              <a class="linhas__leva" href={`/nova?id=${m.id}`}>
                <strong>{m.titulo}</strong>
                <span>{formatarData(m)}</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )
  }

  {
    relatos.length > 0 && (
      <section class="painel">
        <h2>Relatos</h2>
        <ul class="linhas">
          {relatos.map((r) => (
            <li>
              <a class="linhas__leva" href={`/memorias/${r.memoriaId}/relato`}>
                <strong>{r.titulo}</strong>
                <span>relato em andamento</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )
  }
</Pagina>
