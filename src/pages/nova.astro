---
import { comArtigo } from '../lib/servidor/conteudo';
import Base from '../layouts/Base.astro';
import { TIPO_OUTRO, TIPO_PADRAO } from '../lib/tipos';
import { MESES } from '../lib/datas';
import { pessoasComAcesso } from '../lib/servidor/acesso';
import { podeEditarMemoria, podeRemoverFoto } from '../lib/servidor/permissoes';
import { listarCapitulos, listarIntegrantes, listarNucleos, listarRelatos, listarTemasVisiveis, obterMemoria } from '../lib/servidor/repositorio';

// Esta página serve para três coisas: registrar uma memória nova, continuar
// um rascunho e corrigir uma memória já publicada (?id=...).
const { usuario } = Astro.locals;
const id = Astro.url.searchParams.get('id');
const memoria = id ? await obterMemoria(usuario, id) : undefined;
if (id && !memoria) return new Response('Memória não encontrada', { status: 404 });
if (memoria && !podeEditarMemoria(usuario, memoria).ok) return Astro.redirect(`/memorias/${memoria.id}`);

const publicada = memoria?.situacao === 'publicada';
const integrantes = await listarIntegrantes();
// Só quem criou muda quem pode ver. Para quem é citado, as opções ficam travadas com o valor atual.
const travaQuemVe = Boolean(memoria) && memoria!.criadaPor !== usuario.pessoa;
const travaNucleos = travaQuemVe && memoria!.visibilidade === 'nucleos';
const criadora = travaQuemVe ? integrantes.find((i) => i.id === memoria!.criadaPor) : undefined;
const quemCriou = criadora ? comArtigo(criadora) : 'quem criou';
const comAcesso = await pessoasComAcesso();
const semAcesso = integrantes.filter((i) => i.tipo === 'pessoa' && !comAcesso.has(i.id));
const nucleos = await listarNucleos();
// A pessoa marca os próprios núcleos. Numa edição, os que já estavam aparecem também.
const nucleosDisponiveis = nucleos.filter((n) => usuario.nucleos.includes(n.id) || memoria?.nucleos.includes(n.id));
const nucleosMarcados = memoria?.nucleos ?? (usuario.nucleos.length === 1 ? usuario.nucleos : []);
// O relato só entra aqui enquanto a memória não foi publicada. Depois, cada um edita o seu na própria página.
// Pode ser o relato da própria pessoa ou o de alguém que não acessa o site, registrado por ela.
const doRascunho = memoria && !publicada ? (await listarRelatos(usuario, memoria.id)).filter((r) => r.registradoPor === usuario.pessoa) : [];
const meuRelato = doRascunho.find((r) => r.por === usuario.pessoa) ?? doRascunho[0];
const capitulosReunidos = (await listarCapitulos(usuario)).filter((c) => c.modo === 'reunido');
const todosOsTemas = await listarTemasVisiveis(usuario);
const temasDaMemoria = (memoria?.temas ?? []).map((id) => todosOsTemas.find((t) => t.id === id)?.nome).filter(Boolean).join(', ');
const anoAtual = new Date().getFullYear();
// "Hoje" no horário de Brasília, para o limite do calendário
const hojeIso = new Intl.DateTimeFormat('en-CA', { timeZone: 'America/Sao_Paulo' }).format(new Date());
const titulo = !memoria ? 'Nova memória' : publicada ? 'Corrigir memória' : 'Continuar rascunho';
---

<Base titulo={titulo}>
  <div class="abertura abertura--curta">
    <h1>{titulo}</h1>
    <p>
      {
        publicada
          ? 'Ajuste a ficha, as fotos ou quem pode ver. Os relatos não mudam por aqui: cada pessoa cuida do seu.'
          : `Olá, ${usuario.nome}. Conte o que aconteceu, do seu jeito. Só o título e o ano são obrigatórios, e dá para salvar como rascunho a qualquer momento.`
      }
    </p>
  </div>

  <form class="formulario" method="post" action="/api/memorias" data-formulario-memoria data-id={memoria?.id ?? ''} novalidate>
    {memoria && <input type="hidden" name="id" value={memoria.id} />}
    <section data-etapa="O momento">
    <fieldset>
      <legend>O que aconteceu?</legend>
      <label class="campo">
        <span>Título</span>
        <input type="text" name="titulo" required maxlength="120" autocomplete="off" value={memoria?.titulo ?? ''} placeholder="Ex.: Casamento da Giovanna" />
      </label>
      <div class="campo">
        <span id="rotulo-tipo">Que tipo de momento foi?</span>
        <div class="opcoes" role="radiogroup" aria-labelledby="rotulo-tipo">
          {
            Astro.locals.tipos.map((tipo) => (
              <label class="opcao" style={`--cor-tipo: ${tipo.cor}`}>
                <input type="radio" name="tipo" value={tipo.id} checked={tipo.id === (memoria?.tipo ?? TIPO_PADRAO)} />
                <span class="tipo">{tipo.rotulo}</span>
              </label>
            ))
          }
        </div>
      </div>
      <label class="campo" data-tipo-outro hidden={(memoria?.tipo ?? TIPO_PADRAO) !== TIPO_OUTRO}>
        <span>O que foi? <small>(opcional)</small></span>
        <input type="text" name="tipoOutro" maxlength="40" autocomplete="off" value={memoria?.tipoOutro ?? ''} placeholder="Ex.: Formatura" />
        <span class="dica">Uma ou duas palavras. Se outras memórias usarem o mesmo nome, ele pode virar um tipo da lista.</span>
      </label>
    </fieldset>

    <fieldset>
      <legend>Quando foi?</legend>
      <div class="campo">
        <label for="campo-ano">Ano</label>
        <div class="passo-ano" data-ano>
          <button type="button" data-passo="-10" aria-label="Dez anos antes">−10</button>
          <button type="button" data-passo="-1" aria-label="Um ano antes">−1</button>
          <input id="campo-ano" type="number" name="ano" required inputmode="numeric" min="1800" max={anoAtual} value={memoria?.ano ?? ''} placeholder="Ano" />
          <button type="button" data-passo="1" aria-label="Um ano depois">+1</button>
          <button type="button" data-passo="10" aria-label="Dez anos depois">+10</button>
        </div>
      </div>
      <div class="campos-data campos-data--dois">
        <label class="campo">
          <span>Mês, se souber</span>
          <select name="mes">
            <option value="">Não sei</option>
            {MESES.map((nome, i) => <option value={i + 1} selected={memoria?.mes === i + 1}>{nome}</option>)}
          </select>
        </label>
        <label class="campo">
          <span>Dia, se souber</span>
          <input type="number" name="dia" inputmode="numeric" min="1" max="31" value={memoria?.dia ?? ''} />
        </label>
      </div>
      <div class="atalhos">
        <label class="campo">
          <span>Ou escolha no calendário</span>
          <input type="date" data-calendario min="1800-01-01" max={hojeIso} />
        </label>
        <button type="button" class="botao botao--leve" data-hoje>Foi hoje</button>
      </div>
      <label class="marcar">
        <input type="checkbox" name="aproximada" checked={memoria?.aproximada} />
        <span>Não tenho certeza da data</span>
      </label>
    </fieldset>
    </section>

    <section data-etapa="Pessoas e lugar">
    <fieldset>
      <legend>Quem estava?</legend>
      {integrantes.length > 10 && (
        <label class="campo">
          <span>Procurar pelo nome</span>
          <input type="search" data-filtrar-pessoas autocomplete="off" placeholder="Digite para filtrar a lista" />
        </label>
      )}
      <div class="opcoes" data-lista-de-pessoas>
        {
          integrantes.map((p) => (
            <label class="opcao" data-nome={`${p.nome} ${p.apelido ?? ''}`.toLowerCase()}>
              <input type="checkbox" name="pessoas" value={p.id} checked={memoria?.integrantes.includes(p.id)} />
              <span>{p.apelido ?? p.nome}</span>
            </label>
          ))
        }
      </div>
      <div data-novas-pessoas></div>
      <button type="button" class="botao botao--leve" data-adicionar-pessoa>Adicionar alguém que não está na lista</button>
    </fieldset>

    <fieldset>
      <legend>Onde foi?</legend>
      <label class="campo">
        <span>Lugar, se quiser</span>
        <input type="text" name="lugar" maxlength="120" value={memoria?.lugar ?? ''} placeholder="Ex.: Belo Horizonte" />
      </label>
    </fieldset>
    </section>

    <section data-etapa="Capítulo e temas">
      <fieldset>
        <legend>Faz parte de algo maior?</legend>
        <p class="dica">Opcional. Um capítulo junta memórias de um mesmo momento, como as várias festas de um casamento.</p>
        {
          capitulosReunidos.length > 0 && (
            <div class="campo">
              <span id="rotulo-capitulos">Capítulos</span>
              <div class="opcoes" role="group" aria-labelledby="rotulo-capitulos">
                {capitulosReunidos.map((c) => (
                  <label class="opcao">
                    <input type="checkbox" name="capitulos" value={c.id} checked={memoria?.capitulos.includes(c.id)} />
                    <span>{c.titulo}</span>
                  </label>
                ))}
              </div>
            </div>
          )
        }
        <p class="dica">
          {capitulosReunidos.length === 0 ? 'Ainda não há capítulos. ' : 'Não achou? '}
          Dá para <a href="/capitulos/novo" target="_blank" rel="noopener">criar um capítulo</a> e colocar esta memória nele depois.
        </p>
        <label class="campo">
          <span>Temas</span>
          <input type="text" name="temas" maxlength="500" autocomplete="off" list="lista-de-temas" value={temasDaMemoria} placeholder="Ex.: viagens, casas onde moramos" />
          <span class="dica">Etiquetas livres, separadas por vírgula. Cada tema tem uma página que junta tudo o que o usa.</span>
        </label>
        <datalist id="lista-de-temas">
          {todosOsTemas.map((t) => <option value={t.nome} />)}
        </datalist>
      </fieldset>
    </section>

    <section data-etapa="Fotos">
    <fieldset>
      <legend>Fotos</legend>
      <p class="dica">Escolha as fotos desse momento. Você pode escrever uma legenda para cada uma.</p>
      <label class="botao botao--leve botao--arquivo">
        Escolher fotos
        <input type="file" accept="image/*" multiple data-escolher-fotos class="oculto-visualmente" />
      </label>
      <ul class="fotos-enviadas" data-fotos>
        {
          (memoria?.fotos ?? []).map((foto) => (
            <li class="foto-enviada" data-foto-id={foto.id}>
              <div class="foto__papel">{foto.chave ? <img src={`/fotos/${foto.chave}`} alt="" /> : <div class="foto__reserva">Foto de exemplo</div>}</div>
              <div class="foto-enviada__campos">
                <label class="campo">
                  <span>Legenda</span>
                  <input type="text" data-legenda maxlength="200" value={foto.legenda ?? ''} />
                </label>
                <label class="marcar">
                  <input type="radio" name="fotoPrincipal" value={foto.id} checked={foto.principal} />
                  <span>Usar na linha do tempo</span>
                </label>
                {podeRemoverFoto(usuario, foto.enviadaPor).ok ? (
                  <button type="button" class="botao botao--leve" data-remover>
                    Remover foto
                  </button>
                ) : (
                  <p class="dica">Só quem enviou pode remover.</p>
                )}
              </div>
            </li>
          ))
        }
      </ul>
    </fieldset>
    </section>

    {
      !publicada && (
        <section data-etapa="Relato">
        <fieldset>
            <legend>Como foi?</legend>
            <label class="campo">
              <span>Quem está contando</span>
              <select name="relatoPor" data-relato-por>
                <option value={usuario.pessoa}>Eu, {usuario.nome}</option>
                {semAcesso.map((p) => <option value={p.id} selected={meuRelato?.por === p.id}>{p.nome}, e eu estou escrevendo</option>)}
              </select>
            </label>
            <label class="campo">
              <span>O relato</span>
              <textarea name="relato" rows="8" maxlength="20000" placeholder="Escreva como você lembra. Outras pessoas da família vão poder contar a versão delas depois.">{meuRelato?.texto ?? ''}</textarea>
            </label>
            <p class="dica">Só você vai poder alterar este texto.</p>
          </fieldset>
        </section>
      )
    }

    <section data-etapa="Quem vê">
    <fieldset>
      <legend>Quem pode ver?</legend>
      {
        nucleosDisponiveis.length > 0 && (
          <div class="campo">
            <span id="rotulo-nucleos">De quais núcleos é esta memória?</span>
            <div class="opcoes" role="group" aria-labelledby="rotulo-nucleos">
              {nucleosDisponiveis.map((n) => (
                <label class="opcao">
                  <input type="checkbox" name="nucleos" value={n.id} checked={nucleosMarcados.includes(n.id)} disabled={travaNucleos} />
                  <span>{n.nome}</span>
                </label>
              ))}
            </div>
          </div>
        )
      }
      <label class="marcar">
        <input type="radio" name="visibilidade" value="todos" checked={(memoria?.visibilidade ?? 'todos') === 'todos'} disabled={travaQuemVe} />
        <span>Toda a família vê</span>
      </label>
      <label class="marcar">
        <input type="radio" name="visibilidade" value="nucleos" checked={memoria?.visibilidade === 'nucleos'} disabled={travaQuemVe} />
        <span>Só quem é dos núcleos marcados acima</span>
      </label>
      {travaQuemVe && <input type="hidden" name="visibilidade" value={memoria!.visibilidade} />}
      {travaNucleos && memoria!.nucleos.map((n) => <input type="hidden" name="nucleos" value={n} />)}
      <p class="dica">{travaQuemVe ? `Só ${quemCriou}, que criou a memória, muda quem pode ver.` : 'Dá para mudar depois. Quem não pode ver não fica sabendo que a memória existe.'}</p>
    </fieldset>
      <div class="resumo" data-resumo hidden>
        <h2>Confira antes de guardar</h2>
        <dl data-resumo-lista></dl>
      </div>
    </section>

    <p class="situacao" data-situacao role="status" aria-live="polite"></p>
    <div class="acoes acoes--etapas">
      <button type="button" class="botao botao--leve" data-etapa-voltar>Voltar</button>
      {!publicada && <button type="submit" class="botao botao--leve acoes__rascunho" name="situacao" value="rascunho" data-salvar="rascunho">Salvar rascunho</button>}
      <button type="button" class="botao" data-etapa-continuar>Continuar</button>
      {
        publicada ? (
          <button type="submit" class="botao" name="situacao" value="publicada" data-salvar="publicada">Salvar alterações</button>
        ) : (
          <button type="submit" class="botao" name="situacao" value="publicada" data-salvar="publicada" data-so-no-fim>Publicar memória</button>
        )
      }
    </div>
    {memoria && !publicada && <p class="memoria__rodape"><a href={`/memorias/${memoria.id}/excluir`}>Descartar este rascunho</a></p>}
  </form>

  <div class="confirmacao" data-confirmacao hidden>
    <h2>Memória guardada</h2>
    <p>Ela já está na linha do tempo.</p>
    <p>
      <a class="botao" data-confirmacao-link href="/">Ver a memória</a>
      <a class="botao botao--leve" href="/nova">Registrar outra memória</a>
    </p>
  </div>
</Base>

<script>
  import { ligarCamposDeAno, montarEtapas } from '../lib/cliente/etapas';
  import { ligarDatas } from '../lib/cliente/datas';
  import { prepararFoto } from '../lib/cliente/fotos';

  const form = document.querySelector<HTMLFormElement>('[data-formulario-memoria]');
  if (form) {
    const situacaoEl = form.querySelector<HTMLElement>('[data-situacao]')!;
    const listaFotos = form.querySelector<HTMLUListElement>('[data-fotos]')!;
    const novasPessoas = form.querySelector<HTMLElement>('[data-novas-pessoas]')!;
    const relatoPor = form.querySelector<HTMLSelectElement>('[data-relato-por]');
    const botoes = [...form.querySelectorAll<HTMLButtonElement>('[data-salvar]')];
    const idExistente = form.dataset.id || undefined;
    const RASCUNHO_LOCAL = 'rascunho-nova-memoria';
    let proximaFoto = 0;

    // Etapas: uma parte do formulário por vez, com resumo na última
    const MESES = ['janeiro', 'fevereiro', 'março', 'abril', 'maio', 'junho', 'julho', 'agosto', 'setembro', 'outubro', 'novembro', 'dezembro'];
    const montarResumo = () => {
      const caixa = form.querySelector<HTMLElement>('[data-resumo]');
      const lista = form.querySelector<HTMLElement>('[data-resumo-lista]');
      if (!caixa || !lista) return;
      const d = new FormData(form);
      const tipo = form.querySelector<HTMLInputElement>('input[name="tipo"]:checked');
      const rotuloDoTipo = tipo?.value === 'outro' && String(d.get('tipoOutro') ?? '').trim() ? String(d.get('tipoOutro')).trim() : (tipo?.nextElementSibling?.textContent ?? '');
      let quando = String(d.get('ano') ?? '');
      if (d.get('mes')) quando = `${MESES[Number(d.get('mes')) - 1]} de ${quando}`;
      if (d.get('mes') && d.get('dia')) quando = `${d.get('dia')} de ${quando}`;
      if (d.get('aproximada') === 'on') quando = `por volta de ${quando}`;
      const pessoas = [
        ...[...form.querySelectorAll<HTMLInputElement>('input[name="pessoas"]:checked')].map((c) => c.nextElementSibling?.textContent ?? ''),
        ...[...form.querySelectorAll<HTMLInputElement>('[data-nova-pessoa] [data-nome]')].map((c) => c.value.trim()).filter(Boolean),
      ];
      const fotos = form.querySelectorAll('.foto-enviada').length;
      const nucleos = [...form.querySelectorAll<HTMLInputElement>('input[name="nucleos"]:checked')].map((c) => c.nextElementSibling?.textContent ?? '');
      const linhas: [string, string][] = [
        ['O quê', `${String(d.get('titulo') ?? '').trim() || 'sem título'} (${rotuloDoTipo.trim()})`],
        ['Quando', quando],
        ['Quem', pessoas.join(', ') || 'ninguém marcado'],
        ['Onde', String(d.get('lugar') ?? '').trim() || 'não informado'],
        ['Capítulo', [...form.querySelectorAll<HTMLInputElement>('input[name="capitulos"]:checked')].map((c) => c.nextElementSibling?.textContent ?? '').join(', ') || 'nenhum'],
        ['Fotos', fotos === 0 ? 'nenhuma' : fotos === 1 ? '1 foto' : `${fotos} fotos`],
      ];
      if (form.querySelector('[name="relato"]')) linhas.push(['Relato', String(d.get('relato') ?? '').trim() ? 'escrito' : 'em branco, dá para escrever depois']);
      linhas.push(['Quem vê', d.get('visibilidade') === 'nucleos' ? `só ${nucleos.join(' e ') || 'os núcleos marcados'}` : 'toda a família']);
      lista.replaceChildren(
        ...linhas.flatMap(([termo, valor]) => {
          const dt = document.createElement('dt');
          dt.textContent = termo;
          const dd = document.createElement('dd');
          dd.textContent = valor;
          return [dt, dd];
        }),
      );
      caixa.hidden = false;
    };
    const etapas = montarEtapas(form, (_indice, secao) => {
      if (secao.querySelector('[data-resumo]')) montarResumo();
    });
    form.addEventListener('change', () => {
      if (!form.querySelector<HTMLElement>('[data-resumo]')?.closest<HTMLElement>('[data-etapa]')?.hidden) montarResumo();
    });
    ligarCamposDeAno(form);
    ligarDatas(form, [{ ano: 'ano', mes: 'mes', dia: 'dia' }]);
    // Calendário e "Foi hoje" preenchem dia, mês e ano de uma vez
    const calendario = form.querySelector<HTMLInputElement>('[data-calendario]');
    const preencherData = (ano: number, mes: number, dia: number) => {
      (form.elements.namedItem('ano') as HTMLInputElement).value = String(ano);
      (form.elements.namedItem('mes') as HTMLSelectElement).value = String(mes);
      (form.elements.namedItem('dia') as HTMLInputElement).value = String(dia);
      (form.elements.namedItem('aproximada') as HTMLInputElement).checked = false;
      form.elements.namedItem('dia')!.dispatchEvent(new Event('input'));
    };
    calendario?.addEventListener('change', () => {
      const partes = /^(\d{4})-(\d{2})-(\d{2})$/.exec(calendario.value);
      if (partes) preencherData(Number(partes[1]), Number(partes[2]), Number(partes[3]));
    });
    form.querySelector('[data-hoje]')?.addEventListener('click', () => {
      const hoje = new Date();
      preencherData(hoje.getFullYear(), hoje.getMonth() + 1, hoje.getDate());
      if (calendario) calendario.value = '';
    });
    // Com muita gente na lista, um campo filtra pelo nome
    const filtro = form.querySelector<HTMLInputElement>('[data-filtrar-pessoas]');
    filtro?.addEventListener('input', () => {
      // Sem acento e sem maiúscula dos dois lados: "vo" acha "Vó Bela"
      const simples = (texto: string) => texto.normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase();
      const termo = simples(filtro.value.trim());
      for (const opcao of form.querySelectorAll<HTMLElement>('[data-lista-de-pessoas] .opcao')) {
        const marcada = opcao.querySelector<HTMLInputElement>('input')?.checked;
        opcao.hidden = Boolean(termo) && !marcada && !simples(opcao.dataset.nome ?? '').includes(termo);
      }
    });

    // "Outro" abre um campo para dizer o que foi
    const campoOutro = form.querySelector<HTMLElement>('[data-tipo-outro]');
    for (const radio of form.querySelectorAll<HTMLInputElement>('input[name="tipo"]')) {
      radio.addEventListener('change', () => {
        if (campoOutro) campoOutro.hidden = radio.value !== 'outro';
      });
    }

    const avisar = (texto: string, tipo: 'normal' | 'erro' = 'normal') => {
      situacaoEl.textContent = texto;
      situacaoEl.dataset.tipo = tipo;
    };

    // Numa memória nova, o texto digitado fica guardado no aparelho até ser salvo no site
    const camposDeTexto = ['titulo', 'lugar', 'relato'] as const;
    const campo = (nome: string) => form.elements.namedItem(nome) as HTMLInputElement | HTMLTextAreaElement | null;
    if (!idExistente) {
      try {
        const salvo = JSON.parse(localStorage.getItem(RASCUNHO_LOCAL) ?? '{}');
        for (const nome of camposDeTexto) {
          const c = campo(nome);
          if (c && typeof salvo[nome] === 'string' && !c.value) c.value = salvo[nome];
        }
      } catch {
        // sem rascunho local, segue vazio
      }
    }
    form.addEventListener('input', () => {
      if (situacaoEl.dataset.tipo === 'erro') avisar('');
      if (idExistente) return;
      try {
        const dados: Record<string, string> = {};
        for (const nome of camposDeTexto) dados[nome] = campo(nome)?.value ?? '';
        localStorage.setItem(RASCUNHO_LOCAL, JSON.stringify(dados));
      } catch {
        // navegador sem armazenamento: o formulário funciona do mesmo jeito
      }
    });

    // Pessoas que ainda não estão no acervo
    const atualizarQuemConta = () => {
      if (!relatoPor) return;
      for (const opcao of [...relatoPor.querySelectorAll('option[data-nova]')]) opcao.remove();
      novasPessoas.querySelectorAll<HTMLElement>('[data-nova-pessoa]').forEach((linha, i) => {
        const nome = linha.querySelector<HTMLInputElement>('[data-nome]')!.value.trim();
        if (!nome) return;
        const opcao = new Option(`${nome}, e eu estou escrevendo`, `nova:${i}`);
        opcao.dataset.nova = '';
        relatoPor.add(opcao);
      });
    };

    form.querySelector('[data-adicionar-pessoa]')!.addEventListener('click', () => {
      const linha = document.createElement('div');
      linha.className = 'nova-pessoa';
      linha.dataset.novaPessoa = '';
      linha.innerHTML = `
        <label class="campo"><span>Nome</span><input type="text" data-nome maxlength="80" placeholder="Ex.: Tia Lúcia" /></label>
        <button type="button" class="botao botao--leve" data-remover-pessoa>Remover</button>`;
      linha.querySelector('[data-remover-pessoa]')!.addEventListener('click', () => {
        linha.remove();
        atualizarQuemConta();
      });
      linha.querySelector('[data-nome]')!.addEventListener('input', atualizarQuemConta);
      novasPessoas.append(linha);
      linha.querySelector<HTMLInputElement>('[data-nome]')!.focus();
    });

    // Remover vale para fotos que já estavam e para as recém-enviadas
    listaFotos.addEventListener('click', (evento) => {
      const alvo = (evento.target as HTMLElement).closest('[data-remover]');
      alvo?.closest('.foto-enviada')?.remove();
    });

    // Fotos: reduz no aparelho e envia uma a uma
    form.querySelector<HTMLInputElement>('[data-escolher-fotos]')!.addEventListener('change', async (evento) => {
      const entrada = evento.target as HTMLInputElement;
      const arquivos = [...(entrada.files ?? [])];
      entrada.value = '';
      for (const arquivo of arquivos) {
        const marca = `nova-${proximaFoto++}`;
        const item = document.createElement('li');
        item.className = 'foto-enviada';
        item.dataset.estado = 'enviando';
        item.innerHTML = `
          <div class="foto__papel"><div class="foto__reserva">Enviando…</div></div>
          <div class="foto-enviada__campos">
            <label class="campo"><span>Legenda</span><input type="text" data-legenda maxlength="200" /></label>
            <label class="marcar"><input type="radio" name="fotoPrincipal" value="${marca}" /><span>Usar na linha do tempo</span></label>
            <button type="button" class="botao botao--leve" data-remover>Remover foto</button>
          </div>`;
        listaFotos.append(item);
        if (!form.querySelector('input[name="fotoPrincipal"]:checked')) {
          item.querySelector<HTMLInputElement>('input[type="radio"]')!.checked = true;
        }
        try {
          const pronta = await prepararFoto(arquivo);
          const corpo = new FormData();
          corpo.set('foto', pronta, 'foto');
          const resposta = await fetch('/api/fotos', { method: 'POST', body: corpo });
          const dados = await resposta.json();
          if (!resposta.ok) throw new Error(dados.erro ?? 'Falha no envio');
          item.dataset.fotoId = String(dados.id);
          item.dataset.estado = 'pronta';
          const imagem = new Image();
          imagem.alt = '';
          imagem.src = URL.createObjectURL(pronta);
          item.querySelector('.foto__reserva')!.replaceWith(imagem);
        } catch (e) {
          item.dataset.estado = 'erro';
          item.querySelector('.foto__reserva')!.textContent = `Não foi possível enviar. ${e instanceof Error ? e.message : ''}`;
        }
      }
    });

    form.addEventListener('submit', async (evento) => {
      evento.preventDefault();
      const situacao = (evento.submitter as HTMLElement | null)?.dataset.salvar === 'rascunho' ? 'rascunho' : 'publicada';
      const dados = new FormData(form);
      const titulo = String(dados.get('titulo') ?? '').trim();
      const ano = Number(dados.get('ano'));
      if (!titulo) {
        etapas?.ir(0);
        return avisar('Dê um título para a memória.', 'erro');
      }
      if (!dados.get('ano') || !Number.isInteger(ano)) {
        etapas?.ir(0);
        return avisar('Informe o ano, mesmo que seja aproximado.', 'erro');
      }

      const itens = [...listaFotos.querySelectorAll<HTMLElement>('.foto-enviada')];
      if (itens.some((i) => i.dataset.estado === 'enviando')) return avisar('Espere as fotos terminarem de enviar.', 'erro');
      if (itens.some((i) => i.dataset.estado === 'erro')) return avisar('Uma foto não foi enviada. Remova ou escolha de novo.', 'erro');

      const novas = [...novasPessoas.querySelectorAll<HTMLElement>('[data-nova-pessoa]')].map((linha) => ({
        nome: linha.querySelector<HTMLInputElement>('[data-nome]')!.value.trim(),
      }));
      if (novas.some((n) => !n.nome)) return avisar('Escreva o nome da pessoa que você adicionou, ou remova a linha.', 'erro');

      const relato = String(dados.get('relato') ?? '');
      const pedido = {
        id: idExistente,
        titulo,
        ano,
        mes: dados.get('mes') ? Number(dados.get('mes')) : undefined,
        dia: dados.get('dia') ? Number(dados.get('dia')) : undefined,
        aproximada: dados.get('aproximada') === 'on',
        tipo: dados.get('tipo'),
        tipoOutro: dados.get('tipo') === 'outro' ? String(dados.get('tipoOutro') ?? '').trim() || undefined : undefined,
        pessoas: [...dados.getAll('pessoas').map(String), ...novas.map((_, i) => `nova:${i}`)],
        novasPessoas: novas,
        lugar: String(dados.get('lugar') ?? '').trim() || undefined,
        capitulos: dados.getAll('capitulos').map(String),
        temas: String(dados.get('temas') ?? ''),
        nucleos: dados.getAll('nucleos').map(String),
        visibilidade: dados.get('visibilidade') ?? 'todos',
        situacao,
        fotos: itens.map((item) => ({
          id: Number(item.dataset.fotoId),
          legenda: item.querySelector<HTMLInputElement>('[data-legenda]')?.value.trim() || undefined,
          principal: item.querySelector<HTMLInputElement>('input[type="radio"]')?.checked ?? false,
        })),
        relato: relatoPor && relato.trim() ? { por: relatoPor.value, texto: relato } : undefined,
      };

      for (const b of botoes) b.disabled = true;
      avisar(situacao === 'rascunho' ? 'Salvando rascunho…' : 'Guardando…');
      try {
        const resposta = await fetch('/api/memorias', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(pedido),
        });
        const resultado = await resposta.json();
        if (!resposta.ok) throw new Error(resultado.erro ?? 'Não consegui salvar.');
        try {
          localStorage.removeItem(RASCUNHO_LOCAL);
        } catch {
          // sem armazenamento, nada a limpar
        }
        if (resultado.situacao === 'rascunho') {
          // Recarrega já ligada ao rascunho salvo no site, com as pessoas novas na lista
          sessionStorage.setItem('rascunho-salvo', '1');
          return location.replace(resultado.url);
        }
        form.hidden = true;
        const confirmacao = document.querySelector<HTMLElement>('[data-confirmacao]')!;
        confirmacao.querySelector<HTMLAnchorElement>('[data-confirmacao-link]')!.href = resultado.url;
        confirmacao.hidden = false;
        const tituloEl = confirmacao.querySelector<HTMLElement>('h2')!;
        tituloEl.setAttribute('tabindex', '-1');
        tituloEl.focus();
      } catch (e) {
        avisar(e instanceof Error ? e.message : 'Não consegui salvar.', 'erro');
        for (const b of botoes) b.disabled = false;
      }
    });

    try {
      if (sessionStorage.getItem('rascunho-salvo')) {
        sessionStorage.removeItem('rascunho-salvo');
        avisar('Rascunho salvo. Só você vê, e dá para continuar de qualquer aparelho.');
      }
    } catch {
      // sem armazenamento, só não mostra o aviso
    }
  }
</script>
