---
import { comArtigo } from '../lib/servidor/conteudo';
import Pagina from '../components/formularios/Pagina.astro';
import CampoData from '../components/CampoData.astro';
import QuemEstava from '../components/QuemEstava.astro';
import Dado from '../components/visual/Dado.astro';
import Ficha from '../components/visual/Ficha.astro';
import Polaroid from '../components/visual/Polaroid.astro';
import { Familia } from '../lib/parentesco';
import { TIPO_OUTRO } from '../lib/tipos';
import { estiloDoTipo, legendaLugarAno } from '../lib/visual';
import { pessoasComAcesso } from '../lib/servidor/acesso';
import { alcanceDaCorrecao, podeEditarMemoria, podeExcluirMemoria, podeRemoverFoto } from '../lib/servidor/permissoes';
import ZonaDePerigo from '../components/visual/ZonaDePerigo.astro';
import { familiasDe, listarAudiosDosRelatos, listarCapitulos, listarCasais, listarMemorias, listarFiliacoes, listarIntegrantes, listarIntegrantesQueVe, listarNucleos, listarRelatos, listarTemasVisiveis, obterMemoria } from '../lib/servidor/repositorio';

// Esta página serve para três coisas: registrar uma memória nova, continuar
// um rascunho e corrigir uma memória já publicada (?id=...).
const { usuario } = Astro.locals;
const id = Astro.url.searchParams.get('id');
const memoria = id ? await obterMemoria(usuario, id) : undefined;
if (id && !memoria) return new Response('Memória não encontrada', { status: 404 });
if (memoria && !podeEditarMemoria(usuario, memoria).ok) return Astro.redirect(`/memorias/${memoria.id}`);

const publicada = memoria?.situacao === 'publicada';
const podeExcluir = Boolean(memoria) && podeExcluirMemoria(usuario, memoria!).ok;
// Quem só existe num laço privado de outra pessoa não é oferecido nem aparece marcado (C1, 17/11/2026).
// A API mantém essa marca numa edição, e quem criou continua achado na lista inteira.
const todosOsIntegrantes = await listarIntegrantes();
const integrantes = await listarIntegrantesQueVe(usuario);
// Só quem criou muda quem pode ver. Para quem é citado, as opções ficam travadas com o valor atual.
const travaQuemVe = Boolean(memoria) && memoria!.criadaPor !== usuario.pessoa;
// O administrador que não criou a memória nem está nela corrige só os dados: o título, as famílias, as
// fotos e as legendas ficam como estão, e ele só pode tirar fotos ("Administradores podem mais", 16/11/2026)
const soDados = Boolean(memoria) && alcanceDaCorrecao(usuario, memoria!) === 'dados';
const travaNucleos = travaQuemVe && (memoria!.visibilidade === 'nucleos' || soDados);
const criadora = travaQuemVe ? todosOsIntegrantes.find((i) => i.id === memoria!.criadaPor) : undefined;
const quemCriou = criadora ? comArtigo(criadora) : 'quem criou';
const comAcesso = await pessoasComAcesso();
const semAcesso = integrantes.filter((i) => i.tipo === 'pessoa' && !comAcesso.has(i.id));
const nucleos = await listarNucleos();
// "Quem estava?": a lista inteira agrupada pela família de cada um, e quem está perto de quem pelos laços
const arvore = new Familia(await listarFiliacoes(), await listarCasais(usuario));
const porNome = [...integrantes].sort((a, b) => (a.apelido ?? a.nome).localeCompare(b.apelido ?? b.nome, 'pt-BR'));
const gruposDePessoas = [
  ...nucleos.map((n) => ({ nome: n.nome, ids: porNome.filter((i) => familiasDe(i)[0] === n.id).map((i) => i.id) })),
  { nome: 'De fora das famílias', ids: porNome.filter((i) => !familiasDe(i).some((f) => nucleos.some((n) => n.id === f))).map((i) => i.id) },
];
const proximos = Object.fromEntries(
  integrantes.map((i) => [
    i.id,
    [...new Set([...arvore.casais(i.id).map((c) => c.outro), ...arvore.pais(i.id).map((p) => p.responsavel), ...arvore.filhos(i.id).map((f) => f.filho), ...arvore.irmaos(i.id).map((x) => x.id)])],
  ]),
);
// Os núcleos de cada pessoa, para sugerir os núcleos da memória a partir de quem estava
const familiasPorPessoa = Object.fromEntries(integrantes.map((i) => [i.id, familiasDe(i)]));
// A pessoa marca os próprios núcleos. Numa edição, os que já estavam aparecem também.
const nucleosDisponiveis = nucleos.filter((n) => usuario.nucleos.includes(n.id) || memoria?.nucleos.includes(n.id));
const nucleosMarcados = memoria?.nucleos ?? (usuario.nucleos.length === 1 ? usuario.nucleos : []);
// O relato só entra aqui enquanto a memória não foi publicada. Depois, cada um edita o seu na própria página.
// Pode ser o relato da própria pessoa ou o de alguém que não acessa o site, registrado por ela.
const doRascunho = memoria && !publicada ? (await listarRelatos(usuario, memoria.id)).filter((r) => r.registradoPor === usuario.pessoa) : [];
const meuRelato = doRascunho.find((r) => r.por === usuario.pessoa) ?? doRascunho[0];
// Os áudios do relato do rascunho, para continuar de onde parou
const audiosDoRascunho = meuRelato
  ? ((await listarAudiosDosRelatos([meuRelato.id])).get(meuRelato.id) ?? []).map((a) => ({ id: a.id, src: `/audios/${a.chave}`, duracao: a.duracao, transcricao: a.transcricao }))
  : [];
const capitulosReunidos = (await listarCapitulos(usuario)).filter((c) => c.modo === 'reunido');
// Tipos de momento: com mais de oito, ficam à vista os seis mais usados nas memórias que a pessoa vê
// (na ordem da lista dos admins), e o resto em "Ver mais tipos". Com poucos, todos à vista.
const LIMITE_DE_TIPOS = 8;
const A_VISTA = 6;
const usoDosTipos = new Map<string, number>();
for (const m of await listarMemorias(usuario)) usoDosTipos.set(m.tipo, (usoDosTipos.get(m.tipo) ?? 0) + 1);
const todosOsTipos = Astro.locals.tipos;
const maisUsados = new Set(
  todosOsTipos.length <= LIMITE_DE_TIPOS
    ? todosOsTipos.map((t) => t.id)
    : [...todosOsTipos].sort((a, b) => (usoDosTipos.get(b.id) ?? 0) - (usoDosTipos.get(a.id) ?? 0)).slice(0, A_VISTA).map((t) => t.id),
);
const tiposAVista = todosOsTipos.filter((t) => maisUsados.has(t.id));
const tiposRecolhidos = todosOsTipos.filter((t) => !maisUsados.has(t.id));
const todosOsTemas = await listarTemasVisiveis(usuario);
const temasDaMemoria = (memoria?.temas ?? []).map((id) => todosOsTemas.find((t) => t.id === id)?.nome).filter(Boolean).join(', ');
// "Hoje" no horário de Brasília, para o limite do calendário
const hojeIso = new Intl.DateTimeFormat('en-CA', { timeZone: 'America/Sao_Paulo' }).format(new Date());
// Atalhos de outras páginas: "Nova memória com Fulano" (?com=) e "Nova memória neste capítulo" (?capitulo=)
const comPessoa = !memoria ? integrantes.find((i) => i.id === Astro.url.searchParams.get('com'))?.id : undefined;
const noCapitulo = !memoria ? capitulosReunidos.find((c) => c.id === Astro.url.searchParams.get('capitulo'))?.id : undefined;
// A foto-chave, para o resumo ao lado do formulário (só no computador)
const fotoChave = memoria?.fotos.find((f) => f.principal) ?? memoria?.fotos[0];
const ONDE_HA_LADO = '(min-width: 62rem)';
const titulo = !memoria ? 'Nova memória' : publicada ? 'Corrigir memória' : 'Continuar rascunho';
---

{/* Aprovado pelo Gui em 17/11/2026 (pergunta 6 do PR do grupo "formularios"): a linha pequena acima do título */}
<Pagina titulo={titulo} rotulo={publicada ? 'Memória publicada' : memoria ? 'Rascunho' : undefined} nucleos={memoria?.nucleos} secao="nova">
  <p slot="abertura">
    {
      soDados
        ? 'Como administrador, você corrige os dados desta memória: data, lugar, tipo de momento, quem estava, capítulos e temas. O título, as fotos e quem pode ver ficam com quem criou e com quem estava nela.'
        : publicada
        ? 'Ajuste a ficha, as fotos ou quem pode ver. Os relatos não mudam por aqui: cada pessoa cuida do seu.'
        : `Olá, ${usuario.nome}. Conte o que aconteceu, do seu jeito. Só o título e o ano são obrigatórios, e dá para salvar como rascunho a qualquer momento.`
    }
  </p>
  {/* A frase com lacunas também na abertura (resposta do Gui à pergunta 1 do PR do grupo "formularios",
      17/11/2026): "Isso aconteceu em ___, em ___, com ___." Ela mostra o que já foi preenchido, e cada
      lacuna leva à etapa certa: a data e o lugar, a "Quando e onde"; as pessoas, a "Quem estava?".
      Só existe com script, que a preenche e a mostra: sem ele, as etapas já aparecem todas em sequência.
      Respostas do Gui ao QA de design de 17/11/2026: as lacunas vazias perguntam (P128), a frase sai
      na etapa "Quando e onde" (P140) e, no celular, ela desce para baixo da pergunta, para a pergunta
      da etapa ficar no alto da tela (P126; o script a muda de lugar). */}
  <p slot="frase" class="frase frase--abertura" data-frase-abertura hidden>
    Isso aconteceu{' '}
    <span class="frase__data" role="button" tabindex="0" data-abertura="data">em que data?</span><span data-abertura-liga>, </span>
    <span class="frase__data" role="button" tabindex="0" data-abertura="lugar">em que lugar?</span><span data-abertura-liga>, </span>
    <span class="frase__data" role="button" tabindex="0" data-abertura="pessoas">com quem?</span><span data-abertura-liga>.</span>
  </p>

  <form class="formulario" method="post" action="/api/memorias" data-formulario-memoria data-id={memoria?.id ?? ''} data-publicada={publicada ? '' : undefined} novalidate>
    {memoria && <input type="hidden" name="id" value={memoria.id} />}
    {/* Uma pergunta principal por etapa, e as opcionais depois das que contam a memória (QA de UX, 16/11/2026) */}
    <section data-etapa="O que aconteceu">
    <fieldset>
      <legend>O que aconteceu?</legend>
      <label class="campo">
        <span>Título</span>
        <input type="text" name="titulo" required maxlength="120" autocomplete="off" value={memoria?.titulo ?? ''} placeholder="Ex.: Casamento da Giovanna" readonly={soDados} aria-describedby={soDados ? 'titulo-so-dados' : undefined} />
      </label>
      {soDados && <p class="dica" id="titulo-so-dados">O título fica com quem criou e com quem estava na memória.</p>}
      <div class="campo">
        <span id="rotulo-tipo">Que tipo de momento foi?</span>
        {/* Começa sem marcação: marcado por padrão, um aniversário passava como dia a dia (decisão do Gui, 16/11/2026) */}
        {/* Com muitos tipos, os mais usados ficam à vista e o resto em "Ver mais tipos" (QA de UX, 16/11/2026) */}
        <div role="radiogroup" aria-labelledby="rotulo-tipo" class="tipos-de-momento">
          <div class="opcoes">
            {
              tiposAVista.map((tipo) => (
                <label class="opcao" style={estiloDoTipo(tipo.id)}>
                  <input type="radio" name="tipo" value={tipo.id} checked={tipo.id === memoria?.tipo} required />
                  <span class="tipo">{tipo.rotulo}</span>
                </label>
              ))
            }
          </div>
          {
            tiposRecolhidos.length > 0 && (
              <details class="mais-opcoes" open={tiposRecolhidos.some((t) => t.id === memoria?.tipo)}>
                <summary>Ver mais tipos ({tiposRecolhidos.length})</summary>
                <div class="opcoes">
                  {tiposRecolhidos.map((tipo) => (
                    <label class="opcao" style={estiloDoTipo(tipo.id)}>
                      <input type="radio" name="tipo" value={tipo.id} checked={tipo.id === memoria?.tipo} required />
                      <span class="tipo">{tipo.rotulo}</span>
                    </label>
                  ))}
                </div>
              </details>
            )
          }
        </div>
      </div>
      <label class="campo" data-tipo-outro hidden={memoria?.tipo !== TIPO_OUTRO}>
        <span>O que foi? <small>(opcional)</small></span>
        <input type="text" name="tipoOutro" maxlength="40" autocomplete="off" value={memoria?.tipoOutro ?? ''} placeholder="Ex.: Formatura" />
        <span class="dica">Uma ou duas palavras. Se outras memórias usarem o mesmo nome, ele pode virar um tipo da lista.</span>
      </label>
    </fieldset>
    </section>

    <section data-etapa="Quando e onde">
    {/* O formulário em frase (docs/visual.md, "A data no formulário em frase"): a lacuna da data mostra
        a data como o site escreve e, ao toque, abre logo abaixo o controle de data flexível. A do
        lugar é texto livre. Sem script, a lacuna da data não aparece e o controle fica aberto.
        O texto da frase e o da lacuna vazia ("em que data?") ficaram, e a frase entrou também na
        abertura (resposta do Gui à pergunta 1 do PR do grupo "formularios", 17/11/2026).
        Nesta etapa a frase é a própria pergunta: a legenda fica só para o leitor de tela, para não
        haver dois títulos grandes na mesma tela (resposta do Gui à P133 do QA de design, 17/11/2026). */}
    <fieldset>
      <legend class="so-leitor">Quando e onde foi?</legend>
      <p class="frase" data-frase>
        Isso aconteceu{' '}
        {/* A lacuna da data é um trecho da frase que se comporta como botão: um <button> não quebra de
            linha no meio, e a data longa ("por volta de 24 de setembro de 2025") precisa quebrar no celular */}
        <span class="frase__data" role="button" tabindex="0" data-frase-data aria-expanded="true" aria-controls="controle-da-data" hidden>em que data?</span><span data-frase-sem-script>na data abaixo</span>,{' '}
        {/* "em", o lugar e o ponto final andam juntos: o ponto não fica sozinho na linha de baixo. Com
            script, a lacuna tem a largura do que foi escrito (resposta do Gui à P144, 17/11/2026). */}
        <span class="frase__junto">
          em{' '}
          <label class="frase__lacuna" style="--cabe: 14">
            <span class="so-leitor">Lugar, se quiser</span>
            <input type="text" name="lugar" maxlength="120" value={memoria?.lugar ?? ''} placeholder="algum lugar" data-frase-lugar />
          </label>.
        </span>
      </p>
      <div id="controle-da-data" data-controle-da-data>
        <CampoData ano={memoria?.ano || undefined} mes={memoria?.mes} dia={memoria?.dia} obrigatorio />
        <div class="atalhos">
          <label class="campo">
            <span>Ou escolha no calendário</span>
            <input type="date" data-calendario min="1800-01-01" max={hojeIso} />
          </label>
          <button type="button" class="botao botao--leve" data-hoje>Foi hoje</button>
        </div>
        <label class="marcar">
          <input type="checkbox" name="aproximada" checked={memoria?.aproximada} />
          <span>Não tenho certeza da data</span>
        </label>
      </div>
      <p class="dica">O lugar é opcional. Ex.: Belo Horizonte.</p>
    </fieldset>
    </section>

    <section data-etapa="Quem estava" data-opcional>
      <QuemEstava integrantes={integrantes} marcados={memoria?.integrantes.filter((p) => integrantes.some((i) => i.id === p)) ?? (comPessoa ? [comPessoa] : [])} grupos={gruposDePessoas} proximos={proximos} eu={usuario.pessoa} />
    </section>

    <section data-etapa="Fotos" data-opcional>
    <fieldset>
      {/* A legenda em pergunta, como as outras etapas (resposta do Gui à P141 do QA de design, 17/11/2026) */}
      <legend>Tem fotos desse dia?</legend>
      {
        soDados ? (
          <p class="dica">As fotos e as legendas ficam com quem criou e com quem estava na memória. Como administrador, você pode tirar uma foto: ela vai para a lixeira, com o seu nome. Para acrescentar fotos, escreva o seu relato.</p>
        ) : (
          <p class="dica">Escolha as fotos desse momento. Você pode escrever uma legenda para cada uma.</p>
        )
      }
      <label class="botao botao--leve botao--arquivo" hidden={soDados}>
        Escolher fotos
        <input type="file" accept="image/*" multiple data-escolher-fotos class="oculto-visualmente" disabled={soDados} />
      </label>
      <ul class="fotos-enviadas" data-fotos>
        {
          (memoria?.fotos ?? []).map((foto) => (
            <li class="foto-enviada" data-foto-id={foto.id}>
              <div class="foto__papel">{foto.chave ? <img src={`/fotos/${foto.chave}`} alt="" /> : <div class="foto__reserva">Foto de exemplo</div>}</div>
              <div class="foto-enviada__campos">
                <label class="campo">
                  <span>Legenda</span>
                  <input type="text" data-legenda maxlength="200" value={foto.legenda ?? ''} readonly={soDados} />
                </label>
                <label class="marcar">
                  <input type="radio" name="fotoPrincipal" value={foto.id} checked={foto.principal} disabled={soDados} />
                  <span>Usar na linha do tempo</span>
                </label>
                {podeRemoverFoto(usuario, foto.enviadaPor).ok ? (
                  <button type="button" class="botao botao--leve" data-remover>
                    Remover foto
                  </button>
                ) : (
                  <p class="dica">Só quem enviou e os administradores podem remover.</p>
                )}
              </div>
            </li>
          ))
        }
      </ul>
    </fieldset>
    </section>

    {
      !publicada && (
        <section data-etapa="Relato" data-opcional>
        <fieldset>
            <legend>Como foi?</legend>
            {/* Áudios já na memória nova: ficam soltos até a memória ser salva (ver api/audios.ts) */}
            <div class="campo audios" data-audios hidden>
              <span>Prefere falar? <small>(opcional)</small></span>
              <p class="dica">Grave contando como foi, ou envie um áudio que já está no celular, como os do WhatsApp.</p>
              <ol class="audios__lista" data-lista-audios></ol>
              <p class="acoes">
                <button type="button" class="botao botao--leve" data-gravar>Gravar áudio</button>
                <label class="botao botao--leve botao--arquivo">
                  Enviar arquivo de áudio
                  <input type="file" accept="audio/*,.opus,.ogg,.m4a,.mp3,.wav,.webm" multiple data-enviar-audio class="oculto-visualmente" />
                </label>
              </p>
              <p class="situacao" data-situacao-audio role="status" aria-live="polite"></p>
              <script type="application/json" data-audios-do-rascunho set:html={JSON.stringify(audiosDoRascunho).replace(/</g, '\\u003c')} />
            </div>
            <label class="campo">
              <span>O relato escrito</span>
              <textarea name="relato" rows="8" maxlength="20000" placeholder="Escreva como você lembra. Outras pessoas da família vão poder contar a versão delas depois.">{meuRelato?.texto ?? ''}</textarea>
            </label>
            <p class="dica">Só você vai poder alterar este relato.</p>
            {/* Quase sempre quem conta é quem escreve: "Quem está contando" deixou de ser o primeiro
                campo e fica numa linha recolhida, depois do texto, que abre a busca (resposta do Gui à
                P137 do QA de design, 17/11/2026). Fechar a linha volta para "Eu". */}
            <details class="mais-opcoes" data-outra-pessoa open={Boolean(meuRelato) && meuRelato!.por !== usuario.pessoa}>
              <summary>Estou escrevendo por outra pessoa</summary>
              <label class="campo">
                <span>Quem está contando</span>
                <select name="relatoPor" data-relato-por>
                  <option value={usuario.pessoa}>Eu, {usuario.nome}</option>
                  {semAcesso.map((p) => <option value={p.id} selected={meuRelato?.por === p.id}>{p.nome}, e eu estou escrevendo</option>)}
                </select>
              </label>
            </details>
          </fieldset>
        </section>
      )
    }

    <section data-etapa="Capítulo e temas" data-opcional>
      <fieldset>
        <legend>Faz parte de algo maior?</legend>
        <p class="dica">Opcional. Um capítulo junta memórias de um mesmo momento, como as várias festas de um casamento.</p>
        {
          capitulosReunidos.length > 0 && (
            <div class="campo">
              <span id="rotulo-capitulos">Capítulos</span>
              <div class="opcoes" role="group" aria-labelledby="rotulo-capitulos">
                {capitulosReunidos.map((c) => (
                  <label class="opcao">
                    <input type="checkbox" name="capitulos" value={c.id} checked={memoria ? memoria.capitulos.includes(c.id) : c.id === noCapitulo} />
                    <span>{c.titulo}</span>
                  </label>
                ))}
              </div>
            </div>
          )
        }
        {/* Sem o link que abria outra aba no meio da memória (resposta do Gui à P142 do QA de design, 17/11/2026) */}
        <p class="dica">
          {capitulosReunidos.length === 0 ? 'Ainda não há capítulos. ' : 'Não achou? '}
          Dá para criar o capítulo depois e colocar esta memória nele.
        </p>
        <label class="campo">
          <span>Temas</span>
          <input type="text" name="temas" maxlength="500" autocomplete="off" list="lista-de-temas" value={temasDaMemoria} placeholder="Ex.: viagens, casas onde moramos" />
          <span class="dica">Etiquetas livres, separadas por vírgula. Cada tema tem uma página que junta tudo o que o usa.</span>
        </label>
        <datalist id="lista-de-temas">
          {todosOsTemas.map((t) => <option value={t.nome} />)}
        </datalist>
      </fieldset>
    </section>

    <section data-etapa="Quem vê">
    <fieldset>
      <legend>Quem pode ver?</legend>
      <label class="marcar">
        <input type="radio" name="visibilidade" value="todos" checked={(memoria?.visibilidade ?? 'todos') === 'todos'} disabled={travaQuemVe} />
        <span>Toda a família vê</span>
      </label>
      <label class="marcar">
        <input type="radio" name="visibilidade" value="nucleos" checked={memoria?.visibilidade === 'nucleos'} disabled={travaQuemVe} />
        <span>Só quem é das famílias marcadas abaixo</span>
      </label>
      {
        nucleosDisponiveis.length > 0 && (
          <div class="campo">
            <span id="rotulo-nucleos">De quais famílias é esta memória?</span>
            <div class="opcoes" role="group" aria-labelledby="rotulo-nucleos">
              {nucleosDisponiveis.map((n) => (
                <label class="opcao">
                  <input type="checkbox" name="nucleos" value={n.id} checked={nucleosMarcados.includes(n.id)} disabled={travaNucleos} />
                  <span>{n.nome}</span>
                </label>
              ))}
            </div>
          </div>
        )
      }
      <p class="dica" data-nucleos-sugeridos hidden>Marcamos as famílias de quem estava na memória. Confira e mude se precisar.</p>
      <script type="application/json" data-familias-pessoas set:html={JSON.stringify(familiasPorPessoa).replace(/</g, '\\u003c')} />
      {travaQuemVe && <input type="hidden" name="visibilidade" value={memoria!.visibilidade} />}
      {travaNucleos && memoria!.nucleos.map((n) => <input type="hidden" name="nucleos" value={n} />)}
      <p class="dica">{travaQuemVe ? `Só ${quemCriou}, que criou a memória, muda quem pode ver.` : 'Dá para mudar depois. Quem não pode ver não fica sabendo que a memória existe.'}</p>
    </fieldset>
      <div class="resumo" data-resumo hidden>
        <h2>{publicada ? 'Confira antes de salvar' : 'Confira antes de publicar'}</h2>
        <dl data-resumo-lista></dl>
      </div>
    </section>

    <p class="situacao" data-situacao role="status" aria-live="polite"></p>
    <div class="acoes acoes--etapas">
      <button type="button" class="botao botao--leve" data-etapa-voltar>Voltar</button>
      {!publicada && <button type="submit" class="botao botao--leve acoes__rascunho" name="situacao" value="rascunho" data-salvar="rascunho">Salvar rascunho</button>}
      {/* O botão cheio é sempre o da ponta: na correção, "Salvar alterações" em contorno vem antes de
          "Continuar" (resposta do Gui à P135 do QA de design, 17/11/2026) */}
      {publicada && <button type="submit" class="botao" name="situacao" value="publicada" data-salvar="publicada">Salvar alterações</button>}
      <button type="button" class="botao" data-etapa-continuar>Continuar</button>
      {!publicada && <button type="submit" class="botao" name="situacao" value="publicada" data-salvar="publicada" data-so-no-fim>Publicar memória</button>}
    </div>
    {/* Ao lado, no computador (resposta do Gui à pergunta 7 do PR do grupo "formularios", 17/11/2026):
        a foto-chave e um resumo da memória, que acompanham o preenchimento. Sem foto ainda, o cartão
        do tipo de momento, como a memória sem foto. Só existe a partir de 62rem e com script, que o
        preenche: a foto não é baixada no celular. É apoio para quem vê a tela: não rouba o foco nem
        anuncia cada tecla ao leitor de tela (sem aria-live), e o resumo da última etapa continua.
        Respostas do Gui ao QA de design de 17/11/2026: o que entra e os rótulos ficam (P129); sem tipo
        escolhido, o cartão é neutro, em papel e sem ícone (P129); e na última etapa ficam só a foto e
        o título, porque a ficha já está em "Confira antes de publicar" (P134). */}
    <aside class="ao-lado" data-ao-lado aria-labelledby="ao-lado-titulo" hidden>
      <h2 class="rotulo suave" id="ao-lado-titulo">A memória até aqui</h2>
      <div class="ao-lado__foto" data-ao-lado-com-foto style={estiloDoTipo(memoria?.tipo ?? 'outro')} hidden>
        <Polaroid id={memoria?.id ?? 'nova-memoria'} fotos={[{ chave: fotoChave?.chave ?? '', legenda: null }]} legenda={memoria?.ano ? legendaLugarAno(memoria.lugar, memoria.ano) : (memoria?.lugar ?? '')} alt="" monte={false} soOnde={ONDE_HA_LADO} />
      </div>
      {[...todosOsTipos.map((t) => t.id), ''].map((tipo) => (
        <div class:list={['ao-lado__foto', { 'ao-lado__foto--neutra': !tipo }]} data-ao-lado-sem-foto={tipo} style={tipo ? estiloDoTipo(tipo) : undefined} hidden>
          <Polaroid id={memoria?.id ?? 'nova-memoria'} fotos={[]} legenda="" tipo={tipo || 'outro'} monte={false} />
        </div>
      ))}
      <p class="ao-lado__nome" data-ao-lado-campo="titulo"></p>
      <div data-ao-lado-ficha>
      <Ficha>
        <Dado rotulo="Tipo"><span data-ao-lado-campo="tipo"></span></Dado>
        <Dado rotulo="Quando"><span data-ao-lado-campo="quando"></span></Dado>
        <Dado rotulo="Onde"><span data-ao-lado-campo="onde"></span></Dado>
        <Dado rotulo="Quem estava"><span data-ao-lado-campo="quem"></span></Dado>
        <Dado rotulo="Fotos"><span data-ao-lado-campo="fotos"></span></Dado>
        <Dado rotulo="Capítulo"><span data-ao-lado-campo="capitulo"></span></Dado>
        <Dado rotulo="Quem vê"><span data-ao-lado-campo="quemve"></span></Dado>
      </Ficha>
      </div>
    </aside>
  </form>

  {/* A zona de perigo (pedido do Gui, 17/11/2026): o que apaga fica junto, no fim, longe do salvar.
      Só aparece para quem pode excluir (os administradores, ou quem escreveu o rascunho), e leva à
      página de confirmação. O nome e os textos ficaram (resposta do Gui à P131 do QA de design,
      17/11/2026). Com script, só aparece na última etapa, depois do resumo (P136); sem script, as
      etapas vêm em sequência e ela fica no fim. */}
  {
    memoria && podeExcluir && (
      <div data-zona-de-perigo>
        <ZonaDePerigo>
          <p>{publicada ? 'A memória vai para a lixeira, com as fotos e os relatos, e pode ser restaurada.' : 'O rascunho vai para a lixeira e pode ser restaurado.'}</p>
          <a class="acao" href={`/memorias/${memoria.id}/excluir`}>
            {publicada ? 'Excluir esta memória' : 'Descartar este rascunho'}
          </a>
        </ZonaDePerigo>
      </div>
    )
  }

  <div class="confirmacao" data-confirmacao hidden>
    <h2>{publicada ? 'Memória atualizada' : 'Memória publicada'}</h2>
    <p>{publicada ? 'A versão anterior ficou guardada no histórico da memória.' : 'Ela já está na linha do tempo.'}</p>
    <p>
      <a class="botao" data-confirmacao-link href="/">Ver a memória</a>
      <a class="botao botao--leve" href="/nova">Registrar outra memória</a>
    </p>
  </div>
</Pagina>

<script>
  import { ligarCamposDeAno, montarEtapas } from '../lib/cliente/etapas';
  import { ligarDatas } from '../lib/cliente/datas';
  import { dataNaFrase } from '../lib/datas';
  import { legendaLugarAno, listaCurta } from '../lib/visual';
  import { prepararFoto } from '../lib/cliente/fotos';
  import { buscaDePessoa } from '../lib/cliente/busca-pessoa';
  import { ligarQuemEstava } from '../lib/cliente/quem-estava';
  import { ligarAudios } from '../lib/cliente/audios';

  const form = document.querySelector<HTMLFormElement>('[data-formulario-memoria]');
  if (form) {
    const situacaoEl = form.querySelector<HTMLElement>('[data-situacao]')!;
    const listaFotos = form.querySelector<HTMLUListElement>('[data-fotos]')!;
    const novasPessoas = form.querySelector<HTMLElement>('[data-novas-pessoas]')!;
    const relatoPor = form.querySelector<HTMLSelectElement>('[data-relato-por]');
    if (relatoPor) buscaDePessoa(relatoPor);
    // "Estou escrevendo por outra pessoa": abrir a linha põe o foco na busca, e fechar volta para "Eu"
    const outraPessoa = form.querySelector<HTMLDetailsElement>('[data-outra-pessoa]');
    if (outraPessoa && relatoPor) {
      outraPessoa.querySelector('summary')?.addEventListener('click', () =>
        setTimeout(() => {
          // O nome que está no campo fica selecionado: o que a pessoa digitar toma o lugar dele
          if (outraPessoa.open) return outraPessoa.querySelector<HTMLInputElement>('.busca__campo')?.select();
          if (relatoPor.selectedIndex === 0) return;
          relatoPor.selectedIndex = 0;
          relatoPor.dispatchEvent(new Event('change', { bubbles: true }));
        }),
      );
    }
    const botoes = [...form.querySelectorAll<HTMLButtonElement>('[data-salvar]')];
    const idExistente = form.dataset.id || undefined;
    // Áudios do relato: a memória pode ainda não existir; o áudio fica solto até ela ser salva
    const blocoDeAudios = form.querySelector<HTMLElement>('[data-audios]');
    const audios = blocoDeAudios ? ligarAudios(blocoDeAudios, idExistente ?? '', () => form.dispatchEvent(new Event('change'))) : undefined;
    audios?.carregar(JSON.parse(blocoDeAudios?.querySelector('[data-audios-do-rascunho]')?.textContent ?? '[]'));
    const RASCUNHO_LOCAL = 'rascunho-nova-memoria';
    let proximaFoto = 0;

    // Etapas: uma parte do formulário por vez, com resumo na última
    const MESES = ['janeiro', 'fevereiro', 'março', 'abril', 'maio', 'junho', 'julho', 'agosto', 'setembro', 'outubro', 'novembro', 'dezembro'];
    // O que já foi preenchido, lido do formulário: serve ao resumo da última etapa, à frase da
    // abertura e ao resumo ao lado
    // O ano só conta quando está dentro do intervalo do campo: a frase não escreve "em 1700"
    const anoInformado = (): number | undefined => {
      const entrada = form.elements.namedItem('ano') as HTMLInputElement;
      const ano = Number(entrada.value);
      return entrada.value && Number.isInteger(ano) && ano >= Number(entrada.min) && ano <= Number(entrada.max) ? ano : undefined;
    };
    const lerPreenchido = () => {
      const d = new FormData(form);
      const tipo = form.querySelector<HTMLInputElement>('input[name="tipo"]:checked');
      const rotuloDoTipo = tipo?.value === 'outro' && String(d.get('tipoOutro') ?? '').trim() ? String(d.get('tipoOutro')).trim() : (tipo?.nextElementSibling?.textContent ?? '');
      let quando = String(d.get('ano') ?? '');
      if (d.get('mes')) quando = `${MESES[Number(d.get('mes')) - 1]} de ${quando}`;
      if (d.get('mes') && d.get('dia')) quando = `${d.get('dia')} de ${quando}`;
      if (d.get('aproximada') === 'on') quando = `por volta de ${quando}`;
      const pessoas = [
        ...[...form.querySelectorAll<HTMLInputElement>('input[name="pessoas"]:checked')].map((c) => c.nextElementSibling?.textContent ?? ''),
        ...[...form.querySelectorAll<HTMLInputElement>('[data-nova-pessoa] [data-nome]')].map((c) => c.value.trim()).filter(Boolean),
      ];
      const fotos = form.querySelectorAll('.foto-enviada').length;
      const nucleos = [...form.querySelectorAll<HTMLInputElement>('input[name="nucleos"]:checked')].map((c) => c.nextElementSibling?.textContent ?? '');
      const visibilidade = form.querySelector<HTMLInputElement>('input[name="visibilidade"]:checked')?.value ?? d.get('visibilidade');
      return {
        d,
        titulo: String(d.get('titulo') ?? '').trim(),
        tipo: tipo?.value ?? '',
        rotuloDoTipo: rotuloDoTipo.trim(),
        ano: anoInformado(),
        quando,
        pessoas: pessoas.map((p) => p.trim()).filter(Boolean),
        lugar: String(d.get('lugar') ?? '').trim(),
        capitulos: [...form.querySelectorAll<HTMLInputElement>('input[name="capitulos"]:checked')].map((c) => (c.nextElementSibling?.textContent ?? '').trim()),
        temas: String(d.get('temas') ?? '').split(',').map((t) => t.trim()).filter(Boolean),
        fotos: fotos === 0 ? 'nenhuma' : fotos === 1 ? '1 foto' : `${fotos} fotos`,
        quemVe: visibilidade === 'nucleos' ? `só ${nucleos.join(' e ') || 'as famílias marcadas'}` : 'toda a família',
      };
    };
    const montarResumo = () => {
      const caixa = form.querySelector<HTMLElement>('[data-resumo]');
      const lista = form.querySelector<HTMLElement>('[data-resumo-lista]');
      if (!caixa || !lista) return;
      const p = lerPreenchido();
      const d = p.d;
      const linhas: [string, string][] = [
        ['O quê', `${p.titulo || 'sem título'} (${p.rotuloDoTipo})`],
        // A ordem da frase da abertura: a data, o lugar e quem estava (resposta do Gui à P134, 17/11/2026)
        ['Quando', p.quando],
        ['Onde', p.lugar || 'não informado'],
        ['Quem', p.pessoas.join(', ') || 'ninguém marcado'],
        ['Capítulo', p.capitulos.join(', ') || 'nenhum'],
        ['Temas', p.temas.join(', ') || 'nenhum'],
        ['Fotos', p.fotos],
      ];
      if (form.querySelector('[name="relato"]')) linhas.push(['Relato', String(d.get('relato') ?? '').trim() ? 'escrito' : 'em branco, dá para escrever depois']);
      linhas.push(['Quem vê', p.quemVe]);
      lista.replaceChildren(
        ...linhas.flatMap(([termo, valor]) => {
          const dt = document.createElement('dt');
          dt.textContent = termo;
          const dd = document.createElement('dd');
          dd.textContent = valor;
          return [dt, dd];
        }),
      );
      caixa.hidden = false;
    };
    // Núcleos da memória: numa memória nova, enquanto a pessoa não mexeu neles, vêm marcados os
    // núcleos de quem estava (entre os que ela pode marcar). Ela confere e muda se quiser.
    const familiasPorPessoa = JSON.parse(form.querySelector('[data-familias-pessoas]')?.textContent ?? '{}') as Record<string, string[]>;
    let mexeuNosNucleos = false;
    for (const c of form.querySelectorAll<HTMLInputElement>('input[name="nucleos"]')) c.addEventListener('change', () => (mexeuNosNucleos = true));
    const sugerirNucleos = () => {
      if (idExistente || mexeuNosNucleos) return;
      const daMemoria = new Set([...form.querySelectorAll<HTMLInputElement>('input[name="pessoas"]:checked')].flatMap((c) => familiasPorPessoa[c.value] ?? []));
      const caixas = [...form.querySelectorAll<HTMLInputElement>('input[name="nucleos"]:not(:disabled)')];
      if (!daMemoria.size || !caixas.some((c) => daMemoria.has(c.value))) return;
      for (const c of caixas) c.checked = daMemoria.has(c.value);
      const aviso = form.querySelector<HTMLElement>('[data-nucleos-sugeridos]');
      if (aviso) aviso.hidden = false;
    };
    // A frase da abertura e o resumo ao lado acompanham o preenchimento (escritos mais abaixo)
    const fraseDaAbertura = document.querySelector<HTMLElement>('[data-frase-abertura]');
    const aoLado = form.querySelector<HTMLElement>('[data-ao-lado]');
    const haLado = matchMedia('(min-width: 62rem)');
    let acompanhar = () => {};
    const pagina = form.closest<HTMLElement>('.pagina-de-formulario');
    const zonaDePerigo = document.querySelector<HTMLElement>('[data-zona-de-perigo]');
    // Depois de "Salvar rascunho" a página recarrega já ligada ao rascunho, e volta para a etapa em
    // que a pessoa estava (resposta do Gui à P127 do QA de design, 17/11/2026)
    let voltouDoRascunho = false;
    let etapaInicial = 0;
    try {
      const guardada = sessionStorage.getItem('rascunho-salvo');
      if (guardada !== null) {
        sessionStorage.removeItem('rascunho-salvo');
        voltouDoRascunho = true;
        etapaInicial = Number(guardada) || 0;
      }
    } catch {
      // sem armazenamento, a página abre na primeira etapa e sem o aviso
    }
    // A frase da abertura sai na etapa "Quando e onde", que já tem a frase, para não repetir (P140). No
    // celular, sai também na última etapa, em que o "Confira antes de publicar" já diz tudo (resposta do
    // Gui à 47-N10, 17/11/2026); no computador ela fica no alto da página.
    let secaoAtual: HTMLElement | undefined;
    const esconderFraseDaAbertura = () => {
      if (!fraseDaAbertura || !secaoAtual || form.hidden) return;
      const naEtapaDaFrase = Boolean(secaoAtual.querySelector('[data-frase]'));
      const naUltimaNoCelular = !haLado.matches && Boolean(secaoAtual.querySelector('[data-resumo]'));
      fraseDaAbertura.hidden = naEtapaDaFrase || naUltimaNoCelular;
    };
    haLado.addEventListener('change', esconderFraseDaAbertura);
    const etapas = montarEtapas(
      form,
      (indice, secao) => {
        const ultima = Boolean(secao.querySelector('[data-resumo]'));
        if (secao.querySelector('input[name="nucleos"]')) sugerirNucleos();
        if (ultima) montarResumo();
        secaoAtual = secao;
        esconderFraseDaAbertura();
        // No celular, a frase de boas-vindas fica só na primeira etapa (P126)
        pagina?.toggleAttribute('data-adiante', indice > 0);
        // A zona de perigo só na última etapa, depois do resumo (P136)
        if (zonaDePerigo) zonaDePerigo.hidden = !ultima;
        // Na última etapa, o resumo ao lado fica só com a foto e o título (P134)
        const ficha = aoLado?.querySelector<HTMLElement>('[data-ao-lado-ficha]');
        if (ficha) ficha.hidden = ultima;
        acompanhar();
      },
      etapaInicial,
    );
    form.addEventListener('change', () => {
      if (!form.querySelector<HTMLElement>('[data-resumo]')?.closest<HTMLElement>('[data-etapa]')?.hidden) montarResumo();
    });
    ligarCamposDeAno(form);
    ligarDatas(form, [{ ano: 'ano', mes: 'mes', dia: 'dia' }]);
    // O formulário em frase: a lacuna da data mostra a data como o site escreve e abre o controle
    // logo abaixo. Com a data já informada (rascunho ou correção), o controle começa fechado.
    const lacunaDaData = form.querySelector<HTMLElement>('[data-frase-data]');
    const controleDaData = form.querySelector<HTMLElement>('[data-controle-da-data]');
    if (lacunaDaData && controleDaData) {
      form.querySelector('[data-frase-sem-script]')?.remove();
      lacunaDaData.hidden = false;
      const valor = (nome: string) => Number((form.elements.namedItem(nome) as HTMLInputElement).value) || undefined;
      const escrever = () => {
        const ano = anoInformado();
        lacunaDaData.textContent = dataNaFrase({ ano, mes: valor('mes'), dia: valor('dia'), aproximada: (form.elements.namedItem('aproximada') as HTMLInputElement).checked });
        lacunaDaData.toggleAttribute('data-vazia', !ano);
      };
      const abrir = (aberto: boolean) => {
        controleDaData.hidden = !aberto;
        lacunaDaData.setAttribute('aria-expanded', String(aberto));
      };
      const alternar = () => {
        abrir(controleDaData.hidden);
        if (!controleDaData.hidden) (form.elements.namedItem('ano') as HTMLInputElement).focus();
      };
      lacunaDaData.addEventListener('click', alternar);
      // Como todo botão, responde ao Enter e à barra de espaço
      lacunaDaData.addEventListener('keydown', (evento) => {
        if (evento.key !== 'Enter' && evento.key !== ' ') return;
        evento.preventDefault();
        alternar();
      });
      for (const evento of ['input', 'change']) controleDaData.addEventListener(evento, escrever);
      // O calendário e "Foi hoje" preenchem os campos por código
      controleDaData.addEventListener('click', () => setTimeout(escrever));
      // Um campo com erro dentro do controle fechado não mostraria o balão do navegador: ele abre
      controleDaData.addEventListener('invalid', () => abrir(true), true);
      abrir(!valor('ano'));
      escrever();
    }
    // A lacuna do lugar tem a largura do que foi escrito (ou do exemplo, vazia): medida num trecho
    // escondido com a mesma letra, para o ponto final ficar junto da última letra (P144)
    const lugarNaFrase = form.querySelector<HTMLInputElement>('[data-frase-lugar]');
    if (lugarNaFrase) {
      const medida = document.createElement('span');
      medida.className = 'frase__medida';
      medida.setAttribute('aria-hidden', 'true');
      lugarNaFrase.after(medida);
      const ajustar = () => {
        medida.textContent = lugarNaFrase.value || lugarNaFrase.placeholder;
        const largura = medida.getBoundingClientRect().width;
        // Etapa escondida não tem medida: fica a largura do estilo até ela aparecer
        const estilo = getComputedStyle(lugarNaFrase);
        if (largura) lugarNaFrase.style.width = `${Math.ceil(largura + parseFloat(estilo.paddingLeft) + parseFloat(estilo.paddingRight)) + 2}px`;
      };
      lugarNaFrase.addEventListener('input', ajustar);
      lugarNaFrase.addEventListener('change', ajustar);
      form.addEventListener('click', () => setTimeout(ajustar));
      addEventListener('resize', ajustar);
      document.fonts?.ready.then(ajustar);
      ajustar();
    }
    // No celular, a frase da abertura fica abaixo da pergunta da etapa, antes das ações, para a
    // pergunta subir para o alto da tela; no computador, no alto da página (P126)
    const lugarDaFrase = () => {
      if (!fraseDaAbertura) return;
      const cabecalho = pagina?.querySelector<HTMLElement>('.pagina-de-formulario__abre');
      const destino = haLado.matches ? cabecalho : form;
      if (!destino || fraseDaAbertura.parentElement === destino) return;
      if (destino === form) situacaoEl.before(fraseDaAbertura);
      else destino.append(fraseDaAbertura);
    };
    haLado.addEventListener('change', lugarDaFrase);
    lugarDaFrase();
    // A frase da abertura: "Isso aconteceu em ___, em ___, com ___." Cada lacuna diz o que já foi
    // preenchido e leva à etapa em que aquilo se preenche. Para ir adiante, o obrigatório das etapas
    // do caminho continua valendo: quem ainda não deu o título fica na primeira, com o aviso.
    const indiceDaEtapa = (seletor: string) => [...form.querySelectorAll<HTMLElement>('[data-etapa]')].findIndex((secao) => secao.querySelector(seletor));
    const escreverAbertura = (p: ReturnType<typeof lerPreenchido>) => {
      if (!fraseDaAbertura) return;
      const textos: Record<string, [texto: string, vazia: boolean, etapa: string]> = {
        data: [dataNaFrase({ ano: p.ano, mes: Number(p.d.get('mes')) || undefined, dia: Number(p.d.get('dia')) || undefined, aproximada: p.d.get('aproximada') === 'on' }), !p.ano, 'Quando e onde'],
        lugar: [p.lugar ? `em ${p.lugar}` : 'em que lugar?', !p.lugar, 'Quando e onde'],
        pessoas: [p.pessoas.length ? `com ${listaCurta(p.pessoas, 3)}` : 'com quem?', p.pessoas.length === 0, 'Quem estava'],
      };
      const lacunas = [...fraseDaAbertura.querySelectorAll<HTMLElement>('[data-abertura]')];
      const ligas = [...fraseDaAbertura.querySelectorAll<HTMLElement>('[data-abertura-liga]')];
      lacunas.forEach((lacuna, i) => {
        const [texto, vazia, etapa] = textos[lacuna.dataset.abertura!];
        lacuna.textContent = texto;
        lacuna.toggleAttribute('data-vazia', vazia);
        lacuna.setAttribute('aria-label', `${texto} (ir para a etapa “${etapa}”)`);
        // Depois de uma lacuna vazia, que é uma pergunta, a frase segue sem vírgula nem ponto
        const ultima = i === lacunas.length - 1;
        if (ligas[i]) ligas[i].textContent = vazia ? (ultima ? '' : ' ') : ultima ? '.' : ', ';
      });
    };
    if (fraseDaAbertura && etapas) {
      const irPara = (qual: string) => {
        const pessoas = qual === 'pessoas';
        const destino = indiceDaEtapa(pessoas ? '[data-quem-estava]' : '[data-frase]');
        if (destino < 0) return;
        etapas.ir(destino);
        if (etapas.atual() !== destino || pessoas) return;
        // Chegando em "Quando e onde", o foco vai para o que a lacuna prometeu
        if (qual === 'data') {
          const controle = form.querySelector<HTMLElement>('[data-controle-da-data]');
          if (controle?.hidden) form.querySelector<HTMLElement>('[data-frase-data]')?.click();
          else (form.elements.namedItem('ano') as HTMLInputElement).focus();
        } else form.querySelector<HTMLInputElement>('[data-frase-lugar]')?.focus();
      };
      for (const lacuna of fraseDaAbertura.querySelectorAll<HTMLElement>('[data-abertura]')) {
        lacuna.addEventListener('click', () => irPara(lacuna.dataset.abertura!));
        lacuna.addEventListener('keydown', (evento) => {
          if (evento.key !== 'Enter' && evento.key !== ' ') return;
          evento.preventDefault();
          irPara(lacuna.dataset.abertura!);
        });
      }
      esconderFraseDaAbertura();
    }

    // O resumo ao lado, no computador: a foto-chave (ou o cartão do tipo de momento) e a ficha do que
    // já foi preenchido. No celular ele não existe, e a foto nem é pedida.
    const escreverAoLado = (p: ReturnType<typeof lerPreenchido>) => {
      if (!aoLado) return;
      aoLado.hidden = !haLado.matches;
      if (!haLado.matches) return;
      const campo = (nome: string, texto: string, vazio: string) => {
        const el = aoLado.querySelector<HTMLElement>(`[data-ao-lado-campo="${nome}"]`);
        if (!el) return;
        el.textContent = texto || vazio;
        el.toggleAttribute('data-vazio', !texto);
      };
      campo('titulo', p.titulo, 'Sem título ainda');
      campo('tipo', p.rotuloDoTipo, 'a escolher');
      campo('quando', p.ano ? p.quando : '', 'a informar');
      campo('onde', p.lugar, 'não informado');
      campo('quem', p.pessoas.length ? listaCurta(p.pessoas, 4) : '', 'ninguém marcado');
      campo('fotos', p.fotos === 'nenhuma' ? '' : p.fotos, 'nenhuma');
      campo('capitulo', p.capitulos.join(', '), 'nenhum');
      campo('quemve', p.quemVe, '');
      // A foto-chave é a marcada em "Usar na linha do tempo" ou, sem marca, a primeira
      const itens = [...form.querySelectorAll<HTMLElement>('.foto-enviada')];
      const principal = itens.find((item) => item.querySelector<HTMLInputElement>('input[name="fotoPrincipal"]')?.checked) ?? itens[0];
      const origem = principal?.querySelector<HTMLImageElement>('.foto__papel img')?.src;
      const comFoto = aoLado.querySelector<HTMLElement>('[data-ao-lado-com-foto]');
      const legenda = p.ano ? legendaLugarAno(p.lugar, p.ano) : p.lugar;
      if (comFoto) {
        comFoto.hidden = !origem;
        if (origem) {
          comFoto.querySelector('source')?.remove();
          const foto = comFoto.querySelector<HTMLImageElement>('img');
          if (foto && foto.src !== origem) {
            foto.loading = 'eager';
            foto.src = origem;
          }
        }
      }
      for (const cartao of aoLado.querySelectorAll<HTMLElement>('[data-ao-lado-sem-foto]')) cartao.hidden = Boolean(origem) || cartao.dataset.aoLadoSemFoto !== p.tipo;
      for (const el of aoLado.querySelectorAll<HTMLElement>('.ao-lado__foto figcaption')) el.textContent = legenda;
    };
    acompanhar = () => {
      const p = lerPreenchido();
      escreverAbertura(p);
      escreverAoLado(p);
    };
    // Cada tecla e cada escolha; o que muda a lista de fotos ou de pessoas avisa o formulário por "change"
    let quadro = 0;
    const acompanharLogo = () => {
      cancelAnimationFrame(quadro);
      quadro = requestAnimationFrame(acompanhar);
    };
    form.addEventListener('input', acompanharLogo);
    form.addEventListener('change', acompanharLogo);
    form.addEventListener('click', () => setTimeout(acompanharLogo));
    haLado.addEventListener('change', acompanharLogo);
    acompanhar();

    // Calendário e "Foi hoje" preenchem dia, mês e ano de uma vez
    const calendario = form.querySelector<HTMLInputElement>('[data-calendario]');
    const preencherData = (ano: number, mes: number, dia: number) => {
      (form.elements.namedItem('ano') as HTMLInputElement).value = String(ano);
      (form.elements.namedItem('mes') as HTMLSelectElement).value = String(mes);
      (form.elements.namedItem('dia') as HTMLInputElement).value = String(dia);
      (form.elements.namedItem('aproximada') as HTMLInputElement).checked = false;
      form.elements.namedItem('dia')!.dispatchEvent(new Event('input'));
    };
    calendario?.addEventListener('change', () => {
      const partes = /^(\d{4})-(\d{2})-(\d{2})$/.exec(calendario.value);
      if (partes) preencherData(Number(partes[1]), Number(partes[2]), Number(partes[3]));
    });
    form.querySelector('[data-hoje]')?.addEventListener('click', () => {
      const hoje = new Date();
      preencherData(hoje.getFullYear(), hoje.getMonth() + 1, hoje.getDate());
      if (calendario) calendario.value = '';
    });

    // "Outro" abre um campo para dizer o que foi
    const campoOutro = form.querySelector<HTMLElement>('[data-tipo-outro]');
    for (const radio of form.querySelectorAll<HTMLInputElement>('input[name="tipo"]')) {
      radio.addEventListener('change', () => {
        if (campoOutro) campoOutro.hidden = radio.value !== 'outro';
      });
    }

    const avisar = (texto: string, tipo: 'normal' | 'erro' = 'normal') => {
      situacaoEl.textContent = texto;
      situacaoEl.dataset.tipo = tipo;
    };

    // Numa memória nova, o texto digitado fica guardado no aparelho até ser salvo no site
    const camposDeTexto = ['titulo', 'lugar', 'relato'] as const;
    const campo = (nome: string) => form.elements.namedItem(nome) as HTMLInputElement | HTMLTextAreaElement | null;
    if (!idExistente) {
      try {
        const salvo = JSON.parse(localStorage.getItem(RASCUNHO_LOCAL) ?? '{}');
        for (const nome of camposDeTexto) {
          const c = campo(nome);
          if (c && typeof salvo[nome] === 'string' && !c.value) c.value = salvo[nome];
        }
      } catch {
        // sem rascunho local, segue vazio
      }
    }
    form.addEventListener('input', () => {
      if (situacaoEl.dataset.tipo === 'erro') avisar('');
      if (idExistente) return;
      try {
        const dados: Record<string, string> = {};
        for (const nome of camposDeTexto) dados[nome] = campo(nome)?.value ?? '';
        localStorage.setItem(RASCUNHO_LOCAL, JSON.stringify(dados));
      } catch {
        // navegador sem armazenamento: o formulário funciona do mesmo jeito
      }
    });

    // Pessoas que ainda não estão no acervo
    const atualizarQuemConta = () => {
      if (!relatoPor) return;
      for (const opcao of [...relatoPor.querySelectorAll('option[data-nova]')]) opcao.remove();
      novasPessoas.querySelectorAll<HTMLElement>('[data-nova-pessoa]').forEach((linha, i) => {
        const nome = linha.querySelector<HTMLInputElement>('[data-nome]')!.value.trim();
        if (!nome) return;
        const opcao = new Option(`${nome}, e eu estou escrevendo`, `nova:${i}`);
        opcao.dataset.nova = '';
        relatoPor.add(opcao);
      });
    };

    let contadorDeNovas = 0;
    form.querySelector('[data-adicionar-pessoa]')!.addEventListener('click', () => {
      const linha = document.createElement('div');
      linha.className = 'nova-pessoa';
      linha.dataset.novaPessoa = '';
      // "Como se referir" junto do nome: o site escreve "sua tia" ou "seu tio" (pedido do Gui, 16/11/2026)
      const grupo = `tratamento-nova-${++contadorDeNovas}`;
      linha.innerHTML = `
        <label class="campo"><span>Nome</span><input type="text" data-nome maxlength="80" placeholder="Ex.: Tia Lúcia" /></label>
        <div class="campo">
          <span id="${grupo}">Como se referir</span>
          <div class="opcoes" role="radiogroup" aria-labelledby="${grupo}">
            <label class="opcao"><input type="radio" name="${grupo}" value="ela" data-tratamento-novo /><span>Ela</span></label>
            <label class="opcao"><input type="radio" name="${grupo}" value="ele" data-tratamento-novo /><span>Ele</span></label>
            <label class="opcao"><input type="radio" name="${grupo}" value="" data-tratamento-novo checked /><span>Não informar</span></label>
          </div>
        </div>
        <button type="button" class="botao botao--leve" data-remover-pessoa>Remover</button>`;
      linha.querySelector('[data-remover-pessoa]')!.addEventListener('click', () => {
        linha.remove();
        form.dispatchEvent(new Event('change'));
        atualizarQuemConta();
      });
      linha.querySelector('[data-nome]')!.addEventListener('input', atualizarQuemConta);
      novasPessoas.append(linha);
      form.dispatchEvent(new Event('change'));
      linha.querySelector<HTMLInputElement>('[data-nome]')!.focus();
    });
    // "Quem estava?": sugestões pelos laços, busca e "Cadastrar" para quem não está no acervo
    const quemEstava = form.querySelector<HTMLElement>('[data-quem-estava]');
    if (quemEstava) {
      ligarQuemEstava(quemEstava, (nome) => {
        form.querySelector<HTMLButtonElement>('[data-adicionar-pessoa]')!.click();
        const campoNome = [...novasPessoas.querySelectorAll<HTMLInputElement>('[data-nome]')].pop()!;
        campoNome.value = nome;
        campoNome.dispatchEvent(new Event('input', { bubbles: true }));
      });
    }

    // Remover vale para fotos que já estavam e para as recém-enviadas
    listaFotos.addEventListener('click', (evento) => {
      const alvo = (evento.target as HTMLElement).closest('[data-remover]');
      alvo?.closest('.foto-enviada')?.remove();
      form.dispatchEvent(new Event('change'));
    });

    // Fotos: reduz no aparelho e envia uma a uma
    form.querySelector<HTMLInputElement>('[data-escolher-fotos]')!.addEventListener('change', async (evento) => {
      const entrada = evento.target as HTMLInputElement;
      const arquivos = [...(entrada.files ?? [])];
      entrada.value = '';
      for (const arquivo of arquivos) {
        const marca = `nova-${proximaFoto++}`;
        const item = document.createElement('li');
        item.className = 'foto-enviada';
        item.dataset.estado = 'enviando';
        item.innerHTML = `
          <div class="foto__papel"><div class="foto__reserva">Enviando…</div></div>
          <div class="foto-enviada__campos">
            <label class="campo"><span>Legenda</span><input type="text" data-legenda maxlength="200" /></label>
            <label class="marcar"><input type="radio" name="fotoPrincipal" value="${marca}" /><span>Usar na linha do tempo</span></label>
            <button type="button" class="botao botao--leve" data-remover>Remover foto</button>
          </div>`;
        listaFotos.append(item);
        form.dispatchEvent(new Event('change'));
        if (!form.querySelector('input[name="fotoPrincipal"]:checked')) {
          item.querySelector<HTMLInputElement>('input[type="radio"]')!.checked = true;
        }
        try {
          const pronta = await prepararFoto(arquivo);
          const corpo = new FormData();
          corpo.set('foto', pronta, 'foto');
          const resposta = await fetch('/api/fotos', { method: 'POST', body: corpo });
          const dados = await resposta.json();
          if (!resposta.ok) throw new Error(dados.erro ?? 'Falha no envio');
          item.dataset.fotoId = String(dados.id);
          item.dataset.estado = 'pronta';
          const imagem = new Image();
          imagem.alt = '';
          imagem.src = URL.createObjectURL(pronta);
          item.querySelector('.foto__reserva')!.replaceWith(imagem);
        } catch (e) {
          item.dataset.estado = 'erro';
          item.querySelector('.foto__reserva')!.textContent = `Não foi possível enviar. ${e instanceof Error ? e.message : ''}`;
        }
      }
    });

    form.addEventListener('submit', async (evento) => {
      evento.preventDefault();
      const situacao = (evento.submitter as HTMLElement | null)?.dataset.salvar === 'rascunho' ? 'rascunho' : 'publicada';
      const dados = new FormData(form);
      const titulo = String(dados.get('titulo') ?? '').trim();
      const anoEscrito = String(dados.get('ano') ?? '').trim();
      const ano = anoEscrito ? Number(anoEscrito) : undefined;
      if (!titulo) {
        etapas?.ir(0);
        return avisar('Dê um título para a memória.', 'erro');
      }
      // O rascunho pode ser salvo só com o título: o ano é obrigatório só para publicar, como o tipo
      // (resposta do Gui à P132 do QA de design, 17/11/2026)
      if (ano === undefined ? situacao === 'publicada' : !Number.isInteger(ano)) {
        // O aviso do ano aparece na etapa em que o ano se preenche, com o controle da data aberto
        const etapaDaData = indiceDaEtapa('[data-frase]');
        etapas?.ir(etapaDaData < 0 ? 0 : etapaDaData);
        const controle = form.querySelector<HTMLElement>('[data-controle-da-data]');
        if (controle?.hidden) form.querySelector<HTMLElement>('[data-frase-data]')?.click();
        else (form.elements.namedItem('ano') as HTMLInputElement | null)?.focus();
        // Quem ainda não passou da primeira etapa fica nela, e o aviso diz onde o ano se informa
        if (etapas && etapas.atual() !== etapaDaData) return avisar('Informe o ano, mesmo que seja aproximado, na etapa "Quando e onde".', 'erro');
        return avisar('Informe o ano, mesmo que seja aproximado.', 'erro');
      }

      const itens = [...listaFotos.querySelectorAll<HTMLElement>('.foto-enviada')];
      if (itens.some((i) => i.dataset.estado === 'enviando')) return avisar('Espere as fotos terminarem de enviar.', 'erro');
      if (audios?.ocupado()) return avisar('Espere o áudio terminar de gravar e de enviar.', 'erro');
      if (itens.some((i) => i.dataset.estado === 'erro')) return avisar('Uma foto não foi enviada. Remova ou escolha de novo.', 'erro');

      const novas = [...novasPessoas.querySelectorAll<HTMLElement>('[data-nova-pessoa]')].map((linha) => ({
        nome: linha.querySelector<HTMLInputElement>('[data-nome]')!.value.trim(),
        tratamento: (linha.querySelector<HTMLInputElement>('[data-tratamento-novo]:checked')?.value || null) as 'ela' | 'ele' | null,
      }));
      if (novas.some((n) => !n.nome)) return avisar('Escreva o nome da pessoa que você adicionou, ou remova a linha.', 'erro');

      const relato = String(dados.get('relato') ?? '');
      const pedido = {
        id: idExistente,
        titulo,
        ano,
        mes: dados.get('mes') ? Number(dados.get('mes')) : undefined,
        dia: dados.get('dia') ? Number(dados.get('dia')) : undefined,
        aproximada: dados.get('aproximada') === 'on',
        tipo: dados.get('tipo') ?? '',
        tipoOutro: dados.get('tipo') === 'outro' ? String(dados.get('tipoOutro') ?? '').trim() || undefined : undefined,
        pessoas: [...dados.getAll('pessoas').map(String), ...novas.map((_, i) => `nova:${i}`)],
        novasPessoas: novas,
        lugar: String(dados.get('lugar') ?? '').trim() || undefined,
        capitulos: dados.getAll('capitulos').map(String),
        temas: String(dados.get('temas') ?? ''),
        nucleos: dados.getAll('nucleos').map(String),
        visibilidade: dados.get('visibilidade') ?? 'todos',
        situacao,
        fotos: itens.map((item) => ({
          id: Number(item.dataset.fotoId),
          legenda: item.querySelector<HTMLInputElement>('[data-legenda]')?.value.trim() || undefined,
          principal: item.querySelector<HTMLInputElement>('input[type="radio"]')?.checked ?? false,
        })),
        relato:
          relatoPor && (relato.trim() || audios?.lista().length)
            ? { por: relatoPor.value, texto: relato, ...(audios ? { audios: audios.lista() } : {}) }
            : undefined,
      };

      for (const b of botoes) b.disabled = true;
      avisar(situacao === 'rascunho' ? 'Salvando rascunho…' : form.dataset.publicada !== undefined ? 'Salvando…' : 'Publicando…');
      try {
        const resposta = await fetch('/api/memorias', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(pedido),
        });
        const resultado = await resposta.json();
        if (!resposta.ok) throw new Error(resultado.erro ?? 'Não consegui salvar.');
        try {
          localStorage.removeItem(RASCUNHO_LOCAL);
        } catch {
          // sem armazenamento, nada a limpar
        }
        if (resultado.situacao === 'rascunho') {
          // Recarrega já ligada ao rascunho salvo no site, com as pessoas novas na lista, e volta
          // para a etapa em que a pessoa estava
          try {
            sessionStorage.setItem('rascunho-salvo', String(etapas?.atual() ?? 0));
          } catch {
            // sem armazenamento, a página volta na primeira etapa
          }
          return location.replace(resultado.url);
        }
        form.hidden = true;
        for (const parte of document.querySelectorAll<HTMLElement>('[data-zona-de-perigo], [data-frase-abertura]')) parte.hidden = true;
        const confirmacao = document.querySelector<HTMLElement>('[data-confirmacao]')!;
        confirmacao.querySelector<HTMLAnchorElement>('[data-confirmacao-link]')!.href = resultado.url;
        confirmacao.hidden = false;
        const tituloEl = confirmacao.querySelector<HTMLElement>('h2')!;
        tituloEl.setAttribute('tabindex', '-1');
        tituloEl.focus();
      } catch (e) {
        avisar(e instanceof Error ? e.message : 'Não consegui salvar.', 'erro');
        for (const b of botoes) b.disabled = false;
      }
    });

    if (voltouDoRascunho) {
      // O recado fica no alto, onde a página abre depois de salvar: junto dos botões ele ficava fora da tela
      const recado = document.createElement('p');
      recado.className = 'recado';
      recado.setAttribute('role', 'status');
      recado.textContent = 'Rascunho salvo. Só você vê, e dá para continuar de qualquer aparelho.';
      document.querySelector('.pagina-de-formulario__abre')?.before(recado);
    }
  }
</script>
