---
// O sistema visual (docs/visual.md, "Sistema"): a marca, as fontes, os tokens e todas as peças,
// com os estados de cada uma. É a página de conferência do sistema; não é uma tela do site.
//
// Ela fica (decisão do Gui, 16/11/2026, "A página do sistema fica"): existe em todos os ambientes.
// Na produção e na homologação, só os administradores abrem, pelo link da conta; para os outros,
// 404. Nas prévias de teste e no computador, abre para todos. O conteúdo é fixo, da própria página:
// nada vem do acervo. Só onde há acervo de exemplo a foto revelada usa uma memória de exemplo (o
// Chico e a Karol); fora dali, o cartão é desenhado. A guarda da produção confere as duas travas.
import '../visual/telas/sobre.css';
import '../visual/telas/sistema.css';
import Visual from '../layouts/Visual.astro';
import Assinatura from '../components/visual/Assinatura.astro';
import Audio from '../components/visual/Audio.astro';
import Bilhete from '../components/visual/Bilhete.astro';
import Carimbo from '../components/visual/Carimbo.astro';
import Dado from '../components/visual/Dado.astro';
import Gente from '../components/visual/Gente.astro';
import Etiqueta from '../components/visual/Etiqueta.astro';
import Ficha from '../components/visual/Ficha.astro';
import IconeDoTipo from '../components/visual/IconeDoTipo.astro';
import Monograma from '../components/visual/Monograma.astro';
import Pilula from '../components/visual/Pilula.astro';
import Segmentado from '../components/visual/Segmentado.astro';
import PilulaDeFamilia from '../components/visual/PilulaDeFamilia.astro';
import Polaroid from '../components/visual/Polaroid.astro';
import Rabisco from '../components/visual/Rabisco.astro';
import Recado from '../components/visual/Recado.astro';
import Reacoes from '../components/visual/Reacoes.astro';
import Retrato from '../components/visual/Retrato.astro';
import Sanfona from '../components/visual/Sanfona.astro';
import SinalDoCapitulo from '../components/visual/SinalDoCapitulo.astro';
import Vazio from '../components/visual/Vazio.astro';
import ZonaDePerigo from '../components/visual/ZonaDePerigo.astro';
import { temAcervoDeExemplo } from '../lib/servidor/ambiente';
import { conceitoDisponivel, fontesDoPedido, naoEncontrado } from '../lib/servidor/conceito';
import { listarMemorias, listarNucleos } from '../lib/servidor/repositorio';
import tokens from '../visual/tokens.css?raw';
import { contraste, coresDosTokens, neutroDosTokens } from '../lib/contraste';
import { RABISCOS } from '../visual/rabiscos';
import { COMBINACOES_DE_FONTES, CORES, CORES_NOVAS, NOMES_DAS_CORES, PALETA, FONTES_DO_SITE, PAPEIS_DAS_FONTES, assinaturaDaTela, atributosDasFontes, combinacao, combinacaoDe, combinacaoValida, estiloDoTipo, legendaLugarAno, nomesDasFontes } from '../lib/visual';

const { usuario, tipos } = Astro.locals;
const comExemplos = temAcervoDeExemplo();
if (!comExemplos && !usuario.admin) return naoEncontrado();

const fontes = fontesDoPedido(Astro.request);
// O seletor do alto troca as fontes só nos exemplos desta página (decisão do Gui, 17/11/2026): o
// topo, o menu e o rodapé continuam na fonte do site. Vem pelo endereço (?fontes=b), sem script.
const fontesPedidas = combinacaoValida(Astro.url.searchParams.get('fontes'));
const fontesDosExemplos = fontesPedidas ? combinacao(fontesPedidas) : fontes;
const exemplosEm = combinacaoDe(fontesDosExemplos);
const doSite = combinacaoDe(FONTES_DO_SITE);
const nomeDa = (id: string | null) => COMBINACOES_DE_FONTES.find((c) => c.id === id);
const nucleos = await listarNucleos();
// Só onde há acervo de exemplo a página lê uma memória, para mostrar a foto revelada com foto
const memorias = comExemplos ? (await listarMemorias(usuario)).filter((m) => m.situacao === 'publicada') : [];
const comMonte = memorias.find((m) => m.id === '2025-natal') ?? memorias.find((m) => m.fotos.length > 1);

// A assinatura em cada tela, e com uma família a mais, que ainda não existe, para ver a linha longa
const comMaisUma = [...nucleos, { id: 'exemplo', nome: 'Bracarense Silva', sobrenomes: ['Bracarense', 'Silva'] }];
const assinaturas = [
  { onde: 'Família completa', sobrenomes: assinaturaDaTela([], nucleos).sobrenomes },
  ...nucleos.map((n) => ({ onde: `Só a família ${n.nome}`, sobrenomes: assinaturaDaTela([n.id], nucleos).sobrenomes })),
  { onde: 'Se entrar outra família, por um casamento', sobrenomes: assinaturaDaTela([], comMaisUma).sobrenomes },
];
const familias = [{ id: 'tudo', nome: 'Família completa' }, ...nucleos.map((n) => ({ id: assinaturaDaTela([n.id], nucleos).familia, nome: n.nome })), { id: '3', nome: 'A próxima família' }];
const papeis = { serifa: 'Serifa, nos títulos', grotesca: 'Grotesca, no texto', mono: 'Mono, nas fichas', mao: 'Manuscrita, só na assinatura' } as const;
const escala = [
  { token: 't-capa', classe: 'serifa t-capa', texto: '1994', uso: 'O ano da linha do tempo' },
  { token: 't-titulo-1', classe: 't-1', texto: 'Natal de 2025', uso: 'Título da página' },
  { token: 't-titulo-2', classe: 't-2', texto: 'Quem estava', uso: 'Título de parte, pergunta do formulário' },
  { token: 't-titulo-3', classe: 't-3', texto: 'A receita do pão de queijo', uso: 'Título de memória na lista' },
  { token: 't-abertura', classe: 'serifa t-abertura', texto: '“Fomos só olhar. Voltamos com ele.”', uso: 'Frase de abertura' },
  { token: 't-leitura', classe: 'sis__leitura', texto: 'Dezoito horas de estrada, duas fitas de música e uma briga por causa do ar condicionado.', uso: 'Relato' },
  { token: 't-corpo', classe: 'sis__corpo', texto: 'Cada pessoa conta o dia do jeito que lembra.', uso: 'Texto da interface' },
  { token: 't-pequeno', classe: 'sis__pequeno', texto: 'Sua última visita foi em 17 dez.', uso: 'Apoio' },
  { token: 't-ficha', classe: 'rotulo', texto: '14 ago 1994 · Belo Horizonte', uso: 'Ficha, rótulo e carimbo' },
  { token: 't-micro', classe: 'selo', texto: 'Rascunho, só você vê', uso: 'Selo' },
];
const espacos = ['e-1', 'e-2', 'e-3', 'e-4', 'e-5', 'e-6', 'e-7', 'e-8', 'e-9'];
// A paleta com a conta do contraste, lida dos próprios tokens (a mesma conta de testes/paleta.test.ts)
const valores = coresDosTokens(tokens);
const corDoPapel = neutroDosTokens(tokens, 'creme');
const corDaTinta = neutroDosTokens(tokens, 'tinta');
const razao = (a: string, b: string) => contraste(a, b).toFixed(1).replace('.', ',');

---

<Visual titulo="Sistema" secao="conceito" rodape="metade">
  <div class="sobre sis miolo">
    <header class="sobre__abre">
      <p class="rotulo suave">Revisão visual do zero · fase 2, o sistema</p>
      <h1 class="t-1">Sistema</h1>
      <p class="sobre__texto">
        O que o conceito aprovado usa, arrumado para as outras telas usarem igual: a marca, as fontes, as cores, as medidas e as peças. As telas do conceito já
        são montadas com estas peças e continuam como foram aprovadas.
      </p>
      <nav class="sis__fontes" aria-label="Fontes dos exemplos">
        <span class="rotulo suave">Fontes dos exemplos</span>
        {
          COMBINACOES_DE_FONTES.map((c) => (
            <a class="acao acao--quieta" href={`/sistema?fontes=${c.id}`} aria-current={c.id === exemplosEm ? 'true' : undefined}>
              {c.id.toUpperCase()}, {c.nome}
              {c.id === doSite && <span class="suave">{' (a do site)'}</span>}
            </a>
          ))
        }
      </nav>
    </header>

    <div class="sis__exemplos" {...atributosDasFontes(fontesDosExemplos)}>

    <section aria-labelledby="marca">
      <h2 class="sobre__titulo" id="marca">Monograma</h2>
      <p class="sobre__texto">
        O M de Memórias, tirado da serifa dos títulos e desenhado em SVG. Tem dois cortes: o de título e um mais firme, para ler pequeno. É o ícone do site e, no
        celular, fica no lugar da assinatura. Acompanha a serifa escolhida.
      </p>
      <div class="sis__monogramas">
        {
          COMBINACOES_DE_FONTES.map((c) => (
            <div class="sis__monograma">
              <p class="rotulo">
                {c.id.toUpperCase()} · {c.serifa}
                {c.id === doSite && ' · a do site'}
              </p>
              <p class="sis__tamanhos" aria-hidden="true">
                {[16, 24, 32].map((px) => (
                  <span style={`font-size: ${px}px`}>
                    <Monograma serifa={c.id} corte="pequeno" />
                    <small>{px}</small>
                  </span>
                ))}
                {[64, 112].map((px) => (
                  <span style={`font-size: ${px}px`}>
                    <Monograma serifa={c.id} />
                    <small>{px}</small>
                  </span>
                ))}
              </p>
              <p class="sis__icones">
                <img src={`/icones/${c.id}/favicon.svg`} width="16" height="16" alt="" />
                <img src={`/icones/${c.id}/favicon.svg`} width="32" height="32" alt="" />
                <img src={`/icones/${c.id}/favicon-48.png`} width="48" height="48" alt="" />
                <img class="sis__icone-celular" src={`/icones/${c.id}/apple-touch-icon.png`} width="90" height="90" alt="" />
              </p>
              <p class="ficha suave">Ícone da aba em 16 e 32 px, ícone de reserva em 48 px e ícone da tela inicial do celular.</p>
            </div>
          ))
        }
      </div>
      <h3 class="sis__subtitulo">Na cor do texto ou na cor da família</h3>
      <p class="sis__familias" aria-hidden="true">
        <span><Monograma /></span>
        {
          familias.slice(0, 4).map((f) => (
            <span class="sis__na-cor" data-familia={f.id}>
              <Monograma />
            </span>
          ))
        }
      </p>
      <p class="ficha suave">O padrão é uma cor só, a do texto. A cor da família fica para usos decorativos e momentos específicos: aqui, na tinta de cada uma.</p>
    </section>

    <section aria-labelledby="assinatura">
      <h2 class="sobre__titulo" id="assinatura">Assinatura</h2>
      <p class="sobre__texto">
        “MEMÓRIAS” não muda. Os sobrenomes acompanham o que está sendo visto e vêm do cadastro de cada família. O “&amp;” só aparece quando a tela é de mais de
        uma família. Uma linha mais longa encolhe para caber.
      </p>
      <div class="assinaturas">
        {
          assinaturas.map((a) => (
            <div>
              <Assinatura sobrenomes={a.sobrenomes} />
              <p class="ficha suave">{a.onde}</p>
            </div>
          ))
        }
      </div>
    </section>

    <section aria-labelledby="fontes">
      <h2 class="sobre__titulo" id="fontes">Fontes</h2>
      <p class="sobre__texto">
        {doSite ? `A fonte do site é a combinação ${doSite.toUpperCase()}, ${nomeDa(doSite)!.nome}` : 'A fonte do site mistura combinações'}: {nomesDasFontes(FONTES_DO_SITE)}.
        {exemplosEm !== doSite && ` Os exemplos desta página estão ${exemplosEm ? `na ${exemplosEm.toUpperCase()}, ${nomeDa(exemplosEm)!.nome}` : 'em fontes misturadas'}: ${nomesDasFontes(fontesDosExemplos)}.`} Trocar a
        fonte do site é mudar uma linha do código. {conceitoDisponivel() && <a href="/conceito/sobre">Ver as três combinações lado a lado</a>}
      </p>
      <dl class="sis__papeis">
        {
          PAPEIS_DAS_FONTES.map((papel) => (
            <div>
              <dt class="rotulo suave">{papeis[papel]}</dt>
              <dd class={`sis__papel sis__papel--${papel}`}>{COMBINACOES_DE_FONTES.find((c) => c.id === fontesDosExemplos[papel])![papel]}</dd>
            </div>
          ))
        }
      </dl>
      <h3 class="sis__subtitulo">Escala de tipo</h3>
      <ul class="sis__escala">
        {
          escala.map((e) => (
            <li>
              <p class="ficha suave">
                --{e.token} · {e.uso}
              </p>
              <p class={e.classe}>{e.texto}</p>
            </li>
          ))
        }
      </ul>
    </section>

    <section aria-labelledby="cores">
      <h2 class="sobre__titulo" id="cores">Cores</h2>
      <h3 class="sis__subtitulo">Neutros</h3>
      <ul class="sis__neutros">
        {
          ['papel', 'papel-recuo', 'branco', 'fio', 'tinta-suave', 'tinta'].map((n) => (
            <li>
              <span style={`background: var(--${n})`} />
              <span class="ficha">--{n}</span>
            </li>
          ))
        }
      </ul>
      <h3 class="sis__subtitulo">As onze cores, em quatro tons: pastel, meio, vivo e tinta</h3>
      <ul class="cores sis__cores">
        {
          CORES.map((c) => (
            <li>
              <span style={`background: var(--${c}-pastel)`} />
              <span style={`background: var(--${c}-meio)`} />
              <span style={`background: var(--${c}-vivo)`} />
              <span style={`background: var(--${c}-tinta)`} />
              <span class="ficha">{c}</span>
            </li>
          ))
        }
      </ul>
      <h3 class="sis__subtitulo" id="paleta-ampliada">A paleta ampliada: mais doze cores, para a cor de cada tipo de momento</h3>
      {/* No celular, duas cores por linha, e o nome de gente junto do nome do código (resposta do Gui à P172, 17/11/2026) */}
      <ul class="cores sis__cores sis__cores--novas">
        {
          CORES_NOVAS.map((c) => (
            <li>
              <span style={`background: var(--${c}-pastel)`} />
              <span style={`background: var(--${c}-meio)`} />
              <span style={`background: var(--${c}-vivo)`} />
              <span style={`background: var(--${c}-tinta)`} />
              <span class="ficha">
                {NOMES_DAS_CORES[c]} · {c}
              </span>
            </li>
          ))
        }
      </ul>
      <h3 class="sis__subtitulo">O contraste de cada cor da paleta</h3>
      <p class="sis__nota suave">
        A razão de contraste, pela conta da WCAG: a tinta da cor sobre o pastel dela, a tinta da cor sobre o papel e o texto do site sobre o pastel. O
        combinado é 4,5 para um; o que fica abaixo está marcado.
      </p>
      <div class="sis__rola">
        <table class="sis__contraste">
          <thead>
            <tr>
              <th scope="col">Cor</th>
              <th scope="col">Tinta no pastel</th>
              <th scope="col">Tinta no papel</th>
              <th scope="col">Texto no pastel</th>
            </tr>
          </thead>
          <tbody>
            {
              PALETA.map((c) => {
                const v = valores[c]!;
                const noPastel = contraste(v.tinta, v.pastel);
                return (
                  <tr>
                    <th scope="row">
                      <span class="sis__gota" style={`background: var(--${c}-pastel); color: var(--${c}-tinta)`}>
                        Aa
                      </span>
                      {NOMES_DAS_CORES[c]} <span class="ficha suave">{c}</span>
                    </th>
                    {/* No celular cada número leva o nome da coluna em cima, e os três cabem numa linha (resposta do Gui à P173, 17/11/2026) */}
                    <td data-coluna="Tinta no pastel" data-abaixo={noPastel < 4.5 ? '' : undefined}>
                      {razao(v.tinta, v.pastel)}
                      {noPastel < 4.5 && <span> (abaixo de 4,5)</span>}
                    </td>
                    <td data-coluna="Tinta no papel">{razao(v.tinta, corDoPapel)}</td>
                    <td data-coluna="Texto no pastel">{razao(corDaTinta, v.pastel)}</td>
                  </tr>
                );
              })
            }
          </tbody>
        </table>
      </div>
      <h3 class="sis__subtitulo">A cor de cada família</h3>
      <ul class="cores">
        {
          familias.map((f) => (
            <li data-familia={f.id}>
              <span class="cores__pastel" />
              <span class="cores__meio" />
              <span class="cores__vivo" />
              <span class="cores__tinta" />
              <span class="ficha">{f.nome}</span>
            </li>
          ))
        }
      </ul>
      <h3 class="sis__subtitulo">A cor e o ícone de cada tipo de momento</h3>
      <p class="peca__etiquetas">
        {tipos.map((t) => <Etiqueta tipo={t.id} rotulo={t.rotulo} />)}
      </p>
      <h3 class="sis__subtitulo">O chão das épocas e a página íntima</h3>
      <ul class="sis__neutros">
        {
          ['chao-1', 'chao-2', 'chao-3'].map((n) => (
            <li>
              <span style={`background: var(--${n})`} />
              <span class="ficha">--{n}</span>
            </li>
          ))
        }
        {
          familias.slice(1, 4).map((f) => (
            <li data-familia={f.id} data-intimo>
              <span style="background: var(--papel)" />
              <span class="ficha">Painel, {f.nome}</span>
            </li>
          ))
        }
      </ul>
    </section>

    <section aria-labelledby="medidas">
      <h2 class="sobre__titulo" id="medidas">Medidas</h2>
      <h3 class="sis__subtitulo">Espaços</h3>
      <ul class="sis__espacos">
        {
          espacos.map((e) => (
            <li>
              <span class="ficha">--{e}</span>
              <span style={`width: var(--${e})`} />
            </li>
          ))
        }
      </ul>
      <p class="ficha suave">De 1 a 4, dentro de um grupo. De 5 a 7, entre grupos. 8 e 9, entre partes da página.</p>
      <h3 class="sis__subtitulo">Grade</h3>
      <div class="grade sis__grade" aria-hidden="true">
        {Array.from({ length: 12 }, (_, n) => <span data-coluna={n + 1} />)}
      </div>
      <p class="ficha suave">Quatro colunas no celular e doze a partir de 62rem. A tela grande, de ver juntos na TV, começa em 100rem.</p>
      <h3 class="sis__subtitulo">Formas e sombras</h3>
      <ul class="sis__formas">
        <li><span style="border-radius: var(--raio-foto)" /><span class="ficha">--raio-foto</span></li>
        <li><span style="border-radius: var(--raio-moldura)" /><span class="ficha">--raio-moldura</span></li>
        <li><span style="border-radius: var(--raio-bloco)" /><span class="ficha">--raio-bloco</span></li>
        <li><span style="border-radius: var(--raio-pilula)" /><span class="ficha">--raio-pilula</span></li>
        <li><span style="box-shadow: var(--sombra-foto); background: var(--branco)" /><span class="ficha">--sombra-foto</span></li>
        <li><span style="box-shadow: var(--sombra-bilhete); background: var(--branco)" /><span class="ficha">--sombra-bilhete</span></li>
      </ul>
    </section>

    <section aria-labelledby="pecas">
      <h2 class="sobre__titulo" id="pecas">Peças</h2>
      <p class="sobre__texto">As do conceito e as que ainda não tinham desenho, marcadas como novas. Todas aprovadas.</p>
      <div class="sis__pecas">
        <article class="sis__peca">
          <h3 class="rotulo">Foto revelada e monte de fotos</h3>
          <div class="sis__fotos">
            {
              comMonte && (
                <div style={estiloDoTipo(comMonte.tipo)}>
                  <Polaroid id={comMonte.id} fotos={comMonte.fotos} legenda={legendaLugarAno(comMonte.lugar, comMonte.ano)} alt="" forma />
                </div>
              )
            }
            {/* Conteúdo fixo da página: o cartão sem foto, que não precisa de nenhum arquivo */}
            <div style={estiloDoTipo('festa')}>
              <Polaroid id="sistema-festa" fotos={[]} legenda={legendaLugarAno('Belo Horizonte', 2025)} tipo="festa" forma />
            </div>
            {!comMonte && (
              <div style={estiloDoTipo('viagem')}>
                <Polaroid id="sistema-viagem" fotos={[]} legenda={legendaLugarAno('Porto Seguro', 1998)} tipo="viagem" forma />
              </div>
            )}
          </div>
          <p class="ficha suave">A foto-chave, com as outras atrás e a forma de cor do tipo. Memória sem foto ganha o mesmo cartão, com o ícone do tipo.</p>
        </article>

        <article class="sis__peca">
          <h3 class="rotulo">Carimbo, etiqueta, pílula e selo</h3>
          <p><Carimbo itens={['14 ago 1994', 'Belo Horizonte']} /></p>
          <p class="sis__linha">
            <Etiqueta tipo="viagem" rotulo="Viagem" />
            <Pilula>2018–2020</Pilula>
            <Pilula>por volta de 1994</Pilula>
            <span class="selo">Só Bayara</span>
          </p>
          <p class="ficha suave">O carimbo diz data e lugar. A etiqueta diz o tipo de momento. A pílula, que é nova, diz um período ou uma data aproximada.</p>
        </article>

        <article class="sis__peca">
          <h3 class="rotulo">Pílula de família</h3>
          <nav class="pilulas-de-familia" aria-label="Exemplo de famílias">
            {familias.slice(0, 4).map((f, i) => (
              <PilulaDeFamilia href="#pecas" familia={f.id} atual={i === 0} conta={i === 0 ? undefined : 3 + i * 4}>
                {i === 0 ? 'Todas' : f.nome}
              </PilulaDeFamilia>
            ))}
          </nav>
          <p class="ficha suave">Família é sempre pill. O ponto na cor viva da família e, marcada, a pílula inteira no pastel dela. É um link, e a conta à direita é opcional. Hoje em Pessoas, onde filtra uma família por vez.</p>
        </article>

        <article class="sis__peca">
          <h3 class="rotulo">Seletor segmentado</h3>
          <div>
            <Segmentado rotulo="Exemplo de escolha" nome="exemplo-segmentado" opcoes={[{ valor: 'todos', texto: 'Toda a família', atual: true }, { valor: 'nucleos', texto: 'Famílias escolhidas' }]} />
          </div>
          <p class="ficha suave">Uma escolha só entre duas ou três, com a explicação colada embaixo. Hoje só em "Quem pode ver?" da nova memória. Cada opção é um rádio: vai junto com o formulário e funciona sem script.</p>
        </article>

        <article class="sis__peca">
          <h3 class="rotulo">Ficha em mono</h3>
          <Ficha>
            <Dado rotulo="Quando">24 de dezembro de 2025</Dado>
            <Dado rotulo="Onde">Belo Horizonte</Dado>
            <Dado rotulo="Tipo"><Etiqueta tipo="festa" rotulo="Festa" /></Dado>
            <Dado rotulo="Capítulos"><a href="/capitulos">Natais</a></Dado>
          </Ficha>
          <p class="ficha suave">O verso da foto: rótulo pequeno em caixa alta e valor.</p>
        </article>

        <article class="sis__peca">
          <h3 class="rotulo">Retrato recortado</h3>
          <p class="sis__retratos">
            {
              familias.map((f) => (
                <span>
                  <Retrato nome={f.nome === 'Família completa' ? 'Vó Bela' : f.nome} familia={f.id} />
                </span>
              ))
            }
            <span class="sis__retrato-redondo"><Retrato nome={usuario.nome} redondo /></span>
          </p>
          <p class="ficha suave">Em arco, com a foto do cadastro. Sem foto, as iniciais sobre a cor da família. Redondo só no topo.</p>
        </article>

        <article class="sis__peca">
          <h3 class="rotulo">Gente: uma pessoa numa linha de lista · nova</h3>
          <ul class="sis__gente">
            <li>
              <Gente href="#pecas" nome="Vó Bela" familia="0" laco="sua avó" />
            </li>
            <li>
              <Gente href="#pecas" nome="Marina" familia="tudo" laco="sua melhor amiga" detalhe="muito próximo · só você vê" />
            </li>
          </ul>
          <p class="ficha suave">O retrato pequeno, o nome, o laço e um detalhe em mono. A linha inteira leva à página da pessoa. Nas listas de laços, na página da pessoa e na conta.</p>
        </article>

        <article class="sis__peca sis__peca--larga">
          <h3 class="rotulo">Bilhete, bloco de áudio e nome manuscrito</h3>
          <Bilhete por="Elizete" registradoPor="Gui">
            {/* FIXO: o acervo de exemplo não tem áudio. O bloco usa o tocador do próprio aparelho. */}
            <Audio rotulo="Áudio · 2 min 14 s" transcricao="Eu fiz o bolo na véspera e quase não dormi." />
            <div class="bilhete__texto">
              <p>Eu fiz o bolo na véspera e quase não dormi.</p>
            </div>
          </Bilhete>
          <p class="ficha suave">O relato de uma pessoa. A manuscrita só aparece aqui, no nome de quem conta.</p>
        </article>

        <article class="sis__peca">
          <h3 class="rotulo">Ações</h3>
          <p class="sis__linha">
            <a class="botao" href="#pecas">Escrever meu relato</a>
          </p>
          <p class="sis__linha">
            <a class="botao" href="#pecas" aria-disabled="true" tabindex="-1">Salvando</a>
          </p>
          <p class="sis__linha">
            <a class="acao" href="#pecas">Ver sua página</a>
            <a class="acao acao--quieta" href="#pecas">Corrigir esta memória</a>
            <a href="#pecas">um link no texto</a>
          </p>
          <p class="ficha suave">Botão cheio só para a ação principal da tela, e a versão sem poder agir. O resto é texto sublinhado.</p>
        </article>

        <article class="sis__peca">
          <h3 class="rotulo">Sinal do capítulo, ícones e rabiscos</h3>
          <p class="sis__linha ficha">
            <SinalDoCapitulo id="exemplo-1" titulo="Natais" cor={0} />
            <SinalDoCapitulo id="exemplo-2" titulo="A infância da Giovanna" cor={1} />
          </p>
          <p class="sis__linha sis__icones-dos-tipos">
            {tipos.map((t) => <span style={estiloDoTipo(t.id)}><IconeDoTipo tipo={t.id} /></span>)}
          </p>
          <h4 class="rotulo suave" id="todos-os-rabiscos">Todos os rabiscos dos tipos de momento, com o nome de cada um</h4>
          <ul class="sis__todos-os-rabiscos">
            {
              RABISCOS.map((r) => (
                <li>
                  <IconeDoTipo rabisco={r.id} />
                  <span class="ficha">{r.nome}</span>
                </li>
              ))
            }
          </ul>
          <p class="sis__linha sis__rabiscos">
            <span class="sublinhado serifa t-3">Oi, Gui.<Rabisco desenho="sublinha" /></span>
            <Rabisco desenho="seta" />
            <Rabisco desenho="brilhos" />
            <Rabisco desenho="coracao" />
          </p>
        </article>

        <article class="sis__peca sis__peca--larga">
          <h3 class="rotulo">Sanfona de fases · nova</h3>
          <div>
            <Sanfona ano="2014" titulo="Namoro" quando="mar 2014 a out 2019" grupo="fases" aberta>
              <p>Abre empurrando o conteúdo, sem tela por cima. Só uma fase fica aberta por vez.</p>
            </Sanfona>
            <Sanfona ano="2019" titulo="Noivado" quando="out 2019 a nov 2026" grupo="fases">
              <p>O pedido foi no sítio, no fim da tarde.</p>
            </Sanfona>
            <Sanfona ano="2026" titulo="Casamento" quando="14 nov 2026" grupo="fases">
              <p>O dia em que o site nasceu.</p>
            </Sanfona>
          </div>
          <p class="ficha suave">Para a página do laço: o ano grande, o nome da fase e a data pequena.</p>
        </article>

        <article class="sis__peca sis__peca--larga">
          <h3 class="rotulo">Formulário em frase · novo</h3>
          <p class="frase">
            Isso aconteceu em
            <label class="frase__lacuna" style="--cabe: 9">
              <span class="so-leitor">Quando</span>
              <input type="text" placeholder="quando" autocomplete="off" />
            </label>, em
            <label class="frase__lacuna" style="--cabe: 12">
              <span class="so-leitor">Onde</span>
              <input type="text" value="Belo Horizonte" autocomplete="off" />
            </label>, com
            <label class="frase__lacuna" style="--cabe: 10">
              <span class="so-leitor">Quem estava</span>
              <input type="text" placeholder="quem" autocomplete="off" />
            </label>.
          </p>
          <p class="ficha suave">Para a abertura da Nova memória, sem mudar a ordem das etapas nem o que é obrigatório.</p>
        </article>

        <article class="sis__peca">
          <h3 class="rotulo">Campo de formulário · novo</h3>
          <p class="pergunta">Como foi esse dia?</p>
          <label class="campo">
            <span class="campo__rotulo">Título</span>
            <input class="campo__entrada" type="text" value="Natal de 2025" />
            <span class="campo__dica">Um nome curto, como você chamaria essa lembrança.</span>
          </label>
          <label class="campo campo--erro">
            <span class="campo__rotulo">Ano</span>
            <input class="campo__entrada" type="text" value="20256" aria-invalid="true" />
            <span class="campo__erro">Confira o ano: ele tem quatro algarismos.</span>
          </label>
          <label class="escolha">
            <input type="checkbox" checked />
            <span>Não sei o dia exato</span>
          </label>
          <p class="ficha suave">Uma pergunta por tela, em serifa. A resposta é uma linha para escrever em cima. O texto de exemplo aqui é só para mostrar a peça.</p>
        </article>

        <article class="sis__peca">
          <h3 class="rotulo">Recado e estado vazio</h3>
          <Recado>Memória salva.</Recado>
          <Recado erro>Não deu para salvar. Tente de novo.</Recado>
          <Vazio frase="Ainda não há memórias aqui.">
            <a class="acao" href="#pecas">Nova memória</a>
          </Vazio>
          <p class="ficha suave">O recado do alto da página, nas duas vozes, e a tela sem nada para mostrar.</p>
        </article>

        <article class="sis__peca">
          <h3 class="rotulo">Reações · nova</h3>
          <Reacoes memoria="exemplo" alvo="relato" alvoId={0} marcas={new Map([['coracao', ['eu', 'a']], ['estava', ['b']]])} eu="eu" nome={(id) => ({ a: 'Elizete', b: 'Gui' })[id] ?? id} volta="/sistema#pecas" />
          <p class="ficha suave">Embaixo do relato e de cada foto: coração, riso, saudade e “eu estava lá”, nos rabiscos do site. O seu fica cheio. O riso é provisório, para o acabamento.</p>
        </article>

        <article class="sis__peca">
          <h3 class="rotulo">Zona de perigo · nova</h3>
          <ZonaDePerigo nivel={4}>
            <p>A memória vai para a lixeira e pode ser restaurada.</p>
            <a class="acao" href="#pecas">Excluir esta memória</a>
          </ZonaDePerigo>
          <p class="ficha suave">No fim das telas de editar, longe do salvar: o que apaga fica junto, com um fio e o título na cor de alerta, sem fundo, e leva à confirmação. O botão que confirma continua cheio, na cor de alerta.</p>
        </article>
      </div>
    </section>
    </div>
  </div>
</Visual>
