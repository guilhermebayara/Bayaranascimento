---
// Explorar (docs/regras/explorar.md, "Explorar"): uma tela só para ver o acervo, com a troca entre as
// formas de ver no alto (linha do tempo, mural de fotos, modo TV e uma memória ao acaso) e os
// filtros e a ordem num lugar só. Tudo o que foi escolhido fica no endereço.
//
// As regras estão em src/lib/explorar.ts. Aqui só entram memórias que a pessoa vê: o resultado, o
// mural, modo TV e contagens saem de listarMemorias; o sorteio usa consultas próprias no banco.
import '../visual/telas/linha.css';
import '../visual/telas/explorar.css';
import '../visual/telas/tv.css';
import '../visual/telas/lista.css';
import '../visual/telas/busca.css';
import Visual from '../layouts/Visual.astro';
import Assinatura from '../components/visual/Assinatura.astro';
import Vazio from '../components/visual/Vazio.astro';
import Controles from '../components/explorar/Controles.astro';
import Linha from '../components/explorar/Linha.astro';
import Lista from '../components/explorar/Lista.astro';
import Mural from '../components/explorar/Mural.astro';
import Palco from '../components/explorar/Palco.astro';
import PalcoDaTv from '../components/explorar/PalcoDaTv.astro';
import SemResultado from '../components/busca/SemResultado.astro';
import { buscaEntreAspas, type Motivo } from '../lib/busca';
import { buscarNoAcervo } from '../lib/servidor/busca';
import { SEM_FILTRO, ancoraDaMemoria, contaDoExplorar, enderecoDoExplorar, explorar, lerFiltros, lerForma, lerPassar, lerTamanho, lerFotosDoMural, mostraRascunho, filtrosLigados, soFiltrosConhecidos, temFiltro, terminaNoComecoDoAcervo } from '../lib/explorar';
import { palcoAoAcaso } from '../lib/servidor/ao-acaso';
import { contextoDoExplorar } from '../lib/servidor/explorar';
import { parentescosDeQuemOlha } from '../lib/servidor/parentesco-de-quem-olha';
import { listarCapitulos, listarIntegrantesQueVe, listarMemorias, listarNucleos, listarRelatos, listarTemasVisiveis } from '../lib/servidor/repositorio';
import { assinaturaDaTela, trechoDoRelato } from '../lib/visual';
import { ordemDoModoTv, palcoDaTv, saidasDoModoTv } from '../lib/servidor/tv';
import { naSala, posicaoNaOrdem, vizinhasNaOrdem } from '../lib/sala';

const { usuario, tipos } = Astro.locals;
const parametros = Astro.url.searchParams;
const forma = lerForma(parametros);
const tamanho = lerTamanho(parametros);
const fotosDoMural = lerFotosDoMural(parametros);

// O modo TV (aplicação da E1 e causa 6 da medição M1): a primeira página lê a ordem uma vez, só com o que
// entra (os filtros, quem vê o quê e, com o marcador da sala, só o que é aberto a toda a família), e manda
// os ids junto com o palco da memória da vez. As passagens seguintes pedem uma memória só à rota do palco
// (src/pages/explorar/palco.astro). Abrir o endereço de uma memória direto continua funcionando por aqui.
const modoTv =
  forma === 'tv'
    ? await (async () => {
        const { filtros, memorias, ordem } = await ordemDoModoTv(usuario, parametros, tipos);
        // Sem "m" no endereço, ou com um que não está na ordem, a página abre no primeiro passo (o primeiro
        // parágrafo da carta, na porta "A carta e os Natais"), e o palco põe o "m" no endereço
        const pedida = parametros.get('m');
        const id = pedida && ordem.includes(pedida) ? pedida : ordem[0];
        const vizinhas = id ? vizinhasNaOrdem(ordem, id, lerPassar(parametros).tempo !== null) : undefined;
        const palco = id
          ? await palcoDaTv({ usuario, parametros, filtros, id, memoria: memorias.find((m) => m.id === id), antes: vizinhas?.antes, depois: vizinhas?.depois, posicao: posicaoNaOrdem(ordem, id) })
          : undefined;
        const { sair, limpar } = saidasDoModoTv(filtros, naSala(parametros));
        return { ordem, palco, voltar: sair, limpar };
      })()
    : undefined;

const acaso = forma === 'acaso' ? await palcoAoAcaso(usuario, parametros, tipos) : undefined;
if (acaso?.redirecionar && acaso.id) return Astro.redirect(enderecoDoExplorar(acaso.filtros, 'acaso', { m: acaso.id }), 302);
const [nucleos, todas, integrantes, capitulos, temas] = acaso
  ? [acaso.nucleos, [], acaso.integrantes, acaso.capitulos, acaso.temas]
  : modoTv ? [[], [], [], [], []] : await Promise.all([
  listarNucleos(),
  // O rascunho de quem escreveu entra na linha do tempo e na lista; o mural, o modo TV e o sorteio usam
  // só as publicadas (abaixo)
  listarMemorias(usuario, { comRascunhos: true }),
  // Quem só existe num laço privado de outra pessoa não aparece nem no filtro nem nos nomes (C1)
  listarIntegrantesQueVe(usuario),
  listarCapitulos(usuario),
  listarTemasVisiveis(usuario),
]);
// Todo mundo pode filtrar por qualquer família (decisão do Gui, 16/11/2026). O filtro não muda
// quem vê o quê: listarMemorias só devolve o que a pessoa pode ver, e de uma família de que ela
// não é membro isso é o que foi aberto a todos. Família que não existe é ignorada, assim como o
// tipo, a pessoa, o capítulo e o tema que não existem ou que a pessoa não vê (soFiltrosConhecidos).
const filtros = acaso?.filtros ?? soFiltrosConhecidos(lerFiltros(parametros), {
  tipos: new Set(tipos.map((t) => t.id)),
  pessoas: new Set(integrantes.map((i) => i.id)),
  familias: new Set(nucleos.map((n) => n.id)),
  capitulos: new Set(capitulos.map((c) => c.id)),
  temas: new Set(temas.map((t) => t.id)),
  // A busca (`q`, docs/regras/explorar.md, "A busca"), destino de "Ver no Explorar"
  busca: true,
});
const [contextoSemBusca, achadosDaBusca] = modoTv || acaso
  ? [{ eu: usuario.pessoa, doCapitulo: () => false, comAudio: new Set<string>(), contaram: new Map() }, undefined]
  : await Promise.all([contextoDoExplorar(usuario, todas), filtros.busca ? buscarNoAcervo(usuario, tipos, filtros.busca, todas) : Promise.resolve(undefined)]);
// Só o que a busca achou, entre as memórias que a pessoa vê, com o porquê de cada uma
const contexto = { ...contextoSemBusca, busca: achadosDaBusca && new Set(achadosDaBusca.achados.map((a) => a.id)) };
const motivos = achadosDaBusca ? new Map<string, Motivo[]>(achadosDaBusca.achados.map((a) => [a.id, a.motivos])) : undefined;
const resultado = explorar(todas, filtros, contexto);
const nomeDe = (id: string) => integrantes.find((i) => i.id === id)?.apelido ?? integrantes.find((i) => i.id === id)?.nome;

// O mural, o modo TV e o sorteio são do que já foi publicado: o rascunho só aparece na linha do
// tempo e na lista de quem escreveu, levando ao formulário
const publicadas = resultado.memorias.filter((m) => m.situacao !== 'rascunho');
const memorias = mostraRascunho(forma) ? resultado.memorias : publicadas;
const limpar = temFiltro(filtros) ? enderecoDoExplorar({ ...SEM_FILTRO, ordem: filtros.ordem }, forma) : undefined;
const voltar = enderecoDoExplorar(filtros);

// O palco: a memória da vez vai no endereço ("m"), para o voltar do aparelho e o link funcionarem
const pedida = parametros.get('m');
let daVez = acaso?.memoria ?? publicadas.find((m) => m.id === pedida);
const noPalco = forma === 'tv' || forma === 'acaso';
// O "ao acaso" mostra o trecho do primeiro relato publicado com texto; o modo TV monta o dele em palcoDaTv
const relatoDaVez = daVez && forma === 'acaso' ? (await listarRelatos(usuario, daVez.id)).find((r) => r.situacao === 'publicada' && r.texto.trim()) : undefined;

// As opções dos filtros: só o que existe no que a pessoa vê
const decadaDe = (ano: number) => Math.floor(ano / 10) * 10;
const tiposPresentes = tipos.filter((t) => todas.some((m) => m.tipo === t.id)).map((t) => ({ id: t.id, nome: t.rotulo }));
const presentes = new Set(todas.flatMap((m) => m.integrantes));
const naLista = integrantes.filter((i) => presentes.has(i.id));
// Cada nome com o que a pessoa é para quem olha ("sua mãe"), pela regra de Pessoas (críticas C1 e C2)
const parentescos = modoTv || acaso ? new Map<string, string>() : await parentescosDeQuemOlha(usuario, naLista);
const pessoas = naLista.map((i) => ({ id: i.id, nome: i.apelido ?? i.nome, parentesco: parentescos.get(i.id) })).sort((a, b) => a.nome.localeCompare(b.nome, 'pt-BR'));
const ligados = filtrosLigados(filtros, {
  tipo: (id) => tipos.find((t) => t.id === id)?.rotulo,
  pessoa: nomeDe,
  capitulo: (id) => capitulos.find((c) => c.id === id)?.titulo,
  tema: (id) => temas.find((t) => t.id === id)?.nome,
});

// A assinatura e a cor acompanham a família filtrada; sem filtro de família, a família completa
const { sobrenomes } = assinaturaDaTela(filtros.familias, nucleos);
const umaFamilia = filtros.familias.length === 1 ? nucleos.find((n) => n.id === filtros.familias[0]) : undefined;
const conta = contaDoExplorar(memorias.map((m) => m.ano));
const titulo = forma === 'tv' ? 'Modo TV' : filtros.busca ? `${buscaEntreAspas(filtros.busca)} · Explorar` : (umaFamilia?.nome ?? 'Explorar');

// Quando a busca não acha nada: a frase, a dica e as saídas (tirar a busca, tirar os outros filtros, ao acaso)
const outrosFiltros = temFiltro({ ...filtros, busca: '' });
const semResultado = filtros.busca
  ? {
      busca: filtros.busca,
      semBusca: enderecoDoExplorar({ ...filtros, busca: '' }, forma),
      semOsOutros: outrosFiltros ? enderecoDoExplorar({ ...SEM_FILTRO, busca: filtros.busca, ordem: filtros.ordem }, forma) : undefined,
      acaso: enderecoDoExplorar(SEM_FILTRO, 'acaso'),
    }
  : undefined;
---

<Visual titulo={titulo} secao="explorar" nucleos={filtros.familias} palco={forma === 'tv'}>
  {
    modoTv && (
      <>
        {modoTv.palco ? <PalcoDaTv palco={modoTv.palco} /> : <Palco modo="tv" sair={modoTv.voltar} limpar={modoTv.limpar} />}
        {/* A ordem do modo TV, só os ids, para o palco passar sem pedir a lista de novo */}
        <script type="application/json" data-ordem-da-tv set:html={JSON.stringify(modoTv.ordem).replace(/</g, '\\u003c')} />
      </>
    )
  }
  {
    forma === 'acaso' && (
      <Palco
        modo="acaso"
        memoria={daVez}
        trecho={relatoDaVez && { texto: trechoDoRelato(relatoDaVez.texto, 150), por: nomeDe(relatoDaVez.por) ?? '' }}
        nomes={daVez?.integrantes.map(nomeDe).filter((n): n is string => Boolean(n))}
        depois={(acaso?.total ?? publicadas.length) > 1 && daVez ? enderecoDoExplorar(filtros, 'acaso', { outra: daVez.id }) : undefined}
        sair={daVez ? `${voltar}#${ancoraDaMemoria(daVez.id)}` : voltar}
        limpar={limpar ?? voltar}
      />
    )
  }
  {/* A linha do tempo e o mural ficam numa região que troca de conteúdo sem recarregar a página */}
  {!noPalco && (
  <div data-explorar>
  {
    forma === 'linha' && (
      <Linha
        memorias={memorias}
        capitulos={capitulos}
        integrantes={integrantes}
        nucleos={nucleos}
        ordem={filtros.ordem}
        trilhos={resultado.trilhos}
        limpar={limpar}
        fecho={memorias.length > 0 ? { comecoDoAcervo: terminaNoComecoDoAcervo(memorias, todas, filtros.ordem) } : undefined}
        motivos={motivos}
      >
        {semResultado && <div slot="vazio"><SemResultado {...semResultado} /></div>}
        <header class="linha__capa linha__capa--explorar linha__capa--compacta miolo" slot="capa">
          <Assinatura titulo sobrenomes={sobrenomes} />
          <p class="linha__conta rotulo" aria-live="polite">{conta}</p>
          <Controles
            filtros={filtros}
            forma={forma}
            nucleos={nucleos}
            tipos={tiposPresentes}
            pessoas={pessoas}
            capitulos={capitulos.map((c) => ({ id: c.id, nome: c.titulo }))}
            temas={temas}
            quantas={memorias.length}
            ligados={ligados}
            comDecadas={resultado.trilhos && new Set(memorias.map((m) => decadaDe(m.ano))).size > 1}
          />
        </header>
      </Linha>
    )
  }
  {
    forma === 'mural' && (
      <div class="linha linha--mural">
        <header class="linha__capa linha__capa--explorar linha__capa--compacta miolo">
          <Assinatura titulo sobrenomes={sobrenomes} />
          <p class="linha__conta rotulo" aria-live="polite">{conta}</p>
          <Controles
            filtros={filtros}
            forma={forma}
            nucleos={nucleos}
            tipos={tiposPresentes}
            pessoas={pessoas}
            capitulos={capitulos.map((c) => ({ id: c.id, nome: c.titulo }))}
            temas={temas}
            quantas={memorias.length}
            ligados={ligados}
            tamanho={tamanho}
            fotos={fotosDoMural}
          />
        </header>
        {memorias.length > 0 ? (
          <Mural memorias={memorias} ordem={filtros.ordem} tamanho={tamanho} fotos={fotosDoMural} />
        ) : (
          <div class="miolo">
            {semResultado ? <SemResultado {...semResultado} /> : <Vazio frase={limpar ? 'Nenhuma memória passa nesses filtros.' : 'Ainda não há memórias aqui.'}>
              {limpar ? (
                <a class="acao" href={limpar}>
                  Limpar filtros
                </a>
              ) : (
                <a class="acao" href="/nova">
                  Nova memória
                </a>
              )}
            </Vazio>}
          </div>
        )}
      </div>
    )
  }
  {
    forma === 'lista' && (
      <div class="linha linha--lista">
        <header class="linha__capa linha__capa--explorar linha__capa--compacta miolo">
          <Assinatura titulo sobrenomes={sobrenomes} />
          <p class="linha__conta rotulo" aria-live="polite">{conta}</p>
          <Controles
            filtros={filtros}
            forma={forma}
            nucleos={nucleos}
            tipos={tiposPresentes}
            pessoas={pessoas}
            capitulos={capitulos.map((c) => ({ id: c.id, nome: c.titulo }))}
            temas={temas}
            quantas={memorias.length}
            ligados={ligados}
          />
        </header>
        {memorias.length > 0 ? (
          <Lista memorias={memorias} capitulos={capitulos} integrantes={integrantes} ordem={filtros.ordem} comAudio={contexto.comAudio} motivos={motivos} />
        ) : (
          <div class="miolo">
            {semResultado ? <SemResultado {...semResultado} /> : <Vazio frase={limpar ? 'Nenhuma memória passa nesses filtros.' : 'Ainda não há memórias aqui.'}>
              {limpar ? (
                <a class="acao" href={limpar}>
                  Limpar filtros
                </a>
              ) : (
                <a class="acao" href="/nova">
                  Nova memória
                </a>
              )}
            </Vazio>}
          </div>
        )}
      </div>
    )
  }
  </div>
  )}
</Visual>

<script>
  // Trocar de forma de ver, de família, de tamanho das fotos, de filtros ou de ordem não recarrega
  // a página nem tira a pessoa do lugar: os itens que continuam se movem até o lugar novo
  // (src/lib/cliente/explorar-troca.ts). Sem script, cada escolha continua sendo um link ou um
  // formulário comum. O modo TV e o "ao acaso" têm o palco deles: para lá, a navegação é a de sempre.
  import { ligarTroca } from '../lib/cliente/explorar-troca';
  ligarTroca();
</script>
