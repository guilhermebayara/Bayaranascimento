---
// "Sua conta" (docs/decisoes.md): a página de cada pessoa para cuidar do que é dela. O painel é o
// lugar de chegar e ver o que é novo; a conta, o de cuidar das próprias coisas. Composição da
// proposta A do conceito da sessão E (escolha do Gui, 17/11/2026; docs/visual.md, "Sua conta"): no
// desktop, para quem administra, o cartão da administração ao lado do nome, com a carta de Natal no
// pé da coluna do nome; "O que você criou" numa faixa de largura toda logo abaixo; depois os avisos,
// e rascunhos e laços lado a lado. No celular: quem é, o que criou, avisos, rascunhos, laços, carta
// e, no fim, a administração. A marcação segue a ordem do celular (é também a do teclado e do leitor
// de tela); no desktop, a grade põe a administração e a carta no alto.
// As listas vêm de montarConta (src/lib/servidor/conta.ts), com as regras em src/lib/conta.ts.
import '../visual/telas/painel.css';
import '../visual/telas/conta.css';
import Visual from '../layouts/Visual.astro';
import Avisos from '../components/Avisos.astro';
import Carimbo from '../components/visual/Carimbo.astro';
import Gente from '../components/visual/Gente.astro';
import Recado from '../components/visual/Recado.astro';
import Retrato from '../components/visual/Retrato.astro';
import { GRUPO_DO_ESPACO, contaDePendencias, grupoDaPendencia, gruposDaAdministracao, fraseDaCopiaMensal, idDoGrupo, oComeco, porcentoDoBanco, resumoDoGrupo } from '../lib/conta';
import { LIMITE_DO_PLANO } from '../lib/tamanho-do-banco';
import { formatarData, jaFaleceu } from '../lib/datas';
import { familiaMaisRecente } from '../lib/familias';
import { PROXIMIDADES, lacoParaODono } from '../lib/parentesco';
import { enderecoDoRetrato } from '../lib/retratos';
import { montarConta } from '../lib/servidor/conta';
import { familiasDe, listarAvisos, listarCasais, listarFiliacoes, listarNucleos, obterCarta } from '../lib/servidor/repositorio';
import { carimboDaData, corDaPessoa, corDoNucleo } from '../lib/visual';

// Os textos novos desta tela foram aprovados pelo Gui em 17/11/2026 (pergunta 7 do PR do grupo "pessoal").
const { usuario } = Astro.locals;
const conta = await montarConta(usuario);
const { dados: eu, integrantes } = conta;
const achar = (id: string) => integrantes.find((i) => i.id === id);
const nome = (id: string) => achar(id)?.apelido ?? achar(id)?.nome ?? id;
const ordemDosNucleos = (await listarNucleos()).map((n) => n.id);
// A mesma cor do painel: a da família mais recente de quem vê
const minhaFamilia = familiaMaisRecente({ familias: new Map(integrantes.map((i) => [i.id, familiasDe(i)])), casais: await listarCasais(usuario), filiacoes: await listarFiliacoes() }, usuario.pessoa);
const cor = corDoNucleo(minhaFamilia, ordemDosNucleos);
const familiaDe = (id: string) => corDaPessoa(achar(id) ? familiasDe(achar(id)!) : [], ordemDosNucleos);
const retratoDe = (id: string) => (achar(id)?.retrato ? enderecoDoRetrato(achar(id)!.retrato!) : null);

const nascimento = eu?.nascimentoAno ? formatarData({ ano: eu.nascimentoAno, mes: eu.nascimentoMes, dia: eu.nascimentoDia, aproximada: false }) : undefined;
const { rascunhos, criou, lacos } = conta;
const quantosRascunhos = rascunhos.memorias.length + rascunhos.relatos.length;
const titulo = (id: string) => conta.titulos.get(id) ?? 'uma memória';
// O que você criou: cada lista abre no lugar, e só aparece a que tem alguma coisa
// Respostas do Gui de 17/11/2026: na tela grande as contas ficam numa linha só, com o nome curto (P148),
// e a lista aberta mostra o começo, com o caminho para o resto (P151)
const criados = [
  { id: 'memorias', quantas: criou.memorias.length, um: 'memória que você criou', varios: 'memórias que você criou', curto: ['memória', 'memórias'], resto: 'As', todas: 'Ver todas no Explorar', onde: '/explorar' },
  { id: 'relatos', quantas: criou.relatos.length, um: 'relato que você escreveu', varios: 'relatos que você escreveu', curto: ['relato', 'relatos'], resto: 'Os', todas: 'Ver todos no Explorar', onde: '/explorar' },
  { id: 'fotos', quantas: criou.fotos.length, um: 'foto que você enviou', varios: 'fotos que você enviou', curto: ['foto', 'fotos'], resto: 'As', todas: 'Ver todas no Explorar', onde: '/explorar' },
  { id: 'capitulos', quantas: criou.capitulos.length, um: 'capítulo que você criou', varios: 'capítulos que você criou', curto: ['capítulo', 'capítulos'], resto: 'Os', todas: 'Ver todos em Capítulos', onde: '/capitulos' },
].filter((c) => c.quantas > 0);
// A carta de Natal mora também aqui, para todos, e a saída da conta fica no fim, onde há login
// (respostas do Gui às P5 e P4 do QA de design, 17/11/2026)
const carta = await obterCarta();
// As memórias e as fotos chegam da mais antiga para a mais nova; os relatos, do mais recente para o mais antigo
const memoriasCriadas = oComeco([...criou.memorias].reverse());
const relatosCriados = oComeco(criou.relatos);
const fotosCriadas = oComeco([...criou.fotos].reverse());
const capitulosCriados = oComeco(criou.capitulos);
// Os dados sobem para o alto, numa linha, e só entra o que existe (P149)
const chamado = eu?.apelido && eu.apelido !== eu.nome ? `${eu.tratamento === 'ela' ? 'chamada' : 'chamado'} de ${eu.apelido}` : undefined;
const dados = [nascimento, chamado, conta.email && `e-mail de acesso: ${conta.email}`].filter(Boolean);
// "Baixar cópia do acervo" baixa um arquivo: fica à parte dos links que abrem página, junto do tamanho do banco (P153)
const paginasDaAdministracao = conta.administracao.filter((item) => !item.baixar);
const copias = conta.administracao.filter((item) => item.baixar);
const admin = conta.administracao.length > 0;
// As pendências da administração: o sinal do alto abre a lista delas, e cada uma marca o grupo onde mora
const { pendencias, situacao } = conta;
const pendenciaDo = (tipo: string) => pendencias.find((p) => p.tipo === tipo);
// Os atalhos em grupos por tema, cada um numa lista de linhas (observação do Gui, 18/11/2026)
const grupos = gruposDaAdministracao(paginasDaAdministracao);
const bancoPorcento = situacao?.banco ? porcentoDoBanco(situacao.banco.bytes, LIMITE_DO_PLANO) : 0;
const copiaMensal = situacao ? fraseDaCopiaMensal(situacao.copiaMensal, conta.hoje) : undefined;
// Os avisos: a lista e o histórico (docs/decisoes.md, "Avisos")
const todosOsAvisos = await listarAvisos(usuario, { historico: true });
const avisosPendentes = todosOsAvisos.filter((a) => !a.resolvidoEm);
const avisosVistos = todosOsAvisos.filter((a) => a.resolvidoEm).slice(0, 20);
const ok = Astro.url.searchParams.get('ok');
const erro = Astro.url.searchParams.get('erro');
---

<Visual titulo="Sua conta" secao="conta" familia={cor} intimo>
  <div class:list={['conta', 'miolo', { 'conta--admin': admin }]}>
    {(ok || erro) && <Recado erro={Boolean(erro)}>{erro ?? ok}</Recado>}
    <div class="conta__grade">
      <header class="conta__abre">
        <div class="conta__retrato">
          <Retrato nome={usuario.nome} foto={retratoDe(usuario.pessoa)} familia={cor} cedo />
        </div>
        <div class="conta__quem">
          <p class="rotulo suave">Sua conta · só você vê esta página</p>
          {/* --letras: a palavra mais longa do nome, para o título caber na coluna (conta.css) */}
          <h1 class="t-1" style={`--letras: ${Math.max(...(eu?.nome ?? usuario.nome).split(/\s+/).map((p) => p.length))}`}>{eu?.nome ?? usuario.nome}</h1>
          {dados.length > 0 && <p class="conta__dados ficha suave">{dados.join(' · ')}</p>}
          {!eu && <p class="conta__dados suave">Você entra no acervo, mas ainda não tem uma página de pessoa.</p>}
          {conta.email && <p class="conta__dados conta__dica suave">Só os administradores mudam o e-mail de acesso.</p>}
          {/* Aprovado pelo Gui em 17/11/2026 (pergunta 5 do PR do grupo "pessoal"): os dados são editados na tela de editar a página, que é do grupo 4 */}
          <p class="conta__acoes">
            <a class="botao" href={`/pessoas/${usuario.pessoa}/editar#ficha`}>
              Editar seus dados
            </a>
            <a class="acao" href={`/pessoas/${usuario.pessoa}`}>
              Ver sua página
            </a>
          </p>
        </div>
      </header>

      <section class="conta__criou" aria-labelledby="criou">
        <h2 class="rotulo suave" id="criou">
          O que você criou
        </h2>
        {
          criados.length === 0 && (
            <p class="conta__nada serifa">
              Ainda nada. <a href="/nova">Registrar uma memória</a>
            </p>
          )
        }
        <div class="conta__criados" data-quantos={criados.length}>
          {criados.map((c) => {
            const lista = { memorias: memoriasCriadas, relatos: relatosCriados, fotos: fotosCriadas, capitulos: capitulosCriados }[c.id]!;
            return (
              <details class="criado" name="criou">
                <summary>
                  <span class="criado__numero serifa">{c.quantas}</span>
                  <span class="criado__nome criado__nome--longo serifa">{c.quantas === 1 ? c.um : c.varios}</span>
                  <span class="criado__nome criado__nome--curto serifa">{c.curto[c.quantas === 1 ? 0 : 1]}</span>
                  <span class="criado__abre acao acao--quieta" aria-hidden="true" />
                </summary>
                <div class="criado__lista">
                  {c.id === 'memorias' && (
                    <ul class="conta__lista">
                      {memoriasCriadas.mostra.map((m) => (
                        <li>
                          <a class="conta__item" href={`/memorias/${m.id}`}>
                            <strong>{m.titulo}</strong>
                            <span class="ficha suave">{carimboDaData(m)}</span>
                          </a>
                        </li>
                      ))}
                    </ul>
                  )}
                  {c.id === 'relatos' && (
                    <ul class="conta__lista">
                      {relatosCriados.mostra.map((r) => (
                        <li>
                          <a class="conta__item" href={`/memorias/${r.memoriaId}`}>
                            <strong>{titulo(r.memoriaId)}</strong>
                            {r.emNomeDe && <span class="ficha suave">Registrado em nome de {nome(r.emNomeDe)}</span>}
                          </a>
                        </li>
                      ))}
                    </ul>
                  )}
                  {c.id === 'fotos' && (
                    <ul class="conta__fotos">
                      {fotosCriadas.mostra.map(({ memoria, foto }) => (
                        <li>
                          <a href={`/memorias/${memoria.id}`} aria-label={`Foto em ${memoria.titulo}`}>
                            <img src={`/fotos/${foto.chave}`} alt="" loading="lazy" decoding="async" />
                          </a>
                        </li>
                      ))}
                    </ul>
                  )}
                  {c.id === 'capitulos' && (
                    <ul class="conta__lista">
                      {capitulosCriados.mostra.map((cap) => (
                        <li>
                          <a class="conta__item" href={`/capitulos/${cap.id}`}>
                            <strong>{cap.titulo}</strong>
                          </a>
                        </li>
                      ))}
                    </ul>
                  )}
                  {lista.haMais && (
                    <p class="conta__pe">
                      <span class="suave">
                        {c.resto} {lista.mostra.length} mais recentes de {lista.total}.
                      </span>
                      <a class="acao" href={c.onde}>
                        {c.todas}
                      </a>
                    </p>
                  )}
                </div>
              </details>
            );
          })}
        </div>
      </section>
      <Avisos avisos={avisosPendentes} historico={avisosVistos} onde="conta" />
      <section class="cartao conta__rascunhos" aria-labelledby="rascunhos">
        <h2 class="cartao__titulo rotulo" id="rascunhos">
          Rascunhos e lixeira
        </h2>
        {
          quantosRascunhos === 0 ? (
            <p class="conta__nada serifa">Você não tem rascunhos.</p>
          ) : (
            <ul class="conta__lista">
              {rascunhos.memorias.map((m) => (
                <li>
                  <a class="conta__item" href={`/nova?id=${m.id}`}>
                    <strong>{m.titulo}</strong>
                    <span class="ficha suave">Memória · {carimboDaData(m)}</span>
                  </a>
                </li>
              ))}
              {rascunhos.relatos.map((r) => (
                <li>
                  <a class="conta__item" href={`/memorias/${r.memoriaId}/relato`}>
                    <strong>{titulo(r.memoriaId)}</strong>
                    <span class="ficha suave">{r.por === usuario.pessoa ? 'Relato em andamento' : `Relato de ${nome(r.por)}, em andamento`}</span>
                  </a>
                </li>
              ))}
            </ul>
          )
        }
        <p class="conta__pe">
          <span class="suave">
            {/* Quem administra lê a conta do que a lixeira mostra (P152) */}
            {conta.fraseDaLixeira}
          </span>
          <a class="acao" href="/lixeira">
            Abrir a lixeira
          </a>
        </p>
      </section>

      <section class="cartao conta__lacos" aria-labelledby="lacos">
        <h2 class="cartao__titulo rotulo" id="lacos">
          Seus laços do coração
        </h2>
        {
          lacos.length === 0 ? (
            <p class="conta__nada serifa">Você ainda não tem laços do coração.</p>
          ) : (
            <ul class="conta__gente">
              {lacos.map((l) => (
                <li>
                  <Gente
                    href={`/pessoas/${l.pessoa}`}
                    nome={nome(l.pessoa)}
                    foto={retratoDe(l.pessoa)}
                    familia={familiaDe(l.pessoa)}
                    laco={lacoParaODono(l.nome, achar(l.pessoa)?.tratamento ?? null)}
                    detalhe={[l.proximidade ? PROXIMIDADES[l.proximidade]!.toLowerCase() : '', l.privado ? 'só você vê' : ''].filter(Boolean).join(' · ')}
                    falecido={Boolean(achar(l.pessoa) && jaFaleceu(achar(l.pessoa)!))}
                  />
                </li>
              ))}
            </ul>
          )
        }
        <p class="conta__pe">
          {lacos.length > 0 && <span class="suave">A proximidade só você vê.</span>}
          <a class="acao" href={`/pessoas/${usuario.pessoa}/editar#lacos`}>
            {lacos.length > 0 ? 'Editar seus laços' : 'Adicionar laço'}
          </a>
        </p>
      </section>


      {
        carta && (
          <p class="conta__carta">
            <Carimbo itens={[`Natal de ${carta.escritaEm.slice(0, 4)}`]} />
            <a class="acao" href="/carta">
              Ler a carta de Natal
            </a>
          </p>
        )
      }

      {
        admin && (
          <section class="cartao conta__admin" aria-labelledby="administracao" id="administracao-cartao">
            {/* Proposta A do conceito da sessão H (escolha do Gui, 18/11/2026): cada grupo é uma linha que abre e
                fecha, uma por vez, como no painel da árvore; o sinal do alto abre, por cima, a lista das pendências */}
            <div class="conta__admin-alto">
              <h2 class="rotulo" id="administracao">
                Administração
              </h2>
              {pendencias.length > 0 ? (
                <details class="conta__sinal" data-menu-acoes>
                  <summary class="conta__pendencias ficha">{contaDePendencias(pendencias.length)}</summary>
                  <div class="conta__balao">
                    <p class="rotulo suave">O que pede você</p>
                    <ul>
                      {pendencias.map((p) => (
                        <li>
                          <a class="menu-acoes__item" href={p.href ?? `#${idDoGrupo(grupoDaPendencia(p))}`} data-abre-grupo={p.href ? undefined : idDoGrupo(grupoDaPendencia(p))}>
                            <strong>{p.texto}</strong>
                            <span class="ficha suave">em {grupoDaPendencia(p)}</span>
                          </a>
                        </li>
                      ))}
                    </ul>
                  </div>
                </details>
              ) : (
                <span class="ficha suave">Tudo em dia</span>
              )}
            </div>
            {grupos.map((grupo, i) => {
              const marcadas = pendencias.filter((p) => grupoDaPendencia(p) === grupo.titulo).length;
              return (
                <details class="conta__grupo" name="administracao" id={idDoGrupo(grupo.titulo)} open={i === 0 && pendencias.length === 0 ? true : undefined}>
                  <summary>
                    <span class="conta__grupo-nome">{grupo.titulo}</span>
                    <span class:list={['ficha', marcadas ? 'conta__pendente' : 'suave']}>{resumoDoGrupo(grupo.itens.length, marcadas)}</span>
                  </summary>
                  <ul>
                    {grupo.itens.map((item) => (
                      <li>
                        <a class:list={['conta__atalho', { 'conta__atalho--pendente': item.pendencia }]} href={item.href}>
                          <strong>{item.rotulo}</strong>
                          {item.situacao && <span class="ficha">{item.situacao}</span>}
                        </a>
                      </li>
                    ))}
                  </ul>
                </details>
              );
            })}
            {(() => {
              const marcadas = pendencias.filter((p) => grupoDaPendencia(p) === GRUPO_DO_ESPACO).length;
              return (
                <details class="conta__grupo" name="administracao" id={idDoGrupo(GRUPO_DO_ESPACO)}>
                  <summary>
                    <span class="conta__grupo-nome">{GRUPO_DO_ESPACO}</span>
                    <span class:list={['ficha', marcadas ? 'conta__pendente' : 'suave']}>{marcadas ? contaDePendencias(marcadas) : conta.banco ? `banco em ${bancoPorcento}%` : 'tudo certo'}</span>
                  </summary>
                  <div class="conta__banco">
                    <div class="conta__medidores">
                      {conta.banco && (
                        <div class:list={['conta__medidor', { 'conta__medidor--aviso': conta.bancoEmAviso }]}>
                          <p class="conta__banco-linha">
                            <strong>Banco do acervo</strong>
                            <span class="ficha">{conta.banco}</span>
                          </p>
                          <div class="conta__medida" role="img" aria-label={`Banco: ${conta.banco}`}>
                            <span style={`width: ${bancoPorcento}%`} />
                          </div>
                          {conta.bancoEmAviso && <p class="conta__nota">Perto do limite do plano gratuito. A saída combinada é o plano Workers Paid.</p>}
                        </div>
                      )}
                      {conta.espaco && (
                        <div class:list={['conta__medidor', { 'conta__medidor--aviso': conta.espaco.emAviso }]}>
                          <p class="conta__banco-linha">
                            <strong>Fotos e áudios</strong>
                            <span class="ficha">{conta.espaco.frase}</span>
                          </p>
                          <div class="conta__medida" role="img" aria-label={`Fotos e áudios: ${conta.espaco.frase}`}>
                            <span style={`width: ${conta.espaco.porcento}%`} />
                          </div>
                          {conta.espaco.emAviso && <p class="conta__nota">Perto do limite do plano gratuito, que soma a produção, a homologação e as prévias.</p>}
                          {conta.espaco.nota && <p class="conta__nota ficha">{conta.espaco.nota}</p>}
                        </div>
                      )}
                    </div>
                    <div class="conta__copias">
                      {copiaMensal && <p class:list={['conta__nota', 'ficha', { conta__pendente: Boolean(pendenciaDo('copia')) }]}>{copiaMensal}</p>}
                      {copias.map((copia) => (
                        <a class="acao" href={copia.href} download>
                          {copia.rotulo}
                        </a>
                      ))}
                    </div>
                  </div>
                </details>
              );
            })()}
          </section>
        )
      }
    </div>
  </div>
</Visual>

<script>
  // O balão das pendências (Esc, toque fora) e a pendência sem página própria, que abre o grupo dela
  import { ligarMenus } from '../lib/cliente/menus';
  ligarMenus();
  document.addEventListener('click', (e) => {
    const link = (e.target as HTMLElement).closest<HTMLAnchorElement>('[data-abre-grupo]');
    const grupo = link && (document.getElementById(link.dataset.abreGrupo!) as HTMLDetailsElement | null);
    if (!link || !grupo) return;
    e.preventDefault();
    link.closest<HTMLDetailsElement>('details[data-menu-acoes]')!.open = false;
    grupo.open = true;
    grupo.querySelector('summary')?.focus();
  });
</script>
