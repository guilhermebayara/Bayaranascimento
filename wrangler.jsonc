{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bayaranascimento",
  "compatibility_date": "2026-11-14",
  "compatibility_flags": ["nodejs_compat"],

  // O site só responde no domínio protegido pelo login.
  "workers_dev": false,
  "preview_urls": true,
  // previews_enabled dá a cada branch um endereço <branch>.memorias.bayara.com.br.
  // Sem isso, cada publicação da produção desliga as prévias no domínio.
  "routes": [{ "pattern": "memorias.bayara.com.br", "custom_domain": true, "previews_enabled": true }],

  // Preserva variáveis configuradas pelo painel a cada publicação
  "keep_vars": true,

  "r2_buckets": [{ "binding": "FOTOS", "bucket_name": "bayara-memorias" }],
  "d1_databases": [
    { "binding": "DB", "database_name": "bayara-memorias", "database_id": "9bb25f11-3a8c-4c23-b427-94cce9c23d00" }
  ],

  "vars": {
    // Cloudflare Access: usados para conferir quem está logado
    "ACCESS_TEAM_DOMAIN": "memoriasb-b.cloudflareaccess.com",
    "ACCESS_AUD": "6cb7130805a6a1e18b9863e6d91d6d76e5d980ae09acba0a63e5aba2229fddda",
    // "producao" exige login. Só as prévias de branch usam "previa".
    "AMBIENTE": "producao"
  },

  // Prévias de branch (npx wrangler preview). Usam banco e bucket de teste,
  // só com memórias de exemplo, e por isso funcionam sem login: nada do
  // acervo real fica ao alcance de uma prévia.
  "previews": {
    "vars": {
      "ACCESS_TEAM_DOMAIN": "memoriasb-b.cloudflareaccess.com",
      "ACCESS_AUD": "6cb7130805a6a1e18b9863e6d91d6d76e5d980ae09acba0a63e5aba2229fddda",
      "AMBIENTE": "previa"
    },
    // FOTOS_HOMOLOGA e DB_HOMOLOGA só são usados em homologa.memorias.bayara.com.br, a prévia
    // da branch homologa (ver src/lib/servidor/ambiente.ts). Lá os dados são a estrutura da
    // família espelhada da produção, com nomes e memórias inventados.
    "r2_buckets": [
      { "binding": "FOTOS", "bucket_name": "bayara-memorias-teste" },
      { "binding": "FOTOS_HOMOLOGA", "bucket_name": "bayara-memorias-homologa" }
    ],
    "d1_databases": [
      { "binding": "DB", "database_name": "bayara-memorias-teste", "database_id": "d2c94f2a-5945-4414-8772-5769febac77b" },
      { "binding": "DB_HOMOLOGA", "database_name": "bayara-memorias-homologa", "database_id": "004a27d4-df4b-4127-baa4-fe6b1cf32c34" }
    ],
    // As prévias e a homologação também têm o Workers AI: o Gui liga a transcrição primeiro na homologação
    "ai": { "binding": "AI" }
  },

  // Workers AI, para a transcrição automática dos áudios (resposta do Gui à sessão F, 18/11/2026). A conta
  // está no plano gratuito: passar da cota só faz o pedido falhar, sem cobrança. A transcrição continua
  // desligada até um administrador ligar em Administração, "Transcrição automática".
  "ai": { "binding": "AI" },

  "observability": { "enabled": true }

  // Segredo, configurado pelo painel ou com `wrangler secret put`:
  //   ACESSOS       JSON ligando e-mail de login a integrante, ex.: {"a@b.com":"gui"}
}
